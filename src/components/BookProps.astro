---
import '../styles/book.css';
// Escena del libro 3D: mesa oscura estriada con luz cálida y tres objetos vistos desde arriba (suculenta, lápiz y taza). Todo yace sobre el plano de la mesa.
const leaves = Array.from({ length: 22 }, (_, i) => {
  const ring = i < 9 ? 0 : i < 16 ? 1 : 2;
  const n = [9, 7, 6][ring], k = ring === 0 ? i : ring === 1 ? i - 9 : i - 16;
  const a = (k / n) * 360 + ring * 17;
  const len = [38, 29, 19][ring], w = [11.5, 10.5, 9][ring];
  return { a, len, w, c: ['#7f9a8d', '#8fb0a1', '#a3c4b4'][ring], d: ['#556f64', '#628275', '#78998a'][ring] };
});
---
<i class="bw-desk"></i><i class="bw-lamp"></i>
<!-- suculenta -->
<svg class="bw-flat bw-succ" viewBox="-60 -60 120 120" aria-hidden="true">
  <defs>
    <radialGradient id="sPot" cx=".42" cy=".38" r=".75"><stop offset="0" stop-color="#4b4a45"/><stop offset=".7" stop-color="#2c2b28"/><stop offset="1" stop-color="#171715"/></radialGradient>
    <radialGradient id="sSh" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#000" stop-opacity=".85"/><stop offset="1" stop-color="#000" stop-opacity="0"/></radialGradient>
    <radialGradient id="sSoil" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#1f1d1a"/><stop offset="1" stop-color="#0c0b0a"/></radialGradient>
  </defs>
  <ellipse cx="9" cy="10" rx="58" ry="58" fill="url(#sSh)"/>
  <circle r="47" fill="url(#sPot)"/>
  <circle r="47" fill="none" stroke="rgba(255,255,255,.1)" stroke-width="1"/>
  <circle r="40" fill="url(#sSoil)"/>
  {Array.from({ length: 26 }, (_, i) => <circle cx={Math.cos(i * 2.4) * (14 + (i * 7) % 22)} cy={Math.sin(i * 2.4) * (14 + (i * 7) % 22)} r={1 + (i % 3) * 0.7} fill="#5d5a52" />)}
  {leaves.map((l) => (
    <g transform={`rotate(${l.a})`}>
      <path d={`M0 0 C${l.w} -${l.len * 0.3} ${l.w * 0.9} -${l.len * 0.85} 0 -${l.len} C-${l.w * 0.9} -${l.len * 0.85} -${l.w} -${l.len * 0.3} 0 0Z`} fill={l.c} stroke={l.d} stroke-width=".8"/>
      <path d={`M0 -2 L0 -${l.len * 0.86}`} stroke={l.d} stroke-width=".7" opacity=".55"/>
    </g>
  ))}
  <circle r="3.2" fill="#b9d2c4"/>
</svg>
<!-- lápiz -->
<svg class="bw-flat bw-pencil" viewBox="0 0 300 30" aria-hidden="true">
  <defs>
    <linearGradient id="pB" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a3a3d"/><stop offset=".5" stop-color="#161618"/><stop offset="1" stop-color="#050506"/></linearGradient>
    <linearGradient id="pW" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e9c89c"/><stop offset="1" stop-color="#a8794a"/></linearGradient>
  </defs>
  <ellipse cx="150" cy="22" rx="138" ry="6" fill="rgba(0,0,0,.65)"/>
  <rect x="48" y="7" width="240" height="15" rx="3" fill="url(#pB)"/>
  <rect x="48" y="9" width="240" height="2" fill="rgba(255,255,255,.14)"/>
  <rect x="270" y="7" width="18" height="15" rx="3" fill="#8b8b90"/>
  <path d="M48 7 L8 14.5 L48 22Z" fill="url(#pW)"/>
  <path d="M20 12.6 L8 14.5 L20 16.4Z" fill="#17171a"/>
</svg>
<!-- taza -->
<svg class="bw-flat bw-cupf" viewBox="-70 -60 160 120" aria-hidden="true">
  <defs>
    <radialGradient id="cSa" cx=".4" cy=".35" r=".8"><stop offset="0" stop-color="#f4f2ee"/><stop offset=".7" stop-color="#d9d6cf"/><stop offset="1" stop-color="#a9a69f"/></radialGradient>
    <radialGradient id="cCup" cx=".4" cy=".35" r=".8"><stop offset="0" stop-color="#fbfaf7"/><stop offset="1" stop-color="#cfccc4"/></radialGradient>
    <radialGradient id="cCof" cx=".4" cy=".35" r=".8"><stop offset="0" stop-color="#6d4a32"/><stop offset=".6" stop-color="#3a2416"/><stop offset="1" stop-color="#1a0e07"/></radialGradient>
    <radialGradient id="cSh" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#000" stop-opacity=".8"/><stop offset="1" stop-color="#000" stop-opacity="0"/></radialGradient>
  </defs>
  <ellipse cx="8" cy="8" rx="62" ry="58" fill="url(#cSh)"/>
  <circle r="48" fill="url(#cSa)"/>
  <circle r="48" fill="none" stroke="rgba(0,0,0,.18)" stroke-width="1"/>
  <circle r="36" fill="none" stroke="rgba(0,0,0,.1)" stroke-width="1.2"/>
  <path d="M30 -16 C58 -22 60 14 30 14" fill="none" stroke="#bdbab2" stroke-width="9" stroke-linecap="round"/>
  <path d="M30 -16 C54 -20 56 10 30 10" fill="none" stroke="#f3f1ec" stroke-width="6" stroke-linecap="round"/>
  <circle r="29" fill="url(#cCup)"/>
  <circle r="25" fill="url(#cCof)"/>
  <ellipse cx="-7" cy="-8" rx="12" ry="5" fill="rgba(255,226,190,.2)" transform="rotate(-25 -7 -8)"/>
</svg>
