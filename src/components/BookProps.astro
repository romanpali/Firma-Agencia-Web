---
import '../styles/book.css';
// Escena del libro 3D: mesa oscura estriada con luz cálida y un lápiz visto desde arriba. Todo yace sobre el plano de la mesa.
---
<i class="bw-desk"></i><i class="bw-lamp"></i>
<!-- lápiz -->
<svg class="bw-flat bw-pencil" viewBox="0 0 300 30" aria-hidden="true">
  <defs>
    <linearGradient id="pB" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a3a3d"/><stop offset=".5" stop-color="#161618"/><stop offset="1" stop-color="#050506"/></linearGradient>
    <linearGradient id="pW" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e9c89c"/><stop offset="1" stop-color="#a8794a"/></linearGradient>
  </defs>
  <ellipse cx="150" cy="22" rx="138" ry="6" fill="rgba(0,0,0,.65)"/>
  <rect x="48" y="7" width="240" height="15" rx="3" fill="url(#pB)"/>
  <rect x="48" y="9" width="240" height="2" fill="rgba(255,255,255,.14)"/>
  <rect x="270" y="7" width="18" height="15" rx="3" fill="#8b8b90"/>
  <path d="M48 7 L8 14.5 L48 22Z" fill="url(#pW)"/>
  <path d="M20 12.6 L8 14.5 L20 16.4Z" fill="#17171a"/>
</svg>
