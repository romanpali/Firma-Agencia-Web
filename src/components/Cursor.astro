<div
  data-cursor
  aria-hidden="true"
  class="pointer-events-none fixed left-0 top-0 z-[70] hidden size-8 rounded-full border border-white/60 bg-white/20 opacity-0 backdrop-blur-[4px] backdrop-brightness-[0.82] transition-opacity duration-200 ease-linear [@media(hover:hover)_and_(pointer:fine)]:block"
></div>

<script>
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const el = document.querySelector<HTMLElement>('[data-cursor]')!;
    const target = { x: -100, y: -100 };
    const pos = { x: -100, y: -100 };
    let seen = false;
    let last = performance.now();
    addEventListener('pointermove', (e) => {
      target.x = e.clientX;
      target.y = e.clientY;
      if (!seen) { seen = true; pos.x = e.clientX; pos.y = e.clientY; }
      el.style.opacity = '1';
    });
    document.addEventListener('mouseout', (e) => { if (!e.relatedTarget) el.style.opacity = '0'; });
    const loop = (now: number) => {
      const k = 1 - Math.pow(0.7, (now - last) / 16.67);
      last = now;
      pos.x += (target.x - pos.x) * k;
      pos.y += (target.y - pos.y) * k;
      el.style.transform = `translate3d(${pos.x - 16}px, ${pos.y - 16}px, 0)`;
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }
</script>
