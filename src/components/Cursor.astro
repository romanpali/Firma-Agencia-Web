<div data-cursor-ring class="cursor-ring" aria-hidden="true"></div>
<div data-cursor-dot class="cursor-dot" aria-hidden="true"></div>

<script>
  // Cursor circular minimalista: solo con ratón (no en pantallas táctiles).
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const ring = document.querySelector<HTMLElement>('[data-cursor-ring]')!;
    const dot = document.querySelector<HTMLElement>('[data-cursor-dot]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let x = -100, y = -100, rx = x, ry = y, shown = false, raf = 0;
    const HOVER = 'a,button,summary,label,select,[role="button"],input[type="color"],input[type="range"]';
    const loop = () => {
      rx += (x - rx) * (reduced ? 1 : 0.2); ry += (y - ry) * (reduced ? 1 : 0.2);
      ring.style.transform = `translate3d(${rx.toFixed(1)}px,${ry.toFixed(1)}px,0)`;
      dot.style.transform = `translate3d(${x}px,${y}px,0)`;
      raf = Math.abs(x - rx) + Math.abs(y - ry) > 0.1 ? requestAnimationFrame(loop) : 0;
    };
    addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      if (sb) return;
      x = e.clientX; y = e.clientY;
      if (!shown) { shown = true; rx = x; ry = y; document.documentElement.classList.add('has-cursor'); if (!hidden) ring.style.opacity = dot.style.opacity = '1'; }
      if (hidden) { hidden = false; ring.style.opacity = dot.style.opacity = '1'; rx = x; ry = y; }
      const t = e.target as Element | null;
      ring.classList.toggle('is-hover', !!t?.closest?.(HOVER));
      ring.classList.toggle('is-text', !!t?.closest?.('input:not([type="color"]):not([type="checkbox"]),textarea'));
      if (!raf) raf = requestAnimationFrame(loop);
    }, { passive: true });
    // Si pulsas la barra de scroll (o arrastras), el círculo se oculta hasta soltar, para que no se quede pegado.
    let hidden = false, sb = false;
    const hide = () => { hidden = true; ring.style.opacity = dot.style.opacity = '0'; };
    const show = () => { if (hidden && shown) { hidden = false; ring.style.opacity = dot.style.opacity = '1'; } hidden = false; };
    const onScrollbar = (e: PointerEvent) => {
      const t = e.target as HTMLElement;
      if (t === document.documentElement || t === document.body) return e.clientX >= document.documentElement.clientWidth || e.clientY >= document.documentElement.clientHeight;
      return (t.scrollHeight > t.clientHeight && e.offsetX >= t.clientWidth) || (t.scrollWidth > t.clientWidth && e.offsetY >= t.clientHeight);
    };
    addEventListener('pointerdown', (e) => { if (onScrollbar(e)) { sb = true; hide(); } else ring.classList.add('is-down'); });
    const up = () => { sb = false; ring.classList.remove('is-down'); show(); };
    addEventListener('pointerup', up); addEventListener('pointercancel', up); addEventListener('dragend', up);
    addEventListener('blur', () => { hide(); });
    addEventListener('focus', show);
    document.addEventListener('mouseleave', hide);
    document.addEventListener('mouseenter', show);
  }
</script>
