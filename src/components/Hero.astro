---
---

<section data-hero data-tone="dark" class="relative h-svh min-h-[620px] overflow-hidden bg-[#0a101c] text-[#f3f1ee] md:sticky md:top-0">
  <!-- Sky: blue hour -->
  <div class="absolute inset-0" style="background:linear-gradient(to bottom,#080d18 0%,#142036 26%,#2f4466 52%,#6a7f9f 74%,#a1afc2 90%)"></div>
  <div data-depth="0.08" class="pointer-events-none absolute inset-0">
    <i class="cloud absolute -left-[10%] top-[2%] h-[26%] w-[55%] rounded-[50%] bg-[#060a12]/55 blur-[50px]"></i>
    <i class="cloud absolute right-[-12%] top-[-4%] h-[30%] w-[50%] rounded-[50%] bg-[#060a12]/60 blur-[55px]" style="animation-delay:-14s"></i>
    <i class="cloud absolute left-[30%] top-[14%] h-[16%] w-[40%] rounded-[50%] bg-[#0b1322]/45 blur-[45px]" style="animation-delay:-28s"></i>
  </div>

  <!-- The facade: planes, timber and light -->
  <div data-scene class="absolute bottom-0 left-1/2 aspect-[16/9] w-[156svh] -translate-x-1/2" aria-hidden="true">
    <!-- far block -->
    <div data-depth="0.2" class="absolute" style="left:84%;top:40%;width:34%;height:19%">
      <div class="sc-r size-full" style="background:linear-gradient(135deg,#f3f2ef,#cfd0d2);--d:.9s"></div>
    </div>

    <!-- dark cladding slab -->
    <div data-depth="0.35" class="absolute" style="left:1.4%;top:34%;width:71.6%;height:27.5%">
      <div class="sc-down relative size-full" style="background:linear-gradient(to bottom,#272a2f,#16181b);box-shadow:inset 0 -40px 50px rgba(0,0,0,.5);--d:.5s">
        <i class="absolute inset-0" style="background-image:repeating-linear-gradient(90deg,transparent 0,transparent calc(4.1% - 1px),rgba(255,255,255,.075) calc(4.1% - 1px),rgba(255,255,255,.075) 4.1%)"></i>
        <i class="absolute inset-x-0 top-0 h-px bg-white/15"></i>
      </div>
    </div>

    <!-- timber recess with warm light -->
    <div data-depth="0.5" class="absolute" style="left:38.5%;top:61%;width:25%;height:25.2%">
      <div class="sc-fade relative size-full overflow-hidden" style="background:#24160d;--d:.9s">
        <i class="absolute inset-0" style="background-image:repeating-linear-gradient(90deg,#7a4e2e 0,#7a4e2e .55%,#2a190d .55%,#2a190d .8%)"></i>
        <i class="absolute inset-x-0 top-0 h-[40%]" style="background:linear-gradient(to bottom,rgba(0,0,0,.85),transparent)"></i>
        <i class="lit absolute inset-0" style="background:linear-gradient(to top,rgba(255,176,96,.7),rgba(255,176,96,0) 62%);--d:1.7s"></i>
        {[14, 50, 86].map((x, i) => <i class="lit absolute bottom-0 h-[70%] w-[22%] -translate-x-1/2 blur-[10px]" style={`left:${x}%;background:radial-gradient(ellipse at 50% 100%,rgba(255,200,130,.95),rgba(255,176,96,0) 70%);--d:${1.9 + i * 0.25}s`}></i>)}
      </div>
    </div>

    <!-- stone panel -->
    <div data-depth="0.6" class="absolute" style="left:63.2%;top:60%;width:7.4%;height:26.4%">
      <div class="sc-down size-full" style="background:repeating-linear-gradient(to bottom,#cdbfa4 0,#cdbfa4 6%,#b9aa8d 6%,#b9aa8d 6.6%);box-shadow:inset 6px 0 14px rgba(255,190,120,.45),inset -8px 0 14px rgba(0,0,0,.25);--d:1.1s"></div>
    </div>

    <!-- left concrete plane + angled return -->
    <div data-depth="0.85" class="absolute" style="left:-100%;top:57%;width:124%;height:29.6%">
      <div class="sc-l size-full" style="background:linear-gradient(to right,#dcdad5,#eceae6 60%,#e3e1dc);box-shadow:inset 0 -30px 50px rgba(0,0,0,.18);--d:.7s">
        <i class="absolute inset-y-0" style="left:76%;width:1px;background:rgba(0,0,0,.1)"></i>
        <i class="absolute inset-y-0" style="left:88%;width:1px;background:rgba(0,0,0,.1)"></i>
      </div>
    </div>
    <div data-depth="0.85" class="absolute" style="left:23.8%;top:57%;width:14.8%;height:29.6%">
      <div class="sc-l size-full" style="clip-path:polygon(0 0,100% 11%,100% 100%,0 100%);background:linear-gradient(to right,#e6e4df,#c9c6be);--d:.8s">
        <i class="lit absolute inset-0" style="background:linear-gradient(to top,rgba(255,184,100,.55),rgba(255,184,100,0) 70%);--d:1.9s"></i>
      </div>
    </div>
    {[7, 12.4, 17.8].map((x, i) => <div data-depth="0.85" class="absolute" style={`left:${x}%;top:62%;width:2.6%;height:24%`}><i class="lit absolute inset-0 blur-[7px]" style={`background:linear-gradient(to top,rgba(255,190,110,.95),rgba(255,190,110,0));--d:${2 + i * 0.3}s`}></i></div>)}

    <!-- right concrete plane -->
    <div data-depth="0.85" class="absolute" style="left:70.4%;top:58%;width:130%;height:28.6%">
      <div class="sc-r size-full" style="clip-path:polygon(0 12%,3.6% 0,100% 0,100% 100%,0 100%);background:linear-gradient(to right,#cfcdc8,#eeece8 30%,#e7e5e0);box-shadow:inset 0 -30px 50px rgba(0,0,0,.18);--d:.7s">
        <i class="absolute inset-y-0" style="left:6%;width:1px;background:rgba(0,0,0,.1)"></i>
        <i class="absolute inset-y-0" style="left:13%;width:1px;background:rgba(0,0,0,.1)"></i>
        <i class="absolute inset-y-0" style="left:20%;width:1px;background:rgba(0,0,0,.1)"></i>
      </div>
    </div>
    {[73.4, 77.6].map((x, i) => <div data-depth="0.85" class="absolute" style={`left:${x}%;top:64%;width:2.4%;height:22%`}><i class="lit absolute inset-0 blur-[7px]" style={`background:linear-gradient(to top,rgba(255,190,110,.8),rgba(255,190,110,0));--d:${2.3 + i * 0.3}s`}></i></div>)}

    <!-- ground -->
    <div data-depth="1" class="absolute" style="left:-100%;top:86%;width:300%;height:14%">
      <div class="size-full" style="background:linear-gradient(to bottom,#3a3d42 0,#3a3d42 1.4%,#23262a 1.4%,#14161a 100%)"></div>
      <i class="lit absolute" style="left:117%;top:0;width:34%;height:7%;clip-path:polygon(0 0,100% 0,95% 100%,5% 100%);background:linear-gradient(90deg,rgba(255,190,120,.7),rgba(255,230,190,.35),rgba(255,190,120,.6));--d:2.3s"></i>
      <i class="absolute" style="left:137%;top:-10%;width:34%;height:9%;background:linear-gradient(to top,#33521f,#1d3012)"></i>
    </div>
  </div>

  <!-- Text -->
  <div data-hero-inner class="relative mx-auto h-full max-w-[1280px] px-6 md:px-10">
    <h1 data-words class="absolute left-6 right-6 top-[15svh] max-w-[18ch] text-[clamp(1.9rem,3.9vw,4.4rem)] font-light leading-[1.04] tracking-[-0.04em] text-[#f6f4f0] text-balance md:left-10 md:right-auto md:top-[14svh]">
      Todo lo que hace funcionar a una empresa, conectado bajo un solo estándar.
    </h1>

    <div class="hf-rise absolute inset-x-6 bottom-6 flex flex-col gap-5 md:inset-x-10 md:bottom-9 md:flex-row md:items-end md:justify-between" style="--d:1.4s">
      <p class="max-w-[22rem] text-[15px] leading-relaxed text-white/75 [text-shadow:0_1px_14px_rgba(0,0,0,0.6)]">
        HumanCorp diseña, desarrolla y conecta los sistemas de tu empresa, paso a paso.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/contacto" class="group inline-flex items-center gap-2 rounded-full bg-[#f3f1ee] px-6 py-3.5 text-[15px] font-medium text-[#141618] transition-[transform,background-color] duration-200 hover:scale-[1.03] hover:bg-white active:scale-[0.98]">
          Hablemos de tu empresa
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
        <a href="#construccion" class="inline-flex items-center rounded-full border border-white/40 px-6 py-3.5 text-[15px] font-medium backdrop-blur-sm transition-[background-color,transform] duration-200 hover:bg-white/15 active:scale-[0.98]">
          Ver cómo lo construimos
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const layers = [...hero.querySelectorAll<HTMLElement>('[data-depth]')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ptr = { x: 0, y: 0 }, tgt = { x: 0, y: 0 };
  addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return;
    tgt.x = e.clientX / innerWidth - 0.5;
    tgt.y = e.clientY / innerHeight - 0.5;
  });
  const frame = () => {
    ptr.x += (tgt.x - ptr.x) * 0.06; ptr.y += (tgt.y - ptr.y) * 0.06;
    const hp = Math.min(1, Math.max(0, scrollY / innerHeight));
    for (const el of layers) {
      const d = parseFloat(el.dataset.depth!);
      el.style.transform = `translate3d(${(-ptr.x * 30 * d).toFixed(1)}px, ${(-ptr.y * 10 * d - hp * 110 * d).toFixed(1)}px, 0)`;
    }
    if (!document.hidden && !reduced) requestAnimationFrame(frame);
  };
  requestAnimationFrame(frame);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) requestAnimationFrame(frame); });
  if (reduced) addEventListener('scroll', () => requestAnimationFrame(frame), { passive: true });
</script>
