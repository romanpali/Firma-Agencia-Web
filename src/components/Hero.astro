---
import { divisions } from '../data/servicios';
const names = divisions.map((d) => d.short);
// Celular: emisor en espiral. Cada mosaico nace pequeño y borroso en el centro y sale girando (antihorario) hasta los bordes, ganando tamaño y nitidez.
const N = 24, ARMS = 3;
// Tres brazos de una misma espiral: cada mosaico pertenece a un brazo y recorre la curva de adentro hacia afuera.
const tiles = Array.from({ length: N }, (_, k) => ({ k, arm: k % ARMS, idx: Math.floor(k / ARMS), img: k + 1, off: [-10, 6, -4, 12, -8, 5, -12, 9, -2, 10][k % 10] }));
---

<div data-hero-wrap data-tone="dark" class="relative z-10 h-[190svh]">
  <section data-hero class="sticky top-0 h-lvh min-h-[600px] overflow-hidden text-white">
    <div data-hero-bg class="absolute inset-0 bg-black md:bg-[#1f4cb8] will-change-[opacity,transform]">
      <canvas id="hero-canvas" class="absolute inset-0 hidden size-full md:block" aria-hidden="true"></canvas>
      <div class="pointer-events-none absolute inset-0 hidden bg-black/20 md:block"></div>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-[12%] bg-gradient-to-b from-black/90 to-transparent"></div>
      <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(to bottom,transparent 60%,rgba(2,8,36,.5))"></div>
    </div>

    <div data-hero-text class="absolute inset-0 will-change-[opacity,transform]">
      <!-- escritorio: seda con la marca al centro -->
      <div class="absolute inset-0 hidden flex-col items-center justify-center px-6 text-center md:flex">
      <h1 class="overflow-hidden pb-[0.12em] text-[clamp(3.2rem,7.4vw,7rem)] leading-[0.95] tracking-[-0.035em]" aria-label="HumanCorp">
        <span class="hf-up block" style="--d:.25s"><span class="font-light">HUMAN</span> <span class="font-semibold">CORP</span></span>
      </h1>
      <p class="hf-rise mt-6 max-w-[32rem] text-[clamp(1.05rem,1.35vw,1.4rem)] font-medium leading-[1.5] tracking-tight text-white/90 text-balance" style="--d:.45s">
        Todo lo que hace funcionar a una empresa, conectado bajo un solo <em class="hf-em">estándar</em>.
      </p>
      <div class="hf-rise mt-9 flex justify-center gap-3" style="--d:.62s">
        <a href="/servicios" class="rounded-full bg-white px-7 py-3.5 text-[15px] font-medium text-[#0b0c0f] transition-transform hover:scale-[1.03]">Conocer servicios</a>
        <a href="/arma-tu-proyecto" class="rounded-full border border-white/45 px-7 py-3.5 text-[15px] transition-colors hover:bg-white/10">Arma tu proyecto</a>
      </div>
      <div class="hf-rise absolute inset-x-0 bottom-[3.5%] z-10" style="--d:1s" aria-hidden="true">
        <div class="hf-tick"><div class="hf-track">{[0, 1].map(() => names.map((n) => <span>{n}</span>))}</div></div>
      </div>
      </div>
      <!-- celular: fondo negro con mosaicos en espiral -->
      <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center md:hidden">
      <div class="hh-field pointer-events-none absolute left-1/2 top-1/2" aria-hidden="true">
        {tiles.map((t) => (
          <u class="hh-t" data-arm={t.arm} data-idx={t.idx} data-off={t.off}><b class="hh-s" style={`background-image:url(/hero/t${t.img}.webp)`}></b><b class="hh-b" style={`background-image:url(/hero/t${t.img}-b.webp)`}></b></u>
        ))}
      </div>
      <p class="relative z-10 mb-5 overflow-hidden pb-[0.1em] text-[clamp(2rem,10vw,3rem)] leading-none tracking-[-0.02em]" aria-label="HumanCorp"><span class="hf-up block" style="--d:.1s"><span class="font-light">HUMAN</span> <span class="font-semibold">CORP</span></span></p>
      <h1 class="relative z-10 text-[clamp(2.4rem,11vw,4.6rem)] font-semibold leading-[0.98] tracking-[-0.05em]">
        <span class="sr-only">HumanCorp: </span>
        <span class="block overflow-hidden pb-[0.1em]"><span class="hf-up block" style="--d:.2s">Todo conectado.</span></span>
        <span class="block overflow-hidden pb-[0.1em] text-white/55"><span class="hf-up block" style="--d:.34s">Bajo un solo</span></span>
        <span class="block overflow-hidden pb-[0.1em] text-white/55"><span class="hf-up block" style="--d:.46s">estándar.</span></span>
      </h1>
      <p class="hf-rise relative z-10 mt-6 max-w-[22rem] text-[clamp(1rem,1.25vw,1.25rem)] leading-[1.5] text-white/90 text-balance" style="--d:.45s">Todo lo que hace funcionar a una empresa, bajo un mismo estándar.</p>
      <div class="hf-rise relative z-10 mt-8 flex flex-wrap justify-center gap-3" style="--d:.62s">
        <a href="/servicios" class="rounded-full bg-white px-8 py-3.5 text-[15px] font-medium text-[#0b0c0f] shadow-[0_18px_40px_-14px_rgba(10,8,60,.7)] transition-transform hover:scale-[1.03]">Conocer servicios</a>
        <a href="/arma-tu-proyecto" class="rounded-full border border-white/45 bg-white/10 px-8 py-3.5 text-[15px] transition-colors hover:bg-white/20">Arma tu proyecto</a>
      </div>
      <div class="hf-rise absolute inset-x-0 bottom-[3.5%] z-10" style="--d:1s" aria-hidden="true">
        <div class="hf-tick"><div class="hf-track">{[0, 1].map(() => names.map((n) => <span>{n}</span>))}</div></div>
      </div>
      </div>
    </div>
  </section>
</div>

<script>
  import { onFrame, put, clamp, smooth } from '../scripts/frame';
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const stage = document.querySelector<HTMLElement>('[data-hero]')!;
  const bg = document.querySelector<HTMLElement>('[data-hero-bg]')!;
  const text = document.querySelector<HTMLElement>('[data-hero-text]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const field = document.querySelector<HTMLElement>('.hh-field')!;
  const tl = [...field.querySelectorAll<HTMLElement>('.hh-t')].map((el, k, all) => ({ el, sh: el.firstElementChild as HTMLElement, bl: el.lastElementChild as HTMLElement, a0: (+el.dataset.arm! * 2 * Math.PI) / 3, off: +el.dataset.off!, ph: +el.dataset.idx! / (all.length / 3) }));
  let W = 160, R1 = 600, vw0 = 0;
  const fit = () => { const w = stage.clientWidth, h = stage.clientHeight; vw0 = w; W = Math.max(90, Math.min(190, Math.min(w, h) * 0.22)); R1 = Math.hypot(w, h) * 0.62; tl.forEach((t) => { t.el.style.width = t.el.style.height = `${W}px`; t.el.style.margin = `${-W / 2}px 0 0 ${-W / 2}px`; }); };
  fit(); addEventListener('resize', fit);
  const T = 44, TURNS = 1.15;
  const paintTiles = (sec: number) => {
    tl.forEach((t) => {
      const p = reduced ? (0.25 + t.ph * 0.7) : ((sec / T + t.ph) % 1);
      const th = t.a0 - 2 * Math.PI * TURNS * p;                // antihorario
      const r = R1 * (0.09 + 0.91 * p);
      const e = smooth(p);
      const sc = 0.2 + 0.95 * e;
      const sharp = smooth(clamp((p - 0.1) / 0.42));
      const life = clamp(p / 0.08) * (1 - clamp((p - 0.94) / 0.06));
      put(t.el, 'transform', `translate3d(${(Math.cos(th) * r).toFixed(1)}px,${(Math.sin(th) * r).toFixed(1)}px,0) rotate(${((th * 180) / Math.PI - 90 + t.off).toFixed(1)}deg) scale(${sc.toFixed(3)})`);
      put(t.el, 'opacity', (life * (0.35 + 0.65 * sharp)).toFixed(3));
      put(t.sh, 'opacity', sharp.toFixed(3));
      put(t.bl, 'opacity', (1 - sharp).toFixed(3));
    });
  };
  paintTiles(0);
  const mobile = !matchMedia('(min-width: 768px)').matches;
  const ptr = { x: 0, y: 0, tx: 0, ty: 0 };
  addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') { ptr.tx = e.clientX / innerWidth - 0.5; ptr.ty = 0.5 - e.clientY / innerHeight; } }, { passive: true });
  const VS = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
  const FS = `#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
uniform vec2 res;
uniform float t;
uniform vec2 m;

float hash(vec2 p){ return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }

void main(){
  vec2 uv = gl_FragCoord.xy / res.y;
  vec2 p = uv * 1.7 + m * .3;
  float a = t * .3;
  for (int i = 1; i < 5; i++) {
    float k = float(i);
    p += .42 / (k * k) * vec2(sin(k * 1.7 * p.y + a + k), sin(k * 1.5 * p.x - a * .8 + k * 1.7)) * 2.1;
  }
  float f = .5 + .5 * sin(p.x * 2.4 + p.y * 1.3 + a * .4);

  vec3 purple = vec3(.43, .35, .66);
  vec3 deep   = vec3(.10, .28, .70);
  vec3 light  = vec3(.23, .39, .79);
  vec3 blue = mix(light, deep, smoothstep(.5, .85, f));
  vec3 col = mix(purple, blue, smoothstep(.26, .56, f));
  col += vec3(.04, .06, .13) * exp(-pow((f - .46) * 9., 2.));
  col += (hash(gl_FragCoord.xy + t) - .5) / 128.;
  gl_FragColor = vec4(col, 1.);
}`;

  // The silk is a slow, soft gradient: render it small (about 0.7 MP) and at ~40 fps; the scroll motion stays at full refresh rate.
  let draw: ((t: number) => void) | null = null;
  const gl = mobile ? null : canvas.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'high-performance' });
  if (gl) {
    const sh = (type: number, src: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s); return s; };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, VS));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FS));
    gl.linkProgram(prog);
    if (gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      gl.useProgram(prog);
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      const uRes = gl.getUniformLocation(prog, 'res');
      const uT = gl.getUniformLocation(prog, 't');
      const uM = gl.getUniformLocation(prog, 'm');
      draw = (t: number) => { ptr.x += (ptr.tx - ptr.x) * 0.06; ptr.y += (ptr.ty - ptr.y) * 0.06; gl.uniform2f(uM, ptr.x, ptr.y); gl.uniform1f(uT, t); gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4); };
      const fit = () => {
        const w = canvas.clientWidth, h = canvas.clientHeight;
        const k = Math.min(1, Math.sqrt(0.7e6 / Math.max(1, w * h)));
        canvas.width = Math.max(1, Math.round(w * k));
        canvas.height = Math.max(1, Math.round(h * k));
        gl.viewport(0, 0, canvas.width, canvas.height);
        gl.uniform2f(uRes, canvas.width, canvas.height);
        draw!(4);
      };
      fit();
      addEventListener('resize', fit);
    }
  }

  let last = -1e9;
  onFrame((t, y, vh) => {
    const p = clamp(y / (vh * 0.85));
    const gone = p >= 1;
    put(stage, 'visibility', gone ? 'hidden' : 'visible');
    if (gone) return;
    // scroll-driven dissolve into the horizon (opacity / transform only: compositor work)
    put(bg, 'opacity', (1 - smooth(clamp((p - 0.12) / 0.78))).toFixed(3));
    put(bg, 'transform', `scale(${(1 + p * 0.06).toFixed(4)})`);
    put(text, 'opacity', (1 - smooth(clamp(p / 0.55))).toFixed(3));
    put(text, 'transform', `translate3d(0, ${(-p * vh * 0.12).toFixed(1)}px, 0) scale(${(1 + p * 0.05).toFixed(4)})`);
    if (mobile) { if (!reduced) paintTiles(t / 1000); } else if (draw && !reduced && t - last > 24) { last = t; draw(t / 1000); }
  });
</script>
