---
// Mosaicos que giran en espiral alrededor del texto: radio (fracción), ángulo inicial, giro propio y tamaño.
const tiles = Array.from({ length: 10 }, (_, i) => {
  const a = (i / 10) * Math.PI * 2 - Math.PI / 2;
  const r = 0.95 + (i % 5) * 0.08 + i * 0.01;
  return { i: i + 1, x: Math.cos(a) * r, y: Math.sin(a) * r, tilt: [-14, 9, -6, 16, -10, 7, -18, 12, -4, 14][i], s: [1, 0.86, 1.08, 0.8, 0.96, 0.9, 1.04, 0.82, 1, 0.88][i], d: 0.15 + i * 0.07 };
});
---

<div data-hero-wrap class="relative z-10 h-[190svh]">
  <section data-hero class="sticky top-0 h-svh min-h-[600px] overflow-hidden text-white">
    <div data-hero-bg class="absolute inset-0 bg-[#1f4cb8] will-change-[opacity,transform]">
      <canvas id="hero-canvas" class="absolute inset-0 size-full" aria-hidden="true"></canvas>
      <div class="pointer-events-none absolute inset-0 bg-black/20"></div>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-[12%] bg-gradient-to-b from-black/90 to-transparent"></div>
      <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(to bottom,transparent 60%,rgba(2,8,36,.5))"></div>
    </div>
    <!-- first light: a warm glow rises from the bottom while the silk dissolves into the horizon -->
    <div data-hero-glow class="pointer-events-none absolute inset-x-0 bottom-0 h-[80%] origin-bottom opacity-0 will-change-[opacity,transform]" style="background:linear-gradient(to top,rgba(246,196,138,.95),rgba(216,142,118,.55) 38%,rgba(126,104,172,.2) 70%,transparent)"></div>

    <div data-hero-text class="absolute inset-0 flex flex-col items-start justify-end px-6 pb-[17svh] text-left will-change-[opacity,transform] md:items-center md:justify-center md:pb-0 md:text-center">
      <div class="hh-ring pointer-events-none absolute left-1/2" aria-hidden="true">
        <div class="hh-spin">
          {tiles.map((t) => (
            <i class="hh-tile" style={`--x:${t.x.toFixed(3)};--y:${t.y.toFixed(3)};--tilt:${t.tilt}deg;--s:${t.s};--d:${t.d}s`}><b style={`background-image:url(/hero/t${t.i}.webp)`}></b></i>
          ))}
        </div>
      </div>
      <h1 class="hf-rise relative z-10 max-md:sr-only md:text-[clamp(2.9rem,6.4vw,6.2rem)] md:leading-[0.95] md:tracking-[-0.03em]" style="--d:.25s" aria-label="HumanCorp">
        <span class="font-light">HUMAN</span> <span class="font-semibold">CORP</span>
      </h1>
      <p class="hf-rise relative z-10 w-full max-w-[19rem] text-[0.95rem] font-medium leading-[1.4] text-white/85 md:hidden" style="--d:.3s">Todo lo que hace funcionar a una empresa,</p>
      <p class="hf-rise relative z-10 mt-2 text-[clamp(2.7rem,14vw,4rem)] font-semibold leading-[0.95] tracking-[-0.045em] md:hidden" style="--d:.42s" aria-hidden="true">Conectado.<span class="block text-white/55">Bajo un solo estándar.</span></p>
      <p class="hf-rise relative z-10 mt-7 hidden max-w-[19rem] text-[clamp(1.05rem,1.35vw,1.4rem)] font-medium leading-[1.5] tracking-tight text-white/90 text-balance md:mt-6 md:block md:max-w-[32rem]" style="--d:.45s">
        Todo lo que hace funcionar a una empresa, conectado bajo un solo <em class="hf-em">estándar</em>.
      </p>
      <div class="hf-rise relative z-10 mt-5 flex gap-3 max-md:absolute max-md:inset-x-0 max-md:bottom-[4.5%] max-md:mt-0 max-md:justify-center md:mt-9 md:justify-center" style="--d:.62s">
        <a href="/servicios" class="rounded-full bg-white px-8 py-3.5 text-center text-[15px] font-medium max-md:shadow-[0_18px_40px_-14px_rgba(10,8,60,.7)] text-[#0b0c0f] transition-transform hover:scale-[1.03]">Conocer servicios</a>
        <a href="/arma-tu-proyecto" class="hidden rounded-full border border-white/45 bg-white/10 px-7 py-3.5 text-center text-[15px] md:inline-block transition-colors hover:bg-white/10">Arma tu proyecto</a>
      </div>
      <div class="hf-rise absolute inset-x-0 bottom-[4%] hidden flex-col items-center gap-2 md:flex text-[11px] uppercase tracking-[0.2em] text-white/70" style="--d:1s" aria-hidden="true">
        <span>Desliza</span>
        <i class="block h-9 w-px origin-top bg-white/70" style="animation:scrollLine 2s ease-in-out 1.4s 3 both"></i>
      </div>
    </div>
  </section>
</div>

<script>
  import { onFrame, put, clamp, smooth } from '../scripts/frame';
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const stage = document.querySelector<HTMLElement>('[data-hero]')!;
  const bg = document.querySelector<HTMLElement>('[data-hero-bg]')!;
  const glow = document.querySelector<HTMLElement>('[data-hero-glow]')!;
  const text = document.querySelector<HTMLElement>('[data-hero-text]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const VS = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
  const FS = `#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
uniform vec2 res;
uniform float t;

float hash(vec2 p){ return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }

void main(){
  vec2 uv = gl_FragCoord.xy / res.y;
  vec2 p = uv * 1.7;
  float a = t * .3;
  for (int i = 1; i < 5; i++) {
    float k = float(i);
    p += .42 / (k * k) * vec2(sin(k * 1.7 * p.y + a + k), sin(k * 1.5 * p.x - a * .8 + k * 1.7)) * 2.1;
  }
  float f = .5 + .5 * sin(p.x * 2.4 + p.y * 1.3 + a * .4);

  vec3 purple = vec3(.43, .35, .66);
  vec3 deep   = vec3(.10, .28, .70);
  vec3 light  = vec3(.23, .39, .79);
  vec3 blue = mix(light, deep, smoothstep(.5, .85, f));
  vec3 col = mix(purple, blue, smoothstep(.26, .56, f));
  col += vec3(.04, .06, .13) * exp(-pow((f - .46) * 9., 2.));
  col += (hash(gl_FragCoord.xy + t) - .5) / 128.;
  gl_FragColor = vec4(col, 1.);
}`;

  // The silk is a slow, soft gradient: render it small (about 0.7 MP) and at ~40 fps; the scroll motion stays at full refresh rate.
  let draw: ((t: number) => void) | null = null;
  const gl = canvas.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'high-performance' });
  if (gl) {
    const sh = (type: number, src: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s); return s; };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, VS));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FS));
    gl.linkProgram(prog);
    if (gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      gl.useProgram(prog);
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      const uRes = gl.getUniformLocation(prog, 'res');
      const uT = gl.getUniformLocation(prog, 't');
      draw = (t: number) => { gl.uniform1f(uT, t); gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4); };
      const fit = () => {
        const w = canvas.clientWidth, h = canvas.clientHeight;
        const k = Math.min(1, Math.sqrt(0.7e6 / Math.max(1, w * h)));
        canvas.width = Math.max(1, Math.round(w * k));
        canvas.height = Math.max(1, Math.round(h * k));
        gl.viewport(0, 0, canvas.width, canvas.height);
        gl.uniform2f(uRes, canvas.width, canvas.height);
        draw!(4);
      };
      fit();
      addEventListener('resize', fit);
    }
  }

  let last = -1e9;
  onFrame((t, y, vh) => {
    const p = clamp(y / (vh * 0.85));
    const gone = p >= 1;
    put(stage, 'visibility', gone ? 'hidden' : 'visible');
    if (gone) return;
    // scroll-driven dissolve into the horizon (opacity / transform only: compositor work)
    put(bg, 'opacity', (1 - smooth(clamp((p - 0.12) / 0.78))).toFixed(3));
    put(bg, 'transform', `scale(${(1 + p * 0.06).toFixed(4)})`);
    put(glow, 'opacity', (smooth(clamp(p / 0.45)) * (1 - smooth(clamp((p - 0.55) / 0.45)))).toFixed(3));
    put(glow, 'transform', `scaleY(${(0.5 + p * 0.9).toFixed(3)})`);
    put(text, 'opacity', (1 - smooth(clamp(p / 0.55))).toFixed(3));
    put(text, 'transform', `translate3d(0, ${(-p * vh * 0.12).toFixed(1)}px, 0) scale(${(1 + p * 0.05).toFixed(4)})`);
    if (draw && !reduced && t - last > 24) { last = t; draw(t / 1000); }
  });
</script>
