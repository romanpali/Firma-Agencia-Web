---
import { divisions } from '../data/servicios';
const names = divisions.map((d) => d.short);
// Celular: emisor en espiral. Cada mosaico nace pequeño y borroso en el centro y sale girando (antihorario) hasta los bordes, ganando tamaño y nitidez.
const N = 24, ARMS = 3;
// Tres brazos de una misma espiral: cada mosaico pertenece a un brazo y recorre la curva de adentro hacia afuera.
const tiles = Array.from({ length: N }, (_, k) => ({ k, arm: k % ARMS, idx: Math.floor(k / ARMS), img: k + 1, off: [-10, 6, -4, 12, -8, 5, -12, 9, -2, 10][k % 10] }));
---

<div data-hero-wrap data-tone="dark" class="relative z-10 h-[190svh] max-md:h-[200svh]">
  <section data-hero class="sticky top-0 h-lvh min-h-[600px] overflow-hidden text-white">
    <div data-hero-bg class="absolute inset-0 bg-[#05070f] md:bg-[#08090c] will-change-[opacity,transform]">
      <canvas id="hero-canvas" class="hidden" aria-hidden="true"></canvas>
      <!-- escritorio: fotografía a sangre dentro de un marco con esquinas redondeadas -->
      <div class="hd-fr hidden md:block" aria-hidden="true">
        <img class="hd-bg" src="/hero/desierto.webp" alt="" width="1143" height="2000" decoding="async" fetchpriority="high" />
        <i class="hd-sh"></i><i class="hd-gr grain"></i>
        {[12, 24, 33, 47, 58, 69, 78, 90, 40, 64].map((x, k) => <i class="hd-pt" style={`left:${x}%;--d:${-k * 2.3}s;--s:${11 + (k % 4) * 3}s;--t:${58 + (k * 7) % 34}%`}></i>)}
      </div>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-[12%] bg-gradient-to-b from-black/90 to-transparent md:hidden"></div>
      <div class="pointer-events-none absolute inset-0 md:hidden" style="background:linear-gradient(to bottom,transparent 60%,rgba(2,8,36,.5))"></div>
    </div>

    <div data-hero-text class="absolute inset-0 will-change-[opacity,transform]">
      <!-- escritorio: palabra gigante abajo a la izquierda, texto y botón a la derecha -->
      <div class="hd hidden md:block">
        <h1 class="hd-wm" aria-label="HumanCorp">
          <span class="block overflow-hidden"><span class="hf-up block" style="--d:.25s"><span class="hd-l">Human</span><span class="hd-b">Corp</span><sup>*</sup></span></span>
        </h1>
        <div class="hd-rt">
          <p class="hf-rise" style="--d:.55s">Todo lo que hace funcionar a una empresa, conectado bajo un solo estándar. Diseño, tecnología y operaciones empresariales para que tu empresa funcione con claridad.</p>
          <div class="hf-rise hd-cta" style="--d:.7s"><a class="hd-p" href="/servicios">Conocer servicios<i><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"/></svg></i></a><a class="hd-s" href="/arma-tu-proyecto">Arma tu proyecto</a></div>
        </div>
      </div>
      <!-- celular: la seda de escritorio de fondo; etiqueta arriba, titular abajo a la izquierda, texto y botón -->
      <div class="hm md:hidden">
      <div class="hm-art" aria-hidden="true">
        {[0, 1, 2, 3].map((k) => <i class={`hm-gl g${k}`} style={`--k:${k}`}></i>)}
        <svg class="hm-rg" viewBox="0 0 400 400"><circle cx="200" cy="200" r="196" /><circle cx="200" cy="200" r="150" class="d" /><circle cx="338" cy="110" r="3.2" class="dot" /><circle cx="62" cy="290" r="2.4" class="dot" /></svg>
        {[8, 22, 35, 48, 61, 74, 86, 15, 55].map((x, k) => <i class="hm-pt" style={`left:${x}%;--d:${-k * 1.7}s;--s:${9 + (k % 4) * 2}s`}></i>)}
        <div class="hm-st">
          <div class="hm-sp sl" style="--x:-54vw;--a:52deg;--ac:#e8a24a;--d:0s">
            <div class="sp-h"><span>Contabilidad</span><em>Mar</em></div>
            <b>$ 411 mil</b><small>Gastos del mes</small>
            <div class="sp-b">{[50, 70, 42, 84, 60, 92].map((h, j) => <i style={`height:${h}%;--j:${j}`}></i>)}</div>
            <p><span>Facturas</span><b>126</b></p><p><span>Conciliadas</span><b>94 %</b></p>
          </div>
          <div class="hm-sp sr" style="--x:54vw;--a:-52deg;--ac:#1fbf93;--d:-4.5s">
            <div class="sp-h"><span>Marketing</span><em>Mar</em></div>
            <b>4.2 %</b><small>CTR · 3 campañas</small>
            <svg viewBox="0 0 100 40" preserveAspectRatio="none"><path d="M0 32 C16 30 22 20 36 22 S60 10 72 12 S90 5 100 2" fill="none" stroke="#1fbf93" stroke-width="1.8" vector-effect="non-scaling-stroke"/><path d="M0 36 C20 34 30 30 48 31 S80 24 100 20" fill="none" stroke="#c9d3df" stroke-width="1.4" vector-effect="non-scaling-stroke"/></svg>
            <p><span>Alcance</span><b>84 K</b></p><p><span>Leads</span><b>38</b></p>
          </div>
          <div class="hm-sp hm-cd" style="--x:0px;--a:0deg">
            <div class="cd-h"><b>Panel HumanCorp</b><em>Hoy</em></div>
            <div class="cd-t">{['Ventas', 'Contabilidad', 'Marketing', 'IA'].map((t, k) => <span style={`--k:${k}`}><i></i><em class="t">{t}</em></span>)}</div>
            <div class="cd-m cd-c" style="--k:0;--ac:#3a6bff"><small>Ingresos</small><b>$ 1.28 M</b><u>▲ 8.1 %</u>
              <svg viewBox="0 0 100 36" preserveAspectRatio="none"><defs><linearGradient id="hmA" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a6bff" stop-opacity=".28"/><stop offset="1" stop-color="#3a6bff" stop-opacity="0"/></linearGradient></defs><path d="M0 30 C14 28 20 20 32 22 S54 10 66 9 S88 4 100 1 V36 H0Z" fill="url(#hmA)"/><path d="M0 30 C14 28 20 20 32 22 S54 10 66 9 S88 4 100 1" fill="none" stroke="#3a6bff" stroke-width="1.6" vector-effect="non-scaling-stroke"/></svg>
            </div>
            <div class="cd-g">
              <div class="cd-c" style="--k:1;--ac:#e8a24a"><small>Contabilidad</small><b>94 %</b><span>facturas conciliadas</span><i class="cd-p"><s></s></i></div>
              <div class="cd-c" style="--k:2;--ac:#1fbf93"><small>Marketing</small><b>4.2 %</b><span>CTR · 3 campañas</span><div class="cd-b">{[40, 62, 48, 80, 66].map((h, j) => <i style={`height:${h}%;--j:${j}`}></i>)}</div></div>
              <div class="cd-c" style="--k:3;--ac:#f0617d"><small>IA</small><b>1,284</b><span>tareas automatizadas</span><div class="cd-y"><i></i><i></i><i></i></div></div>
            </div>
          </div>
        </div>
      </div>
      <i class="hm-sh" aria-hidden="true"></i>
      <div class="hm-mid">
        <p class="hm-k hf-rise" style="--d:.2s">Un estándar para toda tu empresa</p>
        <h1 class="hm-h"><span class="sr-only">HumanCorp: </span>
          <span class="block overflow-hidden pb-[0.1em]"><span class="hf-up block" style="--d:.3s">Todo conectado.</span></span>
          <span class="block overflow-hidden pb-[0.1em]"><span class="hf-up block" style="--d:.44s">Bajo un solo estándar.</span></span>
        </h1>
        <p class="hm-p hf-rise" style="--d:.65s">Diseño, tecnología y operaciones empresariales, organizadas para que tu empresa funcione con claridad.</p>
        <div class="hm-cta hf-rise" style="--d:.8s"><a class="p" href="/servicios">Conocer servicios</a><a class="s" href="/arma-tu-proyecto">Arma tu proyecto</a></div>
      </div>
      </div>
    </div>
  </section>
</div>


<style is:global>
  @media (max-width: 767px) {
    .hm-art { position: absolute; inset: 0; overflow: hidden; pointer-events: none; --cw: 72vw; }
    /* luz de color que cambia despacio con el módulo activo (solo opacidad) */
    .hm-gl { position: absolute; left: 50%; top: 30%; width: 140vw; height: 140vw; margin: -70vw 0 0 -70vw; border-radius: 50%; opacity: 0; animation: hmGl 14.4s ease-in-out infinite both; animation-delay: calc(var(--k) * 3.6s); }
    .hm-gl.g0 { background: radial-gradient(circle, rgba(58, 107, 255, 0.45), transparent 60%); } .hm-gl.g1 { background: radial-gradient(circle, rgba(232, 162, 74, 0.4), transparent 60%); }
    .hm-gl.g2 { background: radial-gradient(circle, rgba(31, 191, 147, 0.36), transparent 60%); } .hm-gl.g3 { background: radial-gradient(circle, rgba(240, 97, 125, 0.38), transparent 60%); }
    @keyframes hmGl { 0% { opacity: 0; } 5% { opacity: 1; } 22% { opacity: 1; } 29% { opacity: 0; } 100% { opacity: 0; } }
    .hm-rg { position: absolute; left: 50%; top: 30%; width: 132vw; height: 132vw; margin: -66vw 0 0 -66vw; animation: hmRot 90s linear infinite; }
    .hm-rg circle { fill: none; stroke: rgba(255, 255, 255, 0.12); stroke-width: 0.7; } .hm-rg .d { stroke-dasharray: 2 7; stroke: rgba(255, 255, 255, 0.2); } .hm-rg .dot { fill: #fff; stroke: none; opacity: 0.8; }
    @keyframes hmRot { to { transform: rotate(360deg); } }
    .hm-pt { position: absolute; bottom: 8%; width: 2px; height: 2px; border-radius: 50%; background: #fff; opacity: 0; animation: hmPt var(--s) linear infinite; animation-delay: var(--d); }
    @keyframes hmPt { 0% { transform: translate3d(0, 0, 0); opacity: 0; } 15% { opacity: 0.7; } 85% { opacity: 0.5; } 100% { transform: translate3d(0, -70svh, 0); opacity: 0; } }
    /* pantallas en arco: la central de frente y dos laterales de canto que se mecen */
    .hm-st { position: absolute; left: 0; right: 0; top: 12%; height: calc(var(--cw) * 1.3); perspective: 850px; perspective-origin: 50% 42%; }
    .hm-sp { position: absolute; left: 50%; top: 0; width: var(--cw); height: calc(var(--cw) * 1.1); margin-left: calc(var(--cw) / -2); border-radius: calc(var(--cw) * 0.07); background: linear-gradient(165deg, #ffffff, #eef0f6); color: #11141c; padding: 6%; font-size: calc(var(--cw) * 0.038); box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.5), 0 40px 70px -24px rgba(0, 0, 0, 0.95); overflow: hidden; }
    .hm-sp.sl, .hm-sp.sr { width: calc(var(--cw) * 0.72); height: calc(var(--cw) * 0.95); margin-left: calc(var(--cw) * -0.36); top: 12%; transform: translate3d(var(--x), 0, -120px) rotateY(var(--a)); animation: hmSw 9s ease-in-out infinite alternate; animation-delay: var(--d); }
    .hm-sp.sl::after, .hm-sp.sr::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0, 0, 0, 0.5), transparent 45%, rgba(0, 0, 0, 0.5)); }
    @keyframes hmSw { to { transform: translate3d(calc(var(--x) * 0.9), -8px, -90px) rotateY(calc(var(--a) * 0.82)); } }
    .hm-cd { z-index: 2; animation: hmIn 1.3s cubic-bezier(0.2, 0.8, 0.2, 1) 0.35s both, hmFl 7s ease-in-out 1.7s infinite alternate; }
    @keyframes hmIn { from { opacity: 0; transform: translate3d(0, 46px, 0) scale(0.94); } to { opacity: 1; transform: none; } }
    @keyframes hmFl { from { transform: none; } to { transform: translate3d(0, -8px, 0); } }
    /* contenido de los paneles */
    .sp-h, .cd-h { display: flex; justify-content: space-between; align-items: center; font-size: 0.9em; font-weight: 500; color: #5b6275; } .sp-h em, .cd-h em { font-style: normal; font-size: 0.85em; padding: 0.2em 0.7em; border-radius: 99px; background: #e8ebf3; }
    .hm-sp.sl > b, .hm-sp.sr > b { display: block; margin-top: 0.9em; font-size: 2em; font-weight: 500; letter-spacing: -0.04em; line-height: 1; } .hm-sp.sl > small, .hm-sp.sr > small { display: block; margin-top: 0.4em; font-size: 0.85em; color: var(--ac); font-weight: 500; }
    .sp-b { display: flex; align-items: flex-end; gap: 0.5em; height: 28%; margin-top: 1em; } .sp-b i { flex: 1; border-radius: 0.35em 0.35em 0.1em 0.1em; background: linear-gradient(180deg, var(--ac), rgba(232, 162, 74, 0.2)); }
    .hm-sp.sr svg { display: block; width: 100%; height: 26%; margin-top: 1em; overflow: visible; }
    .hm-sp.sl p, .hm-sp.sr p { display: flex; justify-content: space-between; margin-top: 0.8em; font-size: 0.85em; color: #5b6275; } .hm-sp.sl p b, .hm-sp.sr p b { color: #11141c; font-weight: 500; }
    .hm-sp.sl p:first-of-type, .hm-sp.sr p:first-of-type { padding-top: 0.7em; border-top: 1px solid #e4e7ef; margin-top: 1em; }
    .cd-t { display: flex; gap: 0.4em; margin-top: 0.8em; } .cd-t span { position: relative; flex: 1; text-align: center; font-size: 0.78em; font-weight: 500; padding: 0.55em 0; color: #5b6275; } .cd-t span i { position: absolute; inset: 0; border-radius: 99px; background: #dfe5ff; opacity: 0; animation: hmTab 14.4s ease-in-out infinite both; animation-delay: calc(var(--k) * 3.6s); z-index: 0; } .cd-t span { z-index: 0; }
    .cd-t em.t { position: relative; font-style: normal; }
    @keyframes hmTab { 0% { opacity: 0; } 4% { opacity: 1; } 22% { opacity: 1; } 28% { opacity: 0; } 100% { opacity: 0; } }
    .cd-c { position: relative; border-radius: 1.1em; background: #fff; box-shadow: 0 0 0 1px #e4e7ef, 0 10px 18px -14px rgba(20, 30, 60, 0.4); padding: 0.9em; display: flex; flex-direction: column; }
    .cd-c::after { content: ""; position: absolute; inset: 0; border-radius: inherit; box-shadow: 0 0 0 2px var(--ac); opacity: 0; animation: hmTab 14.4s ease-in-out infinite both; animation-delay: calc(var(--k) * 3.6s); }
    .cd-c small { font-size: 0.82em; color: #5b6275; font-weight: 500; } .cd-c b { font-size: 1.7em; font-weight: 500; letter-spacing: -0.04em; line-height: 1.1; margin-top: 0.2em; font-variant-numeric: tabular-nums; } .cd-c span, .cd-c u { font-size: 0.78em; color: #7a8194; text-decoration: none; } .cd-c u { color: #1fa56a; font-weight: 600; }
    .cd-m { margin-top: 0.7em; height: 31%; } .cd-m svg { position: absolute; left: 0.9em; right: 0.9em; bottom: 0.7em; width: calc(100% - 1.8em); height: 40%; overflow: visible; }
    .cd-m b { font-size: 2em; }
    .cd-g { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5em; margin-top: 0.6em; height: calc(37% - 0.3em); } .cd-g .cd-c { padding: 0.7em; } .cd-g .cd-c b { font-size: 1.35em; } .cd-g .cd-c span { line-height: 1.15; }
    .cd-p { display: block; height: 0.4em; border-radius: 99px; background: #e8ebf3; margin-top: auto; overflow: hidden; } .cd-p s { display: block; height: 100%; width: 94%; background: var(--ac); border-radius: 99px; }
    .cd-b { display: flex; align-items: flex-end; gap: 0.25em; height: 1.8em; margin-top: auto; } .cd-b i { flex: 1; border-radius: 0.2em; background: var(--ac); transform-origin: 50% 100%; animation: cdBr 3s ease-in-out infinite alternate; animation-delay: calc(var(--j) * -0.5s); } @keyframes cdBr { from { transform: scaleY(0.6); } to { transform: scaleY(1); } }
    .cd-y { display: flex; gap: 0.3em; margin-top: auto; } .cd-y i { width: 0.5em; height: 0.5em; border-radius: 50%; background: var(--ac); animation: hmTy 1.2s ease-in-out infinite; opacity: 0.35; } .cd-y i:nth-child(2) { animation-delay: 0.15s; } .cd-y i:nth-child(3) { animation-delay: 0.3s; } @keyframes hmTy { 50% { opacity: 1; } }
    .hm-sh { background: linear-gradient(180deg, rgba(3, 5, 14, 0.35), transparent 18%, transparent 52%, rgba(3, 5, 14, 0.85) 70%, rgba(3, 5, 14, 0.96)) !important; }
    @media (prefers-reduced-motion: reduce) { .hm-art * { animation: none !important; } .hm-gl.g0 { opacity: 1; } .hm-cd { opacity: 1; } }
  }
</style>

<style is:global>
  @media (min-width: 768px) {
    .hd-fr { position: absolute; inset: 12px; border-radius: 24px; overflow: hidden; background: #0b0a08; }
    .hd-bg { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 50% 74%; animation: hdK 34s ease-in-out infinite alternate; }
    @keyframes hdK { from { transform: scale(1.04); } to { transform: scale(1.14) translate3d(-1.2%, -1.2%, 0); } }
    .hd-sh { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8, 7, 6, 0.72), rgba(8, 7, 6, 0) 24%), linear-gradient(0deg, rgba(8, 7, 6, 0.86), rgba(8, 7, 6, 0) 52%), radial-gradient(120% 90% at 50% 50%, transparent 55%, rgba(0, 0, 0, 0.4)); }
    .hd-gr { position: absolute; inset: 0; opacity: 0.16; }
    .hd-pt { position: absolute; top: var(--t); width: 3px; height: 3px; border-radius: 50%; background: #ffd9a0; opacity: 0; animation: hdPt var(--s) linear infinite; animation-delay: var(--d); }
    @keyframes hdPt { 0% { transform: translate3d(0, 0, 0); opacity: 0; } 15% { opacity: 0.75; } 85% { opacity: 0.5; } 100% { transform: translate3d(7vw, -16vh, 0); opacity: 0; } }
    .hd { position: absolute; inset: 0; pointer-events: none; }
    .hd-wm { position: absolute; left: 3.6vw; bottom: 5.5vh; font-size: min(13.4vw, 26vh * 1.9); line-height: 0.88; letter-spacing: -0.06em; color: #efe8d8; white-space: nowrap; }
    .hd-wm .hf-up { padding-bottom: 0.06em; } .hd-l { font-weight: 300; } .hd-b { font-weight: 600; }
    .hd-wm sup { position: relative; top: 0.02em; vertical-align: top; margin-left: 0.04em; font-size: 0.34em; font-weight: 400; letter-spacing: 0; }
    .hd-rt { position: absolute; right: 4.2vw; bottom: 7vh; width: min(23vw, 350px); pointer-events: auto; }
    .hd-rt p { font-size: clamp(12px, 0.95vw, 14.5px); line-height: 1.45; color: rgba(239, 232, 216, 0.82); }
    .hd-cta { display: flex; align-items: center; gap: 18px; margin-top: 22px; }
    .hd-p { display: inline-flex; align-items: center; gap: 12px; height: 46px; padding: 0 6px 0 20px; border-radius: 99px; background: #efe8d8; color: #14110d; font-size: 14.5px; font-weight: 500; text-decoration: none; white-space: nowrap; transition: transform 0.3s; }
    .hd-p i { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #14110d; color: #efe8d8; } .hd-p:hover { transform: scale(1.03); }
    .hd-s { font-size: 14px; color: rgba(239, 232, 216, 0.85); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(239, 232, 216, 0.35); white-space: nowrap; } .hd-s:hover { color: #fff; }
    @media (prefers-reduced-motion: reduce) { .hd-bg, .hd-pt { animation: none; } }
  }
</style>

<script>
  import { onFrame, put, clamp, smooth } from '../scripts/frame';
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const stage = document.querySelector<HTMLElement>('[data-hero]')!;
  const bg = document.querySelector<HTMLElement>('[data-hero-bg]')!;
  const text = document.querySelector<HTMLElement>('[data-hero-text]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const field = document.querySelector<HTMLElement>('.hh-field') ?? document.createElement('div');
  const tl = [...field.querySelectorAll<HTMLElement>('.hh-t')].map((el, k, all) => ({ el, sh: el.firstElementChild as HTMLElement, bl: el.lastElementChild as HTMLElement, a0: (+el.dataset.arm! * 2 * Math.PI) / 3, off: +el.dataset.off!, ph: +el.dataset.idx! / (all.length / 3) }));
  let W = 160, R1 = 600, vw0 = 0;
  const fit = () => { const w = stage.clientWidth, h = stage.clientHeight; vw0 = w; W = Math.max(90, Math.min(190, Math.min(w, h) * 0.22)); R1 = Math.hypot(w, h) * 0.62; tl.forEach((t) => { t.el.style.width = t.el.style.height = `${W}px`; t.el.style.margin = `${-W / 2}px 0 0 ${-W / 2}px`; }); };
  fit(); addEventListener('resize', fit);
  const T = 44, TURNS = 1.15;
  const paintTiles = (sec: number) => {
    tl.forEach((t) => {
      const p = reduced ? (0.25 + t.ph * 0.7) : ((sec / T + t.ph) % 1);
      const th = t.a0 - 2 * Math.PI * TURNS * p;                // antihorario
      const r = R1 * (0.09 + 0.91 * p);
      const e = smooth(p);
      const sc = 0.2 + 0.95 * e;
      const sharp = smooth(clamp((p - 0.1) / 0.42));
      const life = clamp(p / 0.08) * (1 - clamp((p - 0.94) / 0.06));
      put(t.el, 'transform', `translate3d(${(Math.cos(th) * r).toFixed(1)}px,${(Math.sin(th) * r).toFixed(1)}px,0) rotate(${((th * 180) / Math.PI - 90 + t.off).toFixed(1)}deg) scale(${sc.toFixed(3)})`);
      put(t.el, 'opacity', (life * (0.35 + 0.65 * sharp)).toFixed(3));
      put(t.sh, 'opacity', sharp.toFixed(3));
      put(t.bl, 'opacity', (1 - sharp).toFixed(3));
    });
  };
  paintTiles(0);
  const mobile = !matchMedia('(min-width: 768px)').matches;
  const ptr = { x: 0, y: 0, tx: 0, ty: 0 };
  addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') { ptr.tx = e.clientX / innerWidth - 0.5; ptr.ty = 0.5 - e.clientY / innerHeight; } }, { passive: true });
  const VS = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
  const FS = `#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
uniform vec2 res;
uniform float t;
uniform vec2 m;

float hash(vec2 p){ return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }

void main(){
  vec2 uv = gl_FragCoord.xy / res.y;
  vec2 p = uv * 1.7 + m * .3;
  float a = t * .3;
  for (int i = 1; i < 5; i++) {
    float k = float(i);
    p += .42 / (k * k) * vec2(sin(k * 1.7 * p.y + a + k), sin(k * 1.5 * p.x - a * .8 + k * 1.7)) * 2.1;
  }
  float f = .5 + .5 * sin(p.x * 2.4 + p.y * 1.3 + a * .4);

  vec3 purple = vec3(.43, .35, .66);
  vec3 deep   = vec3(.10, .28, .70);
  vec3 light  = vec3(.23, .39, .79);
  vec3 blue = mix(light, deep, smoothstep(.5, .85, f));
  vec3 col = mix(purple, blue, smoothstep(.26, .56, f));
  col += vec3(.04, .06, .13) * exp(-pow((f - .46) * 9., 2.));
  col += (hash(gl_FragCoord.xy + t) - .5) / 128.;
  gl_FragColor = vec4(col, 1.);
}`;

  // The silk is a slow, soft gradient: render it small (about 0.7 MP) and at ~40 fps; the scroll motion stays at full refresh rate.
  let draw: ((t: number) => void) | null = null;
  const gl: WebGLRenderingContext | null = null; // el hero de escritorio ahora es fotográfico: ya no hay seda WebGL
  if (gl) {
    const sh = (type: number, src: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s); return s; };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, VS));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FS));
    gl.linkProgram(prog);
    if (gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      gl.useProgram(prog);
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      const uRes = gl.getUniformLocation(prog, 'res');
      const uT = gl.getUniformLocation(prog, 't');
      const uM = gl.getUniformLocation(prog, 'm');
      draw = (t: number) => { ptr.x += (ptr.tx - ptr.x) * 0.06; ptr.y += (ptr.ty - ptr.y) * 0.06; gl.uniform2f(uM, ptr.x, ptr.y); gl.uniform1f(uT, t); gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4); };
      const fit = () => {
        const w = canvas.clientWidth, h = canvas.clientHeight;
        const k = Math.min(1, Math.sqrt(0.4e6 / Math.max(1, w * h)));
        canvas.width = Math.max(1, Math.round(w * k));
        canvas.height = Math.max(1, Math.round(h * k));
        gl.viewport(0, 0, canvas.width, canvas.height);
        gl.uniform2f(uRes, canvas.width, canvas.height);
        draw!(4);
      };
      fit();
      addEventListener('resize', fit);
    }
  }

  let last = -1e9;
  onFrame((t, y, vh) => {
    const p = clamp(y / (vh * 0.85));
    const gone = p >= 1;
    put(stage, 'visibility', gone ? 'hidden' : 'visible');
    if (gone) return;
    // scroll-driven dissolve into the horizon (opacity / transform only: compositor work)
    put(bg, 'opacity', (1 - smooth(clamp((p - 0.12) / 0.78))).toFixed(3));
    put(bg, 'transform', `scale(${(1 + p * 0.06).toFixed(4)})`);
    put(text, 'opacity', (1 - smooth(clamp(p / 0.55))).toFixed(3));
    put(text, 'transform', `translate3d(0, ${(-p * vh * 0.12).toFixed(1)}px, 0) scale(${(1 + p * 0.05).toFixed(4)})`);
    if (draw && !reduced && t - last > 24) { last = t; draw(t / 1000); }
  });
</script>
