---
import { divisions } from '../data/servicios';
const names = divisions.map((d) => d.short);
// Celular: emisor en espiral. Cada mosaico nace pequeño y borroso en el centro y sale girando (antihorario) hasta los bordes, ganando tamaño y nitidez.
const N = 24, ARMS = 3;
// Tres brazos de una misma espiral: cada mosaico pertenece a un brazo y recorre la curva de adentro hacia afuera.
const tiles = Array.from({ length: N }, (_, k) => ({ k, arm: k % ARMS, idx: Math.floor(k / ARMS), img: k + 1, off: [-10, 6, -4, 12, -8, 5, -12, 9, -2, 10][k % 10] }));
---

<div data-hero-wrap data-tone="dark" class="relative z-10 h-[190svh] max-md:h-[200svh]">
  <section data-hero class="sticky top-0 h-lvh min-h-[600px] overflow-hidden text-white">
    <div data-hero-bg class="absolute inset-0 bg-[#05070f] md:bg-[#1f4cb8] will-change-[opacity,transform]">
      <canvas id="hero-canvas" class="absolute inset-0 hidden size-full md:block" aria-hidden="true"></canvas>
      <div class="pointer-events-none absolute inset-0 hidden bg-black/20 md:block"></div>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-[12%] bg-gradient-to-b from-black/90 to-transparent"></div>
      <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(to bottom,transparent 60%,rgba(2,8,36,.5))"></div>
    </div>

    <div data-hero-text class="absolute inset-0 will-change-[opacity,transform]">
      <!-- escritorio: seda con la marca al centro -->
      <div class="absolute inset-0 hidden flex-col items-center justify-center px-6 text-center md:flex">
      <h1 class="overflow-hidden pb-[0.12em] text-[clamp(3.2rem,7.4vw,7rem)] leading-[0.95] tracking-[-0.035em]" aria-label="HumanCorp">
        <span class="hf-up block" style="--d:.25s"><span class="font-light">HUMAN</span> <span class="font-semibold">CORP</span></span>
      </h1>
      <p class="hf-rise mt-6 max-w-[32rem] text-[clamp(1.05rem,1.35vw,1.4rem)] font-medium leading-[1.5] tracking-tight text-white/90 text-balance" style="--d:.45s">
        Todo lo que hace funcionar a una empresa, conectado bajo un solo <em class="hf-em">estándar</em>.
      </p>
      <div class="hf-rise mt-9 flex justify-center gap-3" style="--d:.62s">
        <a href="/servicios" class="rounded-full bg-white px-7 py-3.5 text-[15px] font-medium text-[#0b0c0f] transition-transform hover:scale-[1.03]">Conocer servicios</a>
        <a href="/arma-tu-proyecto" class="rounded-full border border-white/45 px-7 py-3.5 text-[15px] transition-colors hover:bg-white/10">Arma tu proyecto</a>
      </div>
      <div class="hf-rise absolute inset-x-0 bottom-[3.5%] z-10" style="--d:1s" aria-hidden="true">
        <div class="hf-tick"><div class="hf-track">{[0, 1].map(() => names.map((n) => <span>{n}</span>))}</div></div>
      </div>
      </div>
      <!-- celular: la seda de escritorio de fondo; etiqueta arriba, titular abajo a la izquierda, texto y botón -->
      <div class="hm md:hidden">
      <div class="hm-art" aria-hidden="true">
        {[0, 1, 2, 3].map((k) => <i class={`hm-gl g${k}`} style={`--k:${k}`}></i>)}
        <svg class="hm-rg" viewBox="0 0 400 400"><circle cx="200" cy="200" r="196" /><circle cx="200" cy="200" r="150" class="d" /><circle cx="200" cy="200" r="104" /><circle cx="338" cy="110" r="3.2" class="dot" /><circle cx="62" cy="290" r="2.4" class="dot" /></svg>
        <div class="hm-wm"><b>HUMAN</b>{[0, 1, 2, 3].map((k) => <b class={`t t${k}`} style={`--k:${k}`}>HUMAN</b>)}</div>
        {[8, 22, 35, 48, 61, 74, 86, 15, 55].map((x, k) => <i class="hm-pt" style={`left:${x}%;--d:${-k * 1.7}s;--s:${9 + (k % 4) * 2}s`}></i>)}
        <div class="hm-phw"><div class="hm-ph">
          <div class="hm-scr">
            <i class="hm-is"></i>
            {[['Ventas y CRM', '$ 134 mil', '▲ 12.4 %', 'b'], ['Finanzas', '$ 1.28 M', '▲ 8.1 %', 'a'], ['Operaciones', '94 %', 'Entregas a tiempo', 'm'], ['Asistente de IA', '1,284', 'Tareas automatizadas', 'r']].map(([t, n, d, c], k) => (
              <div class={`hm-sl c${c}`} style={`--k:${k}`}>
                <div class="hm-bar"><span>{t}</span><em>Hoy</em></div>
                <b class="hm-num">{n}</b><span class="hm-dl">{d}</span>
                {k === 0 && <div class="hm-cb">{[40, 58, 46, 72, 64, 90, 78].map((h, j) => <i style={`height:${h}%;--j:${j}`}></i>)}</div>}
                {k === 1 && <svg class="hm-ln" viewBox="0 0 100 44" preserveAspectRatio="none"><defs><linearGradient id="hmA" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f0b56e" stop-opacity=".45"/><stop offset="1" stop-color="#f0b56e" stop-opacity="0"/></linearGradient></defs><path d="M0 36 C14 34 20 26 32 28 S54 16 66 14 S88 6 100 3 V44 H0Z" fill="url(#hmA)"/><path d="M0 36 C14 34 20 26 32 28 S54 16 66 14 S88 6 100 3" fill="none" stroke="#f0b56e" stroke-width="1.6" vector-effect="non-scaling-stroke"/></svg>}
                {k === 2 && <div class="hm-pg">{[['Compras', 0.92], ['Producción', 0.64], ['Entregas', 0.78]].map(([n2, w], j) => <p><span>{n2}</span><i><b style={`--w:${w};--j:${j}`}></b></i></p>)}</div>}
                {k === 3 && <div class="hm-dn"><i></i><span>Respuestas enviadas<br /><small>Con supervisión humana</small></span></div>}
                <div class="hm-rw"><p><span>{['Prospectos nuevos', 'Ingresos', 'Órdenes del día', 'Pendientes'][k]}</span><b>{['38', '$ 640 mil', '126', '3'][k]}</b></p><p><span>{['Propuestas', 'Gastos', 'Incidencias', 'Escaladas a equipo'][k]}</span><b>{['14', '$ 411 mil', '2', '1'][k]}</b></p></div>
              </div>
            ))}
          </div>
        </div></div>
        {['↗ +24 % en ventas', 'Cierre contable al día', '98 % de entregas a tiempo', 'IA con supervisión humana'].map((t, k) => <span class={`hm-ch h${k}`} style={`--k:${k}`}>{t}</span>)}
      </div>
      <i class="hm-sh" aria-hidden="true"></i>
      <div class="hm-mid">
        <p class="hm-k hf-rise" style="--d:.2s">Un estándar para toda tu empresa</p>
        <h1 class="hm-h"><span class="sr-only">HumanCorp: </span>
          <span class="block overflow-hidden pb-[0.1em]"><span class="hf-up block" style="--d:.3s">Todo conectado.</span></span>
          <span class="block overflow-hidden pb-[0.1em]"><span class="hf-up block" style="--d:.44s">Bajo un solo estándar.</span></span>
        </h1>
        <p class="hm-p hf-rise" style="--d:.65s">Diseño, tecnología y operaciones empresariales, organizadas para que tu empresa funcione con claridad.</p>
        <div class="hm-cta hf-rise" style="--d:.8s"><a class="p" href="/servicios">Conocer servicios</a><a class="s" href="/arma-tu-proyecto">Arma tu proyecto</a></div>
      </div>
      </div>
    </div>
  </section>
</div>


<style is:global>
  @media (max-width: 767px) {
    .hm-art { position: absolute; inset: 0; overflow: hidden; pointer-events: none; --pw: min(48vw, 212px); }
    /* luz de color: cuatro halos que se cruzan al cambiar la pantalla del teléfono (solo opacidad) */
    .hm-gl { position: absolute; left: 50%; top: 34%; width: 135vw; height: 135vw; margin: -67.5vw 0 0 -67.5vw; border-radius: 50%; opacity: 0; animation: hmGl 14.4s ease-in-out infinite both; animation-delay: calc(var(--k) * 3.6s); }
    .hm-gl.g0 { background: radial-gradient(circle, rgba(70, 110, 255, 0.5), transparent 62%); } .hm-gl.g1 { background: radial-gradient(circle, rgba(240, 181, 110, 0.42), transparent 62%); }
    .hm-gl.g2 { background: radial-gradient(circle, rgba(60, 220, 180, 0.38), transparent 62%); } .hm-gl.g3 { background: radial-gradient(circle, rgba(255, 120, 150, 0.4), transparent 62%); }
    @keyframes hmGl { 0% { opacity: 0; } 5% { opacity: 1; } 22% { opacity: 1; } 29% { opacity: 0; } 100% { opacity: 0; } }
    .hm-rg { position: absolute; left: 50%; top: 34%; width: 138vw; height: 138vw; margin: -69vw 0 0 -69vw; animation: hmRot 90s linear infinite; }
    .hm-rg circle { fill: none; stroke: rgba(255, 255, 255, 0.12); stroke-width: 0.7; } .hm-rg .d { stroke-dasharray: 2 7; stroke: rgba(255, 255, 255, 0.2); } .hm-rg .dot { fill: #fff; stroke: none; opacity: 0.8; }
    @keyframes hmRot { to { transform: rotate(360deg); } }
    /* palabra gigante detrás del teléfono: base apagada y cuatro tintes que cambian con cada pantalla */
    .hm-wm { position: absolute; left: -2vw; right: 0; top: 13%; height: 28vw; font-size: 27.5vw; line-height: 0.9; font-weight: 600; letter-spacing: -0.06em; white-space: nowrap; }
    .hm-wm b { position: absolute; left: 0; top: 0; font-weight: 600; color: rgba(255, 255, 255, 0.07); }
    .hm-wm b.t { opacity: 0; animation: hmGl 14.4s ease-in-out infinite both; animation-delay: calc(var(--k) * 3.6s); }
    .hm-wm .t0 { color: rgba(80, 120, 255, 0.34); } .hm-wm .t1 { color: rgba(240, 181, 110, 0.3); } .hm-wm .t2 { color: rgba(60, 220, 180, 0.28); } .hm-wm .t3 { color: rgba(255, 120, 150, 0.3); }
    .hm-pt { position: absolute; bottom: 8%; width: 2px; height: 2px; border-radius: 50%; background: #fff; opacity: 0; animation: hmPt var(--s) linear infinite; animation-delay: var(--d); }
    @keyframes hmPt { 0% { transform: translate3d(0, 0, 0); opacity: 0; } 15% { opacity: 0.7; } 85% { opacity: 0.5; } 100% { transform: translate3d(0, -70svh, 0); opacity: 0; } }
    /* teléfono inclinado */
    .hm-phw { position: absolute; left: 50%; top: 11.5%; width: var(--pw); margin-left: calc(var(--pw) / -2); animation: hmFl 7s ease-in-out infinite alternate; }
    @keyframes hmFl { to { translate: 0 -9px; } }
    .hm-ph { position: relative; width: 100%; aspect-ratio: 9 / 18.6; border-radius: calc(var(--pw) * 0.16); padding: calc(var(--pw) * 0.026); background: linear-gradient(145deg, #3a3f4d, #12141b 40%, #2a2e3a); box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.14), 0 40px 70px -22px rgba(0, 0, 0, 0.9); rotate: -8deg; animation: hmIn 1.3s cubic-bezier(0.2, 0.8, 0.2, 1) 0.35s both; }
    @keyframes hmIn { from { opacity: 0; translate: 0 46px; rotate: -17deg; } to { opacity: 1; translate: 0 0; rotate: -8deg; } }
    .hm-scr { position: relative; width: 100%; height: 100%; overflow: hidden; border-radius: calc(var(--pw) * 0.135); background: #090c14; font-size: calc(var(--pw) * 0.047); color: #eef1ff; }
    .hm-is { position: absolute; left: 50%; top: 2.4%; width: 28%; height: 3.4%; margin-left: -14%; border-radius: 99px; background: #000; z-index: 4; }
    .hm-sl { position: absolute; inset: 0; padding: 13% 7% 6%; display: flex; flex-direction: column; opacity: 0; animation: hmSl 14.4s cubic-bezier(0.4, 0, 0.2, 1) infinite both; animation-delay: calc(var(--k) * 3.6s); --ac: #5b8cff; }
    .hm-sl.ca { --ac: #f0b56e; } .hm-sl.cm { --ac: #4ee3b5; } .hm-sl.cr { --ac: #ff8a9b; }
    @keyframes hmSl { 0% { opacity: 0; transform: translate3d(14%, 0, 0); } 4% { opacity: 1; transform: none; } 22% { opacity: 1; transform: none; } 27% { opacity: 0; transform: translate3d(-14%, 0, 0); } 100% { opacity: 0; transform: translate3d(-14%, 0, 0); } }
    .hm-bar { display: flex; justify-content: space-between; align-items: center; font-size: 0.82em; color: rgba(238, 241, 255, 0.6); } .hm-bar em { font-style: normal; padding: 0.25em 0.8em; border-radius: 99px; background: rgba(255, 255, 255, 0.08); }
    .hm-num { display: block; margin-top: 1.1em; font-size: 2.5em; font-weight: 500; letter-spacing: -0.04em; line-height: 1; font-variant-numeric: tabular-nums; }
    .hm-dl { margin-top: 0.5em; font-size: 0.82em; font-weight: 500; color: var(--ac); }
    .hm-cb { display: flex; align-items: flex-end; gap: 0.55em; height: 26%; margin-top: 1.4em; } .hm-cb i { flex: 1; border-radius: 0.4em 0.4em 0.15em 0.15em; background: linear-gradient(180deg, var(--ac), rgba(91, 140, 255, 0.12)); transform-origin: 50% 100%; transform: scaleY(0.12); animation: hmBr 14.4s cubic-bezier(0.3, 0.7, 0.2, 1) infinite both; animation-delay: calc(var(--k, 0) * 3.6s + var(--j) * 70ms); }
    .hm-sl[style*="--k:0"] .hm-cb i { --k: 0; }
    @keyframes hmBr { 0% { transform: scaleY(0.12); } 3% { transform: scaleY(0.12); } 11% { transform: scaleY(1); } 100% { transform: scaleY(1); } }
    .hm-ln { display: block; width: 100%; height: 26%; margin-top: 1.4em; overflow: visible; }
    .hm-pg { margin-top: 1.4em; display: flex; flex-direction: column; gap: 0.9em; } .hm-pg p, .hm-rw p { display: flex; align-items: center; justify-content: space-between; gap: 0.6em; font-size: 0.82em; color: rgba(238, 241, 255, 0.7); }
    .hm-pg p { flex-direction: column; align-items: stretch; gap: 0.4em; } .hm-pg i { display: block; height: 0.5em; border-radius: 99px; background: rgba(255, 255, 255, 0.1); overflow: hidden; } .hm-pg b { display: block; height: 100%; width: 100%; background: var(--ac); border-radius: 99px; transform-origin: 0 50%; transform: scaleX(0.05); animation: hmBx 14.4s cubic-bezier(0.3, 0.7, 0.2, 1) infinite both; animation-delay: calc(2 * 3.6s + var(--j) * 120ms); }
    @keyframes hmBx { 0% { transform: scaleX(0.05); } 3% { transform: scaleX(0.05); } 12% { transform: scaleX(var(--w)); } 100% { transform: scaleX(var(--w)); } }
    .hm-dn { display: flex; align-items: center; gap: 0.9em; margin-top: 1.5em; font-size: 0.82em; color: rgba(238, 241, 255, 0.75); } .hm-dn i { flex: none; width: 4.2em; height: 4.2em; border-radius: 50%; background: conic-gradient(var(--ac) 0 78%, rgba(255, 255, 255, 0.1) 0); -webkit-mask: radial-gradient(circle, transparent 54%, #000 56%); mask: radial-gradient(circle, transparent 54%, #000 56%); } .hm-dn small { color: rgba(238, 241, 255, 0.45); }
    .hm-rw { margin-top: auto; display: flex; flex-direction: column; gap: 0.7em; padding-top: 1em; border-top: 1px solid rgba(255, 255, 255, 0.08); } .hm-rw b { font-weight: 500; color: #fff; font-variant-numeric: tabular-nums; }
    /* etiquetas planas que acompañan cada pantalla */
    .hm-ch { position: absolute; padding: 0.62em 1.05em; border-radius: 99px; font-size: 12px; font-weight: 500; color: #f3f5ff; background: #0f1320; border: 1px solid rgba(255, 255, 255, 0.16); box-shadow: 0 14px 30px -14px rgba(0, 0, 0, 0.9); white-space: nowrap; opacity: 0; animation: hmCh 14.4s ease-in-out infinite both; animation-delay: calc(var(--k) * 3.6s); }
    .hm-ch.h0 { left: 5%; top: 24%; } .hm-ch.h1 { right: 4%; top: 36%; } .hm-ch.h2 { left: 4%; top: 42%; } .hm-ch.h3 { right: 4%; top: 22%; }
    @keyframes hmCh { 0% { opacity: 0; transform: translate3d(0, 14px, 0); } 7% { opacity: 1; transform: none; } 22% { opacity: 1; transform: none; } 28% { opacity: 0; transform: translate3d(0, -8px, 0); } 100% { opacity: 0; } }
    .hm-sh { background: linear-gradient(180deg, rgba(3, 5, 14, 0.35), transparent 18%, transparent 46%, rgba(3, 5, 14, 0.82) 66%, rgba(3, 5, 14, 0.96)) !important; }
    @media (prefers-reduced-motion: reduce) { .hm-art * { animation: none !important; } .hm-sl:first-of-type, .hm-sl.cb { opacity: 1; } .hm-gl.g0 { opacity: 1; } .hm-ph { opacity: 1; } }
  }
</style>

<script>
  import { onFrame, put, clamp, smooth } from '../scripts/frame';
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const stage = document.querySelector<HTMLElement>('[data-hero]')!;
  const bg = document.querySelector<HTMLElement>('[data-hero-bg]')!;
  const text = document.querySelector<HTMLElement>('[data-hero-text]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const field = document.querySelector<HTMLElement>('.hh-field') ?? document.createElement('div');
  const tl = [...field.querySelectorAll<HTMLElement>('.hh-t')].map((el, k, all) => ({ el, sh: el.firstElementChild as HTMLElement, bl: el.lastElementChild as HTMLElement, a0: (+el.dataset.arm! * 2 * Math.PI) / 3, off: +el.dataset.off!, ph: +el.dataset.idx! / (all.length / 3) }));
  let W = 160, R1 = 600, vw0 = 0;
  const fit = () => { const w = stage.clientWidth, h = stage.clientHeight; vw0 = w; W = Math.max(90, Math.min(190, Math.min(w, h) * 0.22)); R1 = Math.hypot(w, h) * 0.62; tl.forEach((t) => { t.el.style.width = t.el.style.height = `${W}px`; t.el.style.margin = `${-W / 2}px 0 0 ${-W / 2}px`; }); };
  fit(); addEventListener('resize', fit);
  const T = 44, TURNS = 1.15;
  const paintTiles = (sec: number) => {
    tl.forEach((t) => {
      const p = reduced ? (0.25 + t.ph * 0.7) : ((sec / T + t.ph) % 1);
      const th = t.a0 - 2 * Math.PI * TURNS * p;                // antihorario
      const r = R1 * (0.09 + 0.91 * p);
      const e = smooth(p);
      const sc = 0.2 + 0.95 * e;
      const sharp = smooth(clamp((p - 0.1) / 0.42));
      const life = clamp(p / 0.08) * (1 - clamp((p - 0.94) / 0.06));
      put(t.el, 'transform', `translate3d(${(Math.cos(th) * r).toFixed(1)}px,${(Math.sin(th) * r).toFixed(1)}px,0) rotate(${((th * 180) / Math.PI - 90 + t.off).toFixed(1)}deg) scale(${sc.toFixed(3)})`);
      put(t.el, 'opacity', (life * (0.35 + 0.65 * sharp)).toFixed(3));
      put(t.sh, 'opacity', sharp.toFixed(3));
      put(t.bl, 'opacity', (1 - sharp).toFixed(3));
    });
  };
  paintTiles(0);
  const mobile = !matchMedia('(min-width: 768px)').matches;
  const ptr = { x: 0, y: 0, tx: 0, ty: 0 };
  addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') { ptr.tx = e.clientX / innerWidth - 0.5; ptr.ty = 0.5 - e.clientY / innerHeight; } }, { passive: true });
  const VS = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
  const FS = `#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
uniform vec2 res;
uniform float t;
uniform vec2 m;

float hash(vec2 p){ return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }

void main(){
  vec2 uv = gl_FragCoord.xy / res.y;
  vec2 p = uv * 1.7 + m * .3;
  float a = t * .3;
  for (int i = 1; i < 5; i++) {
    float k = float(i);
    p += .42 / (k * k) * vec2(sin(k * 1.7 * p.y + a + k), sin(k * 1.5 * p.x - a * .8 + k * 1.7)) * 2.1;
  }
  float f = .5 + .5 * sin(p.x * 2.4 + p.y * 1.3 + a * .4);

  vec3 purple = vec3(.43, .35, .66);
  vec3 deep   = vec3(.10, .28, .70);
  vec3 light  = vec3(.23, .39, .79);
  vec3 blue = mix(light, deep, smoothstep(.5, .85, f));
  vec3 col = mix(purple, blue, smoothstep(.26, .56, f));
  col += vec3(.04, .06, .13) * exp(-pow((f - .46) * 9., 2.));
  col += (hash(gl_FragCoord.xy + t) - .5) / 128.;
  gl_FragColor = vec4(col, 1.);
}`;

  // The silk is a slow, soft gradient: render it small (about 0.7 MP) and at ~40 fps; the scroll motion stays at full refresh rate.
  let draw: ((t: number) => void) | null = null;
  const gl = mobile ? null : canvas.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'high-performance' });
  if (gl) {
    const sh = (type: number, src: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s); return s; };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, VS));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FS));
    gl.linkProgram(prog);
    if (gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      gl.useProgram(prog);
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      const uRes = gl.getUniformLocation(prog, 'res');
      const uT = gl.getUniformLocation(prog, 't');
      const uM = gl.getUniformLocation(prog, 'm');
      draw = (t: number) => { ptr.x += (ptr.tx - ptr.x) * 0.06; ptr.y += (ptr.ty - ptr.y) * 0.06; gl.uniform2f(uM, ptr.x, ptr.y); gl.uniform1f(uT, t); gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4); };
      const fit = () => {
        const w = canvas.clientWidth, h = canvas.clientHeight;
        const k = Math.min(1, Math.sqrt(0.4e6 / Math.max(1, w * h)));
        canvas.width = Math.max(1, Math.round(w * k));
        canvas.height = Math.max(1, Math.round(h * k));
        gl.viewport(0, 0, canvas.width, canvas.height);
        gl.uniform2f(uRes, canvas.width, canvas.height);
        draw!(4);
      };
      fit();
      addEventListener('resize', fit);
    }
  }

  let last = -1e9;
  onFrame((t, y, vh) => {
    const p = clamp(y / (vh * 0.85));
    const gone = p >= 1;
    put(stage, 'visibility', gone ? 'hidden' : 'visible');
    if (gone) return;
    // scroll-driven dissolve into the horizon (opacity / transform only: compositor work)
    put(bg, 'opacity', (1 - smooth(clamp((p - 0.12) / 0.78))).toFixed(3));
    put(bg, 'transform', `scale(${(1 + p * 0.06).toFixed(4)})`);
    put(text, 'opacity', (1 - smooth(clamp(p / 0.55))).toFixed(3));
    put(text, 'transform', `translate3d(0, ${(-p * vh * 0.12).toFixed(1)}px, 0) scale(${(1 + p * 0.05).toFixed(4)})`);
    if (draw && !reduced && t - last > 24) { last = t; draw(t / 1000); }
  });
</script>
