---
import AppFrame from './AppFrame.astro';

const facts = [
  { k: '08', v: 'Áreas de servicio' },
  { k: 'CRM', v: 'Ventas conectadas' },
  { k: 'CFDI 4.0', v: 'Facturación electrónica' },
  { k: 'IA', v: 'Agentes y automatización' },
];
---

<section
  data-hero
  data-tone="dark"
  class="relative min-h-svh overflow-hidden bg-[#06102b] text-white md:sticky md:top-0 md:h-svh"
>
  <!-- Technical ground: fine grid + a spotlight that follows the pointer -->
  <div
    class="pointer-events-none absolute inset-0 opacity-70"
    style="background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);background-size:56px 56px;mask-image:radial-gradient(80% 70% at 62% 45%,#000 30%,transparent 100%)"
  ></div>
  <div
    data-spot
    class="pointer-events-none absolute inset-0"
    style="background:radial-gradient(520px circle at var(--mx,70%) var(--my,40%),rgba(59,110,230,.22),transparent 70%)"
  ></div>
  <div class="pointer-events-none absolute -right-40 top-1/4 h-[560px] w-[560px] rounded-full bg-[#1d4bb8]/25 blur-[120px]"></div>

  <div data-hero-inner class="relative mx-auto flex min-h-svh max-w-[1280px] flex-col px-6 pb-8 pt-28 md:h-full md:px-10 md:pb-0 md:pt-24">
    <div class="grid flex-1 items-center gap-10 md:grid-cols-12 md:gap-8 md:pb-24">
      <div class="md:col-span-5">
        <p class="hf-rise inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.12em] text-white/70" style="--d:.1s">
          <span class="hf-dot size-1.5 rounded-full bg-[#4ade80]"></span>
          Diseño, tecnología y operaciones empresariales
        </p>
        <h1 class="hf-rise mt-6 max-w-[16ch] text-[clamp(2.1rem,3.2vw,3.2rem)] font-medium leading-[1.04] tracking-[-0.03em] text-balance" style="--d:.2s">
          Todo lo que hace funcionar a una empresa, conectado bajo un solo estándar.
        </h1>
        <p class="hf-rise mt-6 max-w-[34rem] font-body text-[17px] leading-relaxed text-white/70" style="--d:.35s">
          HumanCorp diseña, desarrolla y automatiza las ventas, las finanzas, las operaciones y los datos de tu empresa, para que trabajen como un solo sistema.
        </p>
        <div class="hf-rise mt-8 flex flex-wrap gap-3" style="--d:.5s">
          <a href="/contacto" class="group inline-flex items-center gap-2 rounded-full bg-white px-6 py-3.5 text-[15px] font-medium text-[#06102b] transition-transform duration-200 hover:scale-[1.03] active:scale-[0.98]">
            Hablemos de tu empresa
            <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
          <a href="/servicios" class="inline-flex items-center rounded-full border border-white/25 px-6 py-3.5 text-[15px] font-medium transition-[background-color,transform] duration-200 hover:bg-white/10 active:scale-[0.98]">
            Ver los servicios
          </a>
        </div>
      </div>

      <div class="md:col-span-7"><AppFrame /></div>
    </div>

    <!-- Docked strip: hard facts -->
    <ul class="hf-rise mt-10 grid grid-cols-2 gap-y-5 border-t border-white/10 py-5 md:absolute md:inset-x-10 md:bottom-0 md:mt-0 md:grid-cols-4 md:py-6" style="--d:1.2s">
      {facts.map((f) => (
        <li class="pr-4">
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-[#7fa6f5]">{f.k}</p>
          <p class="mt-1 font-body text-[14px] text-white/70">{f.v}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      hero.style.setProperty('--mx', e.clientX - r.left + 'px');
      hero.style.setProperty('--my', e.clientY - r.top + 'px');
    });
  }
</script>
