---
import Header from './Header.astro';
---

<section
  class="relative h-svh min-h-[560px] overflow-hidden text-white"
  style="background:radial-gradient(70% 90% at 80% 40%,#1d4bb8,transparent 70%),#6e5aa9"
>
  <canvas id="hero-canvas" class="absolute inset-0 size-full opacity-0 transition-opacity duration-1000" aria-hidden="true"></canvas>
  <div class="pointer-events-none absolute inset-0 bg-black/20"></div>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-[12%] bg-gradient-to-b from-black/90 to-transparent"></div>
  <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(to bottom,transparent 60%,rgba(2,8,36,.5))"></div>

  <Header />

  <h1 id="hero-title" class="absolute inset-x-0 top-[51.5%] -translate-y-1/2 text-center text-[clamp(3rem,3.8vw,4.5rem)] font-semibold leading-none tracking-tight">NEXA</h1>
  <p class="absolute inset-x-0 bottom-[10%] mx-auto max-w-[22rem] px-6 text-center text-[clamp(1.125rem,1.25vw,1.5rem)] font-medium leading-[1.5] tracking-tight text-balance md:max-w-none">
    Todo lo que hace funcionar a una empresa,<br class="hidden md:block" /> conectado bajo un solo estándar.
  </p>

  <span id="hero-dot" class="pointer-events-none absolute left-0 top-0 z-30 size-2.5 rounded-full bg-white will-change-transform" aria-hidden="true"></span>
</section>

<script>
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const dot = document.getElementById('hero-dot') as HTMLElement;
  const title = document.getElementById('hero-title') as HTMLElement;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Cursor dot: follows the pointer with easing; rests above the wordmark.
  const rest = () => {
    const r = title.getBoundingClientRect();
    return { x: r.left + r.width / 2, y: r.top - 14 };
  };
  let target = rest();
  let pos = { ...target };
  const place = () => (dot.style.transform = `translate3d(${pos.x - 5}px,${pos.y - 5}px,0)`);
  place();
  addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse' && (e.clientX || e.clientY)) target = { x: e.clientX, y: e.clientY }; });
  document.documentElement.addEventListener('pointerleave', () => (target = rest()));
  addEventListener('resize', () => { if (!matchMedia('(hover:hover)').matches) target = rest(); });

  // Animated background: procedural silk-like flow (domain-warped sine field), rendered at full resolution.
  const VS = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
  const FS = `#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
uniform vec2 res;
uniform float t;

float hash(vec2 p){ return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }

void main(){
  vec2 uv = gl_FragCoord.xy / res.y;
  vec2 p = uv * 1.7;
  float a = t * .45;
  for (int i = 1; i < 5; i++) {
    float k = float(i);
    p += .42 / (k * k) * vec2(sin(k * 1.7 * p.y + a + k), sin(k * 1.5 * p.x - a * .8 + k * 1.7)) * 2.1;
  }
  float f = .5 + .5 * sin(p.x * 2.4 + p.y * 1.3 + a * .4);
  
  vec3 purple = vec3(.43, .35, .66);
  vec3 deep   = vec3(.10, .28, .70);
  vec3 light  = vec3(.23, .39, .79);
  vec3 blue = mix(light, deep, smoothstep(.5, .85, f));
  vec3 col = mix(purple, blue, smoothstep(.26, .56, f));
  col += vec3(.04, .06, .13) * exp(-pow((f - .46) * 9., 2.));
  col += (hash(gl_FragCoord.xy + t) - .5) / 128.;
  gl_FragColor = vec4(col, 1.);
}`;

  let render: ((t: number) => void) | null = null;
  const gl = canvas.getContext('webgl', { antialias: false, alpha: false });
  if (gl) {
    const sh = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, VS));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FS));
    gl.linkProgram(prog);
    if (gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      gl.useProgram(prog);
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      const uRes = gl.getUniformLocation(prog, 'res');
      const uT = gl.getUniformLocation(prog, 't');
      const fit = () => {
        // Full device resolution, capped at ~2.5 MP so weak GPUs keep 60 fps (the content is smooth, so it stays sharp).
        const dpr = Math.min(devicePixelRatio, 2);
        const k = Math.min(dpr, Math.sqrt(2.5e6 / (canvas.clientWidth * canvas.clientHeight)));
        canvas.width = Math.max(1, Math.round(canvas.clientWidth * k));
        canvas.height = Math.max(1, Math.round(canvas.clientHeight * k));
        gl.viewport(0, 0, canvas.width, canvas.height);
        gl.uniform2f(uRes, canvas.width, canvas.height);
        if (reduced) draw(4);
      };
      const draw = (t: number) => {
        gl.uniform1f(uT, t);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      };
      render = (ms) => draw(ms / 1000);
      fit();
      draw(4);
      addEventListener('resize', fit);
      canvas.style.opacity = '1';
    }
  }

  const loop = (t: number) => {
    pos.x += (target.x - pos.x) * 0.08;
    pos.y += (target.y - pos.y) * 0.08;
    place();
    if (render && !reduced) render(t);
    if (!document.hidden) requestAnimationFrame(loop);
  };
  requestAnimationFrame(loop);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) requestAnimationFrame(loop); });
</script>
