---
import HeroArt from './HeroArt.astro';
import { designCards, systemCards } from '../data/heroCards';
---

<section data-hero data-tone="light" class="relative h-svh min-h-[620px] bg-paper p-2 md:sticky md:top-0 md:p-3">
  <div data-stage data-hero-inner class="relative size-full overflow-hidden rounded-[22px] bg-[#e9e8e4] text-[#111] md:rounded-[28px]">
    <!-- World 1: design -->
    <HeroArt
      mode="a"
      cards={designCards}
      line1="Diseño"
      line2="que se nota."
      caption="Identidad, web y producción creativa para empresas."
    />

    <!-- World 2: system (revealed by the lens) -->
    <div data-layer-b class="absolute inset-0 bg-[#06102b] text-white" style="clip-path:circle(0px at 70% 50%)">
      <div
        class="absolute inset-0 opacity-70"
        style="background-image:linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px);background-size:48px 48px"
      ></div>
      <HeroArt
        mode="b"
        cards={systemCards}
        line1="Sistema"
        line2="que opera."
        caption="CRM, finanzas, IA y datos conectados en un solo sistema."
      />
    </div>
    <div data-ring class="pointer-events-none absolute left-0 top-0 rounded-full border border-white/70 opacity-0 shadow-[0_0_0_1px_rgba(17,17,17,0.12)]"></div>

    <!-- Shared foreground: inverts on whichever world is under it -->
    <div class="pointer-events-none absolute inset-0 z-30 text-white mix-blend-difference">
      <p class="hf-fade absolute bottom-[4.75rem] left-5 max-w-[16rem] text-[13px] leading-snug md:bottom-8 md:left-8" style="--d:1.3s">
        Todo lo que hace funcionar a una empresa, conectado bajo un solo estándar.
      </p>
      <div class="hf-fade pointer-events-auto absolute bottom-5 left-5 right-5 flex flex-wrap items-center gap-2 md:bottom-8 md:left-auto md:right-8" style="--d:1.4s">
        <button
          type="button"
          data-toggle
          aria-pressed="false"
          class="inline-flex items-center gap-2 rounded-full border border-white px-4 py-2.5 text-[14px] font-medium transition-[background-color,transform] duration-200 hover:bg-white/20 active:scale-[0.97]"
        >
          <span class="size-3 rounded-full border border-white" style="background:linear-gradient(90deg,#fff 50%,transparent 50%)"></span>
          <span data-toggle-label>Ver el sistema</span>
        </button>
        <a href="/servicios" class="hidden rounded-full border border-white px-4 py-2.5 text-[14px] font-medium transition-[background-color,transform] duration-200 hover:bg-white/20 active:scale-[0.97] md:inline-flex">→ Servicios</a>
        <a href="/contacto" class="rounded-full bg-white px-4 py-2.5 text-[14px] font-medium text-black transition-transform duration-200 hover:scale-[1.03] active:scale-[0.97]">→ Hablemos</a>
      </div>
    </div>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('[data-stage]')!;
  const layerB = document.querySelector<HTMLElement>('[data-layer-b]')!;
  const ring = document.querySelector<HTMLElement>('[data-ring]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-toggle]')!;
  const toggleLabel = document.querySelector<HTMLElement>('[data-toggle-label]')!;
  const ribbons = [...document.querySelectorAll<HTMLElement>('[data-ribbon]')];
  const rows = ribbons.map((r) => [...r.querySelectorAll<HTMLElement>('[data-card]')]);
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const LOOP = 40000; // ms for the ribbon to travel one card-spacing x N
  let W = 0, H = 0, cover = 0;
  const fit = () => {
    const r = stage.getBoundingClientRect();
    W = r.width; H = r.height; cover = Math.hypot(W, H);
    const s = Math.max(0.5, Math.min(W / 1440, H / 760));
    ribbons.forEach((b) => (b.style.transform = `translateX(-50%) scale(${s})`));
  };
  fit();
  addEventListener('resize', fit);

  // Lens state
  let lx = 0.7, ly = 0.5, lr = 0; // lx, ly in 0..1 of the stage
  let tx = 0.7, ty = 0.5;
  let last = -1e9, hover = false, full = false;
  stage.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return;
    const r = stage.getBoundingClientRect();
    tx = (e.clientX - r.left) / r.width;
    ty = (e.clientY - r.top) / r.height;
    last = performance.now();
    hover = true;
  });
  stage.addEventListener('pointerleave', () => { hover = false; last = -1e9; });
  toggle.addEventListener('click', () => {
    full = !full;
    toggle.setAttribute('aria-pressed', String(full));
    toggleLabel.textContent = full ? 'Ver el diseño' : 'Ver el sistema';
  });

  const frame = (now: number) => {
    // Ribbon
    const t = reduced ? 0.35 : now / LOOP;
    rows.forEach((cards) => {
      const n = cards.length;
      cards.forEach((c, i) => {
        const d = (i / n + t) % 1;
        c.style.offsetDistance = d * 100 + '%';
        c.style.opacity = String(Math.min(1, d / 0.05, (1 - d) / 0.05));
      });
    });

    // Lens: follows the pointer, drifts on its own when idle (and on touch)
    const idle = now - last > 2500;
    if (idle && !reduced) {
      tx = 0.5 + 0.3 * Math.sin(now / 3200);
      ty = 0.52 + 0.17 * Math.sin(now / 2300 + 1);
    } else if (idle) { tx = 0.7; ty = 0.5; }
    const hp = Math.min(1, Math.max(0, scrollY / innerHeight));
    const base = Math.min(W, H) * (hover ? 0.3 : 0.25);
    const target = (full ? cover : base) + hp * cover;
    const open = now > 500 ? 1 : 0; // lens opens right after the entrance
    lx += (tx - lx) * 0.1;
    ly += (ty - ly) * 0.1;
    lr += (target * open - lr) * 0.07;
    const cx = lx * W, cy = ly * H;
    layerB.style.clipPath = `circle(${lr.toFixed(1)}px at ${cx.toFixed(1)}px ${cy.toFixed(1)}px)`;
    const showRing = lr > 8 && lr < cover * 0.85;
    ring.style.opacity = showRing ? '1' : '0';
    ring.style.width = ring.style.height = lr * 2 + 'px';
    ring.style.transform = `translate3d(${cx - lr}px, ${cy - lr}px, 0)`;
    if (!document.hidden) requestAnimationFrame(frame);
  };
  requestAnimationFrame(frame);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) requestAnimationFrame(frame); });
</script>
