---
// Emisor en espiral: cada mosaico nace pequeño y borroso en el centro y sale girando (antihorario) hasta los bordes, ganando tamaño y nitidez.
const N = 20;
const tiles = Array.from({ length: N }, (_, k) => ({ k, a: ((k * 137.508) % 360).toFixed(1), img: (k % 10) + 1, off: [-10, 6, -4, 12, -8, 5, -12, 9, -2, 10][k % 10] }));
---

<div data-hero-wrap class="relative z-10 h-[190svh]">
  <section data-hero class="sticky top-0 h-svh min-h-[600px] overflow-hidden text-white">
    <div data-hero-bg class="absolute inset-0 bg-black will-change-[opacity,transform]">
      <div class="pointer-events-none absolute inset-0 bg-black/20"></div>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-[12%] bg-gradient-to-b from-black/90 to-transparent"></div>
      <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(to bottom,transparent 60%,rgba(2,8,36,.5))"></div>
    </div>
    <!-- first light: a warm glow rises from the bottom while the silk dissolves into the horizon -->
    <div data-hero-glow class="pointer-events-none absolute inset-x-0 bottom-0 h-[80%] origin-bottom opacity-0 will-change-[opacity,transform]" style="background:linear-gradient(to top,rgba(246,196,138,.95),rgba(216,142,118,.55) 38%,rgba(126,104,172,.2) 70%,transparent)"></div>

    <div data-hero-text class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center will-change-[opacity,transform]">
      <div class="hh-field pointer-events-none absolute left-1/2 top-1/2" aria-hidden="true">
        {tiles.map((t) => (
          <u class="hh-t" data-a={t.a} data-off={t.off}><b class="hh-s" style={`background-image:url(/hero/t${t.img}.webp)`}></b><b class="hh-b" style={`background-image:url(/hero/t${t.img}-b.webp)`}></b></u>
        ))}
      </div>
      <p class="hf-rise relative z-10 text-[clamp(.8rem,1vw,.95rem)] uppercase tracking-[0.3em]" style="--d:.1s"><span class="font-light">HUMAN</span> <span class="font-semibold">CORP</span></p>
      <h1 class="hf-rise relative z-10 mt-5 text-[clamp(2.7rem,7.4vw,6.4rem)] font-semibold leading-[0.96] tracking-[-0.045em] [text-shadow:0_2px_40px_rgba(10,8,60,.35)]" style="--d:.25s">
        <span class="sr-only">HumanCorp: </span>Todo conectado.<span class="block text-white/55">Bajo un solo estándar.</span>
      </h1>
      <p class="hf-rise relative z-10 mt-6 max-w-[22rem] text-[clamp(1rem,1.25vw,1.25rem)] leading-[1.5] text-white/90 text-balance" style="--d:.45s">Todo lo que hace funcionar a una empresa, bajo un mismo estándar.</p>
      <div class="hf-rise relative z-10 mt-8 flex flex-wrap justify-center gap-3" style="--d:.62s">
        <a href="/servicios" class="rounded-full bg-white px-8 py-3.5 text-[15px] font-medium text-[#0b0c0f] shadow-[0_18px_40px_-14px_rgba(10,8,60,.7)] transition-transform hover:scale-[1.03]">Conocer servicios</a>
        <a href="/arma-tu-proyecto" class="rounded-full border border-white/45 bg-white/10 px-8 py-3.5 text-[15px] transition-colors hover:bg-white/20">Arma tu proyecto</a>
      </div>
      <div class="hf-rise absolute inset-x-0 bottom-[3.5%] z-10 flex flex-col items-center gap-2 text-[11px] uppercase tracking-[0.2em] text-white/70" style="--d:1s" aria-hidden="true">
        <span>Desliza</span>
        <i class="block h-7 w-px origin-top bg-white/70" style="animation:scrollLine 2s ease-in-out 1.4s 3 both"></i>
      </div>
    </div>
  </section>
</div>

<script>
  import { onFrame, put, clamp, smooth } from '../scripts/frame';
  const stage = document.querySelector<HTMLElement>('[data-hero]')!;
  const bg = document.querySelector<HTMLElement>('[data-hero-bg]')!;
  const glow = document.querySelector<HTMLElement>('[data-hero-glow]')!;
  const text = document.querySelector<HTMLElement>('[data-hero-text]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const field = document.querySelector<HTMLElement>('.hh-field')!;
  const tl = [...field.querySelectorAll<HTMLElement>('.hh-t')].map((el, k, all) => ({ el, sh: el.firstElementChild as HTMLElement, bl: el.lastElementChild as HTMLElement, a0: (+el.dataset.a! * Math.PI) / 180, off: +el.dataset.off!, ph: k / all.length }));
  let W = 160, R1 = 600, vw0 = 0;
  const fit = () => { const w = stage.clientWidth, h = stage.clientHeight; vw0 = w; W = Math.max(90, Math.min(190, Math.min(w, h) * 0.22)); R1 = Math.hypot(w, h) * 0.62; tl.forEach((t) => { t.el.style.width = t.el.style.height = `${W}px`; t.el.style.margin = `${-W / 2}px 0 0 ${-W / 2}px`; }); };
  fit(); addEventListener('resize', fit);
  const T = 32, TURNS = 1.1;
  const paintTiles = (sec: number) => {
    tl.forEach((t) => {
      const p = reduced ? (0.25 + t.ph * 0.7) : ((sec / T + t.ph) % 1);
      const th = t.a0 - 2 * Math.PI * TURNS * p;                // antihorario
      const r = R1 * p;
      const e = smooth(p);
      const sc = 0.2 + 0.95 * e;
      const sharp = smooth(clamp((p - 0.1) / 0.42));
      const life = clamp(p / 0.08) * (1 - clamp((p - 0.94) / 0.06));
      put(t.el, 'transform', `translate3d(${(Math.cos(th) * r).toFixed(1)}px,${(Math.sin(th) * r).toFixed(1)}px,0) rotate(${((th * 180) / Math.PI - 90 + t.off).toFixed(1)}deg) scale(${sc.toFixed(3)})`);
      put(t.el, 'opacity', (life * (0.35 + 0.65 * sharp)).toFixed(3));
      put(t.sh, 'opacity', sharp.toFixed(3));
      put(t.bl, 'opacity', (1 - sharp).toFixed(3));
    });
  };
  paintTiles(0);
  onFrame((t, y, vh) => {
    const p = clamp(y / (vh * 0.85));
    const gone = p >= 1;
    put(stage, 'visibility', gone ? 'hidden' : 'visible');
    if (gone) return;
    // scroll-driven dissolve into the horizon (opacity / transform only: compositor work)
    put(bg, 'opacity', (1 - smooth(clamp((p - 0.12) / 0.78))).toFixed(3));
    put(bg, 'transform', `scale(${(1 + p * 0.06).toFixed(4)})`);
    put(glow, 'opacity', (smooth(clamp(p / 0.45)) * (1 - smooth(clamp((p - 0.55) / 0.45)))).toFixed(3));
    put(glow, 'transform', `scaleY(${(0.5 + p * 0.9).toFixed(3)})`);
    put(text, 'opacity', (1 - smooth(clamp(p / 0.55))).toFixed(3));
    put(text, 'transform', `translate3d(0, ${(-p * vh * 0.12).toFixed(1)}px, 0) scale(${(1 + p * 0.05).toFixed(4)})`);
    if (!reduced) paintTiles(t / 1000);
  });
</script>
