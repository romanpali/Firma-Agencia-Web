---
import { divisions } from '../data/servicios';
const names = divisions.map((d) => d.short);
// Celular: emisor en espiral. Cada mosaico nace pequeño y borroso en el centro y sale girando (antihorario) hasta los bordes, ganando tamaño y nitidez.
const N = 24, ARMS = 3;
// Tres brazos de una misma espiral: cada mosaico pertenece a un brazo y recorre la curva de adentro hacia afuera.
const tiles = Array.from({ length: N }, (_, k) => ({ k, arm: k % ARMS, idx: Math.floor(k / ARMS), img: k + 1, off: [-10, 6, -4, 12, -8, 5, -12, 9, -2, 10][k % 10] }));
---

<div data-hero-wrap data-tone="dark" class="relative z-10 h-[190svh] max-md:h-[200svh]">
  <section data-hero class="sticky top-0 h-lvh min-h-[600px] overflow-hidden text-white">
    <div data-hero-bg class="absolute inset-0 bg-[#05070f] md:bg-[#08090c] will-change-[opacity,transform]">
      <div class="absolute inset-3 hidden overflow-hidden rounded-3xl bg-[#1f4cb8] md:block">
        <canvas id="hero-canvas" class="absolute inset-0 size-full" aria-hidden="true"></canvas>
        <div class="pointer-events-none absolute inset-0 bg-black/20"></div>
        <div class="pointer-events-none absolute inset-x-0 top-0 h-[12%] bg-gradient-to-b from-black/70 to-transparent"></div>
      </div>
      <div class="pointer-events-none absolute inset-x-0 top-0 h-[12%] bg-gradient-to-b from-black/90 to-transparent md:hidden"></div>
      <div class="pointer-events-none absolute inset-0 md:hidden" style="background:linear-gradient(to bottom,transparent 60%,rgba(2,8,36,.5))"></div>
    </div>

    <div data-hero-text class="absolute inset-0 will-change-[opacity,transform]">
      <!-- escritorio: palabra gigante abajo a la izquierda, texto y botón a la derecha -->
      <div class="hd hidden md:block">
        <h1 class="hd-wm" aria-label="HumanCorp">
          <span class="block overflow-hidden"><span class="hf-up block" style="--d:.25s"><span class="hd-l">Human</span><span class="hd-b">Corp</span><sup>*</sup></span></span>
        </h1>
        <div class="hd-rt">
          <p class="hf-rise" style="--d:.55s">Todo lo que hace funcionar a una empresa, conectado bajo un solo estándar. Diseño, tecnología y operaciones empresariales para que tu empresa funcione con claridad.</p>
          <div class="hf-rise hd-cta" style="--d:.7s"><a class="hd-p" href="/servicios">Conocer servicios<i><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"/></svg></i></a><a class="hd-s" href="/arma-tu-proyecto">Arma tu proyecto</a></div>
        </div>
      </div>
      <!-- celular: tablero inclinado de proyectos que se desliza despacio, nombre al centro -->
      <div class="hm md:hidden">
        <div class="hs" aria-hidden="true"><div class="hs-b"><div class="hs-c c0"><div class="hs-s"><img src="/hero/s-marea.webp" alt="" decoding="async" /><img src="/hero/s-c1.webp" alt="" decoding="async" /><img src="/hero/s-fuji.webp" alt="" decoding="async" /><img src="/hero/s-hikari.webp" alt="" decoding="async" /><img src="/hero/s-r1.webp" alt="" decoding="async" /><img src="/hero/s-marea.webp" alt="" decoding="async" /><img src="/hero/s-c1.webp" alt="" decoding="async" /><img src="/hero/s-fuji.webp" alt="" decoding="async" /><img src="/hero/s-hikari.webp" alt="" decoding="async" /><img src="/hero/s-r1.webp" alt="" decoding="async" /></div></div><div class="hs-c c1"><div class="hs-s"><img src="/hero/s-trama.webp" alt="" decoding="async" /><img src="/hero/s-ret.webp" alt="" decoding="async" /><img src="/hero/s-des.webp" alt="" decoding="async" /><img src="/hero/s-arq1.webp" alt="" decoding="async" /><img src="/hero/s-abaco.webp" alt="" decoding="async" /><img src="/hero/s-trama.webp" alt="" decoding="async" /><img src="/hero/s-ret.webp" alt="" decoding="async" /><img src="/hero/s-des.webp" alt="" decoding="async" /><img src="/hero/s-arq1.webp" alt="" decoding="async" /><img src="/hero/s-abaco.webp" alt="" decoding="async" /></div></div><div class="hs-c c2"><div class="hs-s"><img src="/hero/s-r2.webp" alt="" decoding="async" /><img src="/hero/s-c2.webp" alt="" decoding="async" /><img src="/hero/s-valle.webp" alt="" decoding="async" /><img src="/hero/s-r3.webp" alt="" decoding="async" /><img src="/hero/s-r2.webp" alt="" decoding="async" /><img src="/hero/s-c2.webp" alt="" decoding="async" /><img src="/hero/s-valle.webp" alt="" decoding="async" /><img src="/hero/s-r3.webp" alt="" decoding="async" /></div></div></div></div>
        <i class="hm-sh" aria-hidden="true"></i>
        <div class="hs-mid">
          <h1 class="hs-h"><span class="sr-only">HumanCorp: Todo conectado. Bajo un solo estándar.</span>
            <span class="block overflow-hidden pb-[0.08em]" aria-hidden="true"><span class="hf-up block" style="--d:.3s"><span class="hs-l">Human</span><span class="hs-b2">Corp</span></span></span>
          </h1>
          <p class="hs-t hf-rise" style="--d:.55s" aria-hidden="true">Todo conectado. Bajo un solo estándar.</p>
        </div>
        <div class="hs-bot">
          <div class="hm-cta hf-rise" style="--d:.75s"><a class="p" href="/servicios">Conocer servicios</a><a class="s" href="/arma-tu-proyecto">Arma tu proyecto</a></div>
          <p class="hs-f hf-rise" style="--d:.9s">Diseño, tecnología y operaciones empresariales, organizadas para que tu empresa funcione con claridad.</p>
        </div>
      </div>
    </div>
  </section>
</div>


<style is:global>
  @media (max-width: 767px) {
    .hm { padding: 0; justify-content: flex-start; }
    .hs { position: absolute; inset: 0; overflow: hidden; background: #05070d; animation: hsIn 1.4s ease 0.2s both; }
    @keyframes hsIn { from { opacity: 0; } to { opacity: 1; } }
    .hs-b { position: absolute; left: -28vw; top: -12%; width: 156vw; height: 124%; display: flex; gap: 3.4vw; transform: rotate(-9deg); }
    .hs-c { flex: 1; min-width: 0; overflow: hidden; }
    .hs-s { display: flex; flex-direction: column; gap: 3.4vw; animation: hsUp 70s linear infinite; }
    .hs-c.c1 .hs-s { animation-name: hsDn; animation-duration: 84s; } .hs-c.c2 .hs-s { animation-duration: 76s; }
    .hs-s img { display: block; width: 100%; height: auto; max-width: none; border-radius: 3.4vw; flex: none; }
    @keyframes hsUp { to { transform: translate3d(0, -50%, 0); } } @keyframes hsDn { from { transform: translate3d(0, -50%, 0); } to { transform: translate3d(0, 0, 0); } }
    .hm-sh { background: radial-gradient(70% 22% at 50% 44%, rgba(3, 5, 12, 0.72), transparent 100%), linear-gradient(180deg, rgba(3, 5, 12, 0.55), rgba(3, 5, 12, 0.1) 24%, rgba(3, 5, 12, 0.25) 52%, rgba(3, 5, 12, 0.88) 74%, #03050c) !important; }
    .hs-mid { position: absolute; left: 0; right: 0; top: 40%; z-index: 3; text-align: center; padding: 0 24px; }
    .hs-h { font-size: clamp(3.1rem, 17vw, 4.6rem); line-height: 1; letter-spacing: -0.055em; color: #fff; } .hs-l { font-weight: 300; } .hs-b2 { font-weight: 700; }
    .hs-t { margin-top: 12px; font-size: 15px; font-weight: 500; letter-spacing: -0.01em; color: rgba(255, 255, 255, 0.88); }
    .hs-bot { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; padding: 0 24px calc(34px + env(safe-area-inset-bottom)); text-align: center; }
    .hs-bot .hm-cta { justify-content: center; margin-top: 0; }
    .hs-f { max-width: 21rem; margin: 20px auto 0; font-size: 13px; line-height: 1.5; color: rgba(255, 255, 255, 0.62); }
    @media (prefers-reduced-motion: reduce) { .hs-s { animation: none; } .hs { animation: none; } }
  }
</style>

<style is:global>
  @media (min-width: 768px) {
    .hd-fr { position: absolute; inset: 12px; border-radius: 24px; overflow: hidden; background: #0b0a08; }
    .hd-bg { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; object-position: 50% 74%; animation: hdK 34s ease-in-out infinite alternate; }
    @keyframes hdK { from { transform: scale(1.04); } to { transform: scale(1.14) translate3d(-1.2%, -1.2%, 0); } }
    .hd-sh { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8, 7, 6, 0.72), rgba(8, 7, 6, 0) 24%), linear-gradient(0deg, rgba(8, 7, 6, 0.86), rgba(8, 7, 6, 0) 52%), radial-gradient(120% 90% at 50% 50%, transparent 55%, rgba(0, 0, 0, 0.4)); }
    .hd-gr { position: absolute; inset: 0; opacity: 0.16; }
    .hd-pt { position: absolute; top: var(--t); width: 3px; height: 3px; border-radius: 50%; background: #ffd9a0; opacity: 0; animation: hdPt var(--s) linear infinite; animation-delay: var(--d); }
    @keyframes hdPt { 0% { transform: translate3d(0, 0, 0); opacity: 0; } 15% { opacity: 0.75; } 85% { opacity: 0.5; } 100% { transform: translate3d(7vw, -16vh, 0); opacity: 0; } }
    .hd { position: absolute; inset: 0; pointer-events: none; }
    .hd-wm { position: absolute; left: 3.6vw; bottom: 5.5vh; font-size: min(13.4vw, 26vh * 1.9); line-height: 0.88; letter-spacing: -0.06em; color: #efe8d8; white-space: nowrap; }
    .hd-wm .hf-up { padding-bottom: 0.06em; } .hd-l { font-weight: 300; } .hd-b { font-weight: 600; }
    .hd-wm sup { position: relative; top: 0.02em; vertical-align: top; margin-left: 0.04em; font-size: 0.34em; font-weight: 400; letter-spacing: 0; }
    .hd-rt { position: absolute; right: 4.2vw; bottom: 7vh; width: min(23vw, 350px); pointer-events: auto; }
    .hd-rt p { font-size: clamp(12px, 0.95vw, 14.5px); line-height: 1.45; color: rgba(239, 232, 216, 0.82); }
    .hd-cta { display: flex; align-items: center; gap: 18px; margin-top: 22px; }
    .hd-p { display: inline-flex; align-items: center; gap: 12px; height: 46px; padding: 0 6px 0 20px; border-radius: 99px; background: #efe8d8; color: #14110d; font-size: 14.5px; font-weight: 500; text-decoration: none; white-space: nowrap; transition: transform 0.3s; }
    .hd-p i { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #14110d; color: #efe8d8; } .hd-p:hover { transform: scale(1.03); }
    .hd-s { font-size: 14px; color: rgba(239, 232, 216, 0.85); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(239, 232, 216, 0.35); white-space: nowrap; } .hd-s:hover { color: #fff; }
    @media (prefers-reduced-motion: reduce) { .hd-bg, .hd-pt { animation: none; } }
  }
</style>

<script>
  import { onFrame, put, clamp, smooth } from '../scripts/frame';
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const stage = document.querySelector<HTMLElement>('[data-hero]')!;
  const bg = document.querySelector<HTMLElement>('[data-hero-bg]')!;
  const text = document.querySelector<HTMLElement>('[data-hero-text]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const field = document.querySelector<HTMLElement>('.hh-field') ?? document.createElement('div');
  const tl = [...field.querySelectorAll<HTMLElement>('.hh-t')].map((el, k, all) => ({ el, sh: el.firstElementChild as HTMLElement, bl: el.lastElementChild as HTMLElement, a0: (+el.dataset.arm! * 2 * Math.PI) / 3, off: +el.dataset.off!, ph: +el.dataset.idx! / (all.length / 3) }));
  let W = 160, R1 = 600, vw0 = 0;
  const fit = () => { const w = stage.clientWidth, h = stage.clientHeight; vw0 = w; W = Math.max(90, Math.min(190, Math.min(w, h) * 0.22)); R1 = Math.hypot(w, h) * 0.62; tl.forEach((t) => { t.el.style.width = t.el.style.height = `${W}px`; t.el.style.margin = `${-W / 2}px 0 0 ${-W / 2}px`; }); };
  fit(); addEventListener('resize', fit);
  const T = 44, TURNS = 1.15;
  const paintTiles = (sec: number) => {
    tl.forEach((t) => {
      const p = reduced ? (0.25 + t.ph * 0.7) : ((sec / T + t.ph) % 1);
      const th = t.a0 - 2 * Math.PI * TURNS * p;                // antihorario
      const r = R1 * (0.09 + 0.91 * p);
      const e = smooth(p);
      const sc = 0.2 + 0.95 * e;
      const sharp = smooth(clamp((p - 0.1) / 0.42));
      const life = clamp(p / 0.08) * (1 - clamp((p - 0.94) / 0.06));
      put(t.el, 'transform', `translate3d(${(Math.cos(th) * r).toFixed(1)}px,${(Math.sin(th) * r).toFixed(1)}px,0) rotate(${((th * 180) / Math.PI - 90 + t.off).toFixed(1)}deg) scale(${sc.toFixed(3)})`);
      put(t.el, 'opacity', (life * (0.35 + 0.65 * sharp)).toFixed(3));
      put(t.sh, 'opacity', sharp.toFixed(3));
      put(t.bl, 'opacity', (1 - sharp).toFixed(3));
    });
  };
  paintTiles(0);
  const mobile = !matchMedia('(min-width: 768px)').matches;
  const ptr = { x: 0, y: 0, tx: 0, ty: 0 };
  addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') { ptr.tx = e.clientX / innerWidth - 0.5; ptr.ty = 0.5 - e.clientY / innerHeight; } }, { passive: true });
  const VS = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
  const FS = `#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
uniform vec2 res;
uniform float t;
uniform vec2 m;

float hash(vec2 p){ return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }

void main(){
  vec2 uv = gl_FragCoord.xy / res.y;
  vec2 p = uv * 1.7 + m * .3;
  float a = t * .3;
  for (int i = 1; i < 5; i++) {
    float k = float(i);
    p += .42 / (k * k) * vec2(sin(k * 1.7 * p.y + a + k), sin(k * 1.5 * p.x - a * .8 + k * 1.7)) * 2.1;
  }
  float f = .5 + .5 * sin(p.x * 2.4 + p.y * 1.3 + a * .4);

  vec3 purple = vec3(.43, .35, .66);
  vec3 deep   = vec3(.10, .28, .70);
  vec3 light  = vec3(.23, .39, .79);
  vec3 blue = mix(light, deep, smoothstep(.5, .85, f));
  vec3 col = mix(purple, blue, smoothstep(.26, .56, f));
  col += vec3(.04, .06, .13) * exp(-pow((f - .46) * 9., 2.));
  col += (hash(gl_FragCoord.xy + t) - .5) / 128.;
  gl_FragColor = vec4(col, 1.);
}`;

  // The silk is a slow, soft gradient: render it small (about 0.7 MP) and at ~40 fps; the scroll motion stays at full refresh rate.
  let draw: ((t: number) => void) | null = null;
  const gl = mobile ? null : canvas.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'high-performance' });
  if (gl) {
    const sh = (type: number, src: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s); return s; };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, VS));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FS));
    gl.linkProgram(prog);
    if (gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      gl.useProgram(prog);
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      const uRes = gl.getUniformLocation(prog, 'res');
      const uT = gl.getUniformLocation(prog, 't');
      const uM = gl.getUniformLocation(prog, 'm');
      draw = (t: number) => { ptr.x += (ptr.tx - ptr.x) * 0.06; ptr.y += (ptr.ty - ptr.y) * 0.06; gl.uniform2f(uM, ptr.x, ptr.y); gl.uniform1f(uT, t); gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4); };
      const fit = () => {
        const w = canvas.clientWidth, h = canvas.clientHeight;
        const k = Math.min(1, Math.sqrt(0.4e6 / Math.max(1, w * h)));
        canvas.width = Math.max(1, Math.round(w * k));
        canvas.height = Math.max(1, Math.round(h * k));
        gl.viewport(0, 0, canvas.width, canvas.height);
        gl.uniform2f(uRes, canvas.width, canvas.height);
        draw!(4);
      };
      fit();
      addEventListener('resize', fit);
    }
  }

  let last = -1e9;
  onFrame((t, y, vh) => {
    const p = clamp(y / (vh * 0.85));
    const gone = p >= 1;
    put(stage, 'visibility', gone ? 'hidden' : 'visible');
    if (gone) return;
    // scroll-driven dissolve into the horizon (opacity / transform only: compositor work)
    put(bg, 'opacity', (1 - smooth(clamp((p - 0.12) / 0.78))).toFixed(3));
    put(bg, 'transform', `scale(${(1 + p * 0.06).toFixed(4)})`);
    put(text, 'opacity', (1 - smooth(clamp(p / 0.55))).toFixed(3));
    put(text, 'transform', `translate3d(0, ${(-p * vh * 0.12).toFixed(1)}px, 0) scale(${(1 + p * 0.05).toFixed(4)})`);
    if (draw && !reduced && t - last > 24) { last = t; draw(t / 1000); }
  });
</script>
