---
import Scene from './Scene.astro';
import { areas } from '../data/areas';
---

<section data-hero class="relative h-[180svh] bg-[#0b0c0f]">
  <div class="sticky top-0 h-svh overflow-hidden">
    <div class="absolute inset-0" style="background:linear-gradient(to bottom,#d79d84 0%,#a87b6e 16%,#5b4a52 34%,#22212a 56%,#0d0e12 78%,#08090c 100%)"></div>
    <i class="absolute left-1/2 top-[-18%] h-[60%] w-[70%] -translate-x-1/2 rounded-[50%] bg-[#ffd8b8]/45 blur-[90px]"></i>
    <i class="grain pointer-events-none absolute inset-0"></i>

    <div data-hero-copy class="absolute inset-x-0 top-[13svh] z-10 px-6 text-center will-change-transform">
      <h1 data-words class="mx-auto max-w-[19ch] text-[clamp(2.1rem,4.7vw,5.2rem)] font-light leading-[1.02] tracking-[-0.045em] text-white text-balance">
        Todo lo que hace funcionar a una empresa, conectado bajo un solo estándar.
      </h1>
      <p class="hf-rise mx-auto mt-6 max-w-[27rem] text-[13.5px] leading-relaxed text-white/75" style="--d:1s">
        HumanCorp diseña, desarrolla y conecta los sistemas de tu empresa, paso a paso, hasta que funcionen como uno solo.
      </p>
    </div>

    <!-- Ring of the eight areas -->
    <div data-ring-wrap class="pointer-events-none absolute left-1/2 top-0 z-0 h-0 w-0" style="perspective:2200px">
      <div data-ring style="transform-style:preserve-3d">
        <i class="absolute left-1/2 top-[120px] h-[560px] w-[1200px] -translate-x-1/2 rounded-[50%] bg-black/40 blur-[50px]"></i>
        <div data-spin style="transform-style:preserve-3d">
          {areas.map((a, i) => (
            <figure class="pn" style={`--i:${i}`}>
              <Scene kind={a.scene} lite />
            </figure>
          ))}
        </div>
      </div>
    </div>

    <div class="hf-fade pointer-events-none absolute bottom-6 left-1/2 z-10 -translate-x-1/2 text-[11px] uppercase tracking-[0.3em] text-white/45" style="--d:1.6s">Desliza</div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const wrap = hero.querySelector<HTMLElement>('[data-ring-wrap]')!;
  const ring = hero.querySelector<HTMLElement>('[data-ring]')!;
  const spin = hero.querySelector<HTMLElement>('[data-spin]')!;
  const copy = hero.querySelector<HTMLElement>('[data-hero-copy]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const ease = (t: number) => t * t * (3 - 2 * t);
  const ptr = { x: 0 }, tgt = { x: 0 };
  addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') tgt.x = e.clientX / innerWidth - 0.5; });

  let ry = 0, last = performance.now();
  const frame = (now: number) => {
    const dt = Math.min(0.05, (now - last) / 1000); last = now;
    const H = innerHeight, W = innerWidth;
    const p = clamp(scrollY / Math.max(1, hero.offsetHeight - H));
    const e = ease(p);
    ptr.x += (tgt.x - ptr.x) * 0.05;
    if (!reduced) ry += dt * 5;
    const k = W < 768 ? 0.5 : W < 1100 ? 0.78 : 1;
    const y = (0.9 - 0.4 * e) * H; // rises from the lower edge towards the centre
    wrap.style.transform = `translate3d(0, ${y.toFixed(1)}px, 0) scale(${((0.96 + 0.1 * e) * k).toFixed(3)})`;
    ring.style.transform = `rotateX(${(19 - 6 * e).toFixed(2)}deg)`;
    spin.style.transform = `rotateY(${(ry + scrollY * 0.07 + ptr.x * 14).toFixed(2)}deg)`;
    copy.style.transform = `translate3d(0, ${(-e * 90).toFixed(1)}px, 0)`;
    copy.style.opacity = String(1 - clamp(e * 1.5));
    if (!document.hidden) requestAnimationFrame(frame);
  };
  requestAnimationFrame(frame);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) { last = performance.now(); requestAnimationFrame(frame); } });
</script>
