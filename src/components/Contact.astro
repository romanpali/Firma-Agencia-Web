---
const links = [['Servicios', '/servicios'], ['Paquetes', '/paquetes'], ['Arma tu proyecto', '/arma-tu-proyecto'], ['Contable y fiscal', '/asesoria-contable-y-fiscal'], ['Diagnóstico', '/diagnostico'], ['Nosotros', '/nosotros'], ['Recursos', '/recursos'], ['Contacto', '/contacto'], ['Términos de uso', '/terminos'], ['Privacidad', '/privacidad']];
const flags = ['🇲🇽', '🇺🇸', '🇨🇦', '🇪🇸', '🇫🇷', '🇩🇪', '🇮🇹'];
const social = [
  ['Instagram', 'M4 4h16v16H4zM12 8.5a3.5 3.5 0 1 0 0.01 0M16.6 7.4h.01', 'https://instagram.com'],
  ['TikTok', 'M14 4v10a3 3 0 1 1-3-3M14 4c0 3 2 4 5 4', 'https://tiktok.com'],
  ['X', 'M5 5l14 14M19 5L5 19', 'https://x.com'],
  ['LinkedIn', 'M5 9v10M5 5v1M10 19V9M10 13c0-5 9-5 9 0v6', 'https://linkedin.com'],
];
---

<section id="contacto" data-tone="dark" class="relative z-10 overflow-hidden text-white">
  <canvas data-silk class="absolute inset-0 size-full" aria-hidden="true"></canvas>
  <i class="pointer-events-none absolute inset-0 bg-black/25"></i>
  <i class="pointer-events-none absolute inset-x-0 top-0 h-[26svh]" style="background:linear-gradient(to bottom,#00033D,rgba(0,3,61,0))"></i>
  <i class="pointer-events-none absolute inset-0" style="background:linear-gradient(to bottom,transparent 55%,rgba(2,8,36,.65))"></i>

  <div class="relative mx-auto flex min-h-svh max-w-[1280px] flex-col px-6 pb-20 pt-[16svh] md:px-10 md:pb-16">
    <div class="grid gap-12 md:grid-cols-12 md:gap-8">
      <h2 class="text-[clamp(3.6rem,7.6vw,8rem)] font-semibold leading-[0.92] tracking-[-0.055em] md:col-span-5" aria-label="Let's build meaning work">
        <span class="block overflow-hidden pb-[0.14em] -mb-[0.06em]"><span data-reveal class="block" style="--i:0">Let’s</span></span>
        <span class="block overflow-hidden pb-[0.14em] -mb-[0.06em]"><span data-reveal class="block" style="--i:1">build</span></span>
        <span class="block overflow-hidden pb-[0.14em] -mb-[0.06em]"><span data-reveal class="block" style="--i:2">meaning</span></span>
        <span class="swap relative block overflow-hidden pb-[0.14em]" aria-hidden="true">
          <span class="swap-a block">together</span>
          <span class="swap-b absolute left-0 top-0 block">work</span>
        </span>
      </h2>

      <div data-reveal class="md:col-span-4 md:col-start-6 md:pt-[6svh]">
        <i class="mb-5 flex size-[44px] items-center justify-center rounded-full border border-white/40"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-11.2A7 7 0 0 0 5 9.8C5 14.8 12 21 12 21z"/><circle cx="12" cy="10" r="2.4"/></svg></i>
        <h3 class="text-[clamp(1.6rem,2.4vw,2.2rem)] font-normal tracking-[-0.03em]">Mérida</h3>
        <p class="mt-3 text-[15px] leading-relaxed text-white/70">Mérida, Yucatán, México</p>
        <a href="tel:+529991234567" class="mt-4 block text-[15px] text-white/85 hover:text-white">+52 999 123 4567</a>
      </div>

      <div data-reveal style="--i:1" class="md:col-span-2 md:col-start-11 md:pt-[6svh]">
        <nav class="flex flex-col gap-3.5 text-[14px] font-semibold uppercase tracking-[-0.01em]" aria-label="Pie">
          {links.map(([t, h]) => <a href={h} class="w-fit transition-opacity hover:opacity-60">{t}</a>)}
        </nav>
        <p class="mt-6 flex flex-wrap gap-2.5 text-[22px]" aria-label="Idiomas y países">{flags.map((f) => <span>{f}</span>)}</p>
      </div>
    </div>

    <div class="mt-auto grid items-end gap-10 pt-[12svh] md:grid-cols-3 md:gap-8">
      <div data-reveal>
        <p class="text-[12px] font-semibold uppercase tracking-[0.04em] text-white/85">Contáctanos</p>
        <a href="mailto:info@humancorp.co" class="mt-2 inline-block text-[clamp(1.5rem,2.2vw,2rem)] font-light tracking-[-0.03em] underline decoration-white/35 underline-offset-[0.14em] transition-[decoration-color] hover:decoration-white">info@humancorp.co</a>
      </div>
      <div data-reveal style="--i:1" class="flex gap-2.5 md:justify-center">
        {social.map(([n, d, h]) => (
          <a href={h} target="_blank" rel="noopener" aria-label={n} class="flex size-[42px] items-center justify-center rounded-full border border-white/45 transition-colors hover:bg-white hover:text-[#1f4cb8]"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d} /></svg></a>
        ))}
      </div>
      <p data-reveal style="--i:2" class="flex flex-col gap-1 text-[13px] text-white/75 md:items-end md:text-right"><a href="/privacidad" class="font-medium text-white hover:opacity-70">Privacidad y cookies</a><span>© 2026 Todos los derechos reservados. HumanCorp</span></p>
    </div>
  </div>
</section>

<script>
  import { onFrame } from '../scripts/frame';
  import { mountSilk } from '../scripts/silk';
  const sec = document.getElementById('contacto')!;
  const cv = sec.querySelector<HTMLCanvasElement>('[data-silk]')!;
  let vis = false;
  new IntersectionObserver((e) => { vis = e[0].isIntersecting; }, { rootMargin: '20% 0px' }).observe(sec);
  const draw = mountSilk(cv, () => vis, matchMedia('(prefers-reduced-motion: reduce)').matches);
  if (draw) onFrame((t) => draw(t));
</script>
