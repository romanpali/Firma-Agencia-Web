---
const links = [['Servicios', '/servicios'], ['Nosotros', '/nosotros'], ['Cómo trabajamos', '#como-trabajamos'], ['Preguntas', '#faq'], ['Contacto', '/contacto'], ['Términos de uso', '/terminos'], ['Privacidad', '/privacidad']];
const flags = ['🇲🇽', '🇺🇸', '🇨🇦', '🇪🇸', '🇫🇷', '🇩🇪', '🇮🇹'];
const social = [
  ['Instagram', 'M4 4h16v16H4zM12 8.5a3.5 3.5 0 1 0 0.01 0M16.6 7.4h.01', 'https://instagram.com'],
  ['TikTok', 'M14 4v10a3 3 0 1 1-3-3M14 4c0 3 2 4 5 4', 'https://tiktok.com'],
  ['X', 'M5 5l14 14M19 5L5 19', 'https://x.com'],
  ['LinkedIn', 'M5 9v10M5 5v1M10 19V9M10 13c0-5 9-5 9 0v6', 'https://linkedin.com'],
];
---

<section id="contacto" data-tone="dark" class="relative z-10 overflow-hidden text-white">
  <canvas data-silk class="absolute inset-0 size-full" aria-hidden="true"></canvas>
  <i class="pointer-events-none absolute inset-0 bg-black/25"></i>
  <i class="pointer-events-none absolute inset-x-0 top-0 h-[26svh]" style="background:linear-gradient(to bottom,rgba(5,6,15,.9),transparent)"></i>
  <i class="pointer-events-none absolute inset-0" style="background:linear-gradient(to bottom,transparent 55%,rgba(2,8,36,.65))"></i>

  <div class="relative mx-auto flex min-h-svh max-w-[1280px] flex-col px-6 pb-8 pt-[18svh] md:px-10">
    <h2 class="text-[clamp(3.4rem,10.5vw,10.5rem)] font-semibold leading-[0.92] tracking-[-0.055em]" aria-label="Let's build meaning work">
      <span class="block overflow-hidden pb-[0.14em] -mb-[0.06em]"><span data-reveal class="block" style="--i:0">Let’s</span></span>
      <span class="block overflow-hidden pb-[0.14em] -mb-[0.06em]"><span data-reveal class="block" style="--i:1">build</span></span>
      <span class="block overflow-hidden pb-[0.14em] -mb-[0.06em]"><span data-reveal class="block" style="--i:2">meaning</span></span>
      <span class="swap relative block overflow-hidden pb-[0.14em]" aria-hidden="true">
        <span class="swap-a block">together</span>
        <span class="swap-b absolute left-0 top-0 block">work</span>
      </span>
    </h2>

    <div class="mt-[12svh] grid gap-12 md:grid-cols-12 md:gap-8">
      <div data-reveal class="md:col-span-4">
        <i class="mb-5 flex size-[44px] items-center justify-center rounded-full border border-white/40"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-11.2A7 7 0 0 0 5 9.8C5 14.8 12 21 12 21z"/><circle cx="12" cy="10" r="2.4"/></svg></i>
        <h3 class="text-[clamp(1.6rem,2.4vw,2.2rem)] font-normal tracking-[-0.03em]">Mérida</h3>
        <p class="mt-3 text-[15px] leading-relaxed text-white/70">Mérida, Yucatán, México</p>
        <a href="tel:+529991234567" class="mt-5 block text-[15px] text-white/85 hover:text-white">+52 999 123 4567</a>
      </div>
      <div data-reveal style="--i:1" class="md:col-span-8">
        <nav class="flex flex-wrap gap-x-8 gap-y-3 text-[clamp(1rem,1.5vw,1.35rem)] font-light uppercase tracking-[-0.01em]" aria-label="Pie">
          {links.map(([t, h]) => <a href={h} class="transition-opacity hover:opacity-60">{t}</a>)}
        </nav>
        <p class="mt-6 flex flex-wrap gap-3 text-[26px]" aria-label="Idiomas y países">{flags.map((f) => <span>{f}</span>)}</p>
      </div>
    </div>

    <div data-reveal class="mt-[10svh]">
      <p class="text-[13px] uppercase tracking-[0.12em] text-white/75">Contáctanos</p>
      <a href="mailto:info@humancorp.co" class="mt-3 inline-block text-[clamp(1.8rem,4.6vw,4.4rem)] font-light tracking-[-0.04em] underline decoration-white/35 underline-offset-[0.14em] transition-[decoration-color] hover:decoration-white">info@humancorp.co</a>
      <div class="mt-8 flex gap-3">
        {social.map(([n, d, h]) => (
          <a href={h} target="_blank" rel="noopener" aria-label={n} class="flex size-[46px] items-center justify-center rounded-full border border-white/45 transition-colors hover:bg-white hover:text-[#1f4cb8]"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d} /></svg></a>
        ))}
      </div>
    </div>

    <p class="mt-[9svh] flex flex-wrap items-center justify-between gap-3 text-[13px] text-white/75"><span>© 2026 Todos los derechos reservados. HumanCorp</span><a href="/privacidad" class="hover:text-white">Privacidad y cookies</a></p>
  </div>

  <div class="pointer-events-none sticky bottom-6 z-20 flex justify-center pb-6">
    <a href="mailto:info@humancorp.co?subject=Agendar%20llamada" class="pointer-events-auto rounded-full bg-white px-8 py-4 text-[16px] font-medium text-[#0b0c0f] shadow-[0_14px_40px_-12px_rgba(0,0,0,.5)] transition-transform hover:scale-[1.04] active:scale-[0.98]">Agendar una llamada</a>
  </div>
</section>

<script>
  import { onFrame } from '../scripts/frame';
  import { mountSilk } from '../scripts/silk';
  const sec = document.getElementById('contacto')!;
  const cv = sec.querySelector<HTMLCanvasElement>('[data-silk]')!;
  let vis = false;
  new IntersectionObserver((e) => { vis = e[0].isIntersecting; }, { rootMargin: '20% 0px' }).observe(sec);
  const draw = mountSilk(cv, () => vis, matchMedia('(prefers-reduced-motion: reduce)').matches);
  if (draw) onFrame((t) => draw(t));
</script>
