---
const W = '#ffffff';
const principles = [
  { title: 'Integración', text: 'Conectar herramientas, departamentos, procesos e información.',
    art: `<svg viewBox="0 0 120 120" class="size-full" fill="none" stroke="${W}" stroke-width="1" aria-hidden="true"><path d="M24 92L60 28L96 92Z"/><path d="M60 28V66M24 92L60 66M96 92L60 66" stroke-opacity=".5"/>${[[24, 92], [60, 28], [96, 92]].map(([x, y]) => `<rect x="${x - 7}" y="${y - 7}" width="14" height="14" fill="#1a1d25"/>`).join('')}<circle cx="60" cy="66" r="4" fill="${W}"/><circle r="2.6" fill="${W}" stroke="none"><animateMotion dur="3.2s" repeatCount="indefinite" path="M24 92L60 28L96 92L24 92"/></circle></svg>` },
  { title: 'Diseño', text: 'Construir experiencias, identidades y productos digitales profesionales.',
    art: `<svg viewBox="0 0 120 120" class="size-full" fill="none" stroke="${W}" stroke-width="1" aria-hidden="true"><g class="pg-spin"><rect x="26" y="26" width="52" height="52"/><circle cx="78" cy="78" r="26"/></g></svg>` },
  { title: 'Automatización', text: 'Reducir tareas repetitivas y mejorar los flujos de trabajo.',
    art: `<svg viewBox="0 0 120 120" class="size-full" fill="none" stroke="${W}" stroke-width="1" aria-hidden="true"><circle cx="60" cy="60" r="34" stroke-opacity=".3"/><g class="pg-spin-fast"><circle cx="60" cy="60" r="34" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="52 170"/></g><path d="M48 60l9 9 16-18" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="mv-check" pathLength="1"/></svg>` },
  { title: 'Inteligencia', text: 'Convertir información empresarial en indicadores y conocimiento útil.',
    art: `<svg viewBox="0 0 120 120" class="size-full" aria-hidden="true">${[0, 1, 2, 3, 4].map((i) => `<rect class="pg-grow" x="${22 + i * 18}" y="${92 - [18, 30, 42, 54, 68][i]}" width="10" height="${[18, 30, 42, 54, 68][i]}" fill="${W}" style="animation-delay:${i * 0.3}s"/>`).join('')}<path d="M16 96H104" stroke="${W}" stroke-width="1"/></svg>` },
  { title: 'Optimización', text: 'Mejorar progresivamente cómo una empresa trabaja, administra y crece.',
    art: `<svg viewBox="0 0 120 120" class="size-full" fill="none" stroke="${W}" aria-hidden="true">${[40, 29, 18].map((r, i) => `<g class="${['pg-spin', 'pg-spin-back', 'pg-spin-fast'][i]}"><circle cx="60" cy="60" r="${r}" stroke-width="1.2" stroke-linecap="round" stroke-dasharray="${[110, 70, 44][i]} 400"/></g>`).join('')}<circle cx="60" cy="60" r="2.5" fill="${W}"/></svg>` },
];
---

<section class="relative z-10">
  <div class="mx-auto max-w-[1280px] px-6 py-[16svh] md:px-10">
    <div class="grid gap-6 md:grid-cols-12 md:items-end">
      <h2 data-words class="max-w-[14ch] text-[clamp(2.2rem,4.6vw,4.6rem)] font-light leading-[1.03] tracking-[-0.045em] md:col-span-7">Lo que guía cada proyecto</h2>
      <p data-reveal style="--i:1" class="text-[15.5px] leading-relaxed text-white/70 md:col-span-4 md:col-start-9">Cinco principios que se repiten en todo lo que hacemos, sin importar el área.</p>
    </div>
    <ul class="mt-16 grid grid-cols-2 gap-x-6 gap-y-14 lg:grid-cols-5">
      {principles.map((p, i) => (
        <li data-reveal style={`--i:${i}`} class="group">
          <div class="size-[92px] transition-transform duration-700 ease-out group-hover:scale-110 group-hover:rotate-[-6deg]" set:html={p.art} />
          <p class="mt-8 text-[13px] tabular-nums text-white/45">0{i + 1}</p>
          <h3 class="mt-2 text-[1.4rem] font-normal tracking-[-0.02em]">{p.title}</h3>
          <p class="mt-2 text-[14.5px] leading-relaxed text-white/65">{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
