---
const principles = [
  { title: 'Integración', text: 'Conectar herramientas, departamentos, procesos e información.',
    art: `<svg viewBox="0 0 120 120" class="size-full" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M24 92L60 28L96 92Z"/><path d="M60 28V66M24 92L60 66M96 92L60 66" stroke-opacity=".5"/>${[[24, 92], [60, 28], [96, 92]].map(([x, y]) => `<rect x="${x - 7}" y="${y - 7}" width="14" height="14" fill="#e9e7e2" class="plate-fill"/>`).join('')}<circle cx="60" cy="66" r="4" fill="currentColor"/><circle r="2.6" fill="currentColor" stroke="none"><animateMotion dur="3.2s" repeatCount="indefinite" path="M24 92L60 28L96 92L24 92"/></circle></svg>` },
  { title: 'Diseño', text: 'Construir experiencias, identidades y productos digitales profesionales.',
    art: `<svg viewBox="0 0 120 120" class="size-full" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><g class="pg-spin"><rect x="26" y="26" width="52" height="52"/><circle cx="78" cy="78" r="26"/></g></svg>` },
  { title: 'Automatización', text: 'Reducir tareas repetitivas y mejorar los flujos de trabajo.',
    art: `<svg viewBox="0 0 120 120" class="size-full" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><circle cx="60" cy="60" r="34" stroke-opacity=".3"/><g class="pg-spin-fast"><circle cx="60" cy="60" r="34" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="52 170"/></g><path d="M48 60l9 9 16-18" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="mv-check" pathLength="1"/></svg>` },
  { title: 'Inteligencia', text: 'Convertir información empresarial en indicadores y conocimiento útil.',
    art: `<svg viewBox="0 0 120 120" class="size-full" aria-hidden="true">${[0, 1, 2, 3, 4].map((i) => `<rect class="pg-grow" x="${22 + i * 18}" y="${92 - [18, 30, 42, 54, 68][i]}" width="10" height="${[18, 30, 42, 54, 68][i]}" fill="currentColor" style="animation-delay:${i * 0.3}s"/>`).join('')}<path d="M16 96H104" stroke="currentColor" stroke-width="1"/></svg>` },
  { title: 'Optimización', text: 'Mejorar progresivamente cómo una empresa trabaja, administra y crece.',
    art: `<svg viewBox="0 0 120 120" class="size-full" fill="none" stroke="currentColor" aria-hidden="true">${[40, 29, 18].map((r, i) => `<g class="${['pg-spin', 'pg-spin-back', 'pg-spin-fast'][i]}"><circle cx="60" cy="60" r="${r}" stroke-width="1.2" stroke-linecap="round" stroke-dasharray="${[110, 70, 44][i]} 400"/></g>`).join('')}<circle cx="60" cy="60" r="2.5" fill="currentColor"/></svg>` },
];
---

<section data-tone="light" class="relative z-10 rounded-t-[2rem] bg-[#f5f4f1] text-[#0b0b0c] shadow-[0_-30px_60px_rgba(0,0,0,0.5)]">
  <div class="mx-auto max-w-[1280px] px-6 pb-20 pt-20 md:px-10 md:pb-32 md:pt-32">
    <div class="grid gap-8 md:grid-cols-12 md:items-start">
      <h2 data-words class="max-w-[17ch] text-[clamp(2.4rem,5.2vw,5rem)] font-light leading-[1.02] tracking-[-0.045em] md:col-span-7">
        Una sola firma para diseñar, conectar y operar tu empresa
      </h2>
      <p data-reveal style="--i:1" class="pt-3 text-[16.5px] leading-relaxed text-[#5d6064] md:col-span-4 md:col-start-9">
        HumanCorp reúne diseño, desarrollo digital, marketing, inteligencia artificial, automatización y gestión en una
        estructura coherente. Trabajamos sobre cómo se presenta, vende, opera y decide tu empresa, y conectamos cada parte
        con tecnología.
      </p>
    </div>

    <ul class="mt-20 grid grid-cols-2 gap-x-4 gap-y-12 md:mt-28 lg:grid-cols-5 lg:gap-x-6">
      {principles.map((p, i) => (
        <li data-reveal style={`--i:${i}`} class="group">
          <div class="relative aspect-[4/5] overflow-hidden bg-[#e9e7e2] text-[#0b0b0c] transition-colors duration-700 group-hover:bg-[#0b0b0c] group-hover:text-[#f5f4f1]">
            <span class="absolute left-4 top-4 text-[13px] tabular-nums">0{i + 1}</span>
            <div class="absolute inset-x-[18%] top-1/2 aspect-square -translate-y-[46%] transition-transform duration-700 ease-out group-hover:scale-[1.08]" set:html={p.art} />
          </div>
          <h3 class="mt-5 text-[1.3rem] font-normal tracking-[-0.02em]">{p.title}</h3>
          <p class="mt-2 text-[14.5px] leading-relaxed text-[#5d6064]">{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
