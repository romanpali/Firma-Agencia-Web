---
const INK = '#17140f';
const principles = [
  {
    title: 'Integración', text: 'Conectar herramientas, departamentos, procesos e información.', bg: '#ff6fae', off: '',
    art: `<svg viewBox="0 0 120 96" class="size-full" aria-hidden="true"><g stroke="${INK}" stroke-width="1.6" fill="none"><path d="M22 72L60 24L98 72Z"/><path d="M60 24V54M22 72L60 54M98 72L60 54"/></g><circle cx="60" cy="54" r="9" fill="${INK}"/><circle cx="60" cy="54" r="15" fill="none" stroke="${INK}" stroke-opacity=".4" class="pg-breath"/>${[[22, 72], [60, 24], [98, 72]].map(([x, y]) => `<circle cx="${x}" cy="${y}" r="6.5" fill="#fff" stroke="${INK}" stroke-width="1.6"/>`).join('')}<circle r="3" fill="#fff" stroke="${INK}"><animateMotion dur="2.6s" repeatCount="indefinite" path="M22 72L60 24L98 72L22 72"/></circle></svg>`,
  },
  {
    title: 'Diseño', text: 'Construir experiencias, identidades y productos digitales profesionales.', bg: '#ffd23f', off: 'md:mt-12',
    art: `<svg viewBox="0 0 120 96" class="size-full" aria-hidden="true"><g class="pg-spin" style="transform-origin:60px 48px"><circle cx="60" cy="34" r="22" fill="#fff" fill-opacity=".8" stroke="${INK}" stroke-width="1.6"/><circle cx="48" cy="58" r="22" fill="#ff6fae" fill-opacity=".85" stroke="${INK}" stroke-width="1.6"/><circle cx="72" cy="58" r="22" fill="#6fd0ff" fill-opacity=".85" stroke="${INK}" stroke-width="1.6"/></g></svg>`,
  },
  {
    title: 'Automatización', text: 'Reducir tareas repetitivas y mejorar los flujos de trabajo.', bg: '#6fd0ff', off: '',
    art: `<svg viewBox="0 0 120 96" class="size-full" aria-hidden="true"><circle cx="60" cy="48" r="30" fill="none" stroke="${INK}" stroke-opacity=".25" stroke-width="2"/><g class="pg-spin-fast"><circle cx="60" cy="48" r="30" fill="none" stroke="${INK}" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="44 150"/></g><g class="pg-spin-back"><circle cx="60" cy="48" r="19" fill="none" stroke="${INK}" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="24 98"/></g><path d="M52 48l6 6 11-12" fill="none" stroke="${INK}" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" class="mv-check" pathLength="1"/></svg>`,
  },
  {
    title: 'Inteligencia', text: 'Convertir información empresarial en indicadores y conocimiento útil.', bg: '#7fe3b5', off: 'md:mt-12',
    art: `<svg viewBox="0 0 120 96" class="size-full" aria-hidden="true">${[0, 1, 2, 3, 4].map((i) => `<rect class="pg-grow" x="${18 + i * 20}" y="${70 - [26, 40, 32, 54, 44][i]}" width="13" height="${[26, 40, 32, 54, 44][i]}" rx="4" fill="${i === 3 ? '#fff' : INK}" stroke="${INK}" stroke-width="1.5" style="animation-delay:${i * 0.35}s"/>`).join('')}<path d="M14 74H106" stroke="${INK}" stroke-width="1.5"/></svg>`,
  },
  {
    title: 'Optimización', text: 'Mejorar progresivamente cómo una empresa trabaja, administra y crece.', bg: '#ff8a5b', off: '',
    art: `<svg viewBox="0 0 120 96" class="size-full" aria-hidden="true">${[34, 25, 16].map((r, i) => `<g class="${['pg-spin', 'pg-spin-back', 'pg-spin-fast'][i]}"><circle cx="60" cy="48" r="${r}" fill="none" stroke="${INK}" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="${[78, 54, 36][i]} 400"/></g>`).join('')}<circle cx="60" cy="48" r="4.5" fill="${INK}"/></svg>`,
  },
];
---

<section data-tone="dark" class="relative z-10 overflow-hidden rounded-t-[2rem] bg-paper text-ink shadow-[0_-30px_60px_rgba(0,0,0,0.5)]">
  <i class="pointer-events-none absolute -left-24 top-24 size-[360px] rounded-full bg-[#ff8a5b] opacity-[0.12] blur-[120px]" aria-hidden="true"></i>
  <i class="pointer-events-none absolute -right-24 bottom-10 size-[420px] rounded-full bg-[#6fd0ff] opacity-[0.12] blur-[130px]" aria-hidden="true"></i>
  <div class="relative mx-auto max-w-[1280px] px-6 pb-20 pt-20 md:px-10 md:pb-32 md:pt-28">
    <div class="grid gap-8 md:grid-cols-12 md:items-start">
      <h2 data-words class="max-w-[17ch] text-[clamp(2.4rem,4.8vw,4.4rem)] font-medium leading-[1.02] tracking-[-0.035em] md:col-span-7">
        Una sola firma para <em>diseñar</em>, <em>conectar</em> y <em>operar</em> tu empresa
      </h2>
      <p data-reveal style="--i:1" class="pt-2 text-[16.5px] leading-relaxed text-mute md:col-span-4 md:col-start-9">
        HumanCorp reúne diseño, desarrollo digital, marketing, inteligencia artificial, automatización y gestión en una
        estructura coherente. Trabajamos sobre cómo se presenta, vende, opera y decide tu empresa, y conectamos cada parte
        con tecnología.
      </p>
    </div>

    <ul class="mt-16 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-5 md:mt-24">
      {principles.map((p, i) => (
        <li data-reveal style={`--i:${i}`} class={`group ${p.off}`}>
          <div class="blob mx-auto grid aspect-square w-full max-w-[190px] place-items-center p-7 transition-transform duration-500 group-hover:rotate-[-4deg] group-hover:scale-[1.05]" style={`background:${p.bg};animation-delay:-${i * 3}s`} set:html={p.art} />
          <h3 class="mt-6 text-center text-[1.35rem] font-medium tracking-tight lg:text-left">{p.title}</h3>
          <p class="mt-2 text-center text-[14.5px] leading-relaxed text-mute lg:text-left">{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
