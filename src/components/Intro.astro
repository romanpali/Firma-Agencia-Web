---
const principles = [
  {
    title: 'Integración',
    text: 'Conectar herramientas, departamentos, procesos e información.',
    art: `<svg viewBox="0 0 120 96" class="size-full" aria-hidden="true"><g stroke="#a9c4ff" stroke-opacity=".5" fill="none"><path d="M22 72L60 24L98 72Z"/><path d="M60 24V54M22 72L60 54M98 72L60 54"/></g><circle cx="60" cy="54" r="9" fill="#7c4dff"/><circle cx="60" cy="54" r="15" fill="none" stroke="#cdb8ff" stroke-opacity=".5" class="pg-breath"/>${[[22, 72], [60, 24], [98, 72]].map(([x, y]) => `<circle cx="${x}" cy="${y}" r="6" fill="#0d0a26" stroke="#a9c4ff" stroke-width="1.5"/>`).join('')}<circle r="2.6" fill="#fff"><animateMotion dur="2.6s" repeatCount="indefinite" path="M22 72L60 24L98 72L22 72"/></circle><circle r="2.2" fill="#cdb8ff"><animateMotion dur="2s" repeatCount="indefinite" path="M60 24L60 54L22 72"/></circle></svg>`,
  },
  {
    title: 'Diseño',
    text: 'Construir experiencias, identidades y productos digitales profesionales.',
    art: `<svg viewBox="0 0 120 96" class="size-full" aria-hidden="true"><g class="pg-spin" style="transform-origin:60px 48px"><circle cx="60" cy="34" r="22" fill="#7c4dff" fill-opacity=".75"/><circle cx="48" cy="58" r="22" fill="#ff7fb5" fill-opacity=".7" style="mix-blend-mode:screen"/><circle cx="72" cy="58" r="22" fill="#a9c4ff" fill-opacity=".7" style="mix-blend-mode:screen"/></g><rect x="52" y="40" width="16" height="16" rx="4" fill="none" stroke="#fff" stroke-width="1.5" class="pg-spin-back"/></svg>`,
  },
  {
    title: 'Automatización',
    text: 'Reducir tareas repetitivas y mejorar los flujos de trabajo.',
    art: `<svg viewBox="0 0 120 96" class="size-full" aria-hidden="true"><circle cx="60" cy="48" r="30" fill="none" stroke="#ffffff22" stroke-width="2"/><g class="pg-spin-fast"><circle cx="60" cy="48" r="30" fill="none" stroke="#cdb8ff" stroke-width="3" stroke-linecap="round" stroke-dasharray="40 150"/></g><g class="pg-spin-back"><circle cx="60" cy="48" r="19" fill="none" stroke="#a9c4ff" stroke-width="2" stroke-linecap="round" stroke-dasharray="22 98"/></g><path d="M52 48l6 6 11-12" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="mv-check" pathLength="1"/></svg>`,
  },
  {
    title: 'Inteligencia',
    text: 'Convertir información empresarial en indicadores y conocimiento útil.',
    art: `<svg viewBox="0 0 120 96" class="size-full" aria-hidden="true">${[0, 1, 2, 3, 4].map((i) => `<rect class="pg-grow" x="${18 + i * 20}" y="${66 - [26, 40, 32, 54, 44][i]}" width="12" height="${[26, 40, 32, 54, 44][i]}" rx="3" fill="${i === 3 ? '#cdb8ff' : '#7c4dff'}" style="animation-delay:${i * 0.35}s"/>`).join('')}<path d="M24 44L44 30L64 38L84 14L104 26" fill="none" stroke="#a9c4ff" stroke-width="1.6" stroke-dasharray="3 4"/><path d="M14 72H106" stroke="#ffffff30"/></svg>`,
  },
  {
    title: 'Optimización',
    text: 'Mejorar progresivamente cómo una empresa trabaja, administra y crece.',
    art: `<svg viewBox="0 0 120 96" class="size-full" aria-hidden="true">${[34, 25, 16].map((r, i) => `<g class="${['pg-spin', 'pg-spin-back', 'pg-spin-fast'][i]}"><circle cx="60" cy="48" r="${r}" fill="none" stroke="${['#7c4dff', '#a9c4ff', '#cdb8ff'][i]}" stroke-width="3" stroke-linecap="round" stroke-dasharray="${[70, 50, 34][i]} 400"/></g>`).join('')}<circle cx="60" cy="48" r="4" fill="#fff"/></svg>`,
  },
];
---

<section data-tone="dark" class="relative z-10 rounded-t-[2rem] bg-paper text-ink shadow-[0_-30px_60px_rgba(0,0,0,0.5)]">
  <div class="mx-auto max-w-[1280px] px-6 pb-16 pt-20 md:px-10 md:pb-24 md:pt-28">
    <div class="grid gap-8 md:grid-cols-12 md:items-start">
      <h2 data-words class="max-w-[18ch] text-[clamp(2.25rem,4.4vw,4rem)] font-medium leading-[1.04] tracking-[-0.035em] md:col-span-7">
        Una sola firma para diseñar, conectar y operar tu empresa
      </h2>
      <p data-reveal style="--i:1" class="pt-2 text-[16px] leading-relaxed text-mute md:col-span-4 md:col-start-9">
        HumanCorp reúne diseño, desarrollo digital, marketing, inteligencia artificial, automatización y gestión en una
        estructura coherente. Trabajamos sobre cómo se presenta, vende, opera y decide tu empresa, y conectamos cada parte
        con tecnología.
      </p>
    </div>

    <ul class="mt-16 grid gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-5 md:mt-20">
      {principles.map((p, i) => (
        <li data-reveal style={`--i:${i}`} class="group relative bg-paper p-6 transition-colors duration-500 hover:bg-[#0e0824]">
          <div class="h-24 transition-transform duration-500 group-hover:scale-105" set:html={p.art} />
          <span class="mt-5 block font-mono text-[12px] tabular-nums text-[#a9c4ff]">0{i + 1}</span>
          <h3 class="mt-2 text-xl font-medium tracking-tight">{p.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-mute">{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
