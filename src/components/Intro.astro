---
const INK = '#17191c';
const AMB = '#c9772a';
const principles = [
  { title: 'Integración', text: 'Conectar herramientas, departamentos, procesos e información.',
    art: `<svg viewBox="0 0 120 96" class="size-full" aria-hidden="true"><g stroke="${INK}" stroke-width="1.4" fill="none"><path d="M22 72L60 24L98 72Z"/><path d="M60 24V54M22 72L60 54M98 72L60 54"/></g><circle cx="60" cy="54" r="5" fill="${INK}"/>${[[22, 72], [60, 24], [98, 72]].map(([x, y]) => `<rect x="${x - 6}" y="${y - 6}" width="12" height="12" fill="#ecebe7" stroke="${INK}" stroke-width="1.4"/>`).join('')}<circle r="3" fill="${AMB}"><animateMotion dur="2.8s" repeatCount="indefinite" path="M22 72L60 24L98 72L22 72"/></circle></svg>` },
  { title: 'Diseño', text: 'Construir experiencias, identidades y productos digitales profesionales.',
    art: `<svg viewBox="0 0 120 96" class="size-full" aria-hidden="true"><g class="pg-spin" style="transform-origin:60px 48px" fill="none" stroke="${INK}" stroke-width="1.4"><rect x="30" y="20" width="44" height="44"/><rect x="46" y="32" width="44" height="44"/></g><rect x="52" y="44" width="16" height="16" fill="${AMB}" fill-opacity=".9"/></svg>` },
  { title: 'Automatización', text: 'Reducir tareas repetitivas y mejorar los flujos de trabajo.',
    art: `<svg viewBox="0 0 120 96" class="size-full" aria-hidden="true"><circle cx="60" cy="48" r="30" fill="none" stroke="${INK}" stroke-opacity=".18" stroke-width="1.4"/><g class="pg-spin-fast"><circle cx="60" cy="48" r="30" fill="none" stroke="${INK}" stroke-width="2" stroke-linecap="round" stroke-dasharray="48 150"/></g><path d="M52 48l6 6 11-12" fill="none" stroke="${AMB}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="mv-check" pathLength="1"/></svg>` },
  { title: 'Inteligencia', text: 'Convertir información empresarial en indicadores y conocimiento útil.',
    art: `<svg viewBox="0 0 120 96" class="size-full" aria-hidden="true">${[0, 1, 2, 3, 4].map((i) => `<rect class="pg-grow" x="${18 + i * 20}" y="${70 - [20, 32, 44, 56, 68][i]}" width="12" height="${[20, 32, 44, 56, 68][i]}" fill="${i === 4 ? AMB : INK}" style="animation-delay:${i * 0.3}s"/>`).join('')}<path d="M12 74H108" stroke="${INK}" stroke-width="1.4"/></svg>` },
  { title: 'Optimización', text: 'Mejorar progresivamente cómo una empresa trabaja, administra y crece.',
    art: `<svg viewBox="0 0 120 96" class="size-full" aria-hidden="true">${[34, 25, 16].map((r, i) => `<g class="${['pg-spin', 'pg-spin-back', 'pg-spin-fast'][i]}"><circle cx="60" cy="48" r="${r}" fill="none" stroke="${i === 2 ? AMB : INK}" stroke-width="1.8" stroke-linecap="round" stroke-dasharray="${[88, 60, 40][i]} 400"/></g>`).join('')}<circle cx="60" cy="48" r="3" fill="${INK}"/></svg>` },
];
---

<section data-tone="light" class="relative z-10 rounded-t-[2rem] bg-[#ecebe7] text-[#17191c] shadow-[0_-30px_60px_rgba(0,0,0,0.45)]">
  <div class="mx-auto max-w-[1280px] px-6 pb-20 pt-20 md:px-10 md:pb-32 md:pt-32">
    <div class="grid gap-8 md:grid-cols-12 md:items-start">
      <h2 data-words class="max-w-[17ch] text-[clamp(2.4rem,5.2vw,5rem)] font-light leading-[1.02] tracking-[-0.045em] md:col-span-7">
        Una sola firma para diseñar, conectar y operar tu empresa
      </h2>
      <p data-reveal style="--i:1" class="pt-3 text-[16.5px] leading-relaxed text-[#5d6166] md:col-span-4 md:col-start-9">
        HumanCorp reúne diseño, desarrollo digital, marketing, inteligencia artificial, automatización y gestión en una
        estructura coherente. Trabajamos sobre cómo se presenta, vende, opera y decide tu empresa, y conectamos cada parte
        con tecnología.
      </p>
    </div>

    <ul class="mt-20 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-5 md:mt-28">
      {principles.map((p, i) => (
        <li data-reveal style={`--i:${i}`} class="group border-t border-black/20 pt-6">
          <div class="flex items-start justify-between">
            <span class="text-[13px] tabular-nums text-[#c9772a]">0{i + 1}</span>
            <div class="size-[84px] transition-transform duration-500 group-hover:scale-110" set:html={p.art} />
          </div>
          <h3 class="mt-10 text-[1.4rem] font-normal tracking-[-0.02em]">{p.title}</h3>
          <p class="mt-2 text-[14.5px] leading-relaxed text-[#5d6166]">{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
