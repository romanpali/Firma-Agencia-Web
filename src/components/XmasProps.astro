---
// Escena navideña (solo Obra, en temporada): objetos vistos desde arriba sobre la mesa. Las imágenes se piden solo si la temporada está activa.
const bulbs: [number, number][] = [[0.0804, 0.6684], [0.1089, 0.6401], [0.1262, 0.5251], [0.1592, 0.5036], [0.1989, 0.5876], [0.2308, 0.5894], [0.2615, 0.4889], [0.2959, 0.4738], [0.3286, 0.5721], [0.3616, 0.5964], [0.3994, 0.5078], [0.4353, 0.4899], [0.4659, 0.5907], [0.4995, 0.6287], [0.5384, 0.5444], [0.5743, 0.5149], [0.6069, 0.609], [0.642, 0.6518], [0.677, 0.5637], [0.7098, 0.5145], [0.7477, 0.5915], [0.7869, 0.6285], [0.8136, 0.531], [0.8389, 0.4568], [0.8844, 0.5028], [0.9305, 0.5196]];
---
<div class="bw-xm xm-garl" aria-hidden="true">
  <img data-xm-src="/obra/xm-guirnalda.webp" alt="" decoding="async" />
  {bulbs.map(([x, y], i) => <i style={`left:${(x * 100).toFixed(2)}%;top:${(y * 100).toFixed(2)}%;animation-delay:${((i * 0.37) % 2.6).toFixed(2)}s`}></i>)}
</div>
<div class="bw-xm xm-gift" aria-hidden="true">
  <i class="xg-sh"></i><i class="xg-s xg-n"></i><i class="xg-s xg-w"></i><i class="xg-s xg-e"></i><i class="xg-s xg-f"></i>
  <img class="xg-top" data-xm-src="/obra/xm-regalo.webp" alt="" decoding="async" />
</div>
