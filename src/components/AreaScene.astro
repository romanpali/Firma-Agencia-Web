    <div class="absolute inset-x-6 top-[284px]">
      {[['Video', [[0, 32, '#F6B370'], [34, 26, '#2F3A9E'], [62, 36, '#eccfa6']]], ['Motion', [[10, 22, '#977DFF'], [44, 30, '#F6B370']]], ['Audio', [[0, 98, '#e4dcd0']]]].map(([n, cl], r) => <div class="mb-1.5 flex items-center gap-3"><span class="w-11 text-[10px] text-[#8f8aa6]">{n}</span><div class="relative h-[18px] flex-1 rounded-[5px] bg-[#faf7f2]">{(cl as number[][]).map(([l, w, c], j) => <i class="gx absolute top-0 block h-full rounded-[5px]" style={`${T(0.1 + r * 0.1 + j * 0.07, 0.2)};left:${l}%;width:${w}%;background:${c}`}></i>)}</div></div>)}
      <i class="absolute -top-1 bottom-0 w-[2px] bg-[#14173f]" style="left:calc(56px + (100% - 56px) * (.06 + var(--q) * .84))"><b class="absolute -left-[4px] -top-1 block size-[10px] rounded-full bg-[#14173f]"></b></i>
