    <p class="rv absolute right-6 top-[296px] w-[170px] text-[11px] leading-snug text-[#5f5a7a]" style={T(0.75)}>Producto, equipo, instalaciones y retratos.</p>
  </>)}

  {k === 'd1f' && (<>
