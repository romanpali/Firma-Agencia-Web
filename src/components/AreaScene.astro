      {['Estudio Aurora', 'Casa Lumbre', 'Grupo Ceiba', 'Taller 33'].map((n, i) => <div class="rv mt-2 flex items-center gap-2.5 rounded-[10px] border border-[#efe9e1] px-3 py-2" style={T(0.3 + i * 0.07)}><i class="block size-6 rounded-full" style={dot(['#F6B370', '#2F3A9E', '#eccfa6', '#977DFF'][i])}></i><span class="flex-1 text-[11.5px]">{n}</span><span class="rounded-full bg-[#f5efe8] px-2.5 py-0.5 text-[9.5px] text-[#5f5a7a]">{['Activo', 'En revisión', 'Activo', 'Pendiente'][i]}</span></div>)}</div>
