    </div>
    <div class="absolute left-[270px] top-[56px] w-[346px]"><p class="rv text-[13px] font-medium" style={T(0.1)}>Sistema de diseño</p>
      <div class="mt-3 grid grid-cols-2 gap-2.5">
        <div class="rv rounded-[12px] border border-[#e9e2d8] p-3.5" style={T(0.18)}><p class="mb-2 text-[10px] text-[#8f8aa6]">Botones</p><span class="rounded-full bg-[#14173f] px-4 py-1.5 text-[10.5px] text-white">Principal</span> <span class="ml-1 rounded-full border border-[#14173f] px-4 py-1.5 text-[10.5px]">Secundario</span></div>
        <div class="rv rounded-[12px] border border-[#e9e2d8] p-3.5" style={T(0.26)}><p class="mb-2 text-[10px] text-[#8f8aa6]">Controles</p><i class="relative inline-block h-5 w-9 rounded-full bg-[#2F3A9E] align-middle"><b class="absolute right-0.5 top-0.5 block size-4 rounded-full bg-white"></b></i> <i class="ml-2 inline-block size-5 rounded-[6px] bg-[#F6B370] align-middle"></i></div>
        <div class="rv rounded-[12px] border border-[#e9e2d8] p-3.5" style={T(0.34)}><p class="mb-2 text-[10px] text-[#8f8aa6]">Tipografía</p><p class="text-[26px] font-light leading-none">Aa</p></div>
        <div class="rv rounded-[12px] border border-[#e9e2d8] p-3.5" style={T(0.42)}><p class="mb-2 text-[10px] text-[#8f8aa6]">Color</p><div class="flex gap-1.5">{['#14173f', '#2F3A9E', '#F6B370', '#eccfa6'].map((c) => <i class="block size-6 rounded-full" style={dot(c)}></i>)}</div></div>
      </div>
      <p class="rv mt-5 text-[11.5px] text-[#5f5a7a]" style={T(0.55)}>Wireframe → prototipo interactivo → microinteracciones</p>
      <svg class="absolute" style="left:calc(60px + var(--q) * 220px);top:calc(190px - var(--q) * 90px)" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3l14 8-6 2-3 6z" fill="#14173f" stroke="#fff" stroke-width="1.5"/></svg>
    </div>
  </>)}

  {k === 'd1g' && (<>
    <div class="rv absolute left-6 top-[56px] h-[300px] w-[190px] rounded-[14px] p-5" style={`${T(0.02, 0.16)};background:${G3}`}><p class="text-[10px] uppercase tracking-widest text-white/70">Concepto</p><p class="mt-2 text-[26px] font-medium leading-[1.02] tracking-[-0.03em] text-white">Hecho<br />para<br />crecer</p><span class="absolute bottom-5 left-5 rounded-full bg-white px-3 py-1 text-[10px] font-medium text-[#0600AB]">Conoce más</span></div>
    <div class="absolute left-[236px] top-[56px] flex flex-col gap-3">{[['A', G], ['B', G2]].map(([l, g], i) => <div class="rv relative h-[142px] w-[190px] rounded-[12px] p-3.5" style={`${T(0.14 + i * 0.1)};background:${g}`}><span class="absolute left-3 top-3 grid size-6 place-items-center rounded-full bg-white text-[11px] font-medium text-[#14173f]">{l}</span><i class="absolute bottom-3.5 left-3.5 block h-1.5 w-20 rounded bg-white/80"></i><i class="absolute bottom-8 left-3.5 block h-2.5 w-28 rounded bg-white"></i>{i === 1 && <span class="fl absolute right-3 top-3 rounded-full bg-[#2fbf8a] px-2.5 py-1 text-[9.5px] font-medium text-white" style={T(0.6, 0.1)}>Mejor resultado</span>}</div>)}</div>
    <div class="absolute right-6 top-[56px] w-[170px]"><p class="rv text-[11px] text-[#8f8aa6]" style={T(0.2)}>Canales</p>{['Meta Ads', 'Google Ads', 'Redes sociales', 'Video'].map((t, i) => <div class="rv mt-2 rounded-[10px] border border-[#e9e2d8] px-3 py-2.5 text-[11.5px]" style={T(0.26 + i * 0.07)}>{t}</div>)}
      <p class="rv mt-4 text-[11px] text-[#8f8aa6]" style={T(0.6)}>Lanzamiento · Promoción · Posicionamiento</p></div>
  </>)}

  {k === 'd1h' && (<>
    <div class="absolute left-6 top-[56px] w-[340px]"><p class="rv text-[10px] uppercase tracking-widest text-[#8f8aa6]" style={T(0.02)}>Borrador · Blog</p>
      <p class="mt-2 text-[24px] font-medium leading-[1.1] tracking-[-0.03em]"><span class="type block overflow-hidden whitespace-nowrap" style={T(0.05, 0.3)}>Una marca con voz propia</span></p>
      {[100, 92, 96, 70, 0, 98, 84, 60].map((w, i) => w ? <i class="gx mt-2.5 block h-2 rounded bg-[#14173f]/15" style={`${T(0.3 + i * 0.05, 0.12)};width:${w}%`}></i> : <i class="mt-4 block"></i>)}
