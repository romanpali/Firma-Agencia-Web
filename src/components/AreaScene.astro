    <div class="rv absolute right-6 top-[56px] w-[220px] rounded-[14px] border border-[#e9e2d8] p-3.5" style={T(0.2)}><p class="text-[10px] text-[#8f8aa6]">Newsletter</p><i class="mt-2 block h-[70px] rounded-[8px]" style={dot(G)}></i><p class="mt-2.5 text-[12px] font-medium">Novedades de octubre</p><i class="mt-1.5 block h-1.5 w-32 rounded bg-[#14173f]/20"></i></div>
    <div class="absolute right-6 top-[236px] w-[220px]"><p class="rv text-[11px] font-medium" style={T(0.5)}>Calendario editorial</p><div class="mt-2 grid grid-cols-7 gap-1">{row(21).map((i) => <i class="fl block h-[20px] rounded-[5px]" style={`${T(0.52 + (i % 7) * 0.03 + Math.floor(i / 7) * 0.05, 0.08)};background:${[1, 0, 1, 1, 0, 1, 0][i % 7] ? ['#F6B370', '#2F3A9E', '#eccfa6'][(i + Math.floor(i / 7)) % 3] : '#faf7f2'}`}></i>)}</div></div>
  </>)}

  {k === 'd2b' && (<>
    <div class="absolute left-6 top-[56px] grid w-[360px] grid-cols-2 gap-3">{[['Camisa lino', '$890', G], ['Bolso piel', '$1,450', G2], ['Tenis urbano', '$1,990', G3], ['Gorra', '$390', G]].map(([n, p, g], i) => <div class="rv rounded-[12px] border border-[#e9e2d8] p-2.5" style={T(0.04 + i * 0.07)}><i class="block h-[66px] rounded-[8px]" style={dot(g)}></i><p class="mt-2 flex justify-between text-[11.5px]"><span>{n}</span><span class="text-[#2F3A9E]">{p}</span></p></div>)}</div>
    <div class="rv absolute right-6 top-[56px] h-[230px] w-[218px] rounded-[14px] border border-[#e9e2d8] p-4" style={T(0.3)}><p class="text-[12.5px] font-medium">Tu carrito · 2</p>{[['Camisa lino', '$890'], ['Tenis urbano', '$1,990']].map(([t, p], i) => <p class="rv mt-3 flex justify-between text-[11.5px] text-[#5f5a7a]" style={T(0.38 + i * 0.08)}><span>{t}</span><span>{p}</span></p>)}<p class="mt-5 flex justify-between border-t border-[#e9e2d8] pt-3 text-[12.5px] font-medium"><span>Total</span><span class="text-[#2F3A9E]">$2,880</span></p><span class="fl absolute inset-x-4 bottom-4 rounded-full bg-[#14173f] py-2.5 text-center text-[11px] text-white" style={T(0.55, 0.1)}>Pagar ahora</span></div>
    <div class="absolute inset-x-6 top-[330px] flex items-center">{['Pedido', 'Pago', 'Envío', 'Entrega'].map((t, i) => <><div class="fl flex flex-col items-center gap-1.5" style={T(0.5 + i * 0.1, 0.1)}><i class="grid size-6 place-items-center rounded-full bg-[#14173f] text-[10px] text-white">✓</i><span class="text-[10px] text-[#5f5a7a]">{t}</span></div>{i < 3 && <i class="gx mb-4 block h-px flex-1 bg-[#F6B370]" style={T(0.55 + i * 0.1, 0.1)}></i>}</>)}</div>
  </>)}

