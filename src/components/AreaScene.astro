  </>)}

  {k === 'd1d' && (<>
    <div class="rv absolute left-6 top-[56px] h-[210px] w-[392px] overflow-hidden rounded-[14px]" style={`${T(0.02)};background:${G}`}><i class="absolute left-1/2 top-1/2 grid size-[54px] -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white/90"><svg width="18" height="18" viewBox="0 0 24 24" fill="#14173f" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></i><p class="absolute bottom-3 left-4 text-[12px] font-medium text-white">Video institucional</p><span class="absolute bottom-3 right-4 text-[10px] text-white/80">00:24 / 01:00</span></div>
