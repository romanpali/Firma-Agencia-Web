    <div class="absolute right-6 top-[56px] flex flex-col gap-2">{row(3).map((i) => <div class="rv size-[92px] rounded-[12px]" style={`${T(0.38 + i * 0.07)};background:${[G3, G2, G][i]}`}></div>)}</div>
  </>)}

  {k === 'd1c' && (<>
    <div class="rv absolute inset-x-6 top-[56px] h-[250px] overflow-hidden rounded-[16px]" style={T(0.02, 0.1)}>
      <svg class="absolute inset-0 size-full" viewBox="0 0 592 250" preserveAspectRatio="none" aria-hidden="true" style="filter:saturate(.3) brightness(.85) contrast(.9)"><rect width="592" height="250" fill="#9a97ad"/><circle cx="450" cy="70" r="30" fill="#d6d3df"/><path d="M0 170 L110 100 L220 160 L340 80 L470 160 L592 110 V250 H0Z" fill="#6f6d85"/><path d="M0 210 L140 160 L300 205 L440 170 L592 210 V250 H0Z" fill="#55546a"/></svg>
      <div class="absolute inset-0" style="clip-path:inset(0 calc(100% - (6% + var(--q) * 88%)) 0 0)"><svg class="size-full" viewBox="0 0 592 250" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="rtk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2F3A9E"/><stop offset=".6" stop-color="#F6B370"/><stop offset="1" stop-color="#ffd7a8"/></linearGradient></defs><rect width="592" height="250" fill="url(#rtk)"/><circle cx="450" cy="70" r="30" fill="#fff6e0"/><path d="M0 170 L110 100 L220 160 L340 80 L470 160 L592 110 V250 H0Z" fill="#b8682b"/><path d="M0 210 L140 160 L300 205 L440 170 L592 210 V250 H0Z" fill="#6b3a1f"/></svg></div>
      <i class="absolute inset-y-0 w-[2px] bg-white" style="left:calc(6% + var(--q) * 88%)"><b class="absolute left-1/2 top-1/2 grid size-8 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white text-[11px] text-[#14173f] shadow">⇆</b></i>
