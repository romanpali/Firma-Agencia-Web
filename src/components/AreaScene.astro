---
// Escenas animadas por área (640x400). Todo se mueve con --q (0→1), igual que los paneles de "Cómo lo construimos".
const { k, title } = Astro.props as { k: string; title: string };
const T = (a: number, b = 0.14) => `--a:${a};--b:${b}`;
const dot = (c: string) => `background:${c}`;
const G = 'linear-gradient(150deg,#F6B370,#2F3A9E 78%)';
const G2 = 'linear-gradient(160deg,#eccfa6,#F6B370 45%,#2F3A9E)';
const G3 = 'linear-gradient(160deg,#977DFF,#0033FF 70%,#0600AB)';
const row = (n: number) => Array.from({ length: n }, (_, i) => i);
---

<div class="pn" data-pn={k}>
  <span class="lb">{title}</span>

  {k === 'd1b' && (<>
    <div class="rv absolute left-6 top-[56px] h-[300px] w-[200px] rounded-[14px] p-5" style={`${T(0.02, 0.16)};background:${G}`}><p class="text-[11px] text-white/80">Gran apertura</p><p class="mt-2 text-[30px] font-medium leading-[1] tracking-[-0.03em] text-white">Un nuevo<br />horizonte</p><span class="absolute bottom-5 left-5 rounded-full bg-white px-3 py-1 text-[10px] font-medium text-[#14173f]">Reserva hoy</span></div>
