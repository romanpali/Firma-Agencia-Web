<div data-backdrop class="pointer-events-none fixed inset-0 z-0" aria-hidden="true">
  <div data-bd-img class="absolute inset-[-6%] bg-cover bg-center will-change-transform" style="background-image:url(/horizon.webp)"></div>
  <div data-bd-night class="absolute inset-0 opacity-0" style="background:linear-gradient(to bottom,rgba(9,11,20,.55),rgba(9,11,20,.92))"></div>
  <i class="grain absolute inset-0 opacity-[0.1]"></i>
</div>

<script>
  import { onFrame, measure, put, clamp } from '../scripts/frame';
  const bd = document.querySelector<HTMLElement>('[data-bd-img]')!;
  const night = document.querySelector<HTMLElement>('[data-bd-night]')!;
  const horizon = document.querySelector<HTMLElement>('[data-horizon]');
  const hz = horizon ? measure(horizon) : { top: 0, height: 0 };
  const page = measure(document.body);
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  onFrame((_t, y, vh) => {
    const doc = Math.max(1, page.height - vh);
    const hTop = hz.top, hEnd = hTop + hz.height - vh;
    // sunset while the horizon screen is pinned, then it sinks into night
    const k = hEnd * 0.7 + hTop * 0.3;
    const a = y < k ? 0 : clamp((y - k) / Math.max(1, hEnd * 0.3 - hTop * 0.3 + vh));
    const b = clamp((y - hEnd) / Math.max(1, doc - hEnd));
    put(night, 'opacity', Math.min(1, a * 0.55 + b * 0.45).toFixed(3));
    if (!reduced) {
      const g = clamp(y / doc);
      put(bd, 'transform', `translate3d(0, ${(-g * 5).toFixed(2)}%, 0) scale(${(1 + g * 0.06).toFixed(3)})`);
    }
  });
</script>
