                        <span class="min-w-0"><span class="block truncate text-[11.5px] text-[#14173f]">{t}</span><span class="block truncate text-[10px] text-[#8f8aa6]">{s}</span></span>
                      </div>
                    ))}
                  </div>
                </div>
              </>)}

              {i === 3 && (<>
                <div class="dash absolute inset-x-6 top-[16px] flex items-center justify-between pr-[78px]">
                  <div class="rv flex items-baseline gap-3" style="--a:.02;--b:.12"><p class="text-[15px] font-medium text-[#14173f]">Operaciones</p><span class="text-[11px] text-[#8f8aa6]">Semana 44</span></div>
                  <div class="rv flex rounded-full bg-[#f5efe8] p-[3px] text-[11px]" style="--a:.04;--b:.12">{['Día', 'Semana', 'Mes'].map((t, k) => <span class={`rounded-full px-3 py-[3px] ${k === 1 ? 'bg-[#14173f] text-white' : 'text-[#5f5a7a]'}`}>{t}</span>)}</div>
