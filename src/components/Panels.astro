                  <i class="vg absolute inset-0"></i>
                  <!-- the glass portal: soft light travelling over it -->
                  <div class="portal absolute" aria-hidden="true"><i class="portal-sheen absolute inset-0"></i></div>
                  <i class="absolute" style="left:42%;top:49%;width:2.8%;height:17%;backdrop-filter:blur(6px)" aria-hidden="true"></i>
