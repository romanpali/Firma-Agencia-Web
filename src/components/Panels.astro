                  <svg class="mt-1" width="340" height="132" viewBox="0 0 340 132" aria-hidden="true" style="overflow:visible">
                    <defs><linearGradient id="dgB" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F6B370" stop-opacity=".32"/><stop offset="1" stop-color="#F6B370" stop-opacity="0"/></linearGradient></defs>
                    {[30, 70].map((y) => <path d={`M0 ${y}H340`} stroke="#efe9e1"/>)}
