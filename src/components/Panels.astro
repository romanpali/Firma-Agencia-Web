                  <span class="rv absolute text-[10px] font-light tracking-[0.32em] text-white/90" style="--a:.46;--b:.2;left:42.9%;top:26%;writing-mode:vertical-rl">ALBA</span>
                  <span class="wm rv absolute left-[18px] top-[13px] text-[15px] font-light text-white" style="--a:.1;--b:.3">ALBA</span>
                  <div class="rv absolute inset-x-0 top-[9px] mx-auto flex w-fit gap-4 rounded-full border border-white/30 bg-white/10 px-4 py-[6px] text-[9.5px] text-white/95 backdrop-blur-sm" style="--a:.14;--b:.16"><span>Producto</span><span>Beneficios</span><span>Equipo</span><span>Precios</span><span>Soporte</span></div>
                  <div class="rv absolute right-4 top-[8px] flex gap-1.5 text-[9.5px]" style="--a:.18;--b:.16"><span class="rounded-full border border-white/35 px-3 py-[6px] text-white/95">Cuenta</span><span class="rounded-full bg-white px-3 py-[6px] font-medium text-[#1a1410]">Acceso demo</span></div>
                  <p class="rv absolute bottom-[138px] left-[16px] text-[9.5px] text-white" style="--a:.28;--b:.14"><i class="mr-2 inline-block size-[7px] bg-white align-middle"></i>Temporada de apertura 2026</p>
                  <h4 class="absolute bottom-[56px] left-[16px] text-[37px] font-normal leading-[1.04] tracking-[-0.02em] text-white [text-shadow:0_2px_24px_rgba(30,12,2,.4)]" aria-label="Un nuevo horizonte, cada mañana.">
                    <span class="block" aria-hidden="true"><span class="ch" style="--a:0.180;--b:.1">U</span><span class="ch" style="--a:0.192;--b:.1">n</span><span class="ch" style="--a:0.204;--b:.1">&nbsp;</span><span class="ch" style="--a:0.216;--b:.1">n</span><span class="ch" style="--a:0.228;--b:.1">u</span><span class="ch" style="--a:0.240;--b:.1">e</span><span class="ch" style="--a:0.252;--b:.1">v</span><span class="ch" style="--a:0.264;--b:.1">o</span><span class="ch" style="--a:0.276;--b:.1">&nbsp;</span><span class="ch" style="--a:0.288;--b:.1">h</span><span class="ch" style="--a:0.300;--b:.1">o</span><span class="ch" style="--a:0.312;--b:.1">r</span><span class="ch" style="--a:0.324;--b:.1">i</span><span class="ch" style="--a:0.336;--b:.1">z</span><span class="ch" style="--a:0.348;--b:.1">o</span><span class="ch" style="--a:0.360;--b:.1">n</span><span class="ch" style="--a:0.372;--b:.1">t</span><span class="ch" style="--a:0.384;--b:.1">e</span><span class="ch" style="--a:0.396;--b:.1">,</span></span>
                    <span class="block" aria-hidden="true"><span class="ch" style="--a:0.420;--b:.1">c</span><span class="ch" style="--a:0.432;--b:.1">a</span><span class="ch" style="--a:0.444;--b:.1">d</span><span class="ch" style="--a:0.456;--b:.1">a</span><span class="ch" style="--a:0.468;--b:.1">&nbsp;</span><span class="ch" style="--a:0.480;--b:.1">m</span><span class="ch" style="--a:0.492;--b:.1">a</span><span class="ch" style="--a:0.504;--b:.1">ñ</span><span class="ch" style="--a:0.516;--b:.1">a</span><span class="ch" style="--a:0.528;--b:.1">n</span><span class="ch" style="--a:0.540;--b:.1">a</span><span class="ch" style="--a:0.552;--b:.1">.</span></span>
                  </h4>
                  <div class="absolute bottom-[14px] left-[16px] flex gap-2.5 text-[10.5px]">
                    <span class="rv rounded-full bg-white px-[18px] py-[8px] font-medium text-[#1a1410]" style="--a:.62;--b:.14">Ver beneficios</span>
