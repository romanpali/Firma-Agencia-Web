---
interface Props { i: number }
const { i } = Astro.props;
const labels = ['Identidad', 'Sitio web', 'Finanzas', 'Datos', 'Asistentes', 'Marketing'];
const SB = [
  '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  '<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>',
  '<path d="M5 19L19 5"/><circle cx="7.5" cy="7.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/>',
  '<path d="M3 10l9-6 9 6M5 10v8M10 10v8M14 10v8M19 10v8M3 20h18"/>',
  '<path d="M5 20V10M12 20V4M19 20v-7"/>',
];
const ramp = (v: number) => (v < 0.25 ? '#f5efe8' : v < 0.5 ? '#eccfa6' : v < 0.78 ? '#F6B370' : '#2F3A9E');
const HM = Array.from({ length: 4 }, (_, r) => Array.from({ length: 24 }, (_, c) => ramp(Math.max(0, Math.min(1, 0.5 + 0.42 * Math.sin((c - 6 - r * 2.2) / 3.4) + 0.2 * Math.sin(c * 1.7 + r * 3.1) - (c < 3 || c > 21 ? 0.35 : 0))))));
---

<div class={`pn${i === 1 ? ' dk' : ''}`} data-pn={i}>
  <span class="lb">{labels[i]}</span>
  <span class="ok rv" style="--a:.9;--b:.08">Listo</span>

              {i === 0 && (<>
                <div class="absolute left-6 top-[60px] h-[316px] w-[220px] overflow-hidden rounded-[20px]" style="background:linear-gradient(180deg,#7E86B3 0%,#E8C4A6 36%,#F6B370 64%,#D6802D 100%)">
                  <i class="grain absolute inset-0 opacity-[.12]"></i>
                  <span class="rv absolute inset-x-0 top-[16px] text-center text-[11.5px] font-bold tracking-[0.2em] text-[#2A1F3D]" style="--a:.08;--b:.14">#7E86B3</span>
                  <i class="gy absolute left-1/2 top-[40px] block h-[30px] w-px bg-[#2A1F3D]/70" style="--a:.14;--b:.2;transform-origin:50% 0"></i>
                  <div class="absolute inset-x-0 bottom-[84px] top-[78px] flex items-center justify-center"><span class="rv text-[25px] font-extrabold leading-none tracking-[-0.01em] text-[#2A1F3D]" style="--a:.22;--b:.3;writing-mode:vertical-rl;rotate:180deg">Atardecer <i class="font-light not-italic">· ALBA</i></span></div>
