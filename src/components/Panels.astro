                </div>
                {[['#7E86B3', '7E86B3', '#fff'], ['#E8C4A6', 'E8C4A6', '#5a3a28'], ['#F6B370', 'F6B370', '#5a3a12'], ['#D6802D', 'D6802D', '#fff'], ['#5C422F', '5C422F', '#f0e2d6']].map(([c, h, t], k) => (
                  <i class="gy absolute top-[60px] flex h-[150px] w-[52px] items-end justify-center rounded-[14px] pb-2.5 text-[8.5px] font-bold not-italic tracking-wider" style={`left:${268 + k * 62}px;background:${c};color:${t};--a:${0.22 + k * 0.06};--b:.26`}><span class="rv" style={`--a:${0.5 + k * 0.05};--b:.12`}>{h}</span></i>
                ))}
                <div class="rv absolute left-[268px] top-[226px] flex h-[150px] w-[120px] flex-col items-center justify-center rounded-[18px] bg-[#f8efe6]" style="--a:.5;--b:.25"><span class="text-[78px] font-light leading-none tracking-[-0.04em] text-[#2A1F3D]">Aa</span><span class="mt-2 text-[10px] tracking-wide text-[#8a6f5e]">Light · Regular</span></div>
                <div class="rv absolute left-[404px] top-[246px] h-[96px] w-[150px] -rotate-[5deg] rounded-[14px] p-3.5" style="--a:.62;--b:.25;background:linear-gradient(135deg,#7E86B3,#D6802D)">
