                    <path class="dw" style="--a:.28;--b:.44" d="M8 88 L64 70 L120 78 L176 40 L232 52 L288 26 L332 34" fill="none" stroke="#2F3A9E" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" pathLength="100"/>
                    {[[8, 88], [64, 70], [120, 78], [176, 40], [232, 52], [288, 26], [332, 34]].map(([x, y], k) => <circle class="fl" style={`--a:${0.32 + k * 0.07};--b:.08`} cx={x} cy={y} r={k === 3 ? 5 : 3.2} fill={k === 3 ? '#F6B370' : '#fff'} stroke="#2F3A9E" stroke-width="2"/>)}
