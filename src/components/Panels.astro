                      <p class="mt-0.5 text-[10.5px] text-[#2F3A9E]">{d}</p>
                    </div>
                  ))}
                </div>
                <div class="absolute left-[82px] top-[150px] w-[334px]">
                  <div class="rv flex items-center justify-between" style="--a:.2;--b:.12"><p class="text-[12.5px] font-medium text-[#14173f]">Ingresos y gastos</p>
                    <p class="flex items-center gap-3 text-[10.5px] text-[#5f5a7a]"><span class="flex items-center gap-1.5"><i class="size-2 rounded-full bg-[#2F3A9E]"></i>Ingresos</span><span class="flex items-center gap-1.5"><i class="size-2 rounded-full bg-[#eccfa6]"></i>Gastos</span></p></div>
                  <svg class="mt-2" width="334" height="186" viewBox="0 0 334 186" aria-hidden="true">
                    <defs><linearGradient id="bgA" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F6B370"/><stop offset="1" stop-color="#2F3A9E"/></linearGradient></defs>
                    {[20, 60, 100, 140].map((y) => <path d={`M0 ${y}H334`} stroke="#efe9e1"/>)}
                    <path d="M0 160H334" stroke="#e4dcd0"/>
                    {['May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct'].map((m, k) => (
                      <g>
                        <rect class="gy" style={`--a:${0.26 + k * 0.06};--b:.2`} x={12 + k * 54} y={160 - [86, 96, 78, 110, 104, 124][k]} width="17" height={[86, 96, 78, 110, 104, 124][k]} rx="4" fill="url(#bgA)"/>
                        <rect class="gy" style={`--a:${0.3 + k * 0.06};--b:.2`} x={31 + k * 54} y={160 - [52, 58, 50, 62, 56, 64][k]} width="17" height={[52, 58, 50, 62, 56, 64][k]} rx="4" fill="#eccfa6"/>
