                <div class="absolute left-[82px] top-[16px]"><p class="rv text-[15px] font-medium text-[#14173f]" style="--a:.02;--b:.12">Finanzas</p><p class="rv text-[11px] text-[#8f8aa6]" style="--a:.04;--b:.12">Octubre 2026 · MXN</p></div>
