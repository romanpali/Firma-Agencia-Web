                    <span class={`rv absolute left-[11px] flex size-[36px] items-center justify-center rounded-[11px] ${k === 0 ? 'bg-[#14173f] text-white' : 'text-[#8f8aa6]'}`} style={`top:${70 + k * 44}px;--a:${0.04 + k * 0.04};--b:.1`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={d} /></span>
                  ))}
