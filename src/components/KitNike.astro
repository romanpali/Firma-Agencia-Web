---
// Back of the Nike card: white, monochrome, hairlines. Focus module: operations.
const rows = [['Identidad', '12 componentes', 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3z'], ['Marketing', '182 K de alcance', 'M5 20V10M12 20V4M19 20v-7'], ['Asistentes', '24 automatizaciones', 'M12 3l2 6 6 2-6 2-2 6-2-6-6-2 6-2z'], ['Finanzas', '$771,600 de utilidad', 'M12 4v16M8 8c0-2 8-2 8 0s-8 2-8 4 8 2 8 0']];
const cols = [['Identidad', '12', 'componentes', 0.5], ['Marketing', '182 K', 'alcance', 0.55], ['Operaciones', '96 %', 'a tiempo', 1], ['Asistentes', '24', 'automatiz.', 0.55], ['Finanzas', '$771 K', 'utilidad', 0.5]];
---

<div class="pn kit kit-nk" data-pn="3">
  <div class="rv absolute inset-x-0 top-0 flex h-[36px] items-center justify-between border-b border-[#e6e6e6] px-5 text-[9px] font-semibold text-[#111]" style="--a:.02;--b:.12">
    <span class="flex items-center gap-1.5 text-[12px]"><svg width="16" height="16" viewBox="0 0 34 34" aria-hidden="true"><rect x="2" y="2" width="30" height="30" rx="9" fill="none" stroke="#111" stroke-width="3"/><path d="M9 23c3-9.5 13-9.5 16 0" fill="none" stroke="#111" stroke-width="3" stroke-linecap="round"/></svg>ALBA</span>
    <span class="flex items-center gap-4"><span>Inicio</span><span>Módulos</span><span>Estado</span><span class="flex items-center gap-1 font-normal text-[#666]"><i class="live block size-[5px] rounded-full bg-[#1aa35c]"></i>En línea · 0.8 s</span></span>
  </div>

  <div class="absolute left-5 top-[48px]">
    <h4 class="text-[28px] font-light leading-none tracking-[-0.02em] text-[#111]"><span class="block overflow-hidden"><span class="rl block" style="--a:.06;--b:.2">Opera el sistema.</span></span></h4>
    <p class="rv mt-2 text-[8.5px] text-[#777]" style="--a:.2;--b:.14">Cinco módulos, conectados. Toca un punto para ver la pieza.</p>
  </div>

  <div class="absolute left-5 top-[118px] flex w-[420px] items-end justify-between">
    {cols.map(([n, v, l, o], k) => (
      <div class={`rv relative flex flex-col items-center ${k === 2 ? 'h-[200px] w-[110px]' : 'h-[156px] w-[72px]'}`} style={`--a:${0.12 + k * 0.07};--b:.2;opacity:calc(var(--t) * ${o});${k === 2 ? '' : 'filter:blur(1.2px)'}`}>
        <div class={`flex w-full flex-col items-center rounded-[6px] bg-[#f4f4f4] ${k === 2 ? 'h-[170px] pt-3' : 'h-[120px] pt-3'}`}>
          <span class="text-[7.5px] uppercase tracking-wider text-[#777]">{n}</span>
          <span class={`mt-2 font-light leading-none tracking-[-0.03em] text-[#111] ${k === 2 ? 'text-[34px]' : 'text-[18px]'}`}>{k === 2 ? <><span data-count="96" data-a=".2" data-b=".4">0</span> %</> : v}</span>
          <span class="mt-1 text-[8px] text-[#777]">{l}</span>
          {k === 2 && (<svg class="mt-3" width="94" height="52" viewBox="0 0 94 52" aria-hidden="true"><path class="dw" style="--a:.3;--b:.4" d="M3 40 L22 30 L40 34 L58 14 L76 22 L91 8" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" pathLength="100"/>{[[22, 30, 1], [58, 14, 2], [91, 8, 3]].map(([x, y, n], j) => <g class="fl" style={`--a:${0.5 + j * 0.08};--b:.1`}><circle cx={x} cy={y} r="5.5" fill="#fff" stroke="#111" stroke-width="1.2"/><text x={x} y={y + 2.6} font-size="7" text-anchor="middle" fill="#111" font-family="Inter Tight Variable, sans-serif">{n}</text></g>)}</svg>)}
        </div>
        <i class="mt-1 block rounded-full bg-black/10" style={`height:6px;width:${k === 2 ? 90 : 52}px;filter:blur(3px)`}></i>
      </div>
    ))}
  </div>

  <div class="absolute bottom-4 left-5 flex items-center gap-5 text-[8.5px] text-[#111]">
    <div class="flex items-center gap-[6px]">{[0, 1, 2, 3, 4, 5].map((k) => <i class="relative block h-px w-[44px] bg-[#d9d9d9]"><b class={`gx absolute inset-y-0 left-0 block ${k === 0 ? 'w-full' : 'w-0'} bg-[#111]`} style="--a:.5;--b:.3"></b></i>)}</div>
    <span class="rv text-[#666]" style="--a:.7;--b:.12">01 · Operación en vivo</span>
  </div>

  <div class="absolute inset-y-[36px] right-0 w-[176px] border-l border-[#e6e6e6] bg-white px-4 pt-3">
    <p class="rv text-[10px] font-medium text-[#111]" style="--a:.1;--b:.12">En este sistema</p>
    <div class="mt-2">{rows.map(([n, v, d], k) => (
      <div class="rv flex items-center gap-2.5 border-t border-[#e6e6e6] py-[5px]" style={`--a:${0.2 + k * 0.08};--b:.14`}>
        <i class="flex size-[24px] shrink-0 items-center justify-center rounded-[4px] bg-[#f4f4f4]"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d} /></svg></i>
        <span class="min-w-0 flex-1"><span class="block text-[9.5px] font-medium text-[#111]">{n}</span><span class="block truncate text-[8px] text-[#777]">{v}</span></span>
        <span class="text-[12px] text-[#555]">+</span>
      </div>
    ))}</div>
    <p class="rv absolute inset-x-4 bottom-[54px] text-[7.5px] leading-[1.35] text-[#777]" style="--a:.62;--b:.12"><b class="font-medium text-[#111]">Completa el sistema</b><br />Activa los 5 módulos. Disponibilidad <span class="text-[#111]">99.9 %</span></p>
    <span class="rv absolute inset-x-4 bottom-4 flex h-[30px] items-center justify-between bg-[#111] px-3 text-[9px] text-white" style="--a:.72;--b:.14">Activar sistema completo <span>→</span></span>
  </div>
</div>
