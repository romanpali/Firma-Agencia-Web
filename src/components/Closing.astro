---
import Scene from './Scene.astro';
---

<section data-area class="relative z-10 flex h-svh min-h-[560px] items-center justify-center overflow-hidden bg-[#06080d] text-center text-white">
  <div data-bg class="absolute inset-0" style="transform:scale(1.14)"><Scene kind="cielo" /></div>
  <h2 data-words class="relative max-w-[16ch] px-6 text-[clamp(2.4rem,6vw,6.4rem)] font-light leading-[1.02] tracking-[-0.045em] text-balance">Una sola firma para diseñar, conectar y operar tu empresa</h2>
</section>

<section data-area data-scrub class="relative z-10 overflow-hidden bg-[#06080d] text-white">
  <div data-bg class="absolute inset-0" style="transform:scale(1.14)"><Scene kind="cielo2" /></div>
  <i class="pointer-events-none absolute inset-0 bg-black/25"></i>
  <div class="relative mx-auto max-w-[1100px] px-6 py-[22svh] md:px-10">
    <p data-scrub-text class="text-[clamp(1.5rem,2.9vw,3rem)] font-light leading-[1.2] tracking-[-0.03em]">
      HumanCorp reúne diseño, desarrollo digital, marketing, inteligencia artificial, automatización y gestión en una estructura coherente. Trabajamos sobre cómo se presenta, vende, opera y decide tu empresa, y conectamos cada parte con tecnología.
    </p>
    <ul class="mt-24 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-5">
        <li data-reveal style="--i:0" class="border-t border-white/20 pt-4"><span class="text-[11px] tabular-nums text-white/45">01</span><h3 class="mt-3 text-[1.15rem] font-normal tracking-[-0.02em]">Integración</h3><p class="mt-2 text-[13px] leading-relaxed text-white/60">Conectar herramientas, departamentos, procesos e información.</p></li>
        <li data-reveal style="--i:1" class="border-t border-white/20 pt-4"><span class="text-[11px] tabular-nums text-white/45">02</span><h3 class="mt-3 text-[1.15rem] font-normal tracking-[-0.02em]">Diseño</h3><p class="mt-2 text-[13px] leading-relaxed text-white/60">Construir experiencias, identidades y productos digitales profesionales.</p></li>
        <li data-reveal style="--i:2" class="border-t border-white/20 pt-4"><span class="text-[11px] tabular-nums text-white/45">03</span><h3 class="mt-3 text-[1.15rem] font-normal tracking-[-0.02em]">Automatización</h3><p class="mt-2 text-[13px] leading-relaxed text-white/60">Reducir tareas repetitivas y mejorar los flujos de trabajo.</p></li>
        <li data-reveal style="--i:3" class="border-t border-white/20 pt-4"><span class="text-[11px] tabular-nums text-white/45">04</span><h3 class="mt-3 text-[1.15rem] font-normal tracking-[-0.02em]">Inteligencia</h3><p class="mt-2 text-[13px] leading-relaxed text-white/60">Convertir información empresarial en indicadores y conocimiento útil.</p></li>
        <li data-reveal style="--i:4" class="border-t border-white/20 pt-4"><span class="text-[11px] tabular-nums text-white/45">05</span><h3 class="mt-3 text-[1.15rem] font-normal tracking-[-0.02em]">Optimización</h3><p class="mt-2 text-[13px] leading-relaxed text-white/60">Mejorar progresivamente cómo una empresa trabaja, administra y crece.</p></li>
    </ul>
  </div>
</section>

<section id="contacto" data-area class="relative z-10 flex h-svh min-h-[600px] flex-col items-center justify-center overflow-hidden bg-[#05070f] text-center text-white">
  <div data-bg class="absolute inset-0" style="transform:scale(1.14)"><Scene kind="cielo3" /></div>
  <i class="pointer-events-none absolute inset-0 bg-black/20"></i>
  <div class="relative px-6">
    <h2 data-words class="text-[clamp(3rem,9vw,9rem)] font-light leading-[1] tracking-[-0.05em]">Contáctanos</h2>
    <p data-reveal style="--i:1" class="mx-auto mt-6 max-w-[26rem] text-[14px] leading-relaxed text-white/70">Cuéntanos cómo funciona hoy tu empresa y construyamos juntos el siguiente paso.</p>
    <a data-reveal style="--i:2" href="/contacto" class="group mt-9 inline-flex items-center gap-2 rounded-full bg-white px-7 py-3.5 text-[15px] font-medium text-[#0b0c0f] transition-transform duration-200 hover:scale-[1.04] active:scale-[0.98]">
      Hablemos de tu empresa <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
    </a>
  </div>
  <footer class="absolute inset-x-6 bottom-6 flex flex-wrap items-center justify-between gap-3 text-[12px] text-white/55 md:inset-x-10">
    <span>© HumanCorp · Diseño, tecnología y operaciones empresariales</span>
    <nav class="flex gap-5" aria-label="Pie"><a href="/servicios" class="transition-colors hover:text-white">Servicios</a><a href="/nosotros" class="transition-colors hover:text-white">Nosotros</a><a href="/contacto" class="transition-colors hover:text-white">Contacto</a></nav>
  </footer>
</section>

<script>
  // Parallax on the backdrops + the paragraph that lights up word by word
  const areas = [...document.querySelectorAll<HTMLElement>('[data-area]')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const scrub = document.querySelector<HTMLElement>('[data-scrub-text]');
  const words: HTMLElement[] = [];
  if (scrub) {
    const text = scrub.textContent!.trim().split(/\s+/);
    scrub.textContent = '';
    text.forEach((w) => {
      const s = document.createElement('span');
      s.textContent = w + ' ';
      s.style.opacity = reduced ? '1' : '0.22';
      s.style.transition = 'opacity .5s ease';
      scrub.append(s); words.push(s);
    });
  }
  let queued = false;
  const update = () => {
    queued = false;
    if (!reduced) {
      for (const sec of areas) {
        const r = sec.getBoundingClientRect();
        if (r.bottom < -100 || r.top > innerHeight + 100) continue;
        const bg = sec.querySelector<HTMLElement>('[data-bg]');
        if (bg) {
          const p = (r.top + r.height / 2 - innerHeight / 2) / innerHeight;
          bg.style.transform = `translate3d(0, ${(p * -48).toFixed(1)}px, 0) scale(1.14)`;
        }
      }
    }
    if (scrub && !reduced) {
      const r = scrub.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.85 - r.top) / (innerHeight * 0.6 + r.height * 0.4)));
      const n = Math.round(p * words.length);
      words.forEach((w, i) => (w.style.opacity = i < n ? '1' : '0.22'));
    }
  };
  addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
  addEventListener('resize', update);
  update();
</script>
