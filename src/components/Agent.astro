---
// «HumanCorp AI»: asistente discreto de la web. Un botón pequeño abajo a la derecha abre un panel de cristal con una conversación de ejemplo
// (respuestas guionizadas sobre servicios, paquetes, obra y contacto; no es un modelo en vivo). Sin dependencias.
const spark = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8z"/></svg>';
---

<div class="hca" data-hca data-open="0">
  <section class="hca-p" role="dialog" aria-label="HumanCorp AI" aria-hidden="true">
    <i class="hca-glow" aria-hidden="true"></i>
    <header><div class="hca-id"><i class="hca-orb"></i><div><b>HUMANCORP <em>AI</em></b><small>Servicios, paquetes y contacto</small></div></div><button type="button" class="hca-x" data-hca-close aria-label="Cerrar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button></header>
    <div class="hca-m" data-hca-msgs aria-live="polite">
      <div class="hca-hi"><p class="hca-k">Pregunta lo que quieras</p><h3>¿Qué necesita<br>tu empresa?</h3></div>
      <div class="hca-sg" data-hca-sg></div>
    </div>
    <p class="hca-f">Asistente de demostración · respuestas de ejemplo</p>
  </section>
  <form class="hca-d" data-hca-form>
    <button type="button" class="hca-o" data-hca-fab aria-label="Abrir HumanCorp AI" aria-expanded="false"><i class="hca-orb"></i></button>
    <input type="text" data-hca-in placeholder="Pregúntale a HumanCorp…" aria-label="Pregunta" autocomplete="off" />
    <kbd aria-hidden="true">/</kbd>
    <button type="submit" class="hca-s" aria-label="Enviar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
  </form>
</div>

<script>
  type Link = [string, string];
  type Ans = { re: RegExp; t: string; l?: Link[] };
  const ANS: Ans[] = [
    { re: /servici|qu[eé] hacen|ofrecen|hacen/i, t: 'Trabajamos en ocho áreas: diseño e identidad, desarrollo digital, marketing, ventas y CRM, IA y automatización, finanzas y contable, operaciones y personas, y datos e infraestructura. Puedes pedir una sola o varias conectadas.', l: [['Ver servicios', '/servicios']] },
    { re: /paquet|precio|cuesta|costo|cotiz|tarifa/i, t: 'Tenemos paquetes para empezar con claridad. El precio final depende del alcance, así que lo mejor es revisar los paquetes y, si quieres, pedir una cotización a tu medida.', l: [['Ver paquetes', '/paquetes'], ['Pedir cotización', '/contacto']] },
    { re: /contab|fiscal|impuesto|sat|factur|cfdi|contador/i, t: 'La asesoría contable y fiscal la brinda nuestro Director de Administración y Finanzas (contador) y su área, con el respaldo de nuestra tecnología. Lo jurídico y la seguridad especializada los resolvemos con profesionales aliados.', l: [['Contable y fiscal', '/asesoria-contable-y-fiscal']] },
    { re: /obra|proyecto|ejemplo|portafolio|trabajo|caso/i, t: 'En Obra puedes recorrer cinco proyectos de ejemplo: identidad, sitios web y paneles. También puedes armar una vista de tu propio sitio y verla generarse.', l: [['Ver la obra', '/obra'], ['Arma tu proyecto', '/arma-tu-proyecto']] },
    { re: /sitio|p[aá]gina web|web|tienda|ecommerce|landing/i, t: 'Diseñamos sitios corporativos, landings y tiendas en línea. Si quieres ver cómo podría quedar el tuyo, prueba el configurador: eliges el tipo de negocio y se genera una propuesta.', l: [['Arma tu proyecto', '/arma-tu-proyecto']] },
    { re: /ia\b|inteligencia|automat|agente|chat/i, t: 'Integramos IA y automatización donde ayudan: respuestas a clientes, avisos, reportes y tareas repetidas. Siempre con una persona al tanto y sin prometer lo que no está implementado.', l: [['Servicios', '/servicios']] },
    { re: /diagn[oó]stic|qu[eé] tan|evaluar|revisar mi/i, t: 'El diagnóstico es una revisión breve y gratuita de qué tan conectada está tu empresa. Te da un punto de partida claro.', l: [['Hacer el diagnóstico', '/diagnostico']] },
    { re: /contact|hablar|llam|correo|whats|agendar|tel[eé]fono|reuni/i, t: 'Con gusto. Puedes escribirnos a info@humancorp.co, llamar al +52 999 123 4567 o dejar tus datos para que te contactemos.', l: [['Ir a contacto', '/contacto']] },
    { re: /qui[eé]nes|nosotros|equipo|empresa/i, t: 'Somos un equipo de diseño, tecnología y operaciones empresariales. Nuestra idea es simple: todo lo que hace funcionar a una empresa, conectado bajo un solo estándar.', l: [['Conócenos', '/nosotros']] },
    { re: /cu[aá]nto tarda|tiempo|plazo|entrega/i, t: 'Depende del alcance: un sitio sencillo puede estar en pocas semanas y los proyectos más amplios se calendarizan por etapas. Te damos fechas claras antes de empezar.', l: [['Pedir una propuesta', '/contacto']] },
    { re: /hola|buen[oa]s|qu[eé] tal|hey/i, t: 'Hola. ¿Qué te gustaría resolver: un sitio, una marca, tus procesos o tus números?' },
  ];
  const SG = ['¿Qué servicios ofrecen?', '¿Cuánto cuesta un sitio web?', 'Quiero ver ejemplos', 'Necesito ayuda contable'];
  const root = document.querySelector<HTMLElement>('[data-hca]');
  if (root) {
    const fab = root.querySelector<HTMLElement>('[data-hca-fab]')!, panel = root.querySelector<HTMLElement>('.hca-p')!;
    const msgs = root.querySelector<HTMLElement>('[data-hca-msgs]')!, sg = root.querySelector<HTMLElement>('[data-hca-sg]')!;
    const form = root.querySelector<HTMLFormElement>('[data-hca-form]')!, input = form.querySelector<HTMLInputElement>('input')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const spark = '';
    sg.innerHTML = SG.map((q) => `<button type="button" data-q="${q}">${q}</button>`).join('');
    const set = (on: boolean) => { root.dataset.open = on ? '1' : '0'; panel.setAttribute('aria-hidden', String(!on)); fab.setAttribute('aria-expanded', String(on)); if (on) setTimeout(() => input.focus({ preventScroll: true }), 350); else input.blur(); };
    fab.addEventListener('click', () => set(root.dataset.open !== '1'));
    input.addEventListener('focus', () => { if (root.dataset.open !== '1') set(true); });
    addEventListener('keydown', (e) => { if (e.key === '/' && !/INPUT|TEXTAREA|SELECT/.test((document.activeElement as HTMLElement)?.tagName || '') && !(document.activeElement as HTMLElement)?.isContentEditable) { e.preventDefault(); set(true); input.focus(); } });
    const PH = ['Pregúntale a HumanCorp…', '¿Qué servicios ofrecen?', '¿Cuánto cuesta un sitio web?', 'Quiero ver ejemplos'];
    if (!reduced) { let pi = 0; setInterval(() => { if (document.activeElement !== input && !input.value) input.placeholder = PH[(pi = (pi + 1) % PH.length)]; }, 3200); }
    root.querySelector('[data-hca-close]')!.addEventListener('click', () => set(false));
    addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    const bottom = () => { msgs.scrollTop = msgs.scrollHeight; };
    const ask = (q: string) => {
      q = q.trim(); if (!q) return; root.classList.add('talk'); input.value = ''; if (root.dataset.open !== '1') set(true);
      const me = document.createElement('div'); me.className = 'hca-me'; me.textContent = q; msgs.appendChild(me);
      const bot = document.createElement('div'); bot.className = 'hca-bot'; bot.innerHTML = `<div><span class="hca-dots"><u></u><u></u><u></u></span></div>`; msgs.appendChild(bot); bottom();
      const hit = ANS.find((a) => a.re.test(q));
      const text = hit ? hit.t : 'No tengo una respuesta exacta para eso, pero el equipo sí. Cuéntanos qué necesitas y te respondemos con una propuesta clara.';
      const links = hit?.l || [['Escribir al equipo', '/contacto']] as Link[];
      const box = bot.querySelector('div')!; bottom();
      setTimeout(() => {
        box.innerHTML = '<p></p>'; const p = box.querySelector('p')!; let n = 0;
        const fin = () => { box.insertAdjacentHTML('beforeend', `<div class="hca-ln">${links.map(([l, h]) => `<a href="${h}">${l}<i>↗</i></a>`).join('')}</div>`); bottom(); };
        if (reduced) { p.textContent = text; fin(); return; }
        const t = setInterval(() => { p.textContent = text.slice(0, (n += 2)); bottom(); if (n >= text.length) { clearInterval(t); p.textContent = text; fin(); } }, 16);
      }, reduced ? 0 : 750);
    };
    form.addEventListener('submit', (e) => { e.preventDefault(); ask(input.value); });
    sg.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-q]'); if (b) ask(b.dataset.q!); });
  }
</script>

<style is:global>
  .hca { --navy: #0e1a2e; --navy2: #1f3558; --blue: #2f4a73; --amber: #f0b56e; --amber2: #ffd9a3; position: fixed; left: 50%; bottom: 18px; z-index: 90; width: min(440px, calc(100vw - 28px)); transform: translateX(-50%); font-family: 'Inter Tight Variable', system-ui, sans-serif; }
  .hca button, .hca input { font: inherit; }
  /* dock: la barra siempre visible es el campo de texto */
  .hca-d { position: relative; z-index: 2; display: flex; align-items: center; gap: 8px; height: 54px; padding: 0 6px 0 6px; border-radius: 99px; color: #fff; background: linear-gradient(135deg, rgba(14, 26, 46, 0.78), rgba(31, 53, 88, 0.7)); -webkit-backdrop-filter: blur(22px) saturate(1.5); backdrop-filter: blur(22px) saturate(1.5); box-shadow: 0 18px 44px -14px rgba(5, 10, 24, 0.7), inset 0 0 0 1px rgba(255, 255, 255, 0.16), inset 0 1px 0 rgba(255, 255, 255, 0.28); transition: box-shadow 0.4s, transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .hca-d:focus-within, .hca-d:hover { box-shadow: 0 22px 54px -14px rgba(5, 10, 24, 0.8), inset 0 0 0 1px rgba(240, 181, 110, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.28); }
  .hca-o { flex: none; display: grid; place-items: center; width: 42px; height: 42px; padding: 0; border: 0; border-radius: 50%; background: transparent; cursor: pointer; }
  .hca-orb { position: relative; display: block; width: 26px; height: 26px; border-radius: 50%; background: conic-gradient(from 0deg, #2f4a73, #6f93d6, #ffd9a3, #f0b56e, #2f4a73); animation: hcaSpin 7s linear infinite; box-shadow: 0 0 18px rgba(240, 181, 110, 0.45); } .hca-orb::after { content: ""; position: absolute; inset: 4px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.55), transparent 55%), #0e1a2e; opacity: 0.88; }
  @keyframes hcaSpin { to { transform: rotate(360deg); } }
  .hca-d input { flex: 1; min-width: 0; height: 100%; border: 0; outline: 0; background: none; color: #fff; font-size: 14.5px; letter-spacing: -0.01em; } .hca-d input::placeholder { color: rgba(255, 255, 255, 0.58); }
  .hca-d kbd { flex: none; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 7px; font: 500 12px 'Inter Tight Variable', sans-serif; color: rgba(255, 255, 255, 0.6); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25); }
  .hca-s { flex: none; display: grid; place-items: center; width: 42px; height: 42px; padding: 0; border: 0; border-radius: 50%; cursor: pointer; color: #1a1206; background: linear-gradient(135deg, #ffd9a3, #f0b56e); box-shadow: 0 8px 20px -8px rgba(240, 181, 110, 0.8); transition: transform 0.3s; } .hca-s:hover { transform: scale(1.06); } .hca-s svg { width: 18px; height: 18px; }
  /* panel: sube desde el dock */
  .hca-p { position: absolute; left: 0; right: 0; bottom: 64px; display: flex; flex-direction: column; height: min(520px, calc(100svh - 110px)); border-radius: 28px; overflow: hidden; color: #f3f5fa; background: linear-gradient(160deg, rgba(14, 26, 46, 0.9), rgba(31, 53, 88, 0.86) 70%, rgba(47, 74, 115, 0.85)); -webkit-backdrop-filter: blur(30px) saturate(1.5); backdrop-filter: blur(30px) saturate(1.5); box-shadow: 0 40px 90px -24px rgba(5, 10, 24, 0.8), inset 0 0 0 1px rgba(255, 255, 255, 0.14), inset 0 1px 0 rgba(255, 255, 255, 0.25); transform-origin: 50% 100%; opacity: 0; transform: translateY(18px) scale(0.94); visibility: hidden; transition: opacity 0.35s ease, transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0s 0.55s; }
  .hca[data-open='1'] .hca-p { opacity: 1; transform: none; visibility: visible; transition: opacity 0.35s ease, transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0s; }
  .hca-glow { position: absolute; right: -25%; top: -30%; width: 80%; height: 70%; border-radius: 50%; background: radial-gradient(closest-side, rgba(240, 181, 110, 0.4), transparent); pointer-events: none; animation: hcaB 16s ease-in-out infinite alternate; } @keyframes hcaB { to { transform: translate3d(-20%, 25%, 0); } }
  .hca-p header { position: relative; display: flex; align-items: center; justify-content: space-between; padding: 16px 16px 10px 20px; }
  .hca-id { display: flex; align-items: center; gap: 12px; } .hca-id .hca-orb { width: 30px; height: 30px; } .hca-id b { display: block; font-size: 12px; font-weight: 600; letter-spacing: 0.22em; } .hca-id em { font-style: normal; font-weight: 300; color: var(--amber2); } .hca-id small { display: block; margin-top: 3px; font-size: 11.5px; color: rgba(243, 245, 250, 0.55); }
  .hca-x { display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 50%; background: rgba(255, 255, 255, 0.08); color: inherit; cursor: pointer; } .hca-x svg { width: 15px; height: 15px; }
  .hca-m { position: relative; flex: 1; overflow-y: auto; padding: 10px 20px 8px; display: flex; flex-direction: column; gap: 16px; scrollbar-width: none; } .hca-m::-webkit-scrollbar { display: none; }
  .hca-hi { padding-top: 14px; } .hca-k { margin: 0; font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--amber); } .hca-hi h3 { margin-top: 12px; font-size: 34px; font-weight: 500; line-height: 1.02; letter-spacing: -0.05em; }
  .hca-sg { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; } .hca-sg button { padding: 10px 15px; border: 0; border-radius: 99px; color: #f3f5fa; font-size: 13px; cursor: pointer; background: rgba(255, 255, 255, 0.07); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16); transition: background 0.25s, color 0.25s, box-shadow 0.25s; } .hca-sg button:hover { background: rgba(240, 181, 110, 0.18); box-shadow: inset 0 0 0 1px rgba(240, 181, 110, 0.7); color: #fff; }
  .hca.talk .hca-hi, .hca.talk .hca-sg { display: none; }
  .hca-me { align-self: flex-end; max-width: 82%; padding: 10px 15px; border-radius: 18px 18px 4px 18px; font-size: 14px; line-height: 1.4; color: #1a1206; background: linear-gradient(135deg, #ffd9a3, #f0b56e); animation: hcaIn 0.4s ease both; }
  .hca-bot { position: relative; padding-left: 16px; animation: hcaIn 0.4s ease both; } .hca-bot::before { content: ""; position: absolute; left: 0; top: 4px; bottom: 4px; width: 2px; border-radius: 2px; background: linear-gradient(180deg, var(--amber), rgba(240, 181, 110, 0)); }
  .hca-bot p { margin: 0; font-size: 14.5px; line-height: 1.55; color: rgba(243, 245, 250, 0.94); }
  .hca-dots { display: flex; gap: 5px; padding: 6px 0; } .hca-dots u { width: 6px; height: 6px; border-radius: 50%; background: var(--amber); animation: hcaD 1s ease-in-out infinite; } .hca-dots u:nth-child(2) { animation-delay: 0.15s; } .hca-dots u:nth-child(3) { animation-delay: 0.3s; } @keyframes hcaD { 0%, 100% { opacity: 0.25; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-3px); } }
  .hca-ln { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; } .hca-ln a { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 99px; font-size: 12.5px; font-weight: 500; text-decoration: none; color: #fff; background: rgba(255, 255, 255, 0.1); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.28); animation: hcaIn 0.45s ease both; transition: background 0.25s, color 0.25s; } .hca-ln a:hover { background: #fff; color: #0e1a2e; } .hca-ln a i { font-style: normal; color: var(--amber); }
  @keyframes hcaIn { from { opacity: 0; transform: translateY(8px); } }
  .hca-f { margin: 0; padding: 8px 20px 14px; text-align: center; font-size: 10.5px; letter-spacing: 0.08em; color: rgba(243, 245, 250, 0.38); }
  @media (max-width: 640px) {
    .hca { bottom: max(12px, env(safe-area-inset-bottom)); }
    .hca-d kbd { display: none; }
    .hca-p { bottom: 62px; border-radius: 26px; height: min(70svh, 560px); }
    body:has([data-obs]) .hca { bottom: 86px; }
  }
  @media (prefers-reduced-motion: reduce) { .hca-orb, .hca-glow { animation: none; } .hca-p, .hca-d { transition: none; } }
</style>
