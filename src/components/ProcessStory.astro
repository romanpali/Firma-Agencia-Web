---
const steps = [
  { t: 'Tu empresa, hoy', d: 'Las ventas viven en una hoja de cálculo, las conversaciones en el chat, las facturas en PDF y los pendientes en notas. Funciona, pero nada se conecta.', items: ['Hojas de cálculo', 'Chats', 'Facturas en PDF', 'Notas', 'Correos', 'Redes'] },
  { t: 'Identidad y diseño', d: 'Empezamos por lo que se ve: una sola cara para toda la empresa.', items: ['Marca', 'Paleta y tipografía', 'Producción creativa'] },
  { t: 'Presencia digital', d: 'Un sitio propio, con tu identidad, que informa y vende todo el día.', items: ['Sitio web', 'Tienda en línea', 'Plataformas'] },
  { t: 'Ventas y CRM', d: 'Cada prospecto avanza por un camino claro. Ningún seguimiento se pierde.', items: ['Embudo de ventas', 'Cotizaciones', 'Seguimiento'] },
  { t: 'Finanzas y administración', d: 'Facturación y flujo de caja en orden, preparados para la revisión de tus contadores y asesores.', items: ['Facturación CFDI 4.0', 'Flujo de caja', 'Administración'] },
  { t: 'Operaciones y datos', d: 'Un panel con indicadores de todas las áreas, en lugar de reportes armados a mano.', items: ['Procesos y proyectos', 'Inventarios', 'Dashboards'] },
  { t: 'IA y automatización', d: 'Asistentes que cotizan, dan seguimiento y preparan la factura, para reducir el trabajo manual.', items: ['Agentes de IA', 'Flujos automáticos', 'Asistentes internos'] },
  { t: 'Un solo ecosistema', d: 'Cada módulo comparte información con los demás bajo un solo estándar. Es el sistema que construimos contigo, paso a paso.', items: ['Un solo estándar', 'Información compartida', 'Crece contigo'] },
];
const mods = [
  { raw: 'Logos sueltos', to: 'Identidad', gx: 0, gy: 0, w: 160, h: 150, sx: 292, sy: 246, sr: 8, fx: 0.9, ph: 0.4 },
  { raw: 'Página desactualizada', to: 'Sitio web', gx: 172, gy: 0, w: 368, h: 150, sx: 14, sy: 226, sr: -6, fx: 0.7, ph: 1.9 },
  { raw: 'Hoja de cálculo', to: 'Ventas', gx: 0, gy: 162, w: 200, h: 238, sx: 352, sy: 8, sr: 7, fx: 1.1, ph: 3.1 },
  { raw: 'Facturas en PDF', to: 'Finanzas', gx: 212, gy: 162, w: 160, h: 114, sx: 84, sy: 24, sr: -8, fx: 0.8, ph: 5.2 },
  { raw: 'Reportes a mano', to: 'Datos', gx: 384, gy: 162, w: 156, h: 114, sx: 226, sy: 128, sr: 5, fx: 1.0, ph: 2.6 },
  { raw: 'Chats', to: 'IA', gx: 212, gy: 288, w: 328, h: 112, sx: 150, sy: 296, sr: -4, fx: 0.6, ph: 4.4 },
];
---

<section id="construccion" data-tone="light" class="relative z-10 font-goog text-[#202124]">
  <div data-process class="h-[560vh] bg-white">
    <div data-process-inner class="sticky top-0 h-svh overflow-hidden">
      <div class="relative mx-auto grid h-full max-w-[1280px] grid-rows-[auto_minmax(0,1fr)] gap-3 px-6 pb-6 pt-24 md:grid-cols-12 md:grid-rows-1 md:items-center md:gap-14 md:px-10 md:py-24">
        <div class="md:col-span-5">
          <p class="text-[15px] text-[#5f6368]">Cómo lo construimos</p>
          <div class="relative mt-4 md:mt-7">
            <i class="absolute bottom-1 left-0 top-1 w-px bg-[#e8eaed]" aria-hidden="true"><b data-rail class="absolute inset-0 origin-top scale-y-0 bg-[#1a56db]"></b></i>
            <div class="space-y-0.5 md:space-y-2">
              {steps.map((s, i) => (
                <div class="ps-row" data-row={i}>
                  <div class="flex items-baseline gap-3">
                    <span class="ps-num w-5 text-[12px] tabular-nums md:text-[13px]">{String(i + 1).padStart(2, '0')}</span>
                    <h3 class="ps-title text-[clamp(1.2rem,2.5vw,2.2rem)] font-normal leading-[1.2] tracking-[-0.025em]">{s.t}</h3>
                  </div>
                  <div class="ps-body pl-8">
                    <div>
                      <p class="max-w-[30rem] pt-2 text-[14px] leading-relaxed text-[#5f6368] md:text-[16.5px]">{s.d}</p>
                      <ul class="flex max-w-[30rem] flex-wrap gap-1.5 pb-1.5 pt-3">
                        {s.items.map((l) => <li class="rounded-full border border-[#dadce0] px-3 py-1 text-[12px] text-[#3c4043] md:text-[13.5px]">{l}</li>)}
                      </ul>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div data-stagewrap class="relative min-h-0 md:col-span-7 md:h-[30rem]">
          <div data-fit class="absolute left-1/2 top-1/2 h-[420px] w-[560px]" role="img" aria-label="Piezas sueltas de una empresa se ordenan, una por una, en módulos conectados que forman un solo sistema">
            <div class="absolute inset-[10px]">
              {mods.map((m, i) => (
                <div class="pm" data-mod={i} style={`--gx:${m.gx}px;--gy:${m.gy}px;--w:${m.w}px;--h:${m.h}px;--k:${i}`}>
                  {i === 0 && (<>
                    <svg class="pop absolute left-4 top-4" width="70" height="46" viewBox="0 0 70 46" aria-hidden="true"><circle cx="23" cy="23" r="19" fill="#202124"/><circle cx="45" cy="23" r="19" fill="#1a56db" fill-opacity=".92"/></svg>
                    <span class="pop absolute right-4 top-4 text-[38px] font-medium leading-[46px] tracking-[-0.03em]" style="--k:1">Aa</span>
                    <div class="absolute left-4 top-[74px] flex gap-2">
                      {['#202124', '#1a56db', '#8ab4f8', '#e8eaed'].map((c, k) => <i class="pop size-[18px] rounded-full" style={`background:${c};--k:${k + 2}`}></i>)}
                    </div>
                  </>)}
                  {i === 1 && (<>
                    <div class="absolute inset-x-0 top-0 flex h-[30px] items-center gap-1.5 border-b border-[#e8eaed] px-4" aria-hidden="true">
                      <i class="size-2 rounded-full bg-[#dadce0]"></i><i class="size-2 rounded-full bg-[#dadce0]"></i><i class="size-2 rounded-full bg-[#dadce0]"></i>
                      <i class="ml-3 h-[14px] flex-1 rounded-full bg-[#f1f3f4]"></i>
                    </div>
                    <div class="absolute left-4 top-[44px] w-[190px]" aria-hidden="true">
                      <i class="pop block h-[11px] w-[170px] rounded-full bg-[#202124]" style="--k:0"></i>
                      <i class="pop mt-2 block h-[11px] w-[120px] rounded-full bg-[#202124]" style="--k:1"></i>
                      <i class="pop mt-3 block h-[6px] w-[150px] rounded-full bg-[#dadce0]" style="--k:2"></i>
                      <i class="pop mt-1.5 block h-[6px] w-[110px] rounded-full bg-[#dadce0]" style="--k:2"></i>
                      <i class="pop mt-3 block h-[20px] w-[74px] rounded-full bg-[#1a56db]" style="--k:3"></i>
                    </div>
                    <i class="pop absolute right-4 top-[44px] h-[64px] w-[132px] rounded-[12px] bg-gradient-to-br from-[#dbe6fd] to-[#8ab4f8]" style="--k:2" aria-hidden="true"></i>
                  </>)}
                  {i === 2 && (<>
                    <div class="absolute inset-x-4 top-4 flex gap-2" aria-hidden="true">
                      {[3, 2, 1].map((n, c) => (
                        <div class="flex-1">
                          <i class="block h-[6px] w-7 rounded-full bg-[#bdc1c6]"></i>
                          <div class="mt-2.5 space-y-2">
                            {Array.from({ length: n }).map((_, r) => (
                              <i class={`pop block h-[40px] rounded-[10px] ${c === 2 ? 'bg-[#1a56db]' : 'bg-[#f1f3f4]'}`} style={`--k:${c * 2 + r}`}>
                                <b class={`ml-2 mt-2.5 block h-[5px] w-8 rounded-full ${c === 2 ? 'bg-white/80' : 'bg-[#bdc1c6]'}`}></b>
                                <b class={`ml-2 mt-1.5 block h-[5px] w-5 rounded-full ${c === 2 ? 'bg-white/50' : 'bg-[#dadce0]'}`}></b>
                              </i>
                            ))}
                          </div>
                        </div>
                      ))}
                    </div>
                    <div class="absolute inset-x-4 bottom-[46px] space-y-1.5" aria-hidden="true">
                      {[100, 72, 44].map((w, k) => <i class="pop block h-[7px] rounded-full bg-[#1a56db]" style={`width:${w}%;opacity:${1 - k * 0.28};--k:${k + 6}`}></i>)}
                    </div>
                  </>)}
                  {i === 3 && (
                    <div class="absolute bottom-[40px] left-4 flex h-[56px] items-end gap-2.5" aria-hidden="true">
                      {[18, 30, 24, 42, 56].map((h, k) => <i class={`g block w-[18px] rounded-[5px] ${k === 4 ? 'bg-[#1a56db]' : 'bg-[#dbe6fd]'}`} style={`height:${h}px;transition-delay:${k * 0.08}s`}></i>)}
                    </div>
                  )}
                  {i === 4 && (<>
                    <svg class="absolute left-3 top-3" width="68" height="68" viewBox="0 0 68 68" aria-hidden="true">
                      <circle cx="34" cy="34" r="25" fill="none" stroke="#e8eaed" stroke-width="9"/>
                      <circle class="dr" cx="34" cy="34" r="25" fill="none" stroke="#1a56db" stroke-width="9" stroke-linecap="round" pathLength="100" style="--len:100;--end:28" transform="rotate(-90 34 34)"/>
                    </svg>
                    <svg class="absolute right-3 top-5" width="56" height="34" viewBox="0 0 56 34" aria-hidden="true">
                      <path class="dr" d="M2 28 L14 20 L26 23 L40 8 L54 12" fill="none" stroke="#202124" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" pathLength="100" style="--len:100"/>
                    </svg>
                  </>)}
                  {i === 5 && (<>
                    <div class="absolute left-4 top-4 flex h-[26px] w-[150px] items-center gap-1.5 rounded-full bg-[#f1f3f4] px-3" aria-hidden="true"><i class="pop h-[5px] w-[44px] rounded-full bg-[#bdc1c6]" style="--k:0"></i><i class="pop h-[5px] w-[60px] rounded-full bg-[#dadce0]" style="--k:1"></i></div>
                    <div class="pop absolute right-4 top-[26px] flex h-[34px] w-[186px] items-center gap-2 rounded-full bg-[#1a56db] px-3.5" style="--k:2" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="#fff"><path d="M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4z"/></svg>
                      <i class="h-[5px] w-[96px] rounded-full bg-white/80"></i>
                    </div>
                    <div class="dot3 pop absolute right-5 top-[68px] flex gap-1" style="--k:3" aria-hidden="true"><i class="size-1.5 rounded-full bg-[#1a56db]"></i><i class="size-1.5 rounded-full bg-[#1a56db]"></i><i class="size-1.5 rounded-full bg-[#1a56db]"></i></div>
                  </>)}
                  <span class="tag"><span class="from">{m.raw}</span><span class="to">{m.to}</span></span>
                </div>
              ))}
            </div>
            <svg class="pointer-events-none absolute inset-0 size-full overflow-visible" viewBox="0 0 560 420" aria-hidden="true">
              <rect class="ps-frame" x="1" y="1" width="558" height="418" rx="30" pathLength="2000" />
            </svg>
            <p data-cap class="absolute inset-x-0 top-full mt-4 text-center text-[15px] text-[#5f6368]">Cada herramienta, por su lado.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- the white chapter dissolves into the night -->
  <div class="pointer-events-none h-[30svh] bg-gradient-to-b from-white to-white/0" aria-hidden="true"></div>
</section>

<script define:vars={{ mods }}>
  const sec = document.querySelector('[data-process]');
  const rows = [...sec.querySelectorAll('[data-row]')];
  const els = [...sec.querySelectorAll('[data-mod]')];
  const stage = sec.querySelector('[data-fit]');
  const wrap = sec.querySelector('[data-stagewrap]');
  const rail = sec.querySelector('[data-rail]');
  const cap = sec.querySelector('[data-cap]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const ease = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const BW = 560, BH = 420;
  const fit = () => {
    const r = wrap.getBoundingClientRect();
    const sc = Math.min(r.width / BW, (r.height - 34) / BH, 1.2);
    stage.style.transform = `translate(-50%, -50%) scale(${sc.toFixed(4)})`;
  };
  fit();
  addEventListener('resize', fit);

  let target = 0, F = 0, shown = -1, visible = true;
  const read = () => {
    const r = sec.getBoundingClientRect();
    const p = clamp(-r.top / Math.max(1, r.height - innerHeight));
    target = reduced ? 7 : clamp(p * 7.7 - 0.5, 0, 7);
  };
  const capText = ['Cada herramienta, por su lado.', 'Cada pieza encuentra su lugar.', 'Un solo sistema, conectado.'];
  const render = (time) => {
    F += (target - F) * (reduced ? 1 : 0.14);
    els.forEach((el, i) => {
      const m = mods[i];
      const t = clamp(F - i, 0, 1);
      const e = reduced ? 1 : ease(t);
      const c = 1 - e;
      const dx = (m.sx - m.gx) * c + Math.sin(time * 0.0007 * m.fx + m.ph) * 9 * c;
      const dy = (m.sy - m.gy) * c + Math.cos(time * 0.0006 * m.fx + m.ph) * 9 * c;
      el.style.transform = `translate(${dx.toFixed(1)}px, ${dy.toFixed(1)}px) rotate(${(m.sr * c).toFixed(2)}deg) scale(${(1 - 0.3 * c).toFixed(3)})`;
      el.style.filter = c > 0.01 ? `grayscale(${c.toFixed(2)})` : 'none';
      el.style.zIndex = String(c > 0.01 ? i : 0);
      el.classList.toggle('is-in', t > 0.96);
    });
    rail.style.transform = `scaleY(${(F / 7).toFixed(3)})`;
    const idx = clamp(Math.round(F), 0, 7);
    if (idx !== shown) {
      shown = idx;
      rows.forEach((r, i) => { r.classList.toggle('is-on', i === idx); r.classList.toggle('is-done', i < idx); });
      stage.classList.toggle('ps-eco', idx === 7);
      cap.textContent = capText[idx === 0 ? 0 : idx === 7 ? 2 : 1];
    }
  };
  read();
  if (reduced) {
    render(0);
    rows.forEach((r) => r.classList.add('is-on'));
  } else {
    new IntersectionObserver((en) => { visible = en[0].isIntersecting; }, { rootMargin: '10% 0px' }).observe(sec);
    addEventListener('scroll', read, { passive: true });
    const loop = (time) => { if (visible) render(time); requestAnimationFrame(loop); };
    requestAnimationFrame(loop);
  }
</script>
