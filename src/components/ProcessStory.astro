---
const steps = [
  { t: 'Tu empresa, hoy', d: 'Las ventas viven en una hoja de cálculo, las conversaciones en el chat, las facturas en PDF y los pendientes en notas. Funciona, pero nada se conecta.', items: ['Hojas de cálculo', 'Chats', 'Facturas en PDF', 'Notas', 'Correos', 'Redes'] },
  { t: 'Identidad y diseño', d: 'Empezamos por lo que se ve: una sola cara para toda la empresa.', items: ['Marca', 'Paleta y tipografía', 'Producción creativa'] },
  { t: 'Presencia digital', d: 'Un sitio propio, con tu identidad, que informa y vende todo el día.', items: ['Sitio web', 'Tienda en línea', 'Plataformas'] },
  { t: 'Ventas y CRM', d: 'Cada prospecto avanza por un camino claro. Ningún seguimiento se pierde.', items: ['Embudo de ventas', 'Cotizaciones', 'Seguimiento'] },
  { t: 'Finanzas y administración', d: 'Facturación y flujo de caja en orden, preparados para la revisión de tus contadores y asesores.', items: ['Facturación CFDI 4.0', 'Flujo de caja', 'Administración'] },
  { t: 'Operaciones y datos', d: 'Un panel con indicadores de todas las áreas, en lugar de reportes armados a mano.', items: ['Procesos y proyectos', 'Inventarios', 'Dashboards'] },
  { t: 'IA y automatización', d: 'Asistentes que cotizan, dan seguimiento y preparan la factura, para reducir el trabajo manual.', items: ['Agentes de IA', 'Flujos automáticos', 'Asistentes internos'] },
  { t: 'Un solo ecosistema', d: 'Cada módulo comparte información con los demás bajo un solo estándar. Es el sistema que construimos contigo, paso a paso.', items: ['Un solo estándar', 'Información compartida', 'Crece contigo'] },
];
const ST = 'fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"';
const tools = [
  { key: 'Redes', cx: 86, cy: 96, ax: 22, ay: 18, fx: 0.42, fy: 0.33, ph: 0.4, rot: -8, art: `<rect x="-26" y="-26" width="52" height="52" rx="9"/><circle cx="-9" cy="-9" r="5.5"/><path d="M-26 17L-7 0L7 13L16 5L26 15"/>` },
  { key: 'Correo', cx: 388, cy: 84, ax: 26, ay: 16, fx: 0.31, fy: 0.46, ph: 1.9, rot: 7, art: `<rect x="-30" y="-21" width="60" height="42" rx="6"/><path d="M-30 -17L0 6L30 -17"/>` },
  { key: 'Chat', cx: 238, cy: 196, ax: 30, ay: 22, fx: 0.37, fy: 0.29, ph: 3.1, rot: -5, art: `<path d="M-24 -24H24a8 8 0 0 1 8 8V8a8 8 0 0 1-8 8H-4L-18 28V16H-24a8 8 0 0 1-8-8V-16a8 8 0 0 1 8-8Z"/><path d="M-16 -9H14M-16 2H4"/>` },
  { key: 'Facturas PDF', cx: 84, cy: 300, ax: 20, ay: 26, fx: 0.48, fy: 0.36, ph: 5.2, rot: 9, art: `<path d="M-20 -30H8L22 -16V30H-20Z"/><path d="M8 -30V-16H22"/><path d="M-12 -2H14M-12 9H14M-12 20H6"/>` },
  { key: 'Hojas de cálculo', cx: 392, cy: 300, ax: 24, ay: 20, fx: 0.34, fy: 0.5, ph: 2.6, rot: -7, art: `<rect x="-30" y="-24" width="60" height="48" rx="6"/><path d="M-10 -24V24M10 -24V24M-30 -8H30M-30 8H30"/><rect x="10" y="-8" width="20" height="16" fill="currentColor" fill-opacity=".35" stroke="none"/>` },
  { key: 'Notas', cx: 250, cy: 338, ax: 28, ay: 14, fx: 0.4, fy: 0.44, ph: 4.4, rot: 6, art: `<rect x="-26" y="-28" width="44" height="44" rx="3" transform="rotate(-9)"/><path d="M-16 -8H10M-16 4H2" transform="rotate(-9)"/><path d="M-6 -12H26V20H-2L-6 16Z" fill="var(--bgf, #0b0b0c)"/><path d="M-6 -12H26V20H-2L-6 16Z"/><path d="M2 0H18M2 9H12"/>` },
];
const mods = [
  { n: 'Identidad', sx: 14, sy: 18, sr: -9, gx: 12, gy: 76 },
  { n: 'Sitio web', sx: 318, sy: 6, sr: 7, gx: 172, gy: 76 },
  { n: 'Ventas', sx: 168, sy: 150, sr: -4, gx: 332, gy: 76 },
  { n: 'Finanzas', sx: 6, sy: 296, sr: 8, gx: 12, gy: 212 },
  { n: 'Datos', sx: 326, sy: 276, sr: -7, gx: 172, gy: 212 },
  { n: 'IA', sx: 210, sy: 328, sr: 5, gx: 332, gy: 212 },
];
---

<section id="construccion" data-process data-tone="dark" class="relative z-10 h-[620vh] text-[#f5f4f1]">
  <div data-process-inner class="sticky top-0 h-svh overflow-hidden">
    <div class="relative mx-auto grid h-full max-w-[1280px] grid-rows-[auto_minmax(0,1fr)] gap-4 px-6 pb-6 pt-24 md:grid-cols-12 md:grid-rows-1 md:items-center md:gap-10 md:px-10 md:py-24">
      <div class="md:col-span-6">
        <p class="text-[14px] text-white/45">Cómo lo construimos</p>
        <div class="mt-5 space-y-1 md:mt-8 md:space-y-2.5">
          {steps.map((s, i) => (
            <div class="ps-row" data-row={i}>
              <div class="flex items-baseline gap-4">
                <span class="ps-num w-6 text-[12px] tabular-nums md:w-8 md:text-[13px]">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="ps-title text-[clamp(1.3rem,3vw,2.8rem)] font-light leading-[1.18] tracking-[-0.04em]">{s.t}</h3>
              </div>
              <div class="ps-body pl-10 md:pl-12">
                <div>
                  <p class="max-w-[32rem] pt-2.5 text-[14px] leading-relaxed text-white/65 md:text-[17px]">{s.d}</p>
                  <p class="max-w-[32rem] pb-2 pt-2.5 text-[13px] text-white/40 md:text-[14.5px]">{s.items.join('  ·  ')}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div data-stagewrap class="relative min-h-0 md:col-span-6 md:h-[28rem]">
        <div data-fit class="absolute left-1/2 top-1/2 h-[400px] w-[480px]" role="img" aria-label="Las herramientas sueltas de una empresa se funden, una por una, en módulos que forman un solo sistema">
          <i class="ps-frame"></i>
          {mods.map((m, i) => (
            <div class="mod" data-mod={i} data-gx={m.gx} data-gy={m.gy} style={`--sx:${m.sx}px;--sy:${m.sy}px;--sr:${m.sr}deg;--gx:${m.gx}px;--gy:${m.gy}px`}>
              <span class="absolute left-4 top-3.5 text-[11px] tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <svg viewBox="-34 -34 68 68" class="ico absolute right-3 top-3 size-8" style="--bgf:#f5f4f1" set:html={tools[i].art} {...{ fill: 'none', stroke: 'currentColor', 'stroke-width': 1.6, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }} aria-hidden="true" />
              <span class="absolute bottom-3.5 left-4 text-[16px] font-medium tracking-tight">{m.n}</span>
            </div>
          ))}
          <canvas data-trails class="pointer-events-none absolute inset-0 size-full" aria-hidden="true"></canvas>
          <svg data-glyphs viewBox="0 0 480 400" class="pointer-events-none absolute inset-0 size-full overflow-visible text-[#f5f4f1]" aria-hidden="true">
            <g data-links>
              {[0, 1, 2, 3, 4, 5].map((i) => <g data-link={i}><line stroke="currentColor" stroke-dasharray="3 7" stroke-width="1" /><path stroke="currentColor" stroke-width="1.2" fill="none" /></g>)}
            </g>
            {tools.map((t, i) => (
              <g data-glyph={i}>
                <g {...{ fill: 'none', stroke: 'currentColor', 'stroke-width': 1.5, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' }} set:html={t.art} />
                <text y="50" text-anchor="middle" font-size="12" fill="currentColor" fill-opacity=".6" font-family="Inter Tight Variable, sans-serif">{t.key}</text>
              </g>
            ))}
          </svg>
          <p data-cap class="absolute inset-x-0 top-full mt-3 text-center text-[15px] text-white/55 transition-opacity duration-700">Cada herramienta, por su lado.</p>
          <i data-pointer class="pointer-events-none absolute left-0 top-0 size-[100px] rounded-full border border-white/25 opacity-0 transition-opacity duration-300"></i>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const sec = document.querySelector<HTMLElement>('[data-process]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rows = [...sec.querySelectorAll<HTMLElement>('[data-row]')];
  const mods = [...sec.querySelectorAll<HTMLElement>('[data-mod]')];
  const fitEl = sec.querySelector<HTMLElement>('[data-fit]')!;
  const wrap = sec.querySelector<HTMLElement>('[data-stagewrap]')!;
  const trails = sec.querySelector<HTMLCanvasElement>('[data-trails]')!;
  const tctx = trails.getContext('2d')!;
  const glyphEls = [...sec.querySelectorAll<SVGGElement>('[data-glyph]')];
  const linkEls = [...sec.querySelectorAll<SVGGElement>('[data-link]')];
  const capEl = sec.querySelector<HTMLElement>('[data-cap]')!;
  const ptrEl = sec.querySelector<HTMLElement>('[data-pointer]')!;
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const BW = 480, BH = 400;

  // Loose tools: where they drift today (cx, cy, amplitudes, speeds) and the slot they fall into
  const cfg = [
    { cx: 86, cy: 96, ax: 22, ay: 18, fx: 0.42, fy: 0.33, ph: 0.4, rot: -8 },
    { cx: 388, cy: 84, ax: 26, ay: 16, fx: 0.31, fy: 0.46, ph: 1.9, rot: 7 },
    { cx: 238, cy: 196, ax: 30, ay: 22, fx: 0.37, fy: 0.29, ph: 3.1, rot: -5 },
    { cx: 84, cy: 300, ax: 20, ay: 26, fx: 0.48, fy: 0.36, ph: 5.2, rot: 9 },
    { cx: 392, cy: 300, ax: 24, ay: 20, fx: 0.34, fy: 0.5, ph: 2.6, rot: -7 },
    { cx: 250, cy: 338, ax: 28, ay: 14, fx: 0.4, fy: 0.44, ph: 4.4, rot: 6 },
  ];
  const slots = mods.map((m) => ({ x: Number(m.dataset.gx) + 68, y: Number(m.dataset.gy) + 56 }));
  const g = cfg.map(() => ({ p: 0, off: { x: 0, y: 0 }, x: 0, y: 0, ready: false }));
  const pairs: [number, number][] = [[0, 2], [1, 3], [2, 4], [3, 5], [4, 0], [5, 1]];

  const dpr = Math.min(devicePixelRatio || 1, 2);
  trails.width = BW * dpr; trails.height = BH * dpr;
  tctx.setTransform(dpr, 0, 0, dpr, 0, 0);

  let scale = 1;
  const fit = () => {
    const r = wrap.getBoundingClientRect();
    scale = Math.min(r.width / BW, r.height / BH);
    fitEl.style.transform = `translate(-50%, -50%) scale(${scale.toFixed(4)})`;
  };
  fit();
  addEventListener('resize', fit);

  // Pointer inside the board (design coordinates)
  const ptr = { x: -999, y: -999, in: false };
  wrap.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return;
    const r = fitEl.getBoundingClientRect();
    ptr.x = (e.clientX - r.left) / scale; ptr.y = (e.clientY - r.top) / scale; ptr.in = true;
  });
  wrap.addEventListener('pointerleave', () => { ptr.in = false; ptr.x = ptr.y = -999; });

  let active = -2;
  let idx = 0;
  const update = () => {
    const r = sec.getBoundingClientRect();
    const p = reduced ? 1 : clamp(-r.top / Math.max(1, r.height - innerHeight));
    const next = reduced ? 7 : Math.min(7, Math.floor(p * 7.999));
    if (next === active) return;
    const prev = active;
    active = idx = next;
    rows.forEach((el, i) => {
      el.classList.toggle('is-on', i === next);
      el.classList.toggle('is-done', i < next);
    });
    mods.forEach((el, i) => {
      const on = next >= i + 1;
      if (on && !el.classList.contains('is-in') && prev !== -2) {
        setTimeout(() => { el.classList.add('pop'); setTimeout(() => el.classList.remove('pop'), 800); }, 650);
      }
      el.classList.toggle('is-in', on);
    });
    fitEl.classList.toggle('ps-on-final', next === 7);
    capEl.style.opacity = next === 0 ? '1' : '0';
  };
  update();

  const R = 120; // repel radius
  let last = performance.now();
  const frame = (now: number) => {
    const dt = Math.min(0.05, (now - last) / 1000); last = now;
    const t = now / 1000;
    // fade previous trails
    tctx.globalCompositeOperation = 'destination-out';
    tctx.fillStyle = 'rgba(0,0,0,0.09)';
    tctx.fillRect(0, 0, BW, BH);
    tctx.globalCompositeOperation = 'source-over';

    const pos: { x: number; y: number }[] = [];
    cfg.forEach((c, i) => {
      const st = g[i];
      const target = idx >= i + 1 ? 1 : 0;
      st.p += (target - st.p) * Math.min(1, dt * 2.6);
      const e = st.p * st.p * (3 - 2 * st.p);
      // drift
      let x = c.cx + c.ax * Math.sin(t * c.fx * 2 + c.ph) + Math.sin(t * 0.9 + i) * 4;
      let y = c.cy + c.ay * Math.cos(t * c.fy * 2 + c.ph * 1.3) + Math.cos(t * 0.7 + i) * 4;
      // repel from the pointer
      let fx = 0, fy = 0;
      if (ptr.in && st.p < 0.05) {
        const dx = x - ptr.x, dy = y - ptr.y, d = Math.hypot(dx, dy) || 1;
        if (d < R) { const f = (1 - d / R) ** 2 * 90; fx = (dx / d) * f; fy = (dy / d) * f; }
      }
      st.off.x += (fx - st.off.x) * Math.min(1, dt * 7);
      st.off.y += (fy - st.off.y) * Math.min(1, dt * 7);
      x += st.off.x; y += st.off.y;
      const px = x + (slots[i].x - x) * e;
      const py = y + (slots[i].y - y) * e;
      const rot = c.rot * (1 - e) + Math.sin(t * c.fx + c.ph) * 5 * (1 - e);
      const sc = 1 - 0.5 * e;
      const op = 1 - clamp((st.p - 0.78) / 0.22);
      glyphEls[i].setAttribute('transform', `translate(${px.toFixed(1)} ${py.toFixed(1)}) rotate(${rot.toFixed(1)}) scale(${sc.toFixed(3)})`);
      glyphEls[i].style.opacity = op.toFixed(3);
      pos.push({ x: px, y: py });
      // light trail behind each moving tool
      if (st.ready && op > 0.02) {
        tctx.strokeStyle = `rgba(245,244,241,${(0.28 * op).toFixed(3)})`;
        tctx.lineWidth = 1.4; tctx.lineCap = 'round';
        tctx.beginPath(); tctx.moveTo(st.x, st.y); tctx.lineTo(px, py); tctx.stroke();
      }
      st.x = px; st.y = py; st.ready = true;
    });

    // broken connections: dashed lines with a cross that never close
    pairs.forEach(([a, b], k) => {
      const el = linkEls[k];
      const A = pos[a], B = pos[b];
      const vis = (1 - g[a].p) * (1 - g[b].p);
      const line = el.firstElementChild as SVGLineElement;
      const cross = el.lastElementChild as SVGPathElement;
      line.setAttribute('x1', A.x.toFixed(1)); line.setAttribute('y1', A.y.toFixed(1));
      line.setAttribute('x2', B.x.toFixed(1)); line.setAttribute('y2', B.y.toFixed(1));
      const mx = (A.x + B.x) / 2, my = (A.y + B.y) / 2;
      cross.setAttribute('d', `M${(mx - 4).toFixed(1)} ${(my - 4).toFixed(1)}l8 8M${(mx + 4).toFixed(1)} ${(my - 4).toFixed(1)}l-8 8`);
      const blink = 0.55 + 0.45 * Math.sin(t * 2.2 + k * 1.7);
      line.style.opacity = (0.28 * vis).toFixed(3);
      cross.style.opacity = (0.5 * vis * blink).toFixed(3);
    });

    // pointer ring
    const showRing = ptr.in && idx === 0;
    ptrEl.style.opacity = showRing ? '1' : '0';
    ptrEl.style.transform = `translate3d(${ptr.x - 50}px, ${ptr.y - 50}px, 0)`;

    if (!document.hidden) requestAnimationFrame(frame);
  };

  if (!reduced) {
    let queued = false;
    const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; update(); }); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    requestAnimationFrame(frame);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) { last = performance.now(); requestAnimationFrame(frame); } });
  } else {
    rows.forEach((el) => el.classList.add('is-done'));
    glyphEls.forEach((el) => (el.style.opacity = '0'));
    linkEls.forEach((el) => (el.style.display = 'none'));
    capEl.style.display = 'none';
  }
</script>
