---
const steps = [
  { t: 'Tu empresa, hoy', d: 'Las ventas viven en una hoja de cálculo, las conversaciones en el chat, las facturas en PDF y los pendientes en notas. Funciona, pero nada se conecta.', items: ['Hojas de cálculo', 'Chats', 'Facturas en PDF', 'Notas sueltas'] },
  { t: 'Identidad y diseño', d: 'Empezamos por lo que se ve: una sola cara para toda la empresa.', items: ['Marca', 'Paleta y tipografía', 'Producción creativa'] },
  { t: 'Presencia digital', d: 'Un sitio propio, con tu identidad, que informa y vende todo el día.', items: ['Sitio web', 'Tienda en línea', 'Plataformas'] },
  { t: 'Ventas y CRM', d: 'Cada prospecto avanza por un camino claro. Ningún seguimiento se pierde.', items: ['Embudo de ventas', 'Cotizaciones', 'Seguimiento'] },
  { t: 'Finanzas y administración', d: 'Facturación y flujo de caja en orden, preparados para la revisión de tus contadores y asesores.', items: ['Facturación CFDI 4.0', 'Flujo de caja', 'Administración'] },
  { t: 'Operaciones y datos', d: 'Un panel con indicadores de todas las áreas, en lugar de reportes armados a mano.', items: ['Procesos y proyectos', 'Inventarios', 'Dashboards'] },
  { t: 'IA y automatización', d: 'Asistentes que cotizan, dan seguimiento y preparan la factura, para reducir el trabajo manual.', items: ['Agentes de IA', 'Flujos automáticos', 'Asistentes internos'] },
  { t: 'Un solo ecosistema', d: 'Cada módulo comparte información con los demás bajo un solo estándar. Es el sistema que construimos contigo, paso a paso.', items: ['Un solo estándar', 'Información compartida', 'Crece contigo'] },
];
const mods = [
  { n: 'Identidad', sx: 14, sy: 18, sr: -9, gx: 12, gy: 76 },
  { n: 'Sitio web', sx: 318, sy: 6, sr: 7, gx: 172, gy: 76 },
  { n: 'Ventas', sx: 168, sy: 150, sr: -4, gx: 332, gy: 76 },
  { n: 'Finanzas', sx: 6, sy: 296, sr: 8, gx: 12, gy: 212 },
  { n: 'Datos', sx: 326, sy: 276, sr: -7, gx: 172, gy: 212 },
  { n: 'IA', sx: 210, sy: 328, sr: 5, gx: 332, gy: 212 },
];
---

<section id="construccion" data-process data-tone="dark" class="relative z-10 h-[620vh] bg-[#0b0b0c] text-[#f5f4f1]">
  <div data-process-inner class="sticky top-0 h-svh overflow-hidden">
    <div class="relative mx-auto grid h-full max-w-[1280px] grid-rows-[auto_minmax(0,1fr)] gap-4 px-6 pb-6 pt-24 md:grid-cols-12 md:grid-rows-1 md:items-center md:gap-10 md:px-10 md:py-24">
      <div class="md:col-span-6">
        <p class="text-[14px] text-white/45">Cómo lo construimos</p>
        <div class="mt-5 space-y-1 md:mt-8 md:space-y-2.5">
          {steps.map((s, i) => (
            <div class="ps-row" data-row={i}>
              <div class="flex items-baseline gap-4">
                <span class="ps-num w-6 text-[12px] tabular-nums md:w-8 md:text-[13px]">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="ps-title text-[clamp(1.3rem,3vw,2.8rem)] font-light leading-[1.18] tracking-[-0.04em]">{s.t}</h3>
              </div>
              <div class="ps-body pl-10 md:pl-12">
                <div>
                  <p class="max-w-[32rem] pt-2.5 text-[14px] leading-relaxed text-white/65 md:text-[17px]">{s.d}</p>
                  <p class="max-w-[32rem] pb-2 pt-2.5 text-[13px] text-white/40 md:text-[14.5px]">{s.items.join('  ·  ')}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div data-stagewrap class="relative min-h-0 md:col-span-6 md:h-[28rem]">
        <div data-fit class="absolute left-1/2 top-1/2 h-[400px] w-[480px]" role="img" aria-label="Módulos de la empresa que se acomodan hasta formar un solo sistema">
          <i class="ps-frame"></i>
          {mods.map((m, i) => (
            <div class="mod" data-mod={i} style={`--sx:${m.sx}px;--sy:${m.sy}px;--sr:${m.sr}deg;--gx:${m.gx}px;--gy:${m.gy}px`}>
              <span class="absolute left-4 top-3.5 text-[11px] tabular-nums">{String(i + 1).padStart(2, '0')}</span>
              <span class="absolute bottom-3.5 left-4 text-[16px] font-medium tracking-tight">{m.n}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const sec = document.querySelector<HTMLElement>('[data-process]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rows = [...sec.querySelectorAll<HTMLElement>('[data-row]')];
  const mods = [...sec.querySelectorAll<HTMLElement>('[data-mod]')];
  const fitEl = sec.querySelector<HTMLElement>('[data-fit]')!;
  const wrap = sec.querySelector<HTMLElement>('[data-stagewrap]')!;
  const clamp = (v: number) => Math.min(1, Math.max(0, v));

  const fit = () => {
    const r = wrap.getBoundingClientRect();
    const s = Math.min(r.width / 480, r.height / 400);
    fitEl.style.transform = `translate(-50%, -50%) scale(${s.toFixed(4)})`;
  };
  fit();
  addEventListener('resize', fit);

  let active = -2;
  const update = () => {
    const r = sec.getBoundingClientRect();
    const p = reduced ? 1 : clamp(-r.top / Math.max(1, r.height - innerHeight));
    const idx = reduced ? 7 : Math.min(7, Math.floor(p * 7.999));
    if (idx === active) return;
    active = idx;
    rows.forEach((el, i) => {
      el.classList.toggle('is-on', i === idx);
      el.classList.toggle('is-done', i < idx);
    });
    mods.forEach((el, i) => el.classList.toggle('is-in', idx >= i + 1));
    fitEl.classList.toggle('ps-on-final', idx === 7);
  };
  update();
  if (!reduced) {
    let queued = false;
    const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; update(); }); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
  } else {
    rows.forEach((el) => el.classList.add('is-done'));
  }
</script>
