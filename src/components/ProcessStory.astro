---
const titles = ['Tu empresa, hoy', 'Identidad y diseño', 'Presencia digital', 'Finanzas y administración', 'Operaciones y datos', 'IA y automatización', 'Un solo ecosistema'];
const labels = ['Identidad', 'Sitio web', 'Finanzas', 'Datos', 'Asistentes'];
const SB = [
  '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  '<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>',
  '<path d="M5 19L19 5"/><circle cx="7.5" cy="7.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/>',
  '<path d="M3 10l9-6 9 6M5 10v8M10 10v8M14 10v8M19 10v8M3 20h18"/>',
  '<path d="M5 20V10M12 20V4M19 20v-7"/>',
];
const ramp = (v: number) => (v < 0.25 ? '#f4efe6' : v < 0.5 ? '#f2d9a8' : v < 0.78 ? '#d9a24f' : '#8a5a2b');
const HM = Array.from({ length: 4 }, (_, r) => Array.from({ length: 24 }, (_, c) => ramp(Math.max(0, Math.min(1, 0.5 + 0.42 * Math.sin((c - 6 - r * 2.2) / 3.4) + 0.2 * Math.sin(c * 1.7 + r * 3.1) - (c < 3 || c > 21 ? 0.35 : 0))))));
const FR: Record<string, string> = {
  sheet: '<svg viewBox="0 0 120 90"><rect width="120" height="90" rx="8" fill="#fff" stroke="#dadce0"/><path d="M0 22H120M0 44H120M0 66H120M40 0V90M80 0V90" stroke="#e3e6ea"/><rect x="42" y="24" width="36" height="18" fill="#e8eaed"/><rect x="4" y="48" width="30" height="5" rx="2.5" fill="#dadce0"/></svg>',
  pdf: '<svg viewBox="0 0 80 100"><path d="M6 2H52L74 24V98H6Z" fill="#fff" stroke="#dadce0"/><path d="M52 2V24H74" fill="none" stroke="#dadce0"/><rect x="16" y="38" width="48" height="5" rx="2.5" fill="#e3e6ea"/><rect x="16" y="50" width="38" height="5" rx="2.5" fill="#e3e6ea"/><rect x="16" y="62" width="44" height="5" rx="2.5" fill="#e3e6ea"/><text x="16" y="88" font-size="12" fill="#9aa0a6" font-weight="600" font-family="sans-serif">PDF</text></svg>',
  chat: '<svg viewBox="0 0 120 64"><path d="M14 2H106a12 12 0 0 1 12 12V36a12 12 0 0 1-12 12H40L22 62V48H14A12 12 0 0 1 2 36V14A12 12 0 0 1 14 2Z" fill="#fff" stroke="#dadce0"/><rect x="18" y="16" width="70" height="5" rx="2.5" fill="#e3e6ea"/><rect x="18" y="28" width="48" height="5" rx="2.5" fill="#e3e6ea"/></svg>',
  chat2: '<svg viewBox="0 0 100 52"><path d="M12 2H88a10 10 0 0 1 10 10V28a10 10 0 0 1-10 10H78V50L62 38H12A10 10 0 0 1 2 28V12A10 10 0 0 1 12 2Z" fill="#e8eaed"/><rect x="14" y="14" width="56" height="5" rx="2.5" fill="#bdc1c6"/></svg>',
  note: '<svg viewBox="0 0 90 90"><path d="M4 4H86V64L64 86H4Z" fill="#f1f3f4" stroke="#dadce0"/><path d="M64 86V64H86" fill="#e3e6ea"/><rect x="14" y="18" width="54" height="5" rx="2.5" fill="#bdc1c6"/><rect x="14" y="32" width="40" height="5" rx="2.5" fill="#cfd2d6"/><rect x="14" y="46" width="48" height="5" rx="2.5" fill="#cfd2d6"/></svg>',
  mail: '<svg viewBox="0 0 100 68"><rect x="2" y="2" width="96" height="64" rx="10" fill="#fff" stroke="#dadce0"/><path d="M6 10L50 40L94 10" fill="none" stroke="#bdc1c6" stroke-width="2.5" stroke-linecap="round"/></svg>',
  photo: '<svg viewBox="0 0 110 80"><rect x="2" y="2" width="106" height="76" rx="10" fill="#e8eaed"/><circle cx="34" cy="28" r="9" fill="#cfd2d6"/><path d="M2 66L38 40L62 58L80 44L108 64V68a10 10 0 0 1-10 10H12A10 10 0 0 1 2 68Z" fill="#cfd2d6"/></svg>',
  chart: '<svg viewBox="0 0 90 70"><rect x="2" y="2" width="86" height="66" rx="10" fill="#fff" stroke="#dadce0"/><rect x="16" y="38" width="10" height="20" rx="3" fill="#dadce0"/><rect x="34" y="26" width="10" height="32" rx="3" fill="#cfd2d6"/><rect x="52" y="44" width="10" height="14" rx="3" fill="#dadce0"/><rect x="70" y="32" width="10" height="26" rx="3" fill="#cfd2d6"/></svg>',
  post: '<svg viewBox="0 0 80 96"><rect x="2" y="2" width="76" height="92" rx="12" fill="#fff" stroke="#dadce0"/><circle cx="20" cy="20" r="9" fill="#e3e6ea"/><rect x="34" y="14" width="34" height="5" rx="2.5" fill="#e3e6ea"/><rect x="10" y="38" width="60" height="32" rx="6" fill="#e8eaed"/><path d="M20 82c-6-4-9-7-9-10a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 3-3 6-9 10Z" fill="#cfd2d6"/></svg>',
  cal: '<svg viewBox="0 0 90 84"><rect x="2" y="2" width="86" height="80" rx="10" fill="#fff" stroke="#dadce0"/><rect x="2" y="2" width="86" height="20" rx="10" fill="#e8eaed"/><g fill="#e3e6ea"><rect x="12" y="32" width="12" height="10" rx="2"/><rect x="30" y="32" width="12" height="10" rx="2"/><rect x="48" y="32" width="12" height="10" rx="2"/><rect x="66" y="32" width="12" height="10" rx="2"/><rect x="12" y="50" width="12" height="10" rx="2"/><rect x="30" y="50" width="12" height="10" rx="2" fill="#cfd2d6"/><rect x="48" y="50" width="12" height="10" rx="2"/></g></svg>',
};
const frags = [
  ['sheet', 12, 24, 150, -8, 120], ['pdf', 27, 66, 84, 10, -80], ['chat', 74, 22, 140, 6, 60], ['note', 88, 62, 90, -12, -220], ['mail', 46, 16, 100, -5, 180],
  ['photo', 63, 70, 128, 8, 20], ['chart', 8, 70, 100, 12, -160], ['post', 82, 40, 78, -9, 240], ['cal', 36, 44, 96, 7, -40], ['chat2', 20, 44, 112, -6, 140],
  ['pdf', 55, 38, 74, -14, -300], ['sheet', 70, 50, 104, 5, -120], ['note', 41, 78, 80, 9, 90], ['mail', 90, 14, 84, 11, -60], ['photo', 4, 40, 96, -10, 200], ['post', 52, 60, 66, 7, -180],
];
---

<section id="construccion" data-tone="light" data-titles={JSON.stringify(titles)} class="relative z-10 font-goog text-[#202124]">
  <!-- fog: the sunset dissolves into the white chapter -->
  <div class="pointer-events-none absolute inset-x-0 -top-[26svh] z-20 h-[26svh] bg-gradient-to-b from-white/0 to-white" aria-hidden="true"></div>
  <div data-process class="h-[620vh] bg-white">
    <div data-process-inner class="sticky top-0 h-svh overflow-hidden bg-[radial-gradient(ellipse_at_50%_46%,#f4f7ff_0%,#fff_62%)]">
      <p class="absolute inset-x-0 top-[86px] z-20 text-center text-[15px] text-[#5f6368]">Cómo lo construimos</p>

      <!-- camera -->
      <div data-cam class="absolute inset-0" style="perspective:1800px" role="img" aria-label="Piezas sueltas de una empresa se convierten, una por una, en módulos conectados que forman un solo sistema">
        <div data-world class="absolute left-1/2 top-1/2 size-0" style="transform-style:preserve-3d">
          {labels.map((l, i) => (
            <div class={`pn${i === 1 ? ' dk' : ''}`} data-pn={i}>
              <span class="lb">{l}</span>
              <span class="ok rv" style="--a:.9;--b:.08">Listo</span>

              {i === 0 && (<>
                <div class="absolute left-6 top-[60px] h-[316px] w-[220px] overflow-hidden rounded-[20px] bg-[#1a1410]">
                  <img src="/process/portale-bg.webp" alt="" width="1589" height="990" decoding="async" class="zi absolute inset-0 size-full object-cover" style="--a:.02;--b:.25;object-position:36% 50%" />
                  <i class="absolute inset-0" style="background:linear-gradient(to bottom,rgba(20,12,8,.35),rgba(20,12,8,.1) 40%,rgba(20,12,8,.55))"></i>
                  <div class="absolute inset-x-0 top-[104px] flex flex-col items-center text-white">
                    <svg class="rv" style="--a:.1;--b:.2" width="46" height="46" viewBox="0 0 34 34" aria-hidden="true"><rect x="2" y="2" width="30" height="30" rx="9" fill="none" stroke="#f4efe6" stroke-width="1.5"/><path d="M9 23c3-9.5 13-9.5 16 0" fill="none" stroke="#f4efe6" stroke-width="1.5" stroke-linecap="round"/><circle cx="17" cy="14" r="2.8" fill="#f2b866"/></svg>
                    <span class="wm rv mt-3 text-[26px] font-light leading-none" style="--a:.22;--b:.3">ALBA</span>
                    <i class="gx mt-3 block h-px w-[84px] bg-white/60" style="--a:.4;--b:.2"></i>
                    <span class="rv mt-2.5 text-[11px] tracking-wide text-white/85" style="--a:.46;--b:.2">Un nuevo horizonte</span>
                  </div>
                </div>
                {[['#f4efe6', 'F4EFE6', '#6e6559'], ['#f2b866', 'F2B866', '#5a3a12'], ['#e0814f', 'E0814F', '#fff'], ['#7a4a32', '7A4A32', '#fff'], ['#1a1410', '1A1410', '#fff']].map(([c, h, t], k) => (
                  <i class="gy absolute top-[60px] flex h-[150px] w-[52px] items-end justify-center rounded-[14px] pb-2.5 text-[8.5px] font-medium not-italic tracking-wider ring-1 ring-black/5" style={`left:${268 + k * 62}px;background:${c};color:${t};--a:${0.22 + k * 0.06};--b:.26`}><span class="rv" style={`--a:${0.5 + k * 0.05};--b:.12`}>{h}</span></i>
                ))}
                <div class="rv absolute left-[268px] top-[226px] flex h-[150px] w-[120px] flex-col items-center justify-center rounded-[18px] bg-[#f6f1e8]" style="--a:.5;--b:.25"><span class="text-[78px] font-light leading-none tracking-[-0.04em] text-[#1a1410]">Aa</span><span class="mt-2 text-[10px] tracking-wide text-[#6e6559]">Light · Regular</span></div>
                <div class="rv absolute left-[404px] top-[246px] h-[96px] w-[150px] -rotate-[5deg] rounded-[14px] bg-[#1a1410] p-3.5" style="--a:.62;--b:.25">
                  <svg width="24" height="24" viewBox="0 0 34 34" aria-hidden="true"><rect x="2" y="2" width="30" height="30" rx="9" fill="none" stroke="#f2b866" stroke-width="2"/><circle cx="17" cy="14" r="3" fill="#f2b866"/></svg>
                  <i class="mt-4 block h-[5px] w-16 rounded-full bg-[#f4efe6]/80"></i><i class="mt-2 block h-[5px] w-10 rounded-full bg-[#f4efe6]/40"></i>
                </div>
                <div class="rv absolute left-[566px] top-[230px] flex size-[50px] items-center justify-center rounded-full bg-[#f6f1e8]" style="--a:.72;--b:.2"><i class="size-[18px] rounded-full bg-[#e0814f]"></i></div>
              </>)}

              {i === 1 && (<>
                <div class="site absolute inset-0 overflow-hidden">
                  <!-- page 1: hero -->
                  <div class="s1 absolute inset-0">
                    <img src="/process/portale-bg.webp" alt="" width="1589" height="990" decoding="async" class="zi absolute inset-0 size-full object-cover" style="--a:0;--b:.18" />
                    <i class="absolute inset-0" style="background:linear-gradient(to top,rgba(10,7,6,.38),rgba(10,7,6,0) 46%),linear-gradient(to bottom,rgba(10,7,6,.3),rgba(10,7,6,0) 22%)"></i>
                    <span class="rv absolute left-[18px] top-[11px] text-[15px] font-light tracking-[0.12em]" style="--a:.1;--b:.15">ALBA</span>
                    <div class="rv absolute inset-x-0 top-[8px] mx-auto flex w-fit gap-4 rounded-full border border-white/25 bg-white/10 px-4 py-[6px] text-[9.5px] text-white/95" style="--a:.14;--b:.16">
                      <span>Producto</span><span>Beneficios</span><span>Equipo</span><span>Precios</span><span>Soporte</span>
                    </div>
                    <div class="rv absolute right-4 top-[7px] flex gap-1.5 text-[9.5px]" style="--a:.18;--b:.16"><span class="rounded-full border border-white/30 px-3 py-[6px] text-white/95">Cuenta</span><span class="rounded-full bg-white px-3 py-[6px] font-medium text-[#1a1410]">Acceso demo</span></div>
                    <div class="gcard rv absolute left-[267px] top-[94px] h-[188px] w-[108px]" style="--a:.4;--b:.28">
                      <svg width="108" height="188" viewBox="0 0 108 188" aria-hidden="true">
                        <defs><linearGradient id="cdB" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".32"/><stop offset=".4" stop-color="#fff" stop-opacity=".04"/><stop offset="1" stop-color="#fff" stop-opacity=".16"/></linearGradient></defs>
                        <path d="M1 1L107 9V181L1 187Z" fill="url(#cdB)" stroke="rgba(255,255,255,.75)" stroke-width="1.4" stroke-linejoin="round"/>
                        <rect x="14" y="16" width="24" height="19" rx="5" fill="rgba(255,255,255,.12)" stroke="rgba(255,255,255,.9)" stroke-width="1.2"/><path d="M14 22H22V29H14M38 22H30V29H38M22 16V35M30 16V35" fill="none" stroke="rgba(255,255,255,.8)" stroke-width="1"/>
                        <circle cx="86" cy="166" r="7" fill="none" stroke="rgba(255,255,255,.8)" stroke-width="1.2"/>
                      </svg>
                      <span class="absolute right-[12px] top-[46px] text-[11px] font-light tracking-[0.3em] text-white" style="writing-mode:vertical-rl">ALBA</span>
                    </div>
                    <p class="rv absolute bottom-[134px] left-[14px] text-[9.5px] text-white" style="--a:.28;--b:.14"><i class="mr-2 inline-block size-[7px] bg-white align-middle"></i>Temporada de apertura 2026</p>
                    <h4 class="absolute bottom-[50px] left-[14px] text-[36px] font-normal leading-[1.04] tracking-[-0.02em] text-white [text-shadow:0_2px_20px_rgba(30,12,2,.35)]">
                      <span class="block overflow-hidden"><span class="rl block" style="--a:.26;--b:.2">Un nuevo horizonte,</span></span>
                      <span class="block overflow-hidden"><span class="rl block" style="--a:.33;--b:.2">cada mañana.</span></span>
                    </h4>
                    <div class="absolute bottom-[12px] left-[14px] flex gap-2.5 text-[10.5px]">
                      <span class="btn rv rounded-full bg-white px-[18px] py-[8px] font-medium text-[#1a1410]" style="--a:.5;--b:.14">Ver beneficios</span>
                      <span class="rv rounded-full border border-white/50 px-[16px] py-[8px] text-white" style="--a:.54;--b:.14">▷ Ver demo</span>
                    </div>
                    <p class="rv absolute bottom-[14px] right-[14px] w-[200px] text-[9.5px] leading-[1.5] text-white [text-shadow:0_1px_10px_rgba(30,12,2,.5)]" style="--a:.58;--b:.16">Una marca que abre caminos: identidad, sitio y operación pensados juntos desde el primer día.</p>
                    <i class="ripple absolute block size-[30px] rounded-full border border-white/80" style="left:60px;bottom:10px"></i>
                  </div>
                  <!-- cursor -->
                  <svg class="cur absolute z-20" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 2l16 9-7 2-3 7z" fill="#fff" stroke="#14110f" stroke-width="1.5" stroke-linejoin="round"/></svg>
                </div>
              </>)}

              {i === 2 && (<>
                <div class="dash absolute inset-y-0 left-0 w-[58px] border-r border-[#ece7dd] bg-[#faf8f4]">
                  <svg class="rv absolute left-[14px] top-[18px]" style="--a:.02;--b:.12" width="30" height="30" viewBox="0 0 34 34" aria-hidden="true"><rect x="2" y="2" width="30" height="30" rx="9" fill="none" stroke="#1f1b16" stroke-width="1.8"/><path d="M9 23c3-9.5 13-9.5 16 0" fill="none" stroke="#1f1b16" stroke-width="1.8" stroke-linecap="round"/><circle cx="17" cy="14" r="2.8" fill="#d9a24f"/></svg>
                  {SB.map((d, k) => (
                    <span class={`rv absolute left-[11px] flex size-[36px] items-center justify-center rounded-[11px] ${k === 0 ? 'bg-[#1f1b16] text-white' : 'text-[#9a9184]'}`} style={`top:${70 + k * 44}px;--a:${0.04 + k * 0.04};--b:.1`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={d} /></span>
                  ))}
                  <i class="absolute bottom-[16px] left-[15px] flex size-[28px] items-center justify-center rounded-full bg-[#f2d9a8] text-[11px] font-medium not-italic text-[#5a3a12]">A</i>
                </div>
                <div class="absolute left-[82px] top-[16px]"><p class="rv text-[15px] font-medium text-[#1f1b16]" style="--a:.02;--b:.12">Finanzas</p><p class="rv text-[11px] text-[#9a9184]" style="--a:.04;--b:.12">Octubre 2026 · MXN</p></div>
                <div class="absolute left-[82px] right-6 top-[68px] flex">
                  {[['Ingresos', 1284000, '▲ 8.2 %'], ['Gastos', 512400, '▼ 2.1 %'], ['Utilidad', 771600, '▲ 14.6 %']].map(([l, v, d], k) => (
                    <div class={`rv flex-1 ${k ? 'border-l border-[#ece7dd] pl-4' : ''}`} style={`--a:${0.08 + k * 0.08};--b:.14`}>
                      <p class="text-[11px] text-[#9a9184]">{l}</p>
                      <p class="mt-0.5 text-[21px] font-normal tabular-nums tracking-[-0.02em] text-[#1f1b16]">$<span data-count={v} data-a={0.1 + k * 0.08} data-b=".35">0</span></p>
                      <p class="mt-0.5 text-[10.5px] text-[#b9772f]">{d}</p>
                    </div>
                  ))}
                </div>
                <div class="absolute left-[82px] top-[150px] w-[334px]">
                  <div class="rv flex items-center justify-between" style="--a:.2;--b:.12"><p class="text-[12.5px] font-medium text-[#1f1b16]">Ingresos y gastos</p>
                    <p class="flex items-center gap-3 text-[10.5px] text-[#6e6559]"><span class="flex items-center gap-1.5"><i class="size-2 rounded-full bg-[#1f1b16]"></i>Ingresos</span><span class="flex items-center gap-1.5"><i class="size-2 rounded-full bg-[#d9a24f]"></i>Gastos</span></p></div>
                  <svg class="mt-2" width="334" height="186" viewBox="0 0 334 186" aria-hidden="true">
                    {[20, 60, 100, 140].map((y) => <path d={`M0 ${y}H334`} stroke="#f0ece3"/>)}
                    <path d="M0 160H334" stroke="#e3ddd0"/>
                    {['May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct'].map((m, k) => (
                      <g>
                        <rect class="gy" style={`--a:${0.26 + k * 0.06};--b:.2`} x={12 + k * 54} y={160 - [86, 96, 78, 110, 104, 124][k]} width="17" height={[86, 96, 78, 110, 104, 124][k]} rx="4" fill="#1f1b16"/>
                        <rect class="gy" style={`--a:${0.3 + k * 0.06};--b:.2`} x={31 + k * 54} y={160 - [52, 58, 50, 62, 56, 64][k]} width="17" height={[52, 58, 50, 62, 56, 64][k]} rx="4" fill="#d9a24f"/>
                        <text x={30 + k * 54} y="178" font-size="10" fill="#9a9184" text-anchor="middle" font-family="Google Sans Flex Variable, sans-serif">{m}</text>
                      </g>
                    ))}
                  </svg>
                </div>
                <div class="absolute right-6 top-[150px] w-[176px]">
                  <p class="rv text-[12.5px] font-medium text-[#1f1b16]" style="--a:.24;--b:.12">Próximos vencimientos</p>
                  <div class="mt-2">
                    {[['15', 'nov', 'Facturación CFDI', 'Emitir y timbrar'], ['17', 'nov', 'IVA mensual', 'Revisa tu contador'], ['28', 'nov', 'Nómina', 'Programada'], ['30', 'nov', 'Proveedores', '3 pagos']].map(([d, m, t, s], k) => (
                      <div class="rv flex items-center gap-2.5 border-t border-[#f0ece3] py-[8px]" style={`--a:${0.3 + k * 0.09};--b:.12`}>
                        <span class="flex size-[34px] shrink-0 flex-col items-center justify-center rounded-[9px] bg-[#faf8f4] leading-none"><b class="text-[13px] font-medium text-[#1f1b16]">{d}</b><i class="mt-0.5 text-[8.5px] not-italic uppercase tracking-wider text-[#9a9184]">{m}</i></span>
                        <span class="min-w-0"><span class="block truncate text-[11.5px] text-[#1f1b16]">{t}</span><span class="block truncate text-[10px] text-[#9a9184]">{s}</span></span>
                      </div>
                    ))}
                  </div>
                </div>
              </>)}

              {i === 3 && (<>
                <div class="dash absolute inset-x-6 top-[16px] flex items-center justify-between pr-[78px]">
                  <div class="rv flex items-baseline gap-3" style="--a:.02;--b:.12"><p class="text-[15px] font-medium text-[#1f1b16]">Operaciones</p><span class="text-[11px] text-[#9a9184]">Semana 44</span></div>
                  <div class="rv flex rounded-full bg-[#f4f0e8] p-[3px] text-[11px]" style="--a:.04;--b:.12">{['Día', 'Semana', 'Mes'].map((t, k) => <span class={`rounded-full px-3 py-[3px] ${k === 1 ? 'bg-[#1f1b16] text-white' : 'text-[#6e6559]'}`}>{t}</span>)}</div>
                </div>
                <div class="absolute left-6 top-[60px] w-[340px]">
                  <p class="rv text-[11px] text-[#9a9184]" style="--a:.06;--b:.12">Pedidos</p>
                  <p class="rv flex items-baseline gap-3" style="--a:.08;--b:.15"><span class="text-[36px] font-light leading-[1.1] tracking-[-0.03em] text-[#1f1b16]" data-count="1284" data-a=".1" data-b=".4">0</span><span class="text-[11px] text-[#b9772f]">▲ 6.4 % frente a la semana anterior</span></p>
                  <svg class="mt-1" width="340" height="132" viewBox="0 0 340 132" aria-hidden="true" style="overflow:visible">
                    <defs><linearGradient id="dgB" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#d9a24f" stop-opacity=".32"/><stop offset="1" stop-color="#d9a24f" stop-opacity="0"/></linearGradient></defs>
                    {[30, 70].map((y) => <path d={`M0 ${y}H340`} stroke="#f0ece3"/>)}
                    <path d="M0 110H340" stroke="#e3ddd0"/>
                    <path class="gx" style="--a:.3;--b:.4" d="M8 88 L64 70 L120 78 L176 40 L232 52 L288 26 L332 34 V110 H8Z" fill="url(#dgB)"/>
                    <path class="dw" style="--a:.28;--b:.44" d="M8 88 L64 70 L120 78 L176 40 L232 52 L288 26 L332 34" fill="none" stroke="#1f1b16" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" pathLength="100"/>
                    {[[8, 88], [64, 70], [120, 78], [176, 40], [232, 52], [288, 26], [332, 34]].map(([x, y], k) => <circle class="fl" style={`--a:${0.32 + k * 0.07};--b:.08`} cx={x} cy={y} r={k === 3 ? 5 : 3.2} fill={k === 3 ? '#d9a24f' : '#fff'} stroke="#1f1b16" stroke-width="1.8"/>)}
                    <path class="rv" style="--a:.6;--b:.1" d="M176 46V110" stroke="#d9a24f" stroke-dasharray="3 4"/>
                    {['L', 'M', 'M', 'J', 'V', 'S', 'D'].map((d, k) => <text x={8 + k * 54} y="126" font-size="10" fill="#9a9184" text-anchor="middle" font-family="Google Sans Flex Variable, sans-serif">{d}</text>)}
                  </svg>
                </div>
                <div class="absolute right-6 top-[64px] grid w-[232px] grid-cols-2">
                  {[['Entregas a tiempo', '96', ' %', [5, 6, 5, 7, 8]], ['Ciclo medio', '2.4', ' d', [8, 7, 6, 6, 5]], ['Incidencias', '12', '', [6, 8, 5, 4, 3]], ['Satisfacción', '4.8', ' / 5', [5, 5, 6, 7, 7]]].map(([l, v, u, bars], k) => (
                    <div class={`rv py-3 ${k % 2 ? 'border-l border-[#ece7dd] pl-4' : 'pr-4'} ${k > 1 ? 'border-t border-[#ece7dd]' : ''}`} style={`--a:${0.12 + k * 0.08};--b:.14`}>
                      <p class="text-[10.5px] text-[#9a9184]">{l}</p>
                      <p class="mt-0.5 text-[22px] font-light leading-none tracking-[-0.02em] text-[#1f1b16]">{v}<span class="text-[11px] text-[#9a9184]">{u}</span></p>
                      <div class="mt-2 flex h-[14px] items-end gap-[3px]">{bars.map((h, j) => <i class="gy block w-[6px] rounded-[2px] bg-[#d9a24f]" style={`height:${h * 1.6}px;--a:${0.3 + k * 0.06 + j * 0.03};--b:.16`}></i>)}</div>
                    </div>
                  ))}
                </div>
                <div class="absolute inset-x-6 top-[286px]">
                  <div class="rv flex items-center justify-between" style="--a:.5;--b:.12"><p class="text-[11.5px] font-medium text-[#1f1b16]">Actividad por hora</p><p class="flex items-center gap-1.5 text-[10px] text-[#9a9184]">menos<i class="block h-[7px] w-[54px] rounded-full" style="background:linear-gradient(90deg,#f4efe6,#f2d9a8,#d9a24f,#8a5a2b)"></i>más</p></div>
                  <div class="mt-2 space-y-[4px]">
                    {HM.map((row, r) => (
                      <div class="flex items-center gap-3"><span class="rv w-[68px] text-[10.5px] text-[#6e6559]" style={`--a:${0.52 + r * 0.05};--b:.1`}>{['Compras', 'Producción', 'Envíos', 'Entregas'][r]}</span>
                        <div class="flex flex-1 gap-[3px]">{row.map((c, k) => <i class="fl block h-[16px] flex-1 rounded-[3px]" style={`background:${c};--a:${0.54 + (r + k) * 0.012};--b:.1`}></i>)}</div></div>
                    ))}
                  </div>
                </div>
              </>)}

              {i === 4 && (<>
                <div class="absolute left-6 top-[54px] w-[318px]">
                  <div class="rv flex items-center gap-2" style="--a:.02;--b:.12"><svg width="16" height="16" viewBox="0 0 24 24" fill="#d9a24f" aria-hidden="true"><path d="M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4z"/></svg><p class="text-[13.5px] font-medium text-[#1f1b16]">Asistente comercial</p></div>
                  <div class="rv mt-4 flex gap-3" style="--a:.06;--b:.12"><i class="flex size-[24px] shrink-0 items-center justify-center rounded-full bg-[#f4f0e8] text-[10.5px] font-medium not-italic text-[#6e6559]">Tú</i>
                    <p class="text-[13px] leading-[1.45] text-[#1f1b16]"><span class="type block overflow-hidden whitespace-nowrap" style="--a:.08;--b:.22">Cotiza el proyecto para Estudio Aurora</span></p></div>
                  <div class="rv mt-4 flex gap-3" style="--a:.3;--b:.12"><i class="flex size-[24px] shrink-0 items-center justify-center rounded-full bg-[#1f1b16]"><svg width="12" height="12" viewBox="0 0 24 24" fill="#f2b866" aria-hidden="true"><path d="M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4z"/></svg></i>
                    <p class="text-[13px] text-[#1f1b16]">Listo. Preparé esta cotización:</p></div>
                  <div class="ml-9 mt-2.5 rounded-[12px] border border-[#ece7dd] px-3.5 py-1 text-[12px]">
                    {[['Identidad de marca', '$24,000'], ['Sitio web', '$48,000'], ['Automatización', '$18,500']].map(([t, a], k) => (
                      <div class="rv flex justify-between border-b border-[#f0ece3] py-2 text-[#6e6559]" style={`--a:${0.38 + k * 0.08};--b:.12`}><span>{t}</span><span class="tabular-nums text-[#1f1b16]">{a}</span></div>
                    ))}
                    <div class="rv flex justify-between py-2 font-medium text-[#1f1b16]" style="--a:.64;--b:.12"><span>Total</span><span class="tabular-nums text-[#b9772f]">$90,500</span></div>
                  </div>
                </div>
                <div class="rv absolute bottom-6 left-6 flex h-[38px] w-[318px] items-center justify-between rounded-full border border-[#e3ddd0] pl-4 pr-1.5 text-[12px] text-[#9a9184]" style="--a:.7;--b:.12">Escribe una instrucción…<i class="flex size-[28px] items-center justify-center rounded-full bg-[#1f1b16]"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></i></div>
                <div class="absolute right-6 top-[54px] w-[236px]">
                  <p class="rv text-[13.5px] font-medium text-[#1f1b16]" style="--a:.1;--b:.12">Flujo automático</p>
                  <p class="rv mt-0.5 text-[11px] text-[#9a9184]" style="--a:.12;--b:.12">5 pasos · 2.4 s</p>
                  <div class="relative mt-5">
                    <i class="gy absolute bottom-[26px] left-[9px] top-[10px] block w-px bg-[#e6d3ae]" style="--a:.2;--b:.5;transform-origin:50% 0"></i>
                    {[['Solicitud recibida', 'Desde el chat interno'], ['Cotización generada', 'Con la plantilla de la firma'], ['Enviada por correo', 'A Estudio Aurora'], ['Seguimiento agendado', 'En 3 días'], ['Revisión de tu equipo', 'Aprobar antes de facturar']].map(([t, d], k) => (
                      <div class="rv relative flex items-start gap-3 pb-[17px]" style={`--a:${0.22 + k * 0.11};--b:.12`}>
                        <svg class="relative z-10 shrink-0 bg-white" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                          {k < 4 ? (<><circle cx="10" cy="10" r="9" fill="#1f1b16"/><path class="dw" style={`--a:${0.3 + k * 0.11};--b:.1`} d="M6 10.4l2.8 2.8L14 7.6" fill="none" stroke="#f2b866" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" pathLength="100"/></>) : (<><circle cx="10" cy="10" r="8.6" fill="#fff" stroke="#d9a24f" stroke-width="1.4"/><circle cx="10" cy="8" r="2.2" fill="none" stroke="#b9772f" stroke-width="1.3"/><path d="M5.8 14.6c.6-2 2.2-2.8 4.2-2.8s3.6.8 4.2 2.8" fill="none" stroke="#b9772f" stroke-width="1.3" stroke-linecap="round"/></>)}
                        </svg>
                        <div><p class="text-[12.5px] text-[#1f1b16]">{t}</p><p class="text-[11px] text-[#9a9184]">{d}</p></div>
                      </div>
                    ))}
                  </div>
                </div>
              </>)}
            </div>
          ))}
          <svg data-bus class="bus absolute overflow-visible" style="left:0;top:0;width:1px;height:1px;transform:translateZ(60px)" aria-hidden="true"></svg>
        </div>
      </div>

      <!-- loose pieces (step 1) -->
      <div data-frags class="pointer-events-none absolute inset-0 z-10" style="perspective:1200px" aria-hidden="true">
        {frags.map(([k, x, y, w, r, z]) => (
          <div class="fr" data-fr data-x={x} data-y={y} data-r={r} data-z={z} style={`width:${w}px`} set:html={FR[k as string]}></div>
        ))}
      </div>

      <div class="pointer-events-none absolute inset-x-0 top-0 z-10 h-[17svh] bg-gradient-to-b from-white via-white/80 to-white/0" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-[17svh] bg-gradient-to-t from-white via-white/80 to-white/0" aria-hidden="true"></div>
      <!-- subtitle -->
      <div class="absolute inset-x-0 bottom-[7svh] z-20 flex flex-col items-center px-6 text-center">
        <h3 data-title class="ps-title text-[clamp(1.6rem,3.2vw,2.8rem)] font-normal leading-[1.1] tracking-[-0.03em]">{titles[0]}</h3>
        <i class="mt-5 block h-[3px] w-[min(220px,50vw)] overflow-hidden rounded-full bg-[#e8eaed]" aria-hidden="true"><b data-bar class="block h-full w-full origin-left scale-x-0 bg-[#202124]"></b></i>
      </div>
    </div>
  </div>
</section>

<script>
  import { onFrame, measure, put, clamp as _c, lerp as _l, smooth as _s } from '../scripts/frame';
  const frameMath = { clamp: _c, lerp: _l, smooth: _s };
  const root = document.querySelector<HTMLElement>('#construccion')!;
  const sec = root.querySelector<HTMLElement>('[data-process]')!;
  const inner = root.querySelector<HTMLElement>('[data-process-inner]')!;
  const world = root.querySelector<HTMLElement>('[data-world]')!;
  const pns = [...root.querySelectorAll<HTMLElement>('[data-pn]')];
  const frs = [...root.querySelectorAll<HTMLElement>('[data-fr]')];
  const bus = root.querySelector<SVGSVGElement>('[data-bus]')!;
  const titleEl = root.querySelector<HTMLElement>('[data-title]')!;
  const bar = root.querySelector<HTMLElement>('[data-bar]')!;
  const titles: string[] = JSON.parse(root.dataset.titles!);
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const { clamp, lerp, smooth: sm } = frameMath;
  const cam = root.querySelector<HTMLElement>('[data-cam]')!;
  const fragsEl = root.querySelector<HTMLElement>('[data-frags]')!;
  const sm0 = measure(sec);
  const W = 640, H = 400, GAP = 40;

  // ---- layout: panels on a grid, camera stops, data bus between them
  let C: { x: number; y: number }[] = [], K: number[] = [], vw = 1, vh = 1;
  const LAST = 6; // steps 0..6: loose pieces, five modules, the whole ecosystem
  const layout = () => {
    vw = inner.clientWidth; vh = inner.clientHeight;
    const portrait = vw / vh < 0.85;
    const D = W + GAP, E = H + GAP;
    // panel centres in snake order: identity, website, finance, data, assistants
    const pos = portrait
      ? [[-D / 2, -E], [D / 2, -E], [-D / 2, 0], [D / 2, 0], [0, E]]
      : [[-D, -E / 2], [0, -E / 2], [D, -E / 2], [D / 2, E / 2], [-D / 2, E / 2]];
    const ww = portrait ? 2 * W + GAP : 3 * W + 2 * GAP, wh = portrait ? 3 * H + 2 * GAP : 2 * H + GAP;
    C = pos.map(([x, y]) => ({ x, y }));
    pns.forEach((el, i) => { el.style.left = `${C[i].x - W / 2}px`; el.style.top = `${C[i].y - H / 2}px`; el.style.translate = `0 0 ${i % 2 ? -26 : 26}px`; });
    const kP = portrait ? Math.min(vw * 0.9 / W, vh * 0.5 / H) : Math.min(vw * 0.56 / W, vh * 0.58 / H);
    const kF = Math.min(vw * 0.92 / ww, vh * 0.6 / wh);
    K = [kP * 0.84, kP, kP, kP, kP, kP, kF];
    C = [C[0], ...C, { x: 0, y: 0 }];
    // data bus through the gaps: channels, stubs into every panel, travelling pulses
    const ch = portrait
      ? { v: [[0, -wh / 2, E / 2]], h: [[-E / 2, -ww / 2, ww / 2], [E / 2, -ww / 2, ww / 2]] }
      : { v: [[-D / 2, -wh / 2, 0], [D / 2, -wh / 2, 0], [0, 0, wh / 2]], h: [[0, -ww / 2, ww / 2]] };
    const L: string[] = [], N: string[] = [], P: string[] = [];
    const seg = (d: string, a: number) => L.push(`<path class="dw" style="--a:${a};--b:.5" d="${d}" fill="none" stroke="#20242c" stroke-width="2.5" stroke-linecap="round" pathLength="100"/>`);
    const node = (x: number, y: number, r: number) => N.push(`<circle class="fl" style="--a:.45;--b:.15" cx="${x}" cy="${y}" r="${r}" fill="#fff" stroke="#20242c" stroke-width="2.5"/>`);
    ch.v.forEach(([x, y1, y2], i) => { seg(`M${x} ${y1}V${y2}`, 0.05 + i * 0.08); P.push(`M${x} ${y1}V${y2}`); });
    ch.h.forEach(([y, x1, x2], i) => { seg(`M${x1} ${y}H${x2}`, 0.1 + i * 0.08); P.push(`M${x2} ${y}H${x1}`); });
    ch.v.forEach(([x]) => ch.h.forEach(([y, x1, x2]) => { if (x >= x1 && x <= x2) node(x, y, 7); }));
    const near = (a: number, b: number) => Math.abs(a - b) < 1;
    pos.forEach(([x, y], i) => {
      const l = x - W / 2, r = x + W / 2, t = y - H / 2, bt = y + H / 2;
      ch.v.forEach(([cx, y1, y2]) => {
        if (y < y1 || y > y2) return;
        if (near(cx, r + GAP / 2)) { seg(`M${r} ${y}H${cx}`, 0.3 + i * 0.05); node(r, y, 5); }
        if (near(cx, l - GAP / 2)) { seg(`M${l} ${y}H${cx}`, 0.3 + i * 0.05); node(l, y, 5); }
      });
      ch.h.forEach(([cy, x1, x2]) => {
        if (x < x1 || x > x2) return;
        if (near(cy, bt + GAP / 2)) { seg(`M${x} ${bt}V${cy}`, 0.35 + i * 0.05); node(x, bt, 5); }
        if (near(cy, t - GAP / 2)) { seg(`M${x} ${t}V${cy}`, 0.35 + i * 0.05); node(x, t, 5); }
      });
    });
    const pulses = P.map((d, i) => `<circle r="5" fill="#e0a35a" class="pulse"><animateMotion dur="${3 + i * 0.7}s" begin="${i * 0.5}s" repeatCount="indefinite" path="${d}"/></circle>`).join('');
    bus.innerHTML = L.join('') + N.join('') + pulses;
  };
  layout();
  addEventListener('resize', layout);

  // ---- loose pieces
  const fx = frs.map((el, i) => ({ el, x: +el.dataset.x! / 100, y: +el.dataset.y! / 100, r: +el.dataset.r!, z: +el.dataset.z!, ph: i * 1.7 }));
  const mouse = { x: 0, y: 0, sx: 0, sy: 0 };
  addEventListener('pointermove', (e) => { mouse.x = e.clientX / innerWidth - 0.5; mouse.y = e.clientY / innerHeight - 0.5; }, { passive: true });

  // ---- scroll → timeline u in [0, LAST]
  let target = 0, u = 0, shown = -1, ecoOn = false, visible = true;
  const read = (y: number, vh: number) => {
    const p = clamp((y - sm0.top) / Math.max(1, sm0.height - vh));
    target = reduced ? LAST : clamp(p * (LAST + 0.6) - 0.3, 0, LAST);
  };
  const setTitle = (i: number) => {
    titleEl.classList.add('out');
    setTimeout(() => { titleEl.textContent = titles[i]; titleEl.classList.remove('out'); }, 220);
  };
  const lastQ: number[] = [];
  const counts = pns.map((el) => [...el.querySelectorAll<HTMLElement>('[data-count]')].map((c) => ({ el: c, v: +c.dataset.count!, a: +c.dataset.a!, b: +c.dataset.b! })));
  const render = (time: number) => {
    u += (target - u) * (reduced ? 1 : 0.11);
    if (Math.abs(target - u) < 0.0005) u = target;
    // camera
    const a = Math.min(LAST - 1, Math.floor(u)), f = u - a;
    const tr = sm(clamp((f - 0.5) / 0.5));
    const ccx = lerp(C[a].x, C[a + 1].x, tr), ccy = lerp(C[a].y, C[a + 1].y, tr);
    const push = lerp(1 + 0.05 * clamp(f / 0.5), 1, tr);
    const k = lerp(K[a], K[a + 1], tr) * (1 - 0.15 * Math.sin(Math.PI * tr)) * push;
    const sgn = a % 2 ? -1 : 1, sgn2 = (a + 1) % 2 ? -1 : 1;
    const e7 = clamp((u - (LAST - 0.65)) / 0.65);
    const rx = lerp(sgn * 2.5, sgn2 * 2.5, tr) * (1 - e7) + Math.sin(time * 0.0004) * 0.5 - mouse.sy * 2;
    const ry = lerp(sgn * -5, sgn2 * -5, tr) * (1 - e7) + Math.cos(time * 0.0003) * 0.6 + mouse.sx * 3;
    put(world, 'transform', `scale(${k.toFixed(4)}) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) translate3d(${(-ccx).toFixed(1)}px, ${(-ccy).toFixed(1)}px, 0)`);
    // panels: build + focus
    const vis = clamp((u - 0.3) / 0.5);
    pns.forEach((el, i) => {
      const s = i + 1;
      const q = clamp((u - s + 0.45) / 0.85);
      if (lastQ[i] !== q) { lastQ[i] = q; el.style.setProperty('--q', q.toFixed(4)); counts[i].forEach((c) => { const t = clamp((q - c.a) / c.b); c.el.textContent = Math.round(c.v * (1 - Math.pow(1 - t, 3))).toLocaleString('es-MX'); }); }
      const focus = 1 - clamp((Math.abs(u - (s + 0.05)) - 0.35) / 0.6);
      const o = vis * lerp(u > s - 0.5 ? 0.5 : 0.2, 1, focus);
      put(el, 'opacity', lerp(o, vis, e7).toFixed(3));
    });
    put(bus as unknown as HTMLElement, '--eq', e7.toFixed(3));
    if ((e7 > 0.4) !== ecoOn) { ecoOn = e7 > 0.4; cam.classList.toggle('ps-eco', ecoOn); }
    // loose pieces: drift, then gather into the first panel
    mouse.sx += (mouse.x - mouse.sx) * 0.05; mouse.sy += (mouse.y - mouse.sy) * 0.05;
    const g = sm(clamp((u - 0.1) / 0.85));
    put(fragsEl, 'display', u > 1.05 ? 'none' : '');
    if (u <= 1.05) {
      fx.forEach((o) => {
        const px = o.x * vw + Math.sin(time * 0.0006 + o.ph) * 14 + mouse.sx * o.z * -0.12;
        const py = o.y * vh + Math.cos(time * 0.0005 + o.ph) * 12 + mouse.sy * o.z * -0.12;
        const dx = (vw / 2 - px) * g, dy = (vh / 2 - py) * g;
        const sc = (1 - 0.92 * g) * (vw < 700 ? 0.62 : 1);
        put(o.el, 'transform', `translate3d(${(px + dx).toFixed(1)}px, ${(py + dy).toFixed(1)}px, ${(o.z * (1 - g)).toFixed(0)}px) translate(-50%, -50%) rotate(${(o.r + Math.sin(time * 0.0004 + o.ph) * 3 + g * 60).toFixed(1)}deg) scale(${sc.toFixed(3)})`);
        put(o.el, 'opacity', clamp(1 - g * 1.15).toFixed(3));
      });
    }
    // subtitle
    const idx = clamp(Math.round(u), 0, LAST);
    if (idx !== shown) { if (shown >= 0) setTitle(idx); else titleEl.textContent = titles[idx]; shown = idx; }
    put(bar, 'transform', `scaleX(${(u / LAST).toFixed(3)})`);
  };
  if (reduced) {
    read(0, innerHeight);
    pns.forEach((el) => el.style.setProperty('--q', '1'));
    render(0);
    titleEl.textContent = titles[LAST];
  } else {
    onFrame((time, y, vh) => {
      read(y, vh);
      // only animate while the chapter is on screen (or still settling after leaving)
      if (y + vh * 1.5 < sm0.top || y - vh * 0.5 > sm0.top + sm0.height) return;
      render(time);
    });
  }
</script>
