---
import fs from 'node:fs';
import Scene from './Scene.astro';
import { areas } from '../data/areas';

const hasPhoto = (slug: string) => ['jpg', 'jpeg', 'webp', 'png'].map((e) => `photos/${slug}.${e}`).find((p) => fs.existsSync(`public/${p}`));
---

{areas.map((a, i) => {
  const photo = hasPhoto(a.slug);
  return (
    <section id={a.slug} data-area class="relative z-10 h-svh min-h-[640px] overflow-hidden bg-[#08090c] text-white">
      <div data-bg class="absolute inset-0 will-change-transform" style="transform:scale(1.14)">
        <Scene kind={a.scene} />
        {photo && <img src={`/${photo}`} alt="" class="absolute inset-0 size-full object-cover" loading="lazy" />}
      </div>
      <i class="pointer-events-none absolute inset-0" style="background:linear-gradient(to bottom,rgba(4,5,8,.72),rgba(4,5,8,.18) 45%,rgba(4,5,8,.8))"></i>

      <p data-words class="absolute left-6 top-[19svh] max-w-[22ch] text-[clamp(1.5rem,2.5vw,2.7rem)] font-light leading-[1.15] tracking-[-0.03em] text-white md:left-10 md:max-w-[30ch]">
        {a.statement}
      </p>

      <p class="absolute right-5 top-1/2 hidden -translate-y-1/2 text-[10px] uppercase tracking-[0.5em] text-white/45 md:block [writing-mode:vertical-rl]">Área {String(i + 1).padStart(2, '0')} / 08</p>

      <div class="absolute inset-x-6 bottom-8 md:inset-x-10 md:bottom-10">
        <p data-reveal class="text-[11px] uppercase tracking-[0.24em] text-white">{a.title}</p>
        <p data-reveal style="--i:1" class="mt-3 max-w-[26rem] text-[12.5px] leading-relaxed text-white/60">{a.description}</p>
      </div>
    </section>
  );
})}
