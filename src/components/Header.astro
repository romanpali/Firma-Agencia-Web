---
const links = [
  { href: '/servicios', label: 'Servicios' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/contacto', label: 'Contacto' },
];
---

<header data-nav class="hf-rise fixed inset-x-0 top-4 z-50 flex justify-center px-4 md:top-6">
  <div
    data-header
    class="group/pill flex h-14 text-white w-full max-w-[680px] items-center justify-between rounded-full border border-white/15 bg-[#0d1119]/60 py-2 pl-6 pr-2 shadow-[0_8px_32px_rgba(0,0,0,0.25),inset_0_1px_0_rgba(255,255,255,0.18)] backdrop-blur-2xl backdrop-saturate-150 transition-[background-color,border-color,color,box-shadow] duration-500 data-[tone=light]:border-black/10 data-[tone=light]:bg-white/85 data-[tone=light]:text-ink data-[tone=light]:shadow-[0_8px_32px_rgba(20,22,28,0.10),inset_0_1px_0_rgba(255,255,255,0.8)]"
  >
    <a href="/" class="text-[17px] leading-none tracking-tight" aria-label="HumanCorp"><span class="font-light">HUMAN</span> <span class="font-semibold">CORP</span></a>
    <nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
      {links.map((l) => (
        <a href={l.href} class="text-[15px] font-medium tracking-tight text-white/80 transition-colors hover:text-white group-data-[tone=light]/pill:text-ink/70 group-data-[tone=light]/pill:hover:text-ink">{l.label}</a>
      ))}
    </nav>
    <a
      href="/contacto"
      class="rounded-full bg-white px-5 py-2.5 text-[15px] font-medium leading-none tracking-tight text-[#0b1a4a] transition-[transform,background-color,color] duration-500 hover:scale-[1.03] group-data-[tone=light]/pill:bg-ink group-data-[tone=light]/pill:text-white"
    >
      Hablemos
    </a>
  </div>
</header>
