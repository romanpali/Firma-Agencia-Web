---
import { divisions } from '../data/servicios';
import Cursor from './Cursor.astro';
const links = [
  { href: '/obra', label: 'Obra' },
  { href: '/paquetes', label: 'Paquetes' },
  { href: '/asesoria-contable-y-fiscal', label: 'Contable y fiscal' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/contacto', label: 'Contacto' },
];
const tools = [
  { href: '/arma-tu-proyecto', t: 'Arma tu proyecto (beta)', d: 'Personaliza un sitio y mira cómo se genera.' },
  { href: '/diagnostico', t: 'Diagnóstico gratis', d: '¿Qué tan conectada está tu empresa?' },
  { href: '/recursos', t: 'Recursos', d: 'Listas prácticas para revisar tu negocio.' },
];
const menuLinks = [
  { href: '/servicios', label: 'Servicios' },
  { href: '/obra', label: 'Obra' },
  { href: '/paquetes', label: 'Paquetes' },
  { href: '/arma-tu-proyecto', label: 'Arma tu proyecto' },
  { href: '/asesoria-contable-y-fiscal', label: 'Contable y fiscal' },
  { href: '/diagnostico', label: 'Diagnóstico' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/recursos', label: 'Recursos' },
  { href: '/contacto', label: 'Contacto' },
];
// Índice de búsqueda: páginas, divisiones y áreas de servicio.
const norm = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
const index = [
  ...menuLinks.map((l) => ({ t: l.label, h: l.href, k: 'Página' })),
  { t: 'Terminos y privacidad', h: '/terminos', k: 'Página' },
  ...divisions.flatMap((d) => [{ t: d.title, h: `/servicios#div-${d.n}`, k: `División ${d.n}` }, ...d.areas.map(([a, items]) => ({ t: a, h: `/servicios#div-${d.n}`, k: `División ${d.n}`, x: items }))]),
].map((e) => ({ ...e, n: norm(`${e.t} ${(e as { x?: string }).x ?? ''}`), x: undefined }));
const pill = 'hdr-pill rounded-full border border-white/20 bg-white/10 px-5 py-3 text-[15px] font-medium text-white backdrop-blur-md transition-[background-color,transform] duration-200 hover:bg-white/20 active:scale-[0.97]';
---

<header class="hf-fade fixed inset-x-0 top-0 z-50 flex items-center justify-between px-5 py-4 text-white md:px-9 md:py-5" data-nav style="--d:.1s">
  <div class="flex items-center gap-10 xl:gap-14">
    <a href="/" class="text-[15px] tracking-wide" aria-label="HumanCorp"><span class="font-light">HUMAN</span> <span class="font-semibold">CORP</span></a>
    <nav class="hidden items-center gap-7 lg:flex xl:gap-9" aria-label="Principal">
      <div class="mega-wrap relative">
        <a href="/servicios" class="flex items-center gap-1.5 text-[14px] font-semibold tracking-tight transition-opacity hover:opacity-70" aria-haspopup="true">Servicios<svg width="9" height="9" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2 3.5l3 3 3-3"/></svg></a>
        <div class="mega pointer-events-none absolute left-[-24px] top-full w-[min(760px,88vw)] pt-5 opacity-0 transition-[opacity,transform] duration-300">
          <div class="grid grid-cols-[1.25fr_1fr] gap-6 rounded-[22px] border border-black/[.06] bg-white p-6 text-[#0b0b0c] shadow-[0_40px_80px_-30px_rgba(0,0,40,.45)]">
            <div>
              <p class="px-3 pb-2 text-[11px] font-medium uppercase tracking-[0.14em] text-black/45">Las 8 divisiones</p>
              <ul class="grid grid-cols-2 gap-x-2">
                {divisions.map((d) => <li><a href={`/servicios#div-${d.n}`} class="flex items-baseline gap-3 rounded-lg px-3 py-2 text-[13.5px] leading-snug transition-colors hover:bg-black/[.05]"><span class="w-5 text-[12px] text-black/40">{d.n}</span>{d.short}</a></li>)}
              </ul>
              <a href="/servicios" class="mt-2 inline-block px-3 py-2 text-[13px] underline decoration-black/25 underline-offset-4 hover:decoration-black">Ver todos los servicios →</a>
            </div>
            <div class="border-l border-black/[.07] pl-6">
              <p class="pb-2 text-[11px] font-medium uppercase tracking-[0.14em] text-black/45">Herramientas</p>
              <ul class="space-y-1">
                {tools.map((t) => <li><a href={t.href} class="block rounded-lg px-3 py-2.5 transition-colors hover:bg-black/[.05]"><span class="block text-[14px] font-medium">{t.t}</span><span class="block text-[12px] text-black/55">{t.d}</span></a></li>)}
              </ul>
            </div>
          </div>
        </div>
      </div>
      {links.map((l) => <a href={l.href} class="text-[14px] font-semibold tracking-tight transition-opacity hover:opacity-70">{l.label}</a>)}
    </nav>
  </div>
  <a href="/arma-tu-proyecto" class={`${pill} hidden items-center gap-2 lg:inline-flex`}>Arma tu proyecto<span class="rounded-full bg-white/25 px-2 py-0.5 text-[10px] uppercase tracking-wider">Beta</span></a>
  <button type="button" class="grid size-11 place-items-center text-current transition-opacity duration-200 hover:opacity-70 active:scale-[0.94] lg:hidden" data-menu-open aria-expanded="false" aria-controls="site-menu" aria-label="Abrir menú"><svg width="26" height="18" viewBox="0 0 26 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M2 2h22M2 9h22M2 16h22"/></svg></button>
</header>

<Cursor />

<div id="site-menu" data-menu data-index={JSON.stringify(index)} class="pointer-events-none fixed inset-0 z-[60] flex flex-col overflow-y-auto px-6 pb-7 pt-4 text-center text-white" style="background:radial-gradient(70% 45% at 85% 12%,rgba(122,98,190,.75),transparent 70%),radial-gradient(80% 50% at 10% 55%,rgba(34,88,200,.8),transparent 72%),radial-gradient(70% 40% at 80% 92%,rgba(92,70,170,.7),transparent 70%),linear-gradient(180deg,#0b1a52 0%,#1b3f9e 38%,#4d4a9a 72%,#2a2561 100%);clip-path:circle(0px at calc(100% - 44px) 44px);visibility:hidden" aria-hidden="true">
  <div class="menu-link mx-auto flex w-fit items-center gap-1 rounded-full border border-white/30 bg-white/15 p-1 shadow-[0_14px_34px_-14px_rgba(5,5,40,.6)]" style="--i:0">
    <button type="button" data-menu-close class="flex items-center gap-2.5 rounded-full px-5 py-2.5 text-[15px] font-medium transition-colors hover:bg-white/15"><svg width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M1.5 1.5l11 11M12.5 1.5l-11 11"/></svg>Cerrar</button>
    <span class="h-5 w-px bg-white/25" aria-hidden="true"></span>
    <div class="flex items-center rounded-full text-[13px] font-medium" role="group" aria-label="Idioma">
      <button type="button" aria-pressed="true" class="rounded-full bg-white px-3.5 py-2 text-[#0b0c0f]">ES</button>
      <button type="button" disabled title="Próximamente" aria-label="Inglés (próximamente)" class="rounded-full px-3.5 py-2 text-white/55">EN</button>
    </div>
  </div>
  <form data-search-form role="search" class="menu-link relative mx-auto mt-5 w-full max-w-[26rem]" style="--i:1">
    <svg class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-white/70" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    <input data-search type="search" autocomplete="off" placeholder="Buscar en el sitio" aria-label="Buscar en el sitio" class="w-full rounded-full border border-white/30 bg-white/15 py-3 pl-11 pr-4 text-[15px] text-white placeholder:text-white/65 focus:border-white/70 focus:outline-none" />
  </form>
  <ul data-results class="mx-auto mt-4 hidden w-full max-w-[26rem] flex-col gap-1 text-left" aria-live="polite"></ul>
  <nav data-menu-nav class="my-auto flex flex-col items-center gap-0 py-3" aria-label="Menú">
    {menuLinks.filter((l) => l.href !== '/arma-tu-proyecto').map((l, i) => (
      <a href={l.href} data-menu-link class="menu-link text-[clamp(1.75rem,8.2vw,2.6rem)] font-medium leading-[1.12] tracking-[-0.04em] text-white" style={`--i:${i + 2}`}>{l.label}</a>
    ))}
    <div class="menu-link mt-4 flex flex-col items-center gap-2.5 sm:flex-row" style={`--i:${menuLinks.length + 1}`}>
      <a href="/contacto?interes=Consultor%C3%ADa&mensaje=Hola%2C%20me%20gustar%C3%ADa%20agendar%20una%20llamada." data-menu-link class="rounded-full bg-white px-8 py-3.5 text-[15px] font-medium text-[#0b0c0f] shadow-[0_18px_40px_-14px_rgba(10,8,60,.7)]">Agenda una llamada</a>
      <a href="/arma-tu-proyecto" data-menu-link class="rounded-full border border-white/40 bg-white/10 px-7 py-3.5 text-[15px] font-medium">Arma tu proyecto</a>
    </div>
  </nav>
  <div class="menu-link text-[13px]" style={`--i:${menuLinks.length + 2}`}>
    <p class="font-medium uppercase tracking-[0.14em] text-white/70">Contáctanos</p>
    <a href="mailto:info@humancorp.co" class="mt-1 inline-block text-[1.25rem] font-medium underline decoration-white/40 underline-offset-[6px]">info@humancorp.co</a>
  </div>
</div>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  let sr = 0;
  const mark = () => { sr = 0; nav.toggleAttribute('data-scrolled', scrollY > 24); };
  addEventListener('scroll', () => { if (!sr) sr = requestAnimationFrame(mark); }, { passive: true });
  mark();
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const open = document.querySelector<HTMLElement>('[data-menu-open]')!;
  const reducedM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let hideT = 0;
  // Apertura: un círculo de luz crece desde el botón y las piezas entran en cascada con un fundido; al cerrar se repliega al mismo punto.
  const set = (on: boolean) => {
    clearTimeout(hideT);
    const r = open.getBoundingClientRect();
    const at = `${r.left + r.width / 2}px ${r.top + r.height / 2}px`;
    const big = Math.hypot(innerWidth, innerHeight) + 40;
    if (on) {
      menu.style.visibility = 'visible';
      menu.style.transition = 'none';
      menu.style.clipPath = `circle(0px at ${at})`;
      void menu.offsetWidth;
      menu.style.transition = reducedM ? 'none' : 'clip-path 0.85s cubic-bezier(.7,0,.2,1)';
      menu.style.clipPath = `circle(${big}px at ${at})`;
    } else {
      menu.style.transition = reducedM ? 'none' : 'clip-path 0.6s cubic-bezier(.7,0,.2,1)';
      menu.style.clipPath = `circle(0px at ${at})`;
      hideT = window.setTimeout(() => { menu.style.visibility = 'hidden'; }, reducedM ? 0 : 620);
    }
    menu.style.pointerEvents = on ? 'auto' : 'none';
    menu.setAttribute('aria-hidden', String(!on));
    open.setAttribute('aria-expanded', String(on));
    menu.classList.toggle('is-open', on);
    document.documentElement.style.overflow = on ? 'hidden' : '';
    if (!on) { input.value = ''; showResults(''); }
  };
  // Buscador
  const input = menu.querySelector<HTMLInputElement>('[data-search]')!;
  const list = menu.querySelector<HTMLElement>('[data-results]')!;
  const mnav = menu.querySelector<HTMLElement>('[data-menu-nav]')!;
  const idx: { t: string; h: string; k: string; n: string }[] = JSON.parse(menu.dataset.index!);
  const norm2 = (t: string) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const showResults = (q: string) => {
    const w = norm2(q).trim().split(/\s+/).filter(Boolean);
    if (!w.length) { list.classList.add('hidden'); list.classList.remove('flex'); mnav.classList.remove('hidden'); list.innerHTML = ''; return; }
    const hits = idx.filter((e) => w.every((x) => e.n.includes(x))).slice(0, 7);
    mnav.classList.add('hidden');
    list.classList.remove('hidden'); list.classList.add('flex');
    list.innerHTML = hits.length
      ? hits.map((e) => `<li><a href="${e.h}" data-menu-link class="flex items-baseline justify-between gap-3 rounded-2xl border border-white/20 bg-white/10 px-4 py-3 text-[15px] hover:bg-white/20"><span>${e.t}</span><span class="shrink-0 text-[11px] uppercase tracking-[0.12em] text-white/60">${e.k}</span></a></li>`).join('')
      : '<li class="px-2 py-3 text-[15px] text-white/75">Sin resultados. Escríbenos y te ayudamos a encontrarlo.</li>';
  };
  input.addEventListener('input', () => showResults(input.value));
  menu.querySelector('[data-search-form]')!.addEventListener('submit', (e) => { e.preventDefault(); (list.querySelector('a') as HTMLAnchorElement | null)?.click(); });
  open.addEventListener('click', () => set(true));
  menu.querySelector('[data-menu-close]')!.addEventListener('click', () => set(false));
  // Al elegir una opción, las demás se desenfocan y se apagan mientras la elegida se queda nítida; luego se navega.
  const pick = (a: HTMLAnchorElement, e: MouseEvent) => {
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0 || reducedM) { set(false); return; }
    e.preventDefault();
    menu.classList.add('is-picking');
    menu.querySelectorAll('.is-picked').forEach((x) => x.classList.remove('is-picked'));
    (a.closest('.menu-link') as HTMLElement | null ?? a).classList.add('is-picked');
    a.classList.add('is-picked');
    setTimeout(() => {
      const u = new URL(a.href, location.href);
      if (u.pathname === location.pathname && u.search === location.search) { set(false); if (u.hash) location.hash = u.hash; menu.classList.remove('is-picking'); }
      else location.href = u.href;
    }, 520);
  };
  menu.addEventListener('click', (e) => { const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-menu-link]'); if (a) pick(a, e); });
  addEventListener('pageshow', () => { menu.classList.remove('is-picking'); menu.querySelectorAll('.is-picked').forEach((x) => x.classList.remove('is-picked')); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>
