---
import '../styles/global.css';
import Header from './Header.astro';
import ScrollFx from './ScrollFx.astro';

export type Section = { h: string; p?: string[]; ul?: string[]; after?: string[] };
interface Props { title: string; description: string; intro: string; updated: string; sections: Section[]; other: { href: string; label: string } }
const { title, description, intro, updated, sections, other } = Astro.props;
const slug = (i: number) => `s${i + 1}`;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{title} — HumanCorp</title>
  </head>
  <body class="bg-white font-sans text-[#0b0b0c]">
    <Header />
    <main class="relative z-10 overflow-x-clip">
      <section data-tone="light" class="px-6 pb-[12svh] pt-[22svh] md:px-10">
        <div class="mx-auto max-w-[1280px]">
          <p data-reveal class="text-[13px] font-medium uppercase tracking-[0.14em] text-[#6b6e75]">Legal</p>
          <h1 data-words class="mt-6 max-w-[16ch] font-goog text-[clamp(2.4rem,6vw,5.6rem)] font-light leading-[1.02] tracking-[-0.05em]">{title}</h1>
          <p data-reveal style="--i:1" class="mt-6 max-w-[40rem] text-[clamp(1.02rem,1.4vw,1.2rem)] leading-relaxed text-[#3a3d42]">{intro}</p>
          <p data-reveal style="--i:2" class="mt-4 text-[13px] text-[#6b6e75]">Última actualización: {updated}</p>

          <div class="mt-[8svh] grid gap-10 border-t border-[#e6e4df] pt-10 md:grid-cols-12 md:gap-14 md:pt-14">
            <nav class="md:col-span-4" aria-label="Contenido">
              <div class="md:sticky md:top-28">
                <p class="text-[12px] font-medium uppercase tracking-[0.14em] text-[#6b6e75]">Contenido</p>
                <ol class="mt-4 border-t border-[#e6e4df]">
                  {sections.map((s, i) => (
                    <li class="border-b border-[#e6e4df]"><a href={`#${slug(i)}`} class="group flex items-baseline gap-4 py-2.5 text-[14px] text-[#3a3d42] transition-[padding,color] duration-300 hover:pl-1.5 hover:text-[#0b0b0c]"><span class="w-5 font-goog text-[#6b6e75]">{String(i + 1).padStart(2, '0')}</span>{s.h}</a></li>
                  ))}
                </ol>
                <a href={other.href} class="mt-6 inline-block text-[14px] underline decoration-[#0b0b0c]/25 underline-offset-4 transition-[text-decoration-color] hover:decoration-[#0b0b0c]">{other.label} →</a>
              </div>
            </nav>

            <div class="md:col-span-8">
              {sections.map((s, i) => (
                <article id={slug(i)} class="scroll-mt-28 border-b border-[#e6e4df] py-9 first:pt-0 last:border-b-0">
                  <h2 class="flex items-baseline gap-4 font-goog text-[clamp(1.3rem,2vw,1.7rem)] font-normal leading-snug tracking-[-0.03em]"><span class="text-[14px] text-[#6b6e75]">{String(i + 1).padStart(2, '0')}</span>{s.h}</h2>
                  <div class="mt-5 space-y-4 text-[15.5px] leading-[1.7] text-[#3a3d42] md:pl-[2.2rem]">
                    {s.p?.map((t) => <p>{t}</p>)}
                    {s.ul && <ul class="space-y-2">{s.ul.map((t) => <li class="flex gap-3"><i class="mt-[0.7em] block size-1 shrink-0 rounded-full bg-[#0b0b0c]/50"></i>{t}</li>)}</ul>}
                    {s.after?.map((t) => <p>{t}</p>)}
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <footer data-tone="light" class="px-6 pb-10 md:px-10">
        <div class="mx-auto flex max-w-[1280px] flex-wrap items-center justify-between gap-4 border-t border-[#e6e4df] pt-6 text-[13px] text-[#6b6e75]">
          <span>© 2026 Todos los derechos reservados. HumanCorp</span>
          <nav class="flex flex-wrap gap-6" aria-label="Pie"><a href="/" class="hover:text-[#0b0b0c]">Inicio</a><a href="/servicios" class="hover:text-[#0b0b0c]">Servicios</a><a href="/nosotros" class="hover:text-[#0b0b0c]">Nosotros</a><a href="/contacto" class="hover:text-[#0b0b0c]">Contacto</a><a href="/terminos" class="hover:text-[#0b0b0c]">Términos de uso</a><a href="/privacidad" class="hover:text-[#0b0b0c]">Privacidad</a></nav>
        </div>
      </footer>
    </main>
    <ScrollFx />
  </body>
</html>
