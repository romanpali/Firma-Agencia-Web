<script>
  import { splitWords } from '../scripts/words';
  import { onFrame, measure } from '../scripts/frame';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Reveal on scroll (staggering comes from --i in CSS).
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
  );
  document.querySelectorAll<HTMLElement>('[data-words]').forEach((el) => {
    splitWords(el).forEach((w, i) => w.style.setProperty('--w', String(i)));
  });
  document.querySelectorAll('[data-reveal],[data-words]').forEach((el) => io.observe(el));

  // Navbar tone follows the section under it (cached measures, no layout reads per frame).
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const sections = [...document.querySelectorAll<HTMLElement>('[data-tone]')]
    .filter((el) => el !== header)
    .map((el) => ({ tone: el.dataset.tone!, m: measure(el) }))
    .reverse(); // later sections overlap earlier (sticky) ones
  onFrame((_t, y) => {
    let tone = 'dark';
    for (const s of sections) if (y + 40 >= s.m.top && y + 40 < s.m.top + s.m.height) { tone = s.tone; break; }
    if (header && header.dataset.tone !== tone) header.dataset.tone = tone;
  });
</script>
