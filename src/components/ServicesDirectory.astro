---
import Icon from './Icon.astro';
import { services } from '../data/services';
---

<section data-tone="dark" class="relative z-10 bg-paper">
  <div class="mx-auto max-w-[1280px] px-6 pb-24 pt-8 md:px-10 md:pb-36 md:pt-12">
    <div class="grid gap-8 md:grid-cols-12 md:items-end">
      <h2 data-words class="max-w-[16ch] text-[clamp(2.25rem,4.4vw,4rem)] font-medium leading-[1.04] tracking-[-0.035em] md:col-span-7">
        Ocho áreas para cada parte de tu empresa
      </h2>
      <div data-reveal style="--i:1" class="md:col-span-4 md:col-start-9">
        <p class="text-[16px] leading-relaxed text-mute">Soluciones que funcionan por separado y mejor juntas, de la identidad de marca a los datos y la seguridad.</p>
        <a href="/servicios" class="group mt-6 inline-flex items-center gap-2 rounded-full bg-[#d6c4ff] px-6 py-3 text-sm font-medium text-[#150633] transition-transform hover:scale-[1.03]">
          Ver todos los servicios
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>

    <ul class="mt-14 md:mt-20">
      {services.map((s, i) => (
        <li data-reveal style={`--i:${i % 3}`} class="row relative">
          <a href={`/servicios#${s.slug}`} class="group grid grid-cols-[2.5rem_minmax(0,1fr)_2rem] items-center gap-x-4 py-7 md:grid-cols-[5rem_minmax(0,1.15fr)_minmax(0,1.5fr)_2.5rem] md:gap-x-8 md:py-10">
            <span class="font-mono text-[12px] tabular-nums text-white/35 transition-colors duration-300 group-hover:text-[#a9c4ff]">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-[clamp(1.35rem,2.5vw,2.4rem)] font-medium leading-[1.1] tracking-[-0.03em] transition-transform duration-500 ease-out group-hover:translate-x-2">{s.title}</h3>
            <div class="hidden md:block">
              <p class="max-w-[34rem] text-[14.5px] leading-relaxed text-mute transition-colors duration-300 group-hover:text-white/80">{s.description}</p>
              <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5">
                {s.items.map((it) => (
                  <li class="flex items-center gap-1.5 font-mono text-[10.5px] uppercase tracking-[0.1em] text-white/45">
                    <Icon name={it.icon} class="size-3.5" />{it.label}
                  </li>
                ))}
              </ul>
            </div>
            <span class="justify-self-end text-xl text-white/40 transition-[transform,color] duration-300 group-hover:translate-x-1 group-hover:text-[#a9c4ff]">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
