---
import { services } from '../data/services';
---

<section data-tone="light" class="relative z-10 bg-[#f5f4f1] text-[#0b0b0c]">
  <div class="mx-auto max-w-[1280px] px-6 pb-24 pt-24 md:px-10 md:pb-36 md:pt-36">
    <div class="grid gap-8 md:grid-cols-12 md:items-end">
      <h2 data-words class="max-w-[16ch] text-[clamp(2.4rem,5.2vw,5rem)] font-light leading-[1.02] tracking-[-0.045em] md:col-span-7">
        Ocho áreas para cada parte de tu empresa
      </h2>
      <div data-reveal style="--i:1" class="md:col-span-4 md:col-start-9">
        <p class="text-[16.5px] leading-relaxed text-[#5d6064]">Soluciones que funcionan por separado y mejor juntas, de la identidad de marca a los datos y la seguridad.</p>
        <a href="/servicios" class="group mt-6 inline-flex items-center gap-2 rounded-full bg-[#0b0b0c] px-6 py-3 text-sm font-medium text-[#f5f4f1] transition-transform hover:scale-[1.03]">
          Ver todos los servicios
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>

    <ul class="mt-16 md:mt-24">
      {services.map((s, i) => (
        <li data-reveal style={`--i:${i % 3}`} class="row relative">
          <a href={`/servicios#${s.slug}`} class="group grid grid-cols-[2.2rem_minmax(0,1fr)_1.5rem] items-baseline gap-x-4 py-6 md:grid-cols-[4rem_minmax(0,1.1fr)_minmax(0,1.2fr)_2.5rem] md:gap-x-8 md:py-9">
            <span class="text-[13px] tabular-nums text-black/40">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-[clamp(1.35rem,2.8vw,2.7rem)] font-light leading-[1.08] tracking-[-0.04em] transition-transform duration-500 ease-out group-hover:translate-x-3">{s.title}</h3>
            <p class="hidden max-w-[30rem] text-[15px] leading-relaxed text-[#5d6064] transition-colors duration-300 group-hover:text-[#0b0b0c] md:block">{s.description}</p>
            <span class="justify-self-end text-xl text-black/40 transition-[transform,color] duration-300 group-hover:translate-x-1 group-hover:text-[#0b0b0c]">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
