---
import Scene from './Scene.astro';
import { areas } from '../data/areas';
import { services } from '../data/services';
const items = (slug: string) => services.find((s) => s.slug === slug)?.items.map((i) => i.label) ?? [];
---

<section id="areas" data-areas class="relative z-10 h-[800svh]">
  <div class="sticky top-0 h-svh overflow-hidden">
    <div class="mx-auto grid h-full max-w-[1280px] grid-rows-[minmax(0,1fr)_auto] px-6 pb-8 pt-24 md:grid-cols-12 md:grid-rows-1 md:items-center md:gap-8 md:px-10 md:py-24">
      <!-- Gallery -->
      <div class="relative min-h-0 md:order-2 md:col-span-7 md:h-[26rem]" style="perspective:1800px">
        {areas.map((a, i) => (
          <figure data-tile class="absolute left-1/2 top-1/2 aspect-[16/10] w-[min(88vw,640px)] -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-[3px] bg-[#0b0c10] shadow-[0_40px_80px_-30px_rgba(0,0,0,0.7)] md:w-[min(46vw,640px)]" style={`z-index:${20 - i}`}>
            <Scene kind={a.scene} lite />
          </figure>
        ))}
      </div>

      <!-- Copy -->
      <div class="relative md:order-1 md:col-span-5">
        <p class="text-[clamp(4.5rem,11vw,10rem)] font-light leading-[0.82] tracking-[-0.06em] text-white/90">
          <span data-count>01</span><span class="text-[0.28em] tracking-normal text-white/50"> / 08</span>
        </p>
        <div class="relative mt-5 h-[13.5rem] md:mt-8 md:h-[19rem]">
          {areas.map((a, i) => (
            <div data-copy={i} class="ar-copy absolute inset-x-0 top-0">
              <h3 class="text-[clamp(1.5rem,2.6vw,2.6rem)] font-light leading-[1.08] tracking-[-0.035em]">{a.title}</h3>
              <p class="mt-3 max-w-[27rem] text-[14.5px] leading-relaxed text-white/80 md:text-[16px]">{a.statement}</p>
              <p class="mt-4 max-w-[27rem] text-[13px] leading-relaxed text-white/55 md:text-[14px]">{items(a.slug).join('  ·  ')}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const sec = document.querySelector<HTMLElement>('[data-areas]')!;
  const tiles = [...sec.querySelectorAll<HTMLElement>('[data-tile]')];
  const copies = [...sec.querySelectorAll<HTMLElement>('[data-copy]')];
  const count = sec.querySelector<HTMLElement>('[data-count]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  let active = -1;
  const update = () => {
    const r = sec.getBoundingClientRect();
    const p = clamp(-r.top / Math.max(1, r.height - innerHeight));
    const f = p * (tiles.length - 1);
    const mobile = innerWidth < 768;
    tiles.forEach((el, i) => {
      const d = i - f, ad = Math.abs(d);
      const x = d * (mobile ? 78 : d < 0 ? 46 : 60);
      el.style.transform = `translate3d(${x}%, 0, ${(-ad * 160).toFixed(0)}px) rotateY(${(-9 - d * 26).toFixed(1)}deg) scale(${(1 - Math.min(ad, 2) * 0.07).toFixed(3)})`;
      el.style.opacity = String(Math.max(0, 1 - ad * (d < 0 && !mobile ? 1.5 : 0.62)).toFixed(3));
      el.style.zIndex = String(40 - Math.round(ad * 10));
    });
    const idx = Math.round(f);
    if (idx !== active) {
      active = idx;
      copies.forEach((c, i) => c.classList.toggle('is-on', i === idx));
      count.textContent = String(idx + 1).padStart(2, '0');
    }
  };
  update();
  if (!reduced) {
    let q = false;
    const on = () => { if (!q) { q = true; requestAnimationFrame(() => { q = false; update(); }); } };
    addEventListener('scroll', on, { passive: true });
    addEventListener('resize', on);
  } else {
    copies.forEach((c) => c.classList.add('is-on'));
  }
</script>
