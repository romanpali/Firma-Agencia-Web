---
import Scene from './Scene.astro';
import { areas } from '../data/areas';
import { services } from '../data/services';
const items = (slug: string) => services.find((s) => s.slug === slug)?.items.map((i) => i.label) ?? [];
---

<section id="areas" data-areas data-tone="light" class="relative z-10 h-[620svh] bg-white font-goog text-[#202124]">
  <div class="sticky top-0 h-svh overflow-hidden">
    <div class="mx-auto grid h-full max-w-[1280px] grid-rows-[minmax(0,1fr)_auto] gap-5 px-6 pb-8 pt-24 md:grid-cols-12 md:grid-rows-1 md:items-center md:gap-14 md:px-10 md:py-24">
      <!-- Image -->
      <div class="flex min-h-0 flex-col gap-4 md:order-2 md:col-span-7">
        <div class="relative min-h-0 flex-1 overflow-hidden rounded-[22px] bg-[#e8eaed] md:flex-none md:aspect-[5/4] md:max-h-[66svh] md:w-full md:rounded-[28px]">
          {areas.map((a, i) => (
            <figure data-wipe class="absolute inset-0" style={`z-index:${i + 1}`}>
              <div class="in absolute inset-0 scale-[1.14]"><Scene kind={a.scene} lite /></div>
            </figure>
          ))}
        </div>
        <div class="flex gap-1.5" aria-hidden="true">
          {areas.map(() => <i class="relative h-[3px] flex-1 overflow-hidden rounded-full bg-[#e8eaed]"><b data-seg class="absolute inset-0 origin-left scale-x-0 bg-[#202124]"></b></i>)}
        </div>
      </div>

      <!-- Copy -->
      <div class="relative md:order-1 md:col-span-5">
        <p class="text-[15px] text-[#5f6368]">Qué hacemos</p>
        <p class="mt-3 flex items-baseline gap-2 text-[clamp(2.6rem,5.2vw,4.6rem)] font-light leading-none tracking-[-0.04em]">
          <span data-count>01</span><span class="text-[0.38em] tracking-normal text-[#9aa0a6]">/ 08</span>
        </p>
        <div class="relative mt-5 h-[13rem] md:mt-8 md:h-[17.5rem]">
          {areas.map((a, i) => (
            <div data-copy={i} class="ar-copy absolute inset-x-0 top-0">
              <h3 class="text-[clamp(1.5rem,2.5vw,2.4rem)] font-normal leading-[1.12] tracking-[-0.025em]">{a.title}</h3>
              <p class="mt-3 max-w-[27rem] text-[15px] leading-relaxed text-[#5f6368] md:text-[17px]">{a.statement}</p>
              <ul class="mt-4 flex max-w-[28rem] flex-wrap gap-2">
                {items(a.slug).map((l) => <li class="rounded-full border border-[#dadce0] px-3.5 py-1.5 text-[13px] text-[#3c4043] md:text-[14px]">{l}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
<!-- the white chapter dissolves into the night -->
<div class="pointer-events-none relative z-10 h-[30svh] bg-gradient-to-b from-white to-white/0" aria-hidden="true"></div>

<script>
  import { onFrame, measure, put, clamp } from '../scripts/frame';
  const sec = document.querySelector<HTMLElement>('[data-areas]')!;
  const figs = [...sec.querySelectorAll<HTMLElement>('[data-wipe]')];
  const segs = [...sec.querySelectorAll<HTMLElement>('[data-seg]')];
  const copies = [...sec.querySelectorAll<HTMLElement>('[data-copy]')];
  const count = sec.querySelector<HTMLElement>('[data-count]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);
  const m = measure(sec);
  let active = -1;
  const update = (y: number, vh: number) => {
    const p = clamp((y - m.top) / Math.max(1, m.height - vh));
    const f = p * (figs.length - 1);
    figs.forEach((el, i) => {
      if (Math.abs(f - i) > 1.6) return; // far from the visible pair: nothing to repaint
      const v = i === 0 ? 1 : ease(clamp(f - (i - 1)));
      put(el, 'clipPath', v >= 1 ? 'none' : `inset(${((1 - v) * 100).toFixed(2)}% 0 0 0)`);
      put(el.firstElementChild as HTMLElement, 'transform', `translate3d(0, ${(clamp(f - i, -1, 1) * -4).toFixed(2)}%, 0) scale(1.14)`);
    });
    segs.forEach((s, i) => put(s, 'transform', `scaleX(${clamp(f - i + 0.5).toFixed(3)})`));
    const idx = Math.round(f);
    if (idx !== active) {
      active = idx;
      copies.forEach((c, i) => c.classList.toggle('is-on', i === idx));
      count.textContent = String(idx + 1).padStart(2, '0');
    }
  };
  if (reduced) {
    copies.forEach((c) => c.classList.add('is-on'));
    update(m.top, innerHeight);
  } else {
    onFrame((_t, y, vh) => { if (y + vh >= m.top && y <= m.top + m.height) update(y, vh); });
  }
</script>
