---
// «Agendar una llamada»: asistente a pantalla completa (tema → día y hora → datos → revisión → confirmación).
// La interfaz no depende de ningún calendario: habla con un adaptador (window.HC_CAL) con tres métodos.
// Mientras no exista el calendario real del panel, funciona con un adaptador de ejemplo (horarios y ocupación simulados).
// Para conectar el calendario real basta con definir antes de abrirlo:
//   window.HC_CAL = { days(ym, mins) → Promise<string[]>, slots(iso, mins) → Promise<string[]>, book(datos) → Promise<{ ok, id }> }
// · days: días disponibles del mes («2026-12» → ['2026-12-03', …]) · slots: horas libres de un día en hora de Mérida («09:00», …) · book: crea la cita.
---

<div class="ag" data-ag hidden aria-hidden="true">
  <div class="ag-bg" data-ag-close></div>
  <div class="ag-card" role="dialog" aria-modal="true" aria-labelledby="ag-t" tabindex="-1">
    <aside class="ag-side">
      <p class="ag-brand"><span>HUMAN</span> <b>CORP</b></p>
      <h2 id="ag-t">Agendar una llamada</h2>
      <p class="ag-lead">Elige el tema, el día y la hora. Sin costo y sin compromiso.</p>
      <dl class="ag-sum" data-ag-sum></dl>
      <p class="ag-side-f">info@humancorp.co<br />Mérida, Yucatán · Hora del centro de México (UTC−6)</p>
    </aside>
    <section class="ag-main">
      <header class="ag-top">
        <button type="button" class="ag-ic" data-ag-back aria-label="Volver"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></button>
        <div class="ag-prog" data-ag-prog aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <button type="button" class="ag-ic" data-ag-close aria-label="Cerrar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
      </header>
      <div class="ag-body" data-ag-body></div>
      <footer class="ag-act">
        <span class="ag-hint" data-ag-hint role="status" aria-live="polite"></span>
        <button type="button" class="ag-btn" data-ag-next>Continuar</button>
      </footer>
    </section>
  </div>
  <!-- Definición del formulario para Netlify Forms (las citas llegan al correo y al panel de formularios) -->
  <form name="agendar" data-netlify="true" netlify-honeypot="bot-field" hidden>
    <input name="form-name" value="agendar" /><input name="bot-field" />
    <input name="tema" /><input name="modalidad" /><input name="fecha" /><input name="hora" /><input name="zona" /><input name="duracion" />
    <input name="nombre" /><input name="empresa" /><input name="correo" /><input name="telefono" /><textarea name="notas"></textarea>
  </form>
</div>

<style is:global>
  .ag { position: fixed; inset: 0; z-index: 90; display: grid; place-items: center; color: #14161a; font-family: inherit; }
  .ag[hidden] { display: none; }
  .ag-bg { position: absolute; inset: 0; background: rgba(8, 10, 24, 0.55); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); opacity: 0; transition: opacity 0.5s ease; }
  .ag.on .ag-bg { opacity: 1; }
  .ag-card { position: relative; display: grid; grid-template-columns: 310px minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); width: min(1020px, calc(100vw - 48px)); height: min(700px, calc(100svh - 48px)); overflow: hidden; border-radius: 30px; background: #fff; box-shadow: 0 60px 120px -40px rgba(0, 0, 20, 0.7); outline: none; opacity: 0; transform: translateY(26px) scale(0.985); transition: opacity 0.5s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
  .ag.on .ag-card { opacity: 1; transform: none; }
  .ag-side { display: flex; flex-direction: column; padding: 34px 30px 28px; background: #f5f5f7; }
  .ag-brand { font-size: 13px; letter-spacing: 0.04em; color: rgba(20, 22, 26, 0.6); } .ag-brand span { font-weight: 300; } .ag-brand b { font-weight: 600; color: #14161a; }
  .ag-side h2 { margin-top: 38px; font-size: 30px; font-weight: 300; line-height: 1.05; letter-spacing: -0.045em; }
  .ag-lead { margin-top: 12px; font-size: 13.5px; line-height: 1.55; color: rgba(20, 22, 26, 0.55); }
  .ag-sum { margin-top: 30px; display: grid; gap: 14px; }
  .ag-sum div { display: grid; gap: 3px; padding-top: 12px; border-top: 1px solid rgba(20, 22, 26, 0.1); } .ag-sum dt { font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(20, 22, 26, 0.42); } .ag-sum dd { font-size: 14px; color: rgba(20, 22, 26, 0.85); } .ag-sum dd.e { color: rgba(20, 22, 26, 0.28); }
  .ag-side-f { margin-top: auto; font-size: 11.5px; line-height: 1.6; color: rgba(20, 22, 26, 0.45); }
  .ag-main { display: flex; min-width: 0; flex-direction: column; }
  .ag-top { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 20px 26px 0; }
  .ag-ic { display: grid; width: 40px; height: 40px; place-items: center; border-radius: 50%; background: #f5f5f7; color: #14161a; transition: background 0.2s, opacity 0.2s, transform 0.2s; cursor: pointer; } .ag-ic:hover { background: #ebebef; } .ag-ic:active { transform: scale(0.94); } .ag-ic[disabled] { opacity: 0; pointer-events: none; }
  .ag-prog { display: flex; flex: 1; gap: 6px; max-width: 260px; } .ag-prog i { position: relative; flex: 1; height: 3px; overflow: hidden; border-radius: 9px; background: rgba(20, 22, 26, 0.1); } .ag-prog i::after { content: ""; position: absolute; inset: 0; border-radius: 9px; background: #14161a; transform: scaleX(0); transform-origin: left; transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); } .ag-prog i.d::after { transform: none; }
  .ag-body { flex: 1; min-height: 0; overflow-y: auto; padding: 26px 34px 12px; scrollbar-width: thin; }
  .ag-step { animation: agIn 0.55s cubic-bezier(0.22, 1, 0.36, 1) both; }
  @keyframes agIn { from { opacity: 0; transform: translateY(14px); } }
  .ag-step h3 { font-size: 27px; font-weight: 300; letter-spacing: -0.045em; line-height: 1.08; } .ag-step > p.sub { margin-top: 8px; font-size: 14px; color: rgba(20, 22, 26, 0.55); }
  .ag-h4 { margin: 28px 0 10px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(20, 22, 26, 0.45); }
  .ag-opts { display: grid; gap: 10px; margin-top: 22px; }
  .ag-opt { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; padding: 16px 18px; border-radius: 18px; background: #f5f5f7; text-align: left; cursor: pointer; transition: background 0.2s, box-shadow 0.25s, transform 0.2s; } .ag-opt:hover { background: #ededf0; } .ag-opt:active { transform: scale(0.992); }
  .ag-opt[aria-pressed='true'] { background: #fff; box-shadow: 0 0 0 1.5px #14161a, 0 16px 34px -22px rgba(0, 0, 0, 0.5); }
  .ag-opt b { display: block; font-size: 15px; font-weight: 500; letter-spacing: -0.01em; } .ag-opt span { display: block; margin-top: 3px; font-size: 12.5px; color: rgba(20, 22, 26, 0.5); } .ag-opt em { flex: none; font-style: normal; font-size: 12px; padding: 5px 11px; border-radius: 99px; background: rgba(20, 22, 26, 0.07); color: rgba(20, 22, 26, 0.7); }
  .ag-seg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; } .ag-seg .ag-opt { display: block; padding: 14px; } .ag-seg .ag-opt b { font-size: 13.5px; } .ag-seg .ag-opt span { font-size: 11.5px; }
  .ag-cols { display: grid; grid-template-columns: minmax(0, 1fr) 250px; gap: 30px; margin-top: 22px; align-items: start; }
  .ag-cal-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; } .ag-cal-h b { font-size: 15px; font-weight: 500; text-transform: capitalize; } .ag-cal-h div { display: flex; gap: 6px; } .ag-cal-h button { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 50%; background: #f5f5f7; cursor: pointer; transition: background 0.2s, opacity 0.2s; } .ag-cal-h button:hover { background: #ebebef; } .ag-cal-h button[disabled] { opacity: 0.3; pointer-events: none; }
  .ag-wd, .ag-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; } .ag-wd span { padding: 6px 0 8px; text-align: center; font-size: 11px; letter-spacing: 0.08em; color: rgba(20, 22, 26, 0.4); }
  .ag-d { position: relative; aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; font-size: 14px; cursor: pointer; transition: background 0.2s, color 0.2s, transform 0.2s; } .ag-d:not([disabled]):hover { background: #e9e9ed; } .ag-d[disabled] { color: rgba(20, 22, 26, 0.22); cursor: default; }
  .ag-d.av { font-weight: 500; background: #f5f5f7; } .ag-d.td::after { content: ""; position: absolute; bottom: 20%; width: 4px; height: 4px; border-radius: 50%; background: currentColor; opacity: 0.5; } .ag-d[aria-pressed='true'] { background: #14161a; color: #fff; transform: scale(1.04); }
  .ag-d.ld { animation: agPulse 1.2s ease-in-out infinite; } @keyframes agPulse { 50% { opacity: 0.45; } }
  .ag-slots-h { font-size: 14px; font-weight: 500; } .ag-slots-h::first-letter { text-transform: uppercase; } .ag-tz { margin-top: 4px; font-size: 11.5px; line-height: 1.5; color: rgba(20, 22, 26, 0.45); }
  .ag-slots { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: 14px; max-height: 330px; overflow-y: auto; padding: 2px; scrollbar-width: thin; }
  .ag-s { padding: 12px 0; border-radius: 14px; background: #f5f5f7; font-size: 14px; text-align: center; cursor: pointer; transition: background 0.2s, color 0.2s, transform 0.15s; } .ag-s:hover { background: #ebebef; } .ag-s:active { transform: scale(0.97); } .ag-s[aria-pressed='true'] { background: #14161a; color: #fff; }
  .ag-sk { height: 44px; border-radius: 14px; background: linear-gradient(100deg, #f5f5f7 30%, #fbfbfc 50%, #f5f5f7 70%) 100% 0 / 300% 100%; animation: agSk 1.3s linear infinite; } @keyframes agSk { to { background-position: 0 0; } }
  .ag-empty { margin-top: 14px; padding: 18px; border-radius: 16px; background: #f5f5f7; font-size: 13px; line-height: 1.55; color: rgba(20, 22, 26, 0.55); }
  .ag-form { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 22px; } .ag-form label { display: block; font-size: 12.5px; color: rgba(20, 22, 26, 0.6); } .ag-form .w { grid-column: 1 / -1; }
  .ag-in { display: block; width: 100%; margin-top: 7px; padding: 14px 16px; border-radius: 14px; background: #f5f5f7; font: inherit; font-size: 15px; color: #14161a; outline: none; transition: background 0.2s, box-shadow 0.2s; } .ag-in::placeholder { color: rgba(20, 22, 26, 0.32); } .ag-in:focus { background: #fff; box-shadow: 0 0 0 1.5px #14161a; } .ag-in.bad { box-shadow: 0 0 0 1.5px #d6453d; } textarea.ag-in { min-height: 96px; resize: vertical; }
  .ag-rev { margin-top: 22px; border-radius: 20px; background: #f5f5f7; } .ag-rev div { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 15px 20px; } .ag-rev div + div { border-top: 1px solid rgba(20, 22, 26, 0.08); } .ag-rev small { display: block; font-size: 10.5px; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(20, 22, 26, 0.42); } .ag-rev b { display: block; margin-top: 3px; font-size: 14.5px; font-weight: 500; } .ag-rev button { flex: none; font-size: 12.5px; color: rgba(20, 22, 26, 0.55); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .ag-chk { display: flex; gap: 12px; margin-top: 18px; font-size: 12.5px; line-height: 1.55; color: rgba(20, 22, 26, 0.6); cursor: pointer; } .ag-chk input { flex: none; width: 20px; height: 20px; margin-top: 1px; accent-color: #14161a; } .ag-chk a { text-decoration: underline; text-underline-offset: 2px; }
  .ag-ok { text-align: center; padding-top: 18px; } .ag-ok svg { display: block; margin: 0 auto; width: 84px; height: 84px; } .ag-ok circle { fill: none; stroke: #14161a; stroke-width: 2; stroke-dasharray: 190; stroke-dashoffset: 190; animation: agDraw 0.9s 0.1s cubic-bezier(0.65, 0, 0.35, 1) forwards; } .ag-ok path { fill: none; stroke: #14161a; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 50; stroke-dashoffset: 50; animation: agDraw 0.6s 0.8s cubic-bezier(0.65, 0, 0.35, 1) forwards; } @keyframes agDraw { to { stroke-dashoffset: 0; } }
  .ag-ok h3 { margin-top: 20px; } .ag-ok .ag-rev { max-width: 460px; margin: 26px auto 0; text-align: left; } .ag-id { display: inline-block; margin-top: 14px; padding: 6px 14px; border-radius: 99px; background: #f5f5f7; font-size: 12px; letter-spacing: 0.12em; color: rgba(20, 22, 26, 0.6); }
  .ag-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 22px; } .ag-links a, .ag-links button { padding: 12px 20px; border-radius: 99px; background: #f5f5f7; font-size: 13.5px; font-weight: 500; cursor: pointer; transition: background 0.2s; } .ag-links a:hover, .ag-links button:hover { background: #ebebef; }
  .ag-act { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 34px 24px; border-top: 1px solid rgba(20, 22, 26, 0.06); } .ag-hint { font-size: 12.5px; color: rgba(20, 22, 26, 0.5); }
  .ag-btn { flex: none; padding: 15px 30px; border-radius: 99px; background: #14161a; color: #fff; font-size: 15px; font-weight: 500; cursor: pointer; transition: transform 0.2s, opacity 0.25s; } .ag-btn:hover { transform: scale(1.03); } .ag-btn:active { transform: scale(0.98); } .ag-btn[disabled] { opacity: 0.28; pointer-events: none; }
  .ag-err { margin-top: 14px; padding: 12px 16px; border-radius: 14px; background: #fdecea; font-size: 13px; color: #8a2a24; }
  html.ag-lock { overflow: hidden; }
  @media (max-width: 860px) {
    .ag { place-items: end center; }
    .ag-card { display: flex; flex-direction: column; width: 100vw; height: 100svh; border-radius: 0; transform: translateY(40px); }
    .ag-side { display: none; } .ag-main { flex: 1; min-height: 0; }
    .ag-top { padding: max(14px, env(safe-area-inset-top)) 16px 0; }
    .ag-body { padding: 20px 20px 10px; } .ag-act { padding: 12px 20px max(18px, env(safe-area-inset-bottom)); } .ag-btn { padding: 15px 28px; }
    .ag-step h3 { font-size: 25px; } .ag-cols { grid-template-columns: 1fr; gap: 22px; } .ag-slots { grid-template-columns: repeat(3, 1fr); max-height: none; }
    .ag-seg { grid-template-columns: 1fr; } .ag-seg .ag-opt { display: flex; align-items: center; justify-content: space-between; } .ag-seg .ag-opt span { margin-top: 0; text-align: right; }
    .ag-form { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .ag-card, .ag-bg, .ag-step { transition: none; animation: none; } .ag-sk, .ag-d.ld { animation: none; } }
</style>

<script>
  type Mode = [string, string, string];
  type Topic = [string, string, string, number];
  const TOPICS: Topic[] = [
    ['descubrimiento', 'Llamada de descubrimiento', 'Platicamos de tu empresa y de lo que necesitas.', 30],
    ['contable', 'Asesoría contable y fiscal', 'Con nuestro Director de Administración y Finanzas.', 45],
    ['web', 'Diseño y sitio web', 'Identidad, sitio, tienda en línea o galería.', 30],
    ['tecnologia', 'Tecnología y automatización', 'Procesos, paneles, asistentes y sistemas.', 45],
  ];
  const MODES: Mode[] = [['video', 'Videollamada', 'Enlace por correo'], ['tel', 'Llamada', 'Te marcamos'], ['oficina', 'En la oficina', 'Mérida, Yucatán']];
  const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
  const DIAS = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
  const OFFSET = 6; // Mérida: UTC−6 todo el año

  type Cal = { days(ym: string, mins: number): Promise<string[]>; slots(iso: string, mins: number): Promise<string[]>; book(d: Record<string, string>): Promise<{ ok: boolean; id: string }> };
  const hash = (s: string) => { let h = 2166136261; for (const c of s) h = Math.imul(h ^ c.charCodeAt(0), 16777619); return h >>> 0; };
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const FERIADOS = ['01-01', '05-01', '09-16', '12-25'];

  // Adaptador de ejemplo: horario de atención y ocupación simulados. Se sustituye por window.HC_CAL (calendario real del panel).
  const slotsDe = (iso: string, mins: number) => {
    const [y, m, d] = iso.split('-').map(Number), wd = new Date(Date.UTC(y, m - 1, d)).getUTCDay();
    if (wd === 0 || FERIADOS.includes(iso.slice(5))) return [];
    const [a, b] = wd === 6 ? [600, 840] : [540, 1080], out: string[] = [];
    for (let t = a; t + mins <= b; t += 30) {
      if (wd !== 6 && t < 900 && t + mins > 840) continue; // hora de comida
      const epoch = Date.UTC(y, m - 1, d, 0, t + OFFSET * 60);
      if (epoch < Date.now() + 24 * 3600e3) continue; // con 24 h de anticipación
      if (hash(`${iso}${t}`) % 100 < 22) continue; // ocupado
      out.push(`${String(Math.floor(t / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}`);
    }
    return out;
  };
  const mock: Cal = {
    async days(ym, mins) { await wait(350); const [y, m] = ym.split('-').map(Number), n = new Date(y, m, 0).getDate(), r: string[] = []; for (let d = 1; d <= n; d++) { const iso = `${ym}-${String(d).padStart(2, '0')}`; if (slotsDe(iso, mins).length) r.push(iso); } return r; },
    async slots(iso, mins) { await wait(420); return slotsDe(iso, mins); },
    async book(d) {
      const r = await fetch('/contacto', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams({ 'form-name': 'agendar', ...d }).toString() });
      if (!r.ok) throw new Error(String(r.status));
      return { ok: true, id: `HC-${(hash(d.correo + d.fecha + d.hora) % 90000) + 10000}` };
    },
  };
  const cal = (): Cal => (window as unknown as { HC_CAL?: Cal }).HC_CAL || mock;

  const root = document.querySelector<HTMLElement>('[data-ag]')!;
  const card = root.querySelector<HTMLElement>('.ag-card')!;
  const body = root.querySelector<HTMLElement>('[data-ag-body]')!;
  const next = root.querySelector<HTMLButtonElement>('[data-ag-next]')!;
  const back = root.querySelector<HTMLButtonElement>('[data-ag-back]')!;
  const hint = root.querySelector<HTMLElement>('[data-ag-hint]')!;
  const sum = root.querySelector<HTMLElement>('[data-ag-sum]')!;
  const prog = [...root.querySelectorAll<HTMLElement>('[data-ag-prog] i')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const now = new Date();
  const S = { step: 0, topic: '', mode: 'video', date: '', time: '', month: new Date(now.getFullYear(), now.getMonth(), 1), name: '', company: '', email: '', phone: '', notes: '', consent: false, id: '', sending: false, err: '' };
  let avail: string[] | null = null, slots: string[] | null = null, token = 0, tokenS = 0;
  const topic = () => TOPICS.find((t) => t[0] === S.topic);
  const mins = () => topic()?.[3] ?? 30;
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const pad = (n: number) => String(n).padStart(2, '0');
  const ym = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}`;
  const epochOf = (iso: string, hm: string) => { const [y, m, d] = iso.split('-').map(Number), [h, mi] = hm.split(':').map(Number); return Date.UTC(y, m - 1, d, h + OFFSET, mi); };
  const longDate = (iso: string) => { const [, m, d] = iso.split('-').map(Number); return `${DIAS[new Date(epochOf(iso, '12:00')).getUTCDay()]} ${d} de ${MESES[m - 1]}`; };
  const local = (iso: string, hm: string) => new Date(epochOf(iso, hm)).toLocaleTimeString('es-MX', { hour: 'numeric', minute: '2-digit', hour12: true });
  const merida = (hm: string) => { const [h, m] = hm.split(':').map(Number); return `${h % 12 || 12}:${pad(m)} ${h < 12 ? 'a. m.' : 'p. m.'}`; };
  const sameTz = () => new Date().getTimezoneOffset() === OFFSET * 60;
  const modeName = () => MODES.find((m) => m[0] === S.mode)![1];

  const valid = () => {
    if (S.step === 0) return !!S.topic;
    if (S.step === 1) return !!(S.date && S.time);
    if (S.step === 2) return S.name.trim().length > 1 && /^\S+@\S+\.\S+$/.test(S.email.trim()) && (S.mode !== 'tel' || S.phone.replace(/\D/g, '').length >= 8);
    if (S.step === 3) return S.consent && !S.sending;
    return true;
  };
  const hintFor = () => {
    if (S.step === 0) return S.topic ? `${mins()} minutos · ${modeName()}` : 'Elige un tema para continuar.';
    if (S.step === 1) return S.time ? `${longDate(S.date)} · ${merida(S.time)} (Mérida)` : S.date ? 'Elige una hora.' : 'Elige un día disponible.';
    if (S.step === 2) return valid() ? '' : S.mode === 'tel' ? 'Nombre, correo y un teléfono válidos.' : 'Escribe tu nombre y un correo válido.';
    if (S.step === 3) return S.consent ? '' : 'Acepta el aviso de privacidad para confirmar.';
    return '';
  };

  const renderSum = () => {
    const rows: [string, string][] = [['Tema', topic()?.[1] || ''], ['Duración y modalidad', S.topic ? `${mins()} min · ${modeName()}` : ''], ['Fecha', S.date ? longDate(S.date) : ''], ['Hora', S.time ? `${merida(S.time)} · Mérida` : '']];
    sum.innerHTML = rows.map(([k, v]) => `<div><dt>${k}</dt><dd class="${v ? '' : 'e'}">${v ? esc(v) : '—'}</dd></div>`).join('');
  };

  const chev = (d: string) => `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;
  const calHTML = () => {
    const y = S.month.getFullYear(), m = S.month.getMonth(), first = (new Date(y, m, 1).getDay() + 6) % 7, n = new Date(y, m + 1, 0).getDate();
    const minM = new Date(now.getFullYear(), now.getMonth(), 1), maxM = new Date(now.getFullYear(), now.getMonth() + 2, 1);
    const today = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
    let cells = '';
    for (let i = 0; i < first; i++) cells += '<span></span>';
    for (let d = 1; d <= n; d++) {
      const iso = `${y}-${pad(m + 1)}-${pad(d)}`, ok = !!avail?.includes(iso);
      cells += `<button type="button" class="ag-d${ok ? ' av' : ''}${iso === today ? ' td' : ''}${avail ? '' : ' ld'}" data-d="${iso}" aria-pressed="${S.date === iso}" ${ok ? '' : 'disabled'} aria-label="${longDate(iso)}${ok ? '' : ', sin horarios'}">${d}</button>`;
    }
    return `<div class="ag-cal-h"><b>${MESES[m]} ${y}</b><div><button type="button" data-mv="-1" aria-label="Mes anterior" ${S.month <= minM ? 'disabled' : ''}>${chev('M15 6l-6 6 6 6')}</button><button type="button" data-mv="1" aria-label="Mes siguiente" ${S.month >= maxM ? 'disabled' : ''}>${chev('M9 6l6 6-6 6')}</button></div></div>
      <div class="ag-wd">${['L', 'M', 'M', 'J', 'V', 'S', 'D'].map((x) => `<span>${x}</span>`).join('')}</div><div class="ag-days">${cells}</div>`;
  };
  const slotsHTML = () => {
    if (!S.date) return `<p class="ag-slots-h">Horarios</p><p class="ag-tz">Elige un día para ver los horarios disponibles.</p>`;
    const head = `<p class="ag-slots-h">${longDate(S.date)}</p><p class="ag-tz">${sameTz() ? 'Horario de Mérida (UTC−6), igual al de tu zona.' : 'Horario de Mérida (UTC−6); debajo, la hora en tu zona.'}</p>`;
    if (!slots) return `${head}<div class="ag-slots">${'<i class="ag-sk"></i>'.repeat(6)}</div>`;
    if (!slots.length) return `${head}<p class="ag-empty">Ya no quedan horarios este día. Prueba con otra fecha.</p>`;
    return `${head}<div class="ag-slots">${slots.map((t) => `<button type="button" class="ag-s" data-t="${t}" aria-pressed="${S.time === t}">${merida(t)}${sameTz() ? '' : `<small style="display:block;font-size:10.5px;opacity:.6">${local(S.date, t)} tu hora</small>`}</button>`).join('')}</div>`;
  };
  const renderCal = () => { const c = body.querySelector('[data-cal]'); if (c) c.innerHTML = calHTML(); };
  const renderSlots = () => { const c = body.querySelector('[data-slots]'); if (c) c.innerHTML = slotsHTML(); };
  const loadMonth = async () => {
    const my = ++token; avail = null; renderCal();
    const r = await cal().days(ym(S.month), mins());
    if (my !== token) return; avail = r; renderCal();
  };
  const loadSlots = async () => {
    const my = ++tokenS; slots = null; renderSlots();
    const r = await cal().slots(S.date, mins());
    if (my !== tokenS) return; slots = r; renderSlots();
  };

  const reviewHTML = (edit: boolean) => {
    const rows: [string, string, number][] = [['Tema', `${topic()?.[1]} · ${mins()} min`, 0], ['Modalidad', modeName(), 0], ['Fecha y hora', `${longDate(S.date)}, ${merida(S.time)} (Mérida)${sameTz() ? '' : ` · ${local(S.date, S.time)} tu hora`}`, 1], ['Contacto', `${S.name.trim()} · ${S.email.trim()}${S.phone.trim() ? ' · ' + S.phone.trim() : ''}`, 2]];
    return `<div class="ag-rev">${rows.map(([k, v, st]) => `<div><span><small>${k}</small><b>${esc(v)}</b></span>${edit ? `<button type="button" data-go="${st}">Cambiar</button>` : ''}</div>`).join('')}</div>`;
  };
  const stamp = (t: number) => new Date(t).toISOString().replace(/[-:]|\.\d{3}/g, '');
  const gcal = () => { const s = epochOf(S.date, S.time); return `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent('Llamada con HumanCorp')}&dates=${stamp(s)}/${stamp(s + mins() * 60000)}&details=${encodeURIComponent(`${topic()![1]} · ${modeName()} · Folio ${S.id}`)}&location=${encodeURIComponent(S.mode === 'oficina' ? 'Mérida, Yucatán' : 'En línea')}`; };
  const ics = () => {
    const s = epochOf(S.date, S.time), e = s + mins() * 60000;
    const t = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//HumanCorp//Agendar//ES', 'BEGIN:VEVENT', `UID:${S.id}@humancorp.co`, `DTSTAMP:${stamp(Date.now())}`, `DTSTART:${stamp(s)}`, `DTEND:${stamp(e)}`, 'SUMMARY:Llamada con HumanCorp', `DESCRIPTION:${topic()![1]} · ${modeName()} · Folio ${S.id}`, 'END:VEVENT', 'END:VCALENDAR'].join('\r\n');
    const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([t], { type: 'text/calendar' })); a.download = 'llamada-humancorp.ics'; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 2000);
  };

  const stepHTML = () => {
    if (S.step === 0) return `<div class="ag-step"><h3>¿De qué quieres platicar?</h3><p class="sub">Elige el tema y cómo prefieres la llamada.</p>
      <div class="ag-opts">${TOPICS.map(([id, t, d, m]) => `<button type="button" class="ag-opt" data-topic="${id}" aria-pressed="${S.topic === id}"><div><b>${t}</b><span>${d}</span></div><em>${m} min</em></button>`).join('')}</div>
      <p class="ag-h4">Modalidad</p><div class="ag-seg">${MODES.map(([id, t, d]) => `<button type="button" class="ag-opt" data-mode="${id}" aria-pressed="${S.mode === id}"><b>${t}</b><span>${d}</span></button>`).join('')}</div></div>`;
    if (S.step === 1) return `<div class="ag-step"><h3>Elige día y hora</h3><p class="sub">${mins()} minutos · ${modeName()}. Atendemos de lunes a viernes de 9:00 a 18:00 y los sábados de 10:00 a 14:00.</p>
      <div class="ag-cols"><div data-cal>${calHTML()}</div><div data-slots>${slotsHTML()}</div></div></div>`;
    if (S.step === 2) return `<div class="ag-step"><h3>¿A nombre de quién la agendamos?</h3><p class="sub">Solo usamos tus datos para esta llamada.</p>
      <div class="ag-form"><label>Nombre completo<input class="ag-in" data-f="name" autocomplete="name" placeholder="Tu nombre" value="${esc(S.name)}" /></label>
      <label>Empresa <span style="opacity:.5">(opcional)</span><input class="ag-in" data-f="company" autocomplete="organization" placeholder="Nombre de tu empresa" value="${esc(S.company)}" /></label>
      <label>Correo electrónico<input class="ag-in" data-f="email" type="email" inputmode="email" autocomplete="email" placeholder="tu@correo.com" value="${esc(S.email)}" /></label>
      <label>Teléfono ${S.mode === 'tel' ? '' : '<span style="opacity:.5">(opcional)</span>'}<input class="ag-in" data-f="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+52 999 000 0000" value="${esc(S.phone)}" /></label>
      <label class="w">¿Algo que quieras adelantarnos? <span style="opacity:.5">(opcional)</span><textarea class="ag-in" data-f="notes" placeholder="Cuéntanos en una línea de qué trata tu empresa o qué necesitas">${esc(S.notes)}</textarea></label></div></div>`;
    if (S.step === 3) return `<div class="ag-step"><h3>Revisa y confirma</h3><p class="sub">Si algo no es correcto, cámbialo antes de confirmar.</p>${reviewHTML(true)}
      <label class="ag-chk"><input type="checkbox" data-consent ${S.consent ? 'checked' : ''} /><span>Acepto el <a href="/privacidad" target="_blank" rel="noopener">aviso de privacidad</a> y que HumanCorp use estos datos para agendar y dar seguimiento a esta llamada.</span></label>
      ${S.err ? `<p class="ag-err" role="alert">${S.err}</p>` : ''}</div>`;
    return `<div class="ag-step ag-ok"><svg viewBox="0 0 84 84" aria-hidden="true"><circle cx="42" cy="42" r="30"/><path d="M30 43l9 9 16-18"/></svg><h3>Listo, ${esc(S.name.trim().split(' ')[0])}. Tu llamada está agendada.</h3>
      <p class="sub">${S.mode === 'video' ? 'Te enviaremos el enlace de la videollamada a' : 'Te enviaremos la confirmación a'} ${esc(S.email.trim())}.</p><span class="ag-id">Folio ${S.id}</span>${reviewHTML(false)}
      <div class="ag-links"><a href="${gcal()}" target="_blank" rel="noopener">Agregar a Google Calendar</a><button type="button" data-ics>Descargar .ics</button></div></div>`;
  };

  const refresh = () => { next.disabled = !valid(); hint.textContent = hintFor(); };
  const render = (animate = true) => {
    body.innerHTML = stepHTML();
    if (!animate) body.querySelector('.ag-step')?.setAttribute('style', 'animation:none');
    prog.forEach((p, i) => p.classList.toggle('d', i <= S.step || S.step >= 4));
    back.disabled = S.step === 0 || S.step === 4;
    next.textContent = S.step === 3 ? (S.sending ? 'Confirmando…' : 'Confirmar llamada') : S.step === 4 ? 'Cerrar' : 'Continuar';
    refresh(); renderSum();
  };
  const go = (n: number) => {
    S.step = n; S.err = ''; render(); body.scrollTop = 0;
    if (n === 1) { if (S.date) S.month = new Date(+S.date.slice(0, 4), +S.date.slice(5, 7) - 1, 1); loadMonth(); if (S.date) loadSlots(); }
  };
  const confirm = async () => {
    S.sending = true; S.err = ''; render(false);
    try {
      const r = await cal().book({ tema: topic()![1], modalidad: modeName(), fecha: S.date, hora: S.time, zona: 'America/Merida (UTC-6)', duracion: String(mins()), nombre: S.name.trim(), empresa: S.company.trim(), correo: S.email.trim(), telefono: S.phone.trim(), notas: S.notes.trim() });
      if (!r.ok) throw new Error('no');
      S.id = r.id; S.sending = false; go(4);
    } catch {
      S.sending = false; S.err = 'No pudimos confirmar la llamada. Inténtalo de nuevo o escríbenos a <a href="mailto:info@humancorp.co?subject=Agendar%20llamada" style="text-decoration:underline">info@humancorp.co</a>.'; render(false);
    }
  };

  next.addEventListener('click', () => { if (S.step === 3) confirm(); else if (S.step === 4) close(); else if (valid()) go(S.step + 1); });
  back.addEventListener('click', () => { if (S.step > 0 && S.step < 4) go(S.step - 1); });
  body.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('button,input[data-consent]'); if (!t) return;
    const d = t.dataset;
    if (d.topic) { if (S.topic !== d.topic) { S.topic = d.topic; S.date = ''; S.time = ''; } render(false); }
    else if (d.mode) { S.mode = d.mode; render(false); }
    else if (d.mv) { S.month = new Date(S.month.getFullYear(), S.month.getMonth() + +d.mv, 1); loadMonth(); }
    else if (d.d) { S.date = d.d; S.time = ''; renderCal(); loadSlots(); refresh(); renderSum(); }
    else if (d.t) { S.time = d.t; renderSlots(); refresh(); renderSum(); }
    else if (d.go) go(+d.go);
    else if ('ics' in d) ics();
    else if ('consent' in d) { S.consent = (t as HTMLInputElement).checked; refresh(); }
  });
  body.addEventListener('input', (e) => {
    const i = e.target as HTMLInputElement, k = i.dataset.f as 'name' | 'company' | 'email' | 'phone' | 'notes' | undefined; if (!k) return;
    S[k] = i.value; refresh();
  });
  body.addEventListener('focusout', (e) => {
    const i = e.target as HTMLInputElement; if (i.dataset?.f === 'email') i.classList.toggle('bad', !!i.value && !/^\S+@\S+\.\S+$/.test(i.value.trim()));
  });

  let last: HTMLElement | null = null;
  const open = () => {
    if (!root.hidden) return;
    document.querySelector<HTMLElement>('[data-menu].is-open [data-menu-close]')?.click();
    last = document.activeElement as HTMLElement | null;
    Object.assign(S, { step: 0, topic: '', mode: 'video', date: '', time: '', consent: false, err: '', sending: false, id: '' });
    root.hidden = false; root.setAttribute('aria-hidden', 'false'); document.documentElement.classList.add('ag-lock');
    render(false); void root.offsetWidth; root.classList.add('on'); card.focus({ preventScroll: true });
  };
  function close() {
    root.classList.remove('on'); root.setAttribute('aria-hidden', 'true'); document.documentElement.classList.remove('ag-lock');
    setTimeout(() => { root.hidden = true; }, reduced ? 0 : 520); last?.focus?.({ preventScroll: true });
  }
  root.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-ag-close]')) close(); });
  addEventListener('keydown', (e) => { if (!root.hidden && e.key === 'Escape') close(); });
  document.addEventListener('click', (e) => { const t = (e.target as HTMLElement).closest('[data-agendar]'); if (t) { e.preventDefault(); open(); } });
  if (/[?&]agendar=1/.test(location.search) || location.hash === '#agendar') open();
</script>
