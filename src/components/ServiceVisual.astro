---
interface Props { slug: string }
const { slug } = Astro.props;
---

<div class="relative h-[76px] w-[120px] overflow-hidden rounded-xl border border-white/[0.14] bg-[#0d0a26] transition-transform duration-500 group-hover:scale-[1.06] md:h-[88px] md:w-[142px]" aria-hidden="true">
  {slug === 'diseno' && (
    <div class="flex h-full items-center gap-2.5 p-2.5">
      <span class="grid size-11 shrink-0 place-items-center rounded-xl" style="background:linear-gradient(135deg,#7c4dff,#cdb8ff)"><i class="relative block size-5 rounded-full border-[1.5px] border-white"><i class="absolute -top-[3px] left-1/2 size-[5px] -translate-x-1/2 rounded-full bg-white"></i></i></span>
      <div><div class="flex gap-1">{['#7c4dff', '#cdb8ff', '#a9c4ff', '#ff7fb5'].map((c) => <i class="size-3 rounded-sm" style={`background:${c}`}></i>)}</div><p class="mt-1 text-[22px] font-semibold leading-none tracking-[-0.04em]">Aa</p></div>
    </div>
  )}
  {slug === 'desarrollo' && (
    <div class="p-2"><div class="flex gap-1"><i class="size-1 rounded-full bg-white/30"></i><i class="size-1 rounded-full bg-white/30"></i><i class="size-1 rounded-full bg-white/30"></i></div><i class="mt-2 block h-2 w-16 rounded bg-white/80"></i><i class="mt-1.5 block h-2 w-10 rounded bg-white/80"></i><i class="mv-caret ml-0.5 inline-block h-2 w-[2px] translate-y-[1px] bg-[#cdb8ff]"></i><i class="mt-2 block h-4 w-12 rounded-full bg-[#cdb8ff]"></i><i class="absolute bottom-2 right-2 h-9 w-12 rounded-md" style="background:linear-gradient(160deg,#7c4dff,#ff7fb5)"></i></div>
  )}
  {slug === 'marketing' && (
    <div class="flex h-full items-end gap-1.5 p-3">{[34, 48, 40, 62, 54, 72].map((h, i) => <i class="mv-bar block flex-1 rounded-sm bg-gradient-to-t from-[#7c4dff] to-[#ff7fb5]" style={`height:${h}%;animation-delay:${i * 0.2}s`}></i>)}</div>
  )}
  {slug === 'ventas' && (
    <div class="relative grid h-full grid-cols-3 gap-1.5 p-2">{[2, 1, 2].map((n) => <div class="space-y-1">{Array.from({ length: n }, () => <i class="block h-4 rounded bg-white/15"></i>)}</div>)}<i class="mv-card absolute left-2 top-[34px] block h-4 w-[34px] rounded border border-[#cdb8ff] bg-[#2a1d66]" style="animation-duration:5s"></i></div>
  )}
  {slug === 'ia' && (
    <div class="space-y-1.5 p-2.5"><i class="ml-auto block h-4 w-16 rounded-lg rounded-br-sm bg-[#7c4dff]"></i><i class="block h-4 w-20 rounded-lg rounded-bl-sm bg-white/15"></i><p class="mv-dots flex w-fit gap-1 rounded-lg bg-white/15 px-2 py-1.5"><i class="size-1 rounded-full bg-white/70"></i><i class="size-1 rounded-full bg-white/70"></i><i class="size-1 rounded-full bg-white/70"></i></p></div>
  )}
  {slug === 'finanzas' && (
    <div class="p-2.5"><div class="flex items-center justify-between"><i class="h-1.5 w-12 rounded bg-white/70"></i><i class="rounded-full bg-[#fbbf24]/25 px-1.5 py-[1px] font-mono text-[6px] not-italic text-[#fcd34d]">REVISIÓN</i></div><i class="mt-1.5 block h-1 w-full rounded bg-white/20"></i><i class="mt-1 block h-1 w-4/5 rounded bg-white/20"></i><svg viewBox="0 0 120 34" class="mt-1.5 h-[30px] w-full"><path class="mv-draw" pathLength="1" d="M0 28C15 26 22 14 40 16S70 6 85 8 110 2 120 2" fill="none" stroke="#cdb8ff" stroke-width="2"/></svg></div>
  )}
  {slug === 'operaciones' && (
    <div class="space-y-1.5 p-2.5">{[0, 1, 2].map((i) => <div class="flex items-center gap-2"><svg viewBox="0 0 12 12" class="size-3.5 shrink-0"><rect x="1" y="1" width="10" height="10" rx="3" fill={i < 2 ? '#7c4dff' : 'none'} stroke="#cdb8ff" stroke-opacity={i < 2 ? 1 : 0.5}/>{i < 2 && <path class="mv-check" style={`animation-delay:${i * 0.5}s`} pathLength="1" d="M3 6.2l2 2L9 4" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/>}</svg><i class="h-1.5 rounded bg-white/35" style={`width:${[64, 48, 58][i]}%`}></i></div>)}</div>
  )}
  {slug === 'datos' && (
    <div class="grid h-full grid-cols-[1fr_auto] items-center gap-2 p-2.5"><div class="flex h-full items-end gap-1">{[50, 70, 44, 82].map((h, i) => <i class="mv-bar block flex-1 rounded-sm bg-[#a9c4ff]" style={`height:${h}%;animation-delay:${i * 0.25}s`}></i>)}</div><svg viewBox="0 0 40 40" class="size-12 -rotate-90"><circle cx="20" cy="20" r="14" fill="none" stroke="#ffffff1f" stroke-width="6"/><circle class="mv-donut" pathLength="1" cx="20" cy="20" r="14" fill="none" stroke="#7c4dff" stroke-width="6" stroke-linecap="round"/></svg></div>
  )}
</div>
