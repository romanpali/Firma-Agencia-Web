---
interface Props { slug: string }
const { slug } = Astro.props;
const bars = 'mv-bar block flex-1 rounded-sm';
---

<div class="relative h-[76px] w-[120px] overflow-hidden rounded-2xl bg-[#fcfbfa] text-[#17140f] shadow-[0_16px_34px_-14px_rgba(0,0,0,0.8)] transition-transform duration-500 group-hover:-rotate-2 group-hover:scale-[1.07] md:h-[88px] md:w-[142px]" aria-hidden="true">
  {slug === 'diseno' && (
    <div class="flex h-full items-center gap-2.5 p-2.5">
      <span class="grid size-11 shrink-0 place-items-center rounded-2xl" style="background:linear-gradient(135deg,#ff6fae,#ff9a5c)"><i class="relative block size-5 rounded-full border-[1.5px] border-white"><i class="absolute -top-[3px] left-1/2 size-[5px] -translate-x-1/2 rounded-full bg-white"></i></i></span>
      <div><div class="flex gap-1">{['#ff6fae', '#ffd23f', '#6fd0ff', '#7fe3b5'].map((c) => <i class="size-3 rounded-full" style={`background:${c}`}></i>)}</div><p class="mt-1 text-[24px] font-semibold leading-none tracking-[-0.04em]">A<em class="font-serif font-normal">a</em></p></div>
    </div>
  )}
  {slug === 'desarrollo' && (
    <div class="p-2"><div class="flex gap-1"><i class="size-1 rounded-full bg-[#ff6b5e]"></i><i class="size-1 rounded-full bg-[#ffbd3d]"></i><i class="size-1 rounded-full bg-[#3fd06a]"></i></div><i class="mt-2 block h-2 w-16 rounded bg-[#17140f]"></i><i class="mt-1.5 block h-2 w-10 rounded bg-[#17140f]"></i><i class="mv-caret ml-0.5 inline-block h-2 w-[2px] translate-y-[1px] bg-[#ff6b4a]"></i><i class="mt-2 block h-4 w-12 rounded-full bg-[#ffd23f]"></i><i class="absolute bottom-2 right-2 h-9 w-12 rounded-lg" style="background:linear-gradient(160deg,#6fd0ff,#7fe3b5)"></i></div>
  )}
  {slug === 'marketing' && (
    <div class="flex h-full items-end gap-1.5 p-3">{[34, 48, 40, 62, 54, 72].map((h, i) => <i class={bars} style={`height:${h}%;animation-delay:${i * 0.2}s;background:${['#ff6fae', '#ff8a5b', '#ffd23f', '#6fd0ff', '#7fe3b5', '#ff6fae'][i]}`}></i>)}</div>
  )}
  {slug === 'ventas' && (
    <div class="relative grid h-full grid-cols-3 gap-1.5 p-2">{[2, 1, 2].map((n) => <div class="space-y-1">{Array.from({ length: n }, () => <i class="block h-4 rounded bg-black/[0.07]"></i>)}</div>)}<i class="mv-card absolute left-2 top-[34px] block h-4 w-[34px] rounded bg-white ring-2 ring-[#ff8a5b] shadow-md" style="animation-duration:5s"></i></div>
  )}
  {slug === 'ia' && (
    <div class="space-y-1.5 p-2.5"><i class="ml-auto block h-4 w-16 rounded-xl rounded-br-sm bg-[#17140f]"></i><i class="block h-4 w-20 rounded-xl rounded-bl-sm bg-black/[0.08]"></i><p class="mv-dots flex w-fit gap-1 rounded-xl bg-black/[0.08] px-2 py-1.5"><i class="size-1 rounded-full bg-black/45"></i><i class="size-1 rounded-full bg-black/45"></i><i class="size-1 rounded-full bg-black/45"></i></p></div>
  )}
  {slug === 'finanzas' && (
    <div class="p-2.5"><div class="flex items-center justify-between"><i class="h-1.5 w-12 rounded bg-black/55"></i><i class="rounded-full bg-[#ffd23f] px-1.5 py-[1px] text-[6.5px] font-bold not-italic">REVISIÓN</i></div><i class="mt-1.5 block h-1 w-full rounded bg-black/15"></i><i class="mt-1 block h-1 w-4/5 rounded bg-black/15"></i><svg viewBox="0 0 120 34" class="mt-1.5 h-[30px] w-full"><path class="mv-draw" pathLength="1" d="M0 28C15 26 22 14 40 16S70 6 85 8 110 2 120 2" fill="none" stroke="#ff6b4a" stroke-width="2.4" stroke-linecap="round"/></svg></div>
  )}
  {slug === 'operaciones' && (
    <div class="space-y-1.5 p-2.5">{[0, 1, 2].map((i) => <div class="flex items-center gap-2"><svg viewBox="0 0 12 12" class="size-3.5 shrink-0"><rect x="1" y="1" width="10" height="10" rx="3" fill={i < 2 ? '#7fe3b5' : 'none'} stroke="#17140f" stroke-opacity={i < 2 ? 0.9 : 0.35}/>{i < 2 && <path class="mv-check" style={`animation-delay:${i * 0.5}s`} pathLength="1" d="M3 6.2l2 2L9 4" fill="none" stroke="#17140f" stroke-width="1.6" stroke-linecap="round"/>}</svg><i class="h-1.5 rounded bg-black/30" style={`width:${[64, 48, 58][i]}%`}></i></div>)}</div>
  )}
  {slug === 'datos' && (
    <div class="grid h-full grid-cols-[1fr_auto] items-center gap-2 p-2.5"><div class="flex h-full items-end gap-1">{[50, 70, 44, 82].map((h, i) => <i class={bars} style={`height:${h}%;animation-delay:${i * 0.25}s;background:${['#6fd0ff', '#ff8a5b', '#ffd23f', '#7fe3b5'][i]}`}></i>)}</div><svg viewBox="0 0 40 40" class="size-12 -rotate-90"><circle cx="20" cy="20" r="14" fill="none" stroke="#0000001a" stroke-width="6"/><circle class="mv-donut" pathLength="1" cx="20" cy="20" r="14" fill="none" stroke="#ff8a5b" stroke-width="6" stroke-linecap="round"/></svg></div>
  )}
</div>
