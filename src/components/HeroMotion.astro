<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { splitWords } from '../scripts/words';

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });

  // ---- tuning ----
  const SCROLL_SCREENS = 1.5; // how much scrolling the portal takes
  const DOLLY = 0.18; // camera push-in
  const TILT_Y = -26; // degrees, panel starts turned
  const TILT_X = 5;

  const root = document.documentElement;
  const animated = root.classList.contains('anim');
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const hero = $('[data-hero]');
  const media = $('[data-media]');
  const camera = $('[data-camera]');
  const copy = $('[data-copy]');
  const over = $('[data-over]');
  const planes = [...document.querySelectorAll<HTMLElement>('[data-plane]')];
  const portal = planes[planes.length - 1]; // the one in the Over layer (same size as the glass)
  const glass = $('[data-glass]');
  const rim = $('[data-rim]');
  const fill = $('[data-fill]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const title = $('[data-intro]:not([data-intro="lead"])');
  const lead = $('[data-intro="lead"]');
  const preloader = $('[data-preloader]');
  const countEl = $('[data-count]');

  const seg = (t: number, a: number, b: number) => Math.min(1, Math.max(0, (t - a) / (b - a)));
  const inOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);

  // Shared state: written by the intro and the scroll, read by apply().
  const st = { scale: animated ? 0 : 1, face: animated ? 0 : 1, flash: 0, p: 0 };
  let cover = 4;
  let H = innerHeight;

  const measure = () => {
    H = hero.clientHeight;
    cover = Math.max(hero.clientWidth / portal.offsetWidth, H / portal.offsetHeight) * 1.3;
    apply();
  };

  function apply() {
    const { scale, face, flash, p } = st;
    const s = `scale(${scale})`;
    media.style.transform = s;
    over.style.transform = s;
    camera.style.transform = `scale(${1 + DOLLY * inOut(seg(p, 0, 0.6))})`;
    const turn = inOut(seg(p, 0, 0.4));
    const grow = seg(p, 0.42, 0.9) ** 3;
    const t3d = `rotateY(${TILT_Y * (1 - turn)}deg) rotateX(${TILT_X * (1 - turn)}deg) scale(${1 + (cover - 1) * grow})`;
    for (const pl of planes) pl.style.transform = t3d;
    glass.style.opacity = String(face * (1 - seg(p, 0.12, 0.35)));
    rim.style.opacity = String(Math.max(flash, seg(p, 0.08, 0.35)));
    fill.style.opacity = String(seg(p, 0.3, 0.58));
    copy.style.transform = `translate3d(0, ${-H * 0.14 * seg(p, 0.15, 0.7)}px, 0)`;
    const tone = p >= 0.7 ? 'light' : 'dark';
    if (hero.dataset.tone !== tone) {
      hero.dataset.tone = tone;
      dispatchEvent(new Event('hero:tone'));
    }
  }

  if (!animated) {
    // Reduced motion: static hero, no pin, no portal.
    planes.forEach((pl) => (pl.parentElement!.style.display = 'none'));
    apply();
  } else {
    history.scrollRestoration = 'manual';
    scrollTo(0, 0);

    // Scroll transition: pin the hero and drive the portal.
    const proxy = { p: 0 };
    gsap.to(proxy, {
      p: 1,
      ease: 'none',
      scrollTrigger: {
        trigger: hero,
        start: 'top top',
        end: () => '+=' + innerHeight * SCROLL_SCREENS,
        pin: true,
        scrub: 0.6,
        invalidateOnRefresh: true,
        onRefresh: measure,
      },
      onUpdate: () => { st.p = proxy.p; apply(); },
    });
    measure();

    // Loading: counter follows real progress (fonts + first frame), never reaching 100 until all is ready.
    const counter = { v: 0 };
    const showCount = () => (countEl.textContent = String(Math.round(counter.v)).padStart(2, '0'));
    const follow = gsap.quickTo(counter, 'v', { duration: 0.4, ease: 'power1.out' });
    gsap.ticker.add(showCount);
    const tasks = [
      document.fonts.load('400 1em "Inter Tight Variable"'),
      document.fonts.load('400 1em Lato'),
      document.fonts.load('700 1em Lato'),
      new Promise<void>((res) => {
        if ((window as any).__heroReady) res();
        else addEventListener('hero:ready', () => res(), { once: true });
      }),
    ].map((t) => Promise.race([t.catch(() => {}), new Promise((r) => setTimeout(r, 4000))]));
    let done = 0;
    tasks.forEach((t) => t.then(() => follow((++done / tasks.length) * 90)));

    Promise.all(tasks).then(() => {
      gsap.ticker.remove(showCount);
      const words = splitWords(lead);
      const titleWords = title.querySelectorAll('[data-word]');
      const blurIn = (el: gsap.TweenTarget, at: number, blur = 10) =>
        tl.fromTo(el, { opacity: 0, filter: `blur(${blur}px)` }, { opacity: 1, filter: 'blur(0px)', duration: 0.6, ease: 'power2.out', clearProps: 'filter' }, at);
      const reveal = (set: gsap.TweenTarget, ws: gsap.TweenTarget, at: number, stagger: number) =>
        tl
          .set(set, { opacity: 1 }, at)
          .fromTo(ws, { opacity: 0, filter: 'blur(12px)', yPercent: 25 }, { opacity: 1, filter: 'blur(0px)', yPercent: 0, duration: 0.7, ease: 'power2.out', stagger, clearProps: 'filter,transform' }, at);

      const tl = gsap.timeline({
        defaults: { overwrite: false },
        onComplete: () => {
          root.removeAttribute('data-locked');
          (window as any).__introDone = true;
          ScrollTrigger.refresh();
        },
      });
      tl.to(counter, { v: 100, duration: 0.5, ease: 'power1.out', onUpdate: showCount }, 0)
        .to(countEl.parentElement, { opacity: 0, duration: 0.15, ease: 'power1.in' }, 0.5)
        .to(st, { scale: 1, duration: 0.85, ease: 'power2.out', onUpdate: apply }, 0.6)
        .to(preloader.firstElementChild, { opacity: 0, duration: 0.4, ease: 'power1.out' }, 0.7)
        .to(st, { keyframes: { face: [0, 0.8, 0.15, 1, 0.55, 1] }, duration: 0.45, ease: 'none', onUpdate: apply }, 1.05)
        .to(st, { keyframes: { flash: [0, 1, 0] }, duration: 0.7, ease: 'power1.out', onUpdate: apply }, 1.05);
      if (nav) blurIn(nav, 1.15, 8);
      reveal(title, titleWords, 1.25, 0.09);
      reveal(lead, words, 1.7, 0.035);
      tl.to({}, { duration: 0.01 }, 2.3);
    });
  }
</script>
