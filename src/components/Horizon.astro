---
import Kit from './Kit.astro';
import KitSpritzle from './KitSpritzle.astro';
import KitNightlight from './KitNightlight.astro';
import KitNike from './KitNike.astro';
import KitFelix from './KitFelix.astro';
// Five cards: the photograph of a reference site on the front; on the back, the whole kit (identity, marketing, assistants, operations, finance, live system) in that site's own visual identity.
const cards = ['/horizon/1.webp', '/horizon/2.webp', '/horizon/3.webp', '/horizon/4.webp', '/horizon/5.webp'];
---

<section data-horizon class="relative z-10 -mt-[90svh] h-[340svh]">
  <div class="sticky top-0 h-lvh overflow-hidden">
    <div class="absolute inset-x-0 top-[15svh] z-10 px-6 text-center">
      <h2 data-words class="mx-auto max-w-[24ch] text-[clamp(1.9rem,4vw,4.4rem)] font-light leading-[1.02] tracking-[-0.04em] text-white [text-shadow:0_2px_30px_rgba(40,30,30,0.25)] text-balance">
        Una sola firma para diseñar, conectar y operar tu empresa
      </h2>
    </div>

    <!-- Curved carousel: cards flip from photograph to module -->
    <div data-stage class="absolute inset-x-0 top-[55%] z-10 h-0" style="perspective:1500px;--tw:clamp(190px,23vw,420px);--th:calc(var(--tw)*0.62);--R:calc(var(--tw)*3.2)">
      <div data-cyl class="absolute left-1/2 top-0 size-0" style="transform-style:preserve-3d">
        {cards.map((img, i) => (
          <figure class="hz-tile" style={`--i:${i}`}>
            <div class="hz-flip" data-flip>
              <div class="hz-face hz-front">
                <img src={img} alt="" width="960" height="600" decoding="async" class="size-full object-cover" />
                <i class="hz-sheen absolute inset-0"></i>
              </div>
              <div class="hz-face hz-back"><div class="hz-pn" data-hzpn>{i === 0 && <KitSpritzle />}{i === 1 && <KitNightlight />}{i === 2 && <Kit focus={4} />}{i === 3 && <KitNike />}{i === 4 && <KitFelix />}</div></div>
            </div>
          </figure>
        ))}
        {cards.slice(0, -1).map((_, i) => (
          <i class="hz-link" style={`--i:${i + 0.5}`} aria-hidden="true"><b></b></i>
        ))}
      </div>
    </div>

    <p data-reveal class="absolute inset-x-0 bottom-[calc(100lvh-100svh+13svh)] z-10 mx-auto max-w-[21rem] px-6 text-center text-[13px] leading-relaxed text-white/85 [text-shadow:0_1px_18px_rgba(0,0,0,0.5)]">
      HumanCorp reúne diseño, desarrollo digital, marketing, inteligencia artificial, automatización y gestión en una estructura coherente.
    </p>
  </div>
</section>

<script>
  import { onFrame, measure, put, clamp, smooth, countsOf, paintCounts, dissolveOut } from '../scripts/frame';
  const sec = document.querySelector<HTMLElement>('[data-horizon]')!;
  const cyl = sec.querySelector<HTMLElement>('[data-cyl]')!;
  const stage = sec.querySelector<HTMLElement>('[data-stage]')!;
  const tiles = [...sec.querySelectorAll<HTMLElement>('.hz-tile')].map((el) => {
    const pn = el.querySelector<HTMLElement>('[data-hzpn]')!;
    return { flip: el.querySelector<HTMLElement>('[data-flip]')!, sheen: el.querySelector<HTMLElement>('.hz-sheen')!, pn, panel: pn.firstElementChild as HTMLElement, counts: countsOf(pn), q: -1 };
  });
  const m = measure(sec);
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) dissolveOut(sec.firstElementChild as HTMLElement, document.getElementById('construccion')!);
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const STEP = 20; // degrees between cards
  const ptr = { x: 0 }, tgt = { x: 0 };
  addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') tgt.x = e.clientX / innerWidth - 0.5; }, { passive: true });

  // the 640x400 board is scaled to the card width
  const fit = () => tiles.forEach((t) => { const w = t.flip.clientWidth; if (w) put(t.pn, '--sc', (w / 640).toFixed(4)); });
  fit();
  addEventListener('resize', fit);
  new ResizeObserver(fit).observe(tiles[0].flip);

  const paint = (angle: number, t: (typeof tiles)[number]) => {
    const rad = (angle * Math.PI) / 180;
    put(t.flip, 'transform', angle < 0.2 ? 'none' : `translateZ(${(Math.sin(rad) * 46).toFixed(1)}px) rotateY(${angle.toFixed(2)}deg)`);
    put(t.sheen, 'opacity', (Math.sin(rad) * 0.9).toFixed(3));
    put(t.sheen, 'transform', `translateX(${((angle / 90 - 1) * 70).toFixed(1)}%)`);
    const q = smooth(clamp((angle - 88) / 92));
    if (q !== t.q) { t.q = q; t.panel.style.setProperty('--q', q.toFixed(4)); paintCounts(t.counts, q); }
  };
  if (reduced) tiles.forEach((t) => paint(0, t));

  onFrame((now, y, vh) => {
    if (y + vh < m.top || y > m.top + m.height) return;
    const p = clamp((y - m.top) / Math.max(1, m.height - vh));
    ptr.x += (tgt.x - ptr.x) * 0.05;
    const idle = reduced ? 0 : Math.sin(now / 2600) * 0.08;
    // the carousel settles with all five cards in view, then every card turns together on the last scroll
    const idx = 0.75 + 1.25 * smooth(clamp(p / 0.5)) + idle - ptr.x * 0.2;
    put(cyl, 'transform', `translateZ(var(--R)) rotateY(${(-idx * STEP).toFixed(2)}deg)`);
    if (reduced) return;
    const f = smooth(clamp((p - 0.5) / 0.2));
    tiles.forEach((t) => paint(180 * f, t));
    put(cyl, '--lk', (0.35 + 0.65 * f).toFixed(3));
    put(stage, 'scale', (1 - 0.27 * smooth(clamp((p - 0.38) / 0.3))).toFixed(4)); // pull back so the whole kit is in view
  });
</script>
