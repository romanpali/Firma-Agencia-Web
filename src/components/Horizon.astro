---
// Placeholder photos (public/horizon/1..5.webp) cycled over the eight tiles until the final ones arrive.
const photos = [1, 2, 3, 4, 5];
const tiles = Array.from({ length: 8 }, (_, i) => photos[i % photos.length]);
---

<section data-horizon class="relative z-10 h-[260svh]">
  <div class="sticky top-0 h-svh overflow-hidden">
    <div class="absolute inset-x-0 top-[15svh] z-10 px-6 text-center">
      <h2 data-words class="mx-auto max-w-[24ch] text-[clamp(1.9rem,4vw,4.4rem)] font-light leading-[1.02] tracking-[-0.04em] text-white [text-shadow:0_2px_30px_rgba(40,30,30,0.25)] text-balance">
        Una sola firma para diseñar, conectar y operar tu empresa
      </h2>
    </div>

    <!-- Curved carousel of the eight areas -->
    <div class="absolute inset-x-0 top-[55%] z-10 h-0" style="perspective:1500px;--tw:clamp(175px,23vw,360px);--th:calc(var(--tw)*0.62);--R:calc(var(--tw)*3.2)">
      <div data-cyl style="transform-style:preserve-3d">
        {tiles.map((n, i) => (
          <figure class="hz-tile" style={`--i:${i}`}>
            <img src={`/horizon/${n}.webp`} alt="" width="960" height="600" decoding="async" class="size-full object-cover" />
          </figure>
        ))}
      </div>
    </div>

    <p data-reveal class="absolute inset-x-0 bottom-[13svh] z-10 mx-auto max-w-[21rem] px-6 text-center text-[13px] leading-relaxed text-white/85 [text-shadow:0_1px_18px_rgba(0,0,0,0.5)]">
      HumanCorp reúne diseño, desarrollo digital, marketing, inteligencia artificial, automatización y gestión en una estructura coherente.
    </p>
  </div>
</section>

<script>
  const sec = document.querySelector<HTMLElement>('[data-horizon]')!;
  const cyl = sec.querySelector<HTMLElement>('[data-cyl]')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const STEP = 20; // degrees between tiles
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const ease = (t: number) => t * t * (3 - 2 * t);
  const ptr = { x: 0 }, tgt = { x: 0 };
  addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse') tgt.x = e.clientX / innerWidth - 0.5; });

  const frame = (now: number) => {
    const r = sec.getBoundingClientRect();
    const p = clamp(-r.top / Math.max(1, r.height - innerHeight));
    ptr.x += (tgt.x - ptr.x) * 0.05;
    const idle = reduced ? 0 : Math.sin(now / 2600) * 0.12;
    const idx = 2 + 3 * ease(p) + idle - ptr.x * 0.25; // which tile sits in the centre
    cyl.style.transform = `translateZ(var(--R)) rotateY(${(-idx * STEP).toFixed(2)}deg)`;
    if (!document.hidden) requestAnimationFrame(frame);
  };
  requestAnimationFrame(frame);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) requestAnimationFrame(frame); });
</script>
