<script>
  import { onFrame, measure, put, clamp } from '../scripts/frame';

  // Cuenta animada (una sola vez al entrar a cada paso; no toca el diseño).
  const countUp = (el: HTMLElement) => {
    const to = +el.dataset.count!, pre = el.dataset.pre || '', suf = el.dataset.suf || '';
    const t0 = performance.now(), D = 1100;
    const step = (now: number) => {
      const k = Math.min(1, (now - t0) / D), v = to * (1 - Math.pow(1 - k, 3));
      el.textContent = pre + Math.round(v).toLocaleString('es-MX') + suf;
      if (k < 1) requestAnimationFrame(step);
    };
    el.textContent = pre + '0' + suf;
    requestAnimationFrame(step);
  };

  document.querySelectorAll<HTMLElement>('[data-pm]').forEach((sec) => {
    if (getComputedStyle(sec).display === 'none') return; // escritorio: esta versión no se usa
    const m = measure(sec);
    const steps = [...sec.querySelectorAll<HTMLElement>('[data-s]')];
    const dots = [...sec.querySelectorAll<HTMLElement>('[data-d]')];
    const bar = sec.querySelector<HTMLElement>('[data-bar]')!;
    const o1 = sec.querySelector<HTMLElement>('.pm-o1')!, o2 = sec.querySelector<HTMLElement>('.pm-o2')!;
    const n = steps.length;
    let cur = -2, lastY = -1;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const set = (i: number) => {
      cur = i;
      steps.forEach((s, k) => { s.classList.toggle('on', k === i); s.classList.toggle('past', k < i); });
      dots.forEach((d, k) => d.classList.toggle('on', k === i));
      if (i >= 0) steps[i].querySelectorAll<HTMLElement>('[data-count]').forEach((c) => (reduced ? null : countUp(c)));
    };
    onFrame((_t, y, vh) => {
      if (y === lastY) return;
      lastY = y;
      // Fuera de pantalla no se hace nada.
      if (y + vh < m.top - 40 || y > m.top + m.height + 40) { if (cur !== -1) set(-1); return; }
      const p = clamp((y - m.top) / Math.max(1, m.height - vh));
      const i = y + vh * 0.9 < m.top ? -1 : Math.min(n - 1, Math.floor(p * n));
      if (i !== cur) set(i);
      put(bar, 'transform', `scaleX(${p.toFixed(3)})`);
      put(o1, 'transform', `translate3d(${(-p * 14).toFixed(1)}vmax, ${(p * 10).toFixed(1)}vmax, 0)`);
      put(o2, 'transform', `translate3d(${(p * 16).toFixed(1)}vmax, ${(-p * 8).toFixed(1)}vmax, 0)`);
    });
  });
</script>
