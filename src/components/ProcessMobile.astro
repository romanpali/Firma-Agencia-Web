  .pm-rd u { position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(from 0deg, rgba(124, 155, 255, 0.42), rgba(124, 155, 255, 0) 22%, transparent 22%); } .pm-s.on .pm-rd u.pml { animation: pmSp 3.6s linear infinite; translate: none; } @keyframes pmSp { to { transform: rotate(360deg); } }
