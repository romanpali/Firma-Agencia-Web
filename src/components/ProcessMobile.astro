---
// Celular: «Qué hacemos» y «Cómo trabajamos» en versión ligera y clara.
// Escena fija por secciones; el scroll solo elige el paso activo y cada paso entra con transiciones de transform/opacidad (60 fps).
const qh = [
  { t: 'Tu empresa, hoy', d: 'Hojas sueltas, chats, archivos y herramientas que no se hablan entre sí.' },
  { t: 'Branding e identidad digital', d: 'Una identidad clara: nombre, logotipo, color y tipografía.' },
  { t: 'Presencia digital', d: 'Un sitio web claro, rápido y a la medida de tu negocio.' },
  { t: 'Branding y redes sociales', d: 'Contenido consistente con tu identidad, publicado con orden.' },
  { t: 'Ventas y CRM', d: 'Prospectos y oportunidades con seguimiento en un solo lugar.' },
  { t: 'Finanzas, Asesoría Contable y Fiscal', d: 'Tus números en orden, con la asesoría de nuestro Director de Administración y Finanzas.' },
  { t: 'Operaciones', d: 'Procesos, tareas y equipos coordinados, con avance a la vista.' },
  { t: 'Datos e infraestructura', d: 'Tu información y tus sistemas organizados, respaldados y monitoreados.' },
  { t: 'IA y automatización', d: 'Tareas repetitivas automatizadas, con supervisión humana.' },
  { t: 'Un solo ecosistema', d: 'Todo conectado bajo un solo estándar.' },
];
const ct = [
  { t: 'Contacto inicial', d: 'El cliente contacta a HumanCorp y recibe atención comercial.' },
  { t: 'Llamada de descubrimiento', d: 'Se agenda una llamada para conocer su empresa, necesidades y objetivos.' },
  { t: 'Diagnóstico', d: 'HumanCorp analiza su situación e identifica qué soluciones necesita.' },
  { t: 'Propuesta comercial', d: 'Se presenta la solución, los servicios, entregables, tiempos y precios.' },
  { t: 'Contratación y onboarding', d: 'Se negocian condiciones, se firma el contrato, se recibe el anticipo y se incorpora al cliente.' },
  { t: 'Planificación y ejecución', d: 'Se organiza el proyecto y comienzan los trabajos de las áreas correspondientes.' },
  { t: 'Entrega y validación', d: 'Se presentan los resultados, se realizan ajustes acordados y se entrega formalmente el proyecto.' },
  { t: 'Seguimiento y continuidad', d: 'Se proporciona soporte, mantenimiento, seguimiento de resultados y posibles nuevos servicios.' },
];
const pad = (n: number) => String(n).padStart(2, '0');
// Satélites del paso final: elipse alrededor del centro; cada línea parte del centro con su largo y ángulo.
const sats = ['Branding', 'Web', 'Redes', 'CRM', 'Finanzas', 'Operaciones', 'Datos', 'IA'].map((n, k) => {
  const a = (k / 8) * Math.PI * 2 - Math.PI / 2, rx = 8.4, ry = 5.9;
  const x = Math.cos(a) * rx, y = Math.sin(a) * ry;
  return { n, x: 11 + x, y: 8 + y, len: Math.hypot(x, y), deg: (Math.atan2(y, x) * 180) / Math.PI };
});
const dots = (n: number) => Array.from({ length: n }, (_, i) => i);
---

<!-- ===== Qué hacemos (celular) ===== -->
<section id="qh-m" data-pm data-tone="dark" style={`--n:${qh.length}`} class="pm pm-a font-goog md:hidden" aria-label="Qué hacemos">
  <div class="pm-pin">
    <div class="pm-bg" aria-hidden="true"><i class="pm-o1"></i><i class="pm-o2"></i><i class="pm-grid"></i></div>
    <i data-bar class="pm-bar" aria-hidden="true"></i>
    <p class="pm-eye">Qué hacemos</p>

    {/* 1 · Tu empresa, hoy: piezas sueltas */}
    <article data-s class="pm-s">
      <div class="pm-vis" aria-hidden="true">
        <i class="pm-dash" style="left:2em;top:1.4em;width:18em;height:13em"></i>
        {([['Hoja de cálculo', 0.6, 1.2, -7], ['PDF', 9.6, 0.2, 5], ['Chat', 15.4, 2.2, -4], ['Correo', 1.8, 6.2, 6], ['Nota', 10.2, 5.8, -8], ['Calendario', 14.6, 8.6, 4], ['Fotos', 4.6, 11.4, -5], ['Presupuesto_v3', 11.2, 11.6, 7]] as [string, number, number, number][]).map(([n, x, y, r], k) => (
          <span class="pmp pmi pml" style={`left:calc(var(--u)*${x});top:calc(var(--u)*${y});rotate:${r}deg;--i:${k};--d:${k}`}><u class="pmd"></u>{n}</span>
        ))}
      </div>
      <div class="pm-txt"><span class="pm-k pmi" style="--i:7">01 / 10</span><h3 class="pmi" style="--i:8">{qh[0].t}</h3><p class="pmi" style="--i:9">{qh[0].d}</p></div>
    </article>

    {/* 2 · Branding e identidad */}
    <article data-s class="pm-s">
      <div class="pm-vis" aria-hidden="true">
        <div class="pmc pmi pm-logo" style="left:.6em;top:.8em;width:11.6em;height:14.2em;--i:0">
          <span class="pm-mark"><b>H</b><i class="pm-ring"></i></span>
          <small>HUMAN <b>CORP</b></small>
        </div>
        {(['#0033FF', '#977DFF', '#f0b56e', '#0b1280'] as string[]).map((c, k) => (
          <i class="pmi pm-sw" style={`left:${13.2 + (k % 2) * 4.2}em;top:${0.8 + Math.floor(k / 2) * 4.2}em;background:${c};--i:${k + 1}`}></i>
        ))}
        <div class="pmc pmi pm-aa" style="left:13.2em;top:9.4em;width:8.2em;height:5.6em;--i:5"><b>Aa</b><i class="pmw" style="--i:6;--w:.8"></i><i class="pmw" style="--i:7;--w:.5"></i></div>
      </div>
      <div class="pm-txt"><span class="pm-k pmi" style="--i:7">02 / 10</span><h3 class="pmi" style="--i:8">{qh[1].t}</h3><p class="pmi" style="--i:9">{qh[1].d}</p></div>
    </article>

    {/* 3 · Presencia digital */}
    <article data-s class="pm-s">
      <div class="pm-vis" aria-hidden="true">
        <div class="pmc pmi pm-br" style="left:.5em;top:.8em;width:21em;height:14.4em;--i:0">
          <div class="pm-bt"><i></i><i></i><i></i><span></span></div>
          <div class="pm-bh">
            <b class="pmw" style="--i:2;--w:.9"></b><b class="pmw" style="--i:3;--w:.62"></b><u class="pmw" style="--i:4;--w:.4"></u>
            <em class="pmi pm-ph" style="--i:3"></em>
          </div>
          <div class="pm-bc"><i class="pmi" style="--i:5"></i><i class="pmi" style="--i:6"></i><i class="pmi" style="--i:7"></i></div>
        </div>
        <svg class="pm-cur" viewBox="0 0 24 24" width="24" height="24"><path d="M5 3l14 8-6 2 4 7-3 1-4-7-5 4z" fill="#fff" stroke="#0b0b0c" stroke-width="1.4" stroke-linejoin="round"/></svg>
        <i class="pm-clk"></i>
      </div>
      <div class="pm-txt"><span class="pm-k pmi" style="--i:7">03 / 10</span><h3 class="pmi" style="--i:8">{qh[2].t}</h3><p class="pmi" style="--i:9">{qh[2].d}</p></div>
    </article>

    {/* 4 · Branding y redes */}
    <article data-s class="pm-s">
      <div class="pm-vis" aria-hidden="true">
        <div class="pmc pmi pm-ph2" style="left:7.2em;top:.4em;width:7.8em;height:15.2em;--i:0">
          <i class="pm-nt"></i>
          <div class="pm-pr"><b></b><span><i class="pmw" style="--i:2;--w:.9"></i><i class="pmw" style="--i:3;--w:.6"></i></span></div>
          <div class="pm-tl">{dots(6).map((k) => <i class="pmi" style={`--i:${k + 2};--c:${k % 3}`}></i>)}</div>
        </div>
        <span class="pmp pmi pml g" style="left:calc(var(--u)*.4);top:calc(var(--u)*3.2);--i:3;--d:1">+12 K seguidores</span>
        <span class="pmp pmi pml" style="left:calc(var(--u)*15.6);top:calc(var(--u)*7.4);--i:4;--d:3">♥ 2.4 K</span>
        <span class="pmp pmi pml" style="left:calc(var(--u)*1.2);top:calc(var(--u)*11.2);--i:5;--d:2">Publicación programada</span>
      </div>
      <div class="pm-txt"><span class="pm-k pmi" style="--i:7">04 / 10</span><h3 class="pmi" style="--i:8">{qh[3].t}</h3><p class="pmi" style="--i:9">{qh[3].d}</p></div>
    </article>

    {/* 5 · Ventas y CRM */}
    <article data-s class="pm-s">
      <div class="pm-vis" aria-hidden="true">
        {['Nuevo', 'Propuesta', 'Cierre'].map((n, k) => (
          <div class="pmc pmi pm-col" style={`left:${0.2 + k * 7.3}em;top:.4em;width:6.8em;height:11.6em;--i:${k}`}>
            <small>{n}</small>
            <i class="pm-deal"><b></b><b></b></i>
            {k === 0 && <i class="pm-deal"><b></b><b></b></i>}
            {k === 1 && <i class="pm-deal pml pm-mv"><b></b><b></b></i>}
            {k === 2 && <i class="pm-deal pm-win"><b></b><b></b></i>}
          </div>
        ))}
        <span class="pmp pmi g" style="left:calc(var(--u)*6.2);top:calc(var(--u)*13);font-size:.95em;--i:4"><span data-count="134" data-pre="$ " data-suf=" mil">$ 134 mil</span> en oportunidades</span>
      </div>
      <div class="pm-txt"><span class="pm-k pmi" style="--i:7">05 / 10</span><h3 class="pmi" style="--i:8">{qh[4].t}</h3><p class="pmi" style="--i:9">{qh[4].d}</p></div>
    </article>

    {/* 6 · Finanzas */}
    <article data-s class="pm-s">
      <div class="pm-vis" aria-hidden="true">
        <div class="pmc pmi pm-ch" style="left:.4em;top:.4em;width:21.2em;height:12em;--i:0">
          <i class="pm-gl" style="top:25%"></i><i class="pm-gl" style="top:50%"></i><i class="pm-gl" style="top:75%"></i>
          <div class="pm-bars">{[38, 54, 46, 70, 62, 88].map((h, k) => <i class="pmh" style={`height:${h}%;--i:${k + 1}`}></i>)}</div>
          <svg class="pm-ln" viewBox="0 0 184 72" aria-hidden="true"><path pathLength="1" d="M4 60 C34 56 44 42 70 45 S114 27 136 24 S168 12 180 5" fill="none" stroke="#8fa8ff" stroke-width="2.5" stroke-linecap="round"/></svg>
        </div>
        <span class="pmp pmi g" style="left:calc(var(--u)*1.2);top:calc(var(--u)*13);--i:5"><span data-count="1284000" data-pre="$ ">$ 1,284,000</span></span>
        <span class="pmp pmi" style="left:calc(var(--u)*11.4);top:calc(var(--u)*13);--i:6">Asesoría contable y fiscal</span>
      </div>
      <div class="pm-txt"><span class="pm-k pmi" style="--i:7">06 / 10</span><h3 class="pmi" style="--i:8">{qh[5].t}</h3><p class="pmi" style="--i:9">{qh[5].d}</p></div>
    </article>

    {/* 7 · Operaciones */}
    <article data-s class="pm-s">
      <div class="pm-vis" aria-hidden="true">
        <div class="pmc pmi pm-op" style="left:.4em;top:.4em;width:21.2em;height:14.4em;--i:0">
          {([['Compras', 0.92, 'Listo'], ['Producción', 0.64, 'En curso'], ['Entregas', 0.4, 'En curso'], ['Facturación', 0.78, 'Listo']] as [string, number, string][]).map(([n, w, s], k) => (
            <div class="pm-row"><small class="pmi" style={`--i:${k + 1}`}>{n}</small><span><i class="pmw" style={`--i:${k + 2};--w:${w}`}></i></span><em class={`pmi${s === 'Listo' ? ' ok' : ''}`} style={`--i:${k + 3}`}>{s}</em></div>
          ))}
        </div>
      </div>
      <div class="pm-txt"><span class="pm-k pmi" style="--i:7">07 / 10</span><h3 class="pmi" style="--i:8">{qh[6].t}</h3><p class="pmi" style="--i:9">{qh[6].d}</p></div>
    </article>

    {/* 8 · Datos e infraestructura */}
    <article data-s class="pm-s">
      <div class="pm-vis" aria-hidden="true">
        {[0, 1, 2].map((k) => (
          <div class="pmc pmi pm-sv" style={`left:.6em;top:${0.8 + k * 4.9}em;width:15.4em;height:3.9em;--i:${k}`}>
            <i class="pm-led pml" style={`--d:${k}`}></i><i class="pm-led pml" style={`--d:${k + 2}`}></i>
            <span><i class="pmw" style={`--i:${k + 2};--w:${0.8 - k * 0.18}`}></i></span><i class="pm-pk pml" style={`--d:${k}`}></i>
          </div>
        ))}
        <div class="pmc pmi pm-sh" style="left:17.2em;top:3.4em;width:4.2em;height:7.6em;--i:3">
          <svg viewBox="0 0 24 28" width="26" height="30"><path d="M12 2l9 3.4v8.3c0 5.5-3.8 10-9 12.3-5.2-2.3-9-6.8-9-12.3V5.4z" fill="#0033FF"/><path d="M7.6 13.6l3.2 3.2 5.8-6.4" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <small>Respaldo</small>
        </div>
      </div>
      <div class="pm-txt"><span class="pm-k pmi" style="--i:7">08 / 10</span><h3 class="pmi" style="--i:8">{qh[7].t}</h3><p class="pmi" style="--i:9">{qh[7].d}</p></div>
    </article>

    {/* 9 · IA y automatización */}
    <article data-s class="pm-s">
      <div class="pm-vis" aria-hidden="true">
        <div class="pmc pmi pm-nd" style="left:.4em;top:6em;width:5.6em;height:4em;--i:0"><b>✉</b><small>Correo</small></div>
        <i class="pm-wire pmw" style="left:6em;top:7.96em;width:3.4em;--i:1"></i>
        <i class="pm-pkt pml"></i>
        <div class="pm-ai pmi" style="--i:2"><i class="pm-rg"></i><i class="pm-rg pm-rg2"></i><span><svg viewBox="0 0 24 24" width="30" height="30"><path d="M12 2l2.2 6.3L21 10.5l-6.2 2.3L12 22l-2.8-9.2L3 10.5l6.8-2.2z" fill="#fff"/></svg></span></div>
        <i class="pm-wire pm-w2 pmw" style="--i:3"></i><i class="pm-wire pm-w3 pmw" style="--i:3"></i>
        <div class="pmc pmi pm-nd" style="left:16em;top:1.4em;width:5.6em;height:4em;--i:4"><b class="gt">✓</b><small>Tarea</small></div>
        <div class="pmc pmi pm-nd" style="left:16em;top:10.6em;width:5.6em;height:4em;--i:5"><b class="gt">▤</b><small>Reporte</small></div>
        <span class="pmp pmi" style="left:calc(var(--u)*6.4);top:calc(var(--u)*13.4);--i:6">Con supervisión humana</span>
      </div>
      <div class="pm-txt"><span class="pm-k pmi" style="--i:7">09 / 10</span><h3 class="pmi" style="--i:8">{qh[8].t}</h3><p class="pmi" style="--i:9">{qh[8].d}</p></div>
    </article>

    {/* 10 · Un solo ecosistema */}
    <article data-s class="pm-s">
      <div class="pm-vis" aria-hidden="true">
        {sats.map((s, k) => (
          <i class="pm-sp" style={`left:11em;top:8em;width:${s.len.toFixed(2)}em;rotate:${s.deg.toFixed(1)}deg`}><b class="pmw" style={`--i:${k};--w:1`}></b></i>
        ))}
        {sats.map((s, k) => (
          <span class="pmp pmi pm-sat" style={`left:calc(var(--u)*${s.x.toFixed(2)});top:calc(var(--u)*${s.y.toFixed(2)});--i:${k + 2}`}>{s.n}</span>
        ))}
        <div class="pm-core pmi" style="--i:0"><i class="pm-rg"></i><i class="pm-rg pm-rg2"></i><b>HC</b></div>
      </div>
      <div class="pm-txt"><span class="pm-k pmi" style="--i:7">10 / 10</span><h3 class="pmi" style="--i:8">{qh[9].t}</h3><p class="pmi" style="--i:9">{qh[9].d}</p></div>
    </article>

    <div class="pm-rail" aria-hidden="true">{qh.map(() => <i data-d></i>)}</div>
  </div>
</section>

<!-- ===== Cómo trabajamos (celular) ===== -->
<section id="ct-m" data-pm data-tone="dark" style={`--n:${ct.length}`} class="pm pm-b font-goog md:hidden" aria-label="Cómo trabajamos">
  <div class="pm-pin">
    <div class="pm-bg" aria-hidden="true"><i class="pm-o1"></i><i class="pm-o2"></i><i class="pm-grid"></i></div>
    <i data-bar class="pm-bar" aria-hidden="true"></i>
    <p class="pm-eye">Cómo trabajamos</p>

    {/* 1 · Contacto inicial */}
    <article data-s class="pm-s">
      <span class="pm-gh" aria-hidden="true">01</span>
      <div class="pm-vis pm-v2" aria-hidden="true">
        <div class="pmc pmi pm-bb" style="left:.4em;top:1em;width:14em;--i:0"><i class="pmw" style="--i:1;--w:.9"></i><i class="pmw" style="--i:2;--w:.6"></i></div>
        <div class="pmc pmi pm-bb me" style="left:7.6em;top:5.6em;width:14em;--i:2"><i class="pmw" style="--i:3;--w:.85"></i><i class="pmw" style="--i:4;--w:.5"></i></div>
        <div class="pmc pmi pm-bb" style="left:.4em;top:10.2em;width:7em;--i:4"><span class="pm-ty"><i></i><i></i><i></i></span></div>
        <span class="pmp pmi g" style="left:calc(var(--u)*9.2);top:calc(var(--u)*12.4);--i:5">Atención comercial</span>
      </div>
      <div class="pm-txt"><span class="pm-k pmi" style="--i:7">Paso 01 / 08</span><h3 class="pmi" style="--i:8">{ct[0].t}</h3><p class="pmi" style="--i:9">{ct[0].d}</p></div>
    </article>

    {/* 2 · Llamada */}
    <article data-s class="pm-s">
      <span class="pm-gh" aria-hidden="true">02</span>
      <div class="pm-vis pm-v2" aria-hidden="true">
        <div class="pm-av pmi" style="--i:0"><i class="pm-rg"></i><i class="pm-rg pm-rg2"></i><b>HC</b></div>
        <div class="pm-wv">{dots(13).map((k) => <i class="pml" style={`--d:${k};height:${28 + ((k * 37) % 60)}%`}></i>)}</div>
        <span class="pmp pmi g" style="left:calc(var(--u)*7.2);top:calc(var(--u)*2.6);--i:3">En llamada</span>
        <span class="pmp pmi" style="left:calc(var(--u)*.8);top:calc(var(--u)*12.6);--i:4">Tu empresa</span><span class="pmp pmi" style="left:calc(var(--u)*8.4);top:calc(var(--u)*12.6);--i:5">Necesidades</span><span class="pmp pmi" style="left:calc(var(--u)*15.8);top:calc(var(--u)*12.6);--i:6">Objetivos</span>
      </div>
      <div class="pm-txt"><span class="pm-k pmi" style="--i:7">Paso 02 / 08</span><h3 class="pmi" style="--i:8">{ct[1].t}</h3><p class="pmi" style="--i:9">{ct[1].d}</p></div>
    </article>

    {/* 3 · Diagnóstico */}
    <article data-s class="pm-s">
      <span class="pm-gh" aria-hidden="true">03</span>
      <div class="pm-vis pm-v2" aria-hidden="true">
        <div class="pm-rd pmi" style="--i:0"><i></i><i></i><i></i><u class="pml"></u>
          {([[13.2, 3.4], [5.4, 4.8], [12.6, 9.2], [7.2, 10]] as [number, number][]).map(([x, y], k) => <b class="pmi" style={`left:${x}em;top:${y}em;--i:${k + 2}`}></b>)}
        </div>
        <span class="pmp pmi" style="left:calc(var(--u)*.2);top:calc(var(--u)*.6);--i:3">Necesidades</span><span class="pmp pmi" style="left:calc(var(--u)*16);top:calc(var(--u)*1.8);--i:4">Objetivos</span><span class="pmp pmi g" style="left:calc(var(--u)*14.4);top:calc(var(--u)*13.2);--i:5">Soluciones</span>
      </div>
      <div class="pm-txt"><span class="pm-k pmi" style="--i:7">Paso 03 / 08</span><h3 class="pmi" style="--i:8">{ct[2].t}</h3><p class="pmi" style="--i:9">{ct[2].d}</p></div>
    </article>

    {/* 4 · Propuesta */}
    <article data-s class="pm-s">
      <span class="pm-gh" aria-hidden="true">04</span>
      <div class="pm-vis pm-v2" aria-hidden="true">
        <div class="pmc pmi pm-doc" style="left:3em;top:.2em;width:16em;height:14.4em;--i:0">
          <b class="pmw" style="--i:1;--w:.5"></b>
          {([['Servicios', 4], ['Entregables', 7], ['Tiempos', 6]] as [string, number][]).map(([n, v], k) => <div class="pm-dr pmi" style={`--i:${k + 2}`}><small>{n}</small><span>{dots(v > 5 ? 5 : v).map(() => <i></i>)}</span></div>)}
          <hr />
          <div class="pm-tot pmi" style="--i:6"><small>Inversión total</small><span data-count="90500" data-pre="$ ">$ 90,500</span></div>
        </div>
      </div>
      <div class="pm-txt"><span class="pm-k pmi" style="--i:7">Paso 04 / 08</span><h3 class="pmi" style="--i:8">{ct[3].t}</h3><p class="pmi" style="--i:9">{ct[3].d}</p></div>
    </article>

    {/* 5 · Contratación */}
    <article data-s class="pm-s">
      <span class="pm-gh" aria-hidden="true">05</span>
      <div class="pm-vis pm-v2" aria-hidden="true">
        <div class="pmc pmi pm-doc" style="left:2.4em;top:.4em;width:12.6em;height:14.2em;--i:0">
          <b class="pmw" style="--i:1;--w:.6"></b><i class="pmw pm-tx" style="--i:2;--w:.9"></i><i class="pmw pm-tx" style="--i:3;--w:.8"></i><i class="pmw pm-tx" style="--i:4;--w:.55"></i>
