---
// Empaque de un paquete: gradiente profundo, emblema sólido, marco troquelado y contenido legible (texto blanco sobre fondos oscuros).
import type { Pk } from '../data/paquetes';
const { p, wide = false } = Astro.props as { p: Pk; wide?: boolean };
---

<article class="relative flex h-full flex-col overflow-hidden rounded-[26px] p-7 text-white shadow-[0_30px_60px_-34px_rgba(14,12,60,.75)] transition-transform duration-500 hover:-translate-y-1" style={`background:linear-gradient(rgba(7,8,38,.32),rgba(7,8,38,.5)),linear-gradient(150deg,${p.g[0]},${p.g[1]} 58%,${p.g[2]})`}>
  <svg viewBox="0 0 64 64" class="pointer-events-none absolute -bottom-8 -right-8 size-[15rem] opacity-[.07]" fill="none" stroke="#fff" stroke-width=".8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.mark}></svg>
  <i class="pointer-events-none absolute inset-[10px] rounded-[18px] border border-white/30"></i>
  <div class="relative flex items-center justify-between text-[10.5px] font-semibold uppercase tracking-[0.2em] text-white"><span>{p.kind}</span><span class="text-white/80">{p.code}</span></div>
  <div class="relative mt-7 flex items-center gap-4">
    <span class="grid size-[64px] shrink-0 place-items-center rounded-[20px] bg-white shadow-[0_14px_28px_-14px_rgba(0,0,0,.6)]"><svg viewBox="0 0 64 64" class="size-[40px]" fill="none" stroke={p.g[1]} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.mark}></svg></span>
    <h3 class="font-goog text-[1.85rem] font-normal leading-[1.04] tracking-[-0.04em]">{p.t}</h3>
  </div>
  <p class="relative mt-5 max-w-[36rem] text-[14.5px] leading-relaxed text-white">{p.d}</p>
  <p class="relative mt-5 text-[10.5px] font-semibold uppercase tracking-[0.2em] text-white/85">Divisiones</p>
  <div class="relative mt-2 flex flex-wrap gap-1.5">{p.divs.map((d) => <span class="rounded-full bg-black/25 px-3 py-[5px] text-[12px] text-white ring-1 ring-white/30">{d}</span>)}</div>
  <div class="relative mt-5 rounded-[16px] bg-black/25 p-4 ring-1 ring-white/25">
    <p class="mb-2.5 text-[10.5px] font-semibold uppercase tracking-[0.2em] text-white/85">Incluye</p>
    <ul class={`grid gap-x-5 gap-y-2 text-[13.5px] text-white ${wide ? 'md:grid-cols-3' : p.items.length > 4 ? 'sm:grid-cols-2' : ''}`}>{p.items.map((it) => <li class="flex gap-2.5"><span class="mt-[0.55em] block size-1 shrink-0 rounded-full bg-white"></span>{it}</li>)}</ul>
  </div>
  <div class="relative mt-auto flex items-end justify-between gap-4 pt-6">
    <a href={p.href} class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-[14px] font-medium text-[#14163a] transition-transform hover:scale-[1.03]">Cotizar este paquete <span aria-hidden="true">→</span></a>
    <i class="block h-[22px] w-[84px] opacity-80" style="background:repeating-linear-gradient(90deg,#fff 0 2px,transparent 2px 4px,#fff 4px 5px,transparent 5px 8px,#fff 8px 11px,transparent 11px 13px)"></i>
  </div>
</article>
