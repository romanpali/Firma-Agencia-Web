---
import Icon from './Icon.astro';
import type { IconName } from '../data/services';

const modules: { l: string; i: IconName }[] = [
  { l: 'Panel', i: 'layers' },
  { l: 'Ventas', i: 'users' },
  { l: 'Finanzas', i: 'coins' },
  { l: 'Operaciones', i: 'gear' },
  { l: 'Datos', i: 'chart' },
  { l: 'IA', i: 'bot' },
];
const flow: { l: string; i: IconName }[] = [
  { l: 'Campaña', i: 'mail' },
  { l: 'Sitio web', i: 'code' },
  { l: 'CRM', i: 'users' },
  { l: 'Agente IA', i: 'bot' },
  { l: 'Factura', i: 'coins' },
  { l: 'Dashboard', i: 'chart' },
];
const feed = [
  { t: 'Prospecto calificado por el agente de seguimiento', m: 'Ventas', c: 'bg-[#1d4bb8]' },
  { t: 'Cotización enviada desde el CRM', m: 'Ventas', c: 'bg-[#1d4bb8]' },
  { t: 'Factura CFDI preparada para revisión', m: 'Finanzas', c: 'bg-[#16a34a]' },
  { t: 'Orden de compra enviada a aprobación', m: 'Operaciones', c: 'bg-[#d97706]' },
  { t: 'Reporte semanal actualizado', m: 'Datos', c: 'bg-[#1d4bb8]' },
  { t: 'Recordatorio de renovación programado', m: 'Ventas', c: 'bg-[#1d4bb8]' },
];
---

<div
  class="hf-rise relative overflow-hidden rounded-2xl bg-white text-[#14161c] shadow-[0_40px_90px_-20px_rgba(0,0,0,0.6),0_0_0_1px_rgba(255,255,255,0.12)]"
  style="--d:.55s"
  role="img"
  aria-label="Vista del centro de operaciones: ventas, finanzas, operaciones y datos conectados"
>
  <!-- Toolbar -->
  <div class="flex items-center justify-between border-b border-[#e6e9f0] bg-[#f7f8fb] px-4 py-3">
    <div class="flex items-center gap-2 text-[12px] font-medium">
      <span class="grid size-5 place-items-center rounded-md bg-[#0b1a4a] text-[9px] font-bold text-white">H</span>
      <span>HumanCorp</span>
      <span class="hidden text-[#9aa3b5] sm:inline">/</span>
      <span class="hidden text-[#6b7280] sm:inline">Centro de operaciones</span>
    </div>
    <span class="flex items-center gap-2 whitespace-nowrap rounded-full bg-[#e8f7ee] px-2.5 py-1 text-[11px] font-medium text-[#15803d]">
      <span class="hf-dot size-1.5 rounded-full bg-[#16a34a]"></span>Todo conectado
    </span>
  </div>

  <div class="flex">
    <!-- Sidebar -->
    <nav class="hidden w-[132px] shrink-0 flex-col gap-1 border-r border-[#e6e9f0] bg-[#f7f8fb] p-2.5 md:flex" aria-hidden="true">
      {modules.map((m, i) => (
        <span
          class:list={[
            'hf-rise flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-[12px] font-medium transition-colors',
            i === 0 ? 'bg-white text-[#14161c] shadow-[0_1px_2px_rgba(20,22,28,0.08),0_0_0_1px_#e6e9f0]' : 'text-[#6b7280] hover:bg-white/70',
          ]}
          style={`--d:${0.8 + i * 0.07}s`}
        >
          <Icon name={m.i} class={i === 0 ? 'size-4 text-[#1d4bb8]' : 'size-4'} />
          {m.l}
        </span>
      ))}
    </nav>

    <div class="min-w-0 flex-1 space-y-3 p-3 md:p-4">
      <!-- Flow -->
      <div class="rounded-xl border border-[#e6e9f0] p-3 md:p-4">
        <div class="mb-3 flex items-center justify-between">
          <p class="text-[12px] font-medium">Flujo conectado</p>
          <p class="font-mono text-[10px] uppercase tracking-wider text-[#9aa3b5]">Campaña → Dashboard</p>
        </div>
        <div class="relative">
          <div class="absolute left-[8.33%] right-[8.33%] top-[19px] h-px bg-[#dbe3f3]">
            <div class="hf-draw absolute inset-0 origin-left bg-[#1d4bb8]/40" style="--d:1.1s"></div>
            <span class="hf-pulse absolute top-1/2 size-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#1d4bb8] shadow-[0_0_0_4px_rgba(29,75,184,0.2)]"></span>
          </div>
          <ol class="relative grid grid-cols-6">
            {flow.map((n, i) => (
              <li class="hf-rise flex flex-col items-center gap-2" style={`--d:${1 + i * 0.1}s`}>
                <span class="hf-node grid size-10 place-items-center rounded-xl border border-[#dbe3f3] bg-white text-[#4b5563]" style={`--n:${i}`}>
                  <Icon name={n.i} class="size-[18px]" />
                </span>
                <span class="text-center text-[10px] font-medium leading-tight text-[#4b5563]">{n.l}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="grid gap-3 sm:grid-cols-[1.25fr_1fr]">
        <!-- Activity -->
        <div class="hf-rise overflow-hidden rounded-xl border border-[#e6e9f0] p-3 md:p-4" style="--d:1.5s">
          <div class="mb-2.5 flex items-center justify-between">
            <p class="text-[12px] font-medium">Actividad</p>
            <span class="font-mono text-[10px] uppercase tracking-wider text-[#9aa3b5]">En vivo</span>
          </div>
          <div class="hf-mask relative h-[132px] overflow-hidden">
            <ul class="hf-feed">
              {[...feed, ...feed].map((f) => (
                <li class="flex items-start gap-2.5 py-[7px]">
                  <span class={`mt-[5px] size-1.5 shrink-0 rounded-full ${f.c}`}></span>
                  <span class="min-w-0 flex-1 text-[12px] leading-snug text-[#14161c]">{f.t}</span>
                  <span class="shrink-0 rounded-md bg-[#f1f3f8] px-1.5 py-0.5 font-mono text-[9px] uppercase tracking-wide text-[#6b7280]">{f.m}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Cash flow -->
        <div class="hf-rise rounded-xl border border-[#e6e9f0] p-3 md:p-4" style="--d:1.65s">
          <div class="mb-2 flex items-center justify-between">
            <p class="whitespace-nowrap text-[12px] font-medium">Flujo de caja</p>
            <span class="flex items-center gap-2 text-[10px] text-[#6b7280]">
              <span class="flex items-center gap-1"><i class="size-1.5 rounded-full bg-[#1d4bb8]"></i>Ingresos</span>
              <span class="flex items-center gap-1"><i class="size-1.5 rounded-full bg-[#b6bdcc]"></i>Gastos</span>
            </span>
          </div>
          <div class="relative h-[110px]">
            <svg viewBox="0 0 220 110" class="size-full" preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <linearGradient id="hf-area" x1="0" x2="0" y1="0" y2="1">
                  <stop offset="0" stop-color="#1d4bb8" stop-opacity="0.22" />
                  <stop offset="1" stop-color="#1d4bb8" stop-opacity="0" />
                </linearGradient>
              </defs>
              <g stroke="#eef0f5" stroke-width="1">
                <path d="M0 27.5H220M0 55H220M0 82.5H220" />
              </g>
              <path class="hf-fade" d="M0 84 C 25 78, 40 60, 62 62 S 100 34, 125 40 S 175 18, 220 12 V110 H0Z" fill="url(#hf-area)" style="--d:1.9s" />
              <path class="hf-stroke" pathLength="1" d="M0 92 C 30 90, 50 82, 75 84 S 120 70, 150 72 S 195 62, 220 58" fill="none" stroke="#b6bdcc" stroke-width="1.5" stroke-linecap="round" style="--d:1.8s" />
              <path class="hf-stroke" pathLength="1" d="M0 84 C 25 78, 40 60, 62 62 S 100 34, 125 40 S 175 18, 220 12" fill="none" stroke="#1d4bb8" stroke-width="2" stroke-linecap="round" style="--d:1.7s" />
            </svg>
            <span class="hf-scan absolute inset-y-0 left-0 w-px bg-[#1d4bb8]/30"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
