---
interface Props {
  mode: 'a' | 'b';
  title: string[];
  desc: string;
  chips: string[];
  labels?: string[];
}
const { mode, title, desc, chips, labels = [] } = Astro.props;
const a = mode === 'a';
const titleCls = a
  ? 'font-serif italic text-[clamp(3rem,11vw,3.75rem)] leading-[0.95] tracking-[-0.02em] md:text-[clamp(2.75rem,5.8vw,6.75rem)]'
  : 'font-mono font-light text-[clamp(1.9rem,8vw,2.6rem)] leading-[1.08] tracking-[-0.06em] md:text-[clamp(1.6rem,3.7vw,4.4rem)]';
const glow = a
  ? 'radial-gradient(circle, rgba(255,150,120,.55) 0%, rgba(214,90,130,.22) 38%, transparent 68%)'
  : 'radial-gradient(circle, rgba(90,150,255,.5) 0%, rgba(40,90,220,.18) 38%, transparent 68%)';
---

<div class="absolute inset-0">
  <canvas data-canvas={mode} class="hf-fade absolute inset-0 size-full" style="--d:.3s"></canvas>

  {a && <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[55%]" style="background:radial-gradient(70% 100% at 50% 100%,rgba(255,138,110,.75),rgba(208,96,122,.35) 45%,transparent 75%)"></div>}

  <!-- Orb: the HumanCorp mark -->
  <div class="orb-in pointer-events-none absolute left-1/2 top-[53%] size-0 md:top-1/2" style="--d:.8s">
    <div class="absolute left-1/2 top-1/2 size-[560px] -translate-x-1/2 -translate-y-1/2" style={`background:${glow}`}></div>
    <i class="ring-out absolute left-1/2 top-1/2 size-[120px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/50"></i>
    <i class="ring-out absolute left-1/2 top-1/2 size-[120px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/50" style="animation-delay:2.6s"></i>
    <div class="orb-float absolute left-1/2 top-1/2 size-[104px] -translate-x-1/2 -translate-y-1/2 rounded-full border-[1.5px] border-white/90 shadow-[0_0_60px_rgba(255,255,255,0.35),inset_0_0_30px_rgba(255,255,255,0.2)]">
      <i class="absolute -top-[9px] left-1/2 size-[11px] -translate-x-1/2 rounded-full bg-white shadow-[0_0_14px_rgba(255,255,255,0.9)]"></i>
    </div>
  </div>

  {!a && labels.map((l, i) => <span data-node-label={i + 1} class="hf-fade pointer-events-none absolute -translate-x-1/2 whitespace-nowrap font-mono text-[10px] uppercase tracking-[0.14em] text-[#9db8f5]" style={`--d:${1.6 + i * 0.08}s`}>{l}</span>)}

  <!-- Title (left) -->
  {a
    ? <h1 class="absolute left-6 top-[11%] md:left-[6%] md:top-1/2 md:-translate-y-1/2" style="--d:.3s"><span class="block overflow-hidden pb-[0.1em]"><span class={`rl block ${titleCls}`}>{title[0]}</span></span><span class="block overflow-hidden pb-[0.1em]"><span class={`rl block ${titleCls}`} style="--d:.45s">{title[1]}</span></span></h1>
    : <div aria-hidden="true" class="absolute left-6 top-[11%] md:left-[6%] md:top-1/2 md:-translate-y-1/2"><span class="block overflow-hidden pb-[0.1em]"><span class={`block ${titleCls}`}>{title[0]}</span></span><span class="block overflow-hidden pb-[0.1em]"><span class={`block ${titleCls}`}>{title[1]}</span></span></div>}

  <!-- Description + chips (right) -->
  <div class="hf-fade absolute bottom-[10.5rem] left-6 right-6 md:bottom-auto md:left-auto md:right-[6%] md:top-1/2 md:w-[17.5rem] md:-translate-y-1/2" style="--d:1.1s">
    <p class="text-[14.5px] leading-[1.55] text-white/85">{desc}</p>
    <ul class="mt-4 hidden flex-wrap gap-2 md:flex">
      {chips.map((c) => <li class={`rounded-full border border-white/30 px-3 py-1.5 text-[12px] text-white/85 ${a ? '' : 'font-mono text-[11px]'}`}>{c}</li>)}
    </ul>
  </div>
</div>
