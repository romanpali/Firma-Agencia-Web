---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import ScrollFx from '../components/ScrollFx.astro';
import { divisions } from '../data/servicios';

const people = [
  {
    id: 'paolo',
    name: 'Paolo Pali Maldonado',
    role: 'Director de Diseño y Tecnología',
    img: '/team/paolo.webp',
    alt: 'Retrato de Paolo Pali Maldonado',
    accent: '#977DFF',
    bio: 'Dirige el diseño y la parte técnica de HumanCorp: desde la identidad visual y la experiencia digital hasta los sistemas, las automatizaciones y la infraestructura que las sostienen.',
    tags: ['Diseño', 'Desarrollo', 'Automatización', 'Infraestructura'],
    leads: ['01', '02', '05', '08'],
  },
  {
    id: 'mauricio',
    name: 'Mauricio Alberto Pali Maldonado',
    role: 'Director de Administración y Finanzas',
    img: '/team/mauricio.webp',
    alt: 'Retrato de Mauricio Alberto Pali Maldonado',
    accent: '#7ad3f0',
    bio: 'Dirige el lado empresarial y administrativo: finanzas, administración, operaciones y cumplimiento. Es contador y lleva el área fiscal de la firma, para que la tecnología que construimos hable el mismo idioma que tu empresa.',
    tags: ['Contador', 'Fiscal', 'Administración', 'Finanzas'],
    leads: ['04', '06', '07'],
  },
];

// Quién lidera cada división. «03» (marketing) se trabaja en conjunto.
const owner: Record<string, string[]> = { '01': ['paolo'], '02': ['paolo'], '03': ['paolo', 'mauricio'], '04': ['mauricio'], '05': ['paolo'], '06': ['mauricio'], '07': ['mauricio'], '08': ['paolo'] };
const label: Record<string, string> = { paolo: 'Paolo', mauricio: 'Mauricio' };
const short = (n: string) => divisions.find((d) => d.n === n)!;

const principles = [
  ['Un solo estándar', 'Diseño, tecnología y administración se piensan juntos desde el primer día, no como servicios sueltos.'],
  ['Claridad antes que jerga', 'Te explicamos qué hacemos y por qué, con palabras sencillas y alcances por escrito.'],
  ['Alcance honesto', 'Decimos qué hacemos directamente, qué con terceros y qué no prometemos. En lo fiscal, contable y jurídico trabajamos con profesionales habilitados.'],
];
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Conoce a quienes dirigen HumanCorp: Paolo Pali Maldonado (diseño y tecnología) y Mauricio Alberto Pali Maldonado (administración y finanzas)." />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>Nosotros — HumanCorp</title>
  </head>
  <body class="bg-white font-sans text-[#0b0b0c]">
    <Header />
    <main class="relative z-10 overflow-x-clip">
      <!-- Apertura -->
      <section data-tone="light" class="px-6 pb-[8svh] pt-[24svh] md:px-10">
        <div class="mx-auto max-w-[1280px]">
          <p data-reveal class="text-[13px] font-medium uppercase tracking-[0.14em] text-[#6b6e75]">Nosotros</p>
          <h1 data-words class="mt-6 max-w-[18ch] font-goog text-[clamp(2.5rem,6.6vw,6.4rem)] font-light leading-[1.02] tracking-[-0.05em]">Diseño y tecnología, administración y finanzas: un solo equipo.</h1>
          <div class="mt-[9svh] grid gap-6 border-t border-[#e6e4df] pt-8 md:grid-cols-12">
            <p data-reveal class="text-[13px] font-medium uppercase tracking-[0.14em] text-[#6b6e75] md:col-span-4">Quiénes somos</p>
            <p data-reveal style="--i:1" class="max-w-[38rem] text-[clamp(1.05rem,1.5vw,1.3rem)] leading-relaxed text-[#3a3d42] md:col-span-8">HumanCorp la dirigen dos áreas que se complementan: la creativa y técnica, y la empresarial y administrativa. Por eso podemos acompañarte desde tu identidad hasta tu operación.</p>
          </div>
        </div>
      </section>

      <!-- Quiénes dirigen -->
      {people.map((p, i) => (
        <section id={p.id} data-tone="light" class="px-6 py-[8svh] md:px-10">
          <div class="mx-auto grid max-w-[1280px] items-start gap-10 border-t border-[#e6e4df] pt-10 md:grid-cols-12 md:gap-14 md:pt-14">
            <div data-reveal class={`md:col-span-5 ${i % 2 ? 'md:order-2 md:col-start-8' : ''}`}>
              <div class="md:sticky md:top-28">
                <div class="portrait relative mx-auto aspect-[4/5] w-full max-w-[420px] overflow-hidden rounded-[6px] bg-[#ececea] md:max-w-none">
                  <img src={p.img} alt={p.alt} width="640" height="800" loading={i ? 'lazy' : 'eager'} decoding="async" class="absolute inset-0 size-full object-cover object-top" />
                </div>
                <p class="mt-4 flex items-baseline justify-between gap-4 text-[13px] text-[#6b6e75]"><span>{p.name}</span><span>{String(i + 1).padStart(2, '0')} / 02</span></p>
              </div>
            </div>

            <div class={`md:col-span-6 ${i % 2 ? 'md:order-1 md:col-start-1' : 'md:col-start-7'}`}>
              <p data-reveal class="text-[13px] font-medium uppercase tracking-[0.14em] text-[#6b6e75]">{p.role}</p>
              <h2 data-words class="mt-5 font-goog text-[clamp(2.2rem,4.4vw,4.2rem)] font-light leading-[1.03] tracking-[-0.045em]">{p.name}</h2>
              <p data-reveal class="mt-7 max-w-[34rem] text-[16.5px] leading-relaxed text-[#3a3d42]">{p.bio}</p>
              <p data-reveal class="mt-6 text-[14px] text-[#6b6e75]">{p.tags.join(' · ')}</p>

              <p data-reveal class="mt-12 text-[12px] font-medium uppercase tracking-[0.14em] text-[#6b6e75]">Dirige estas divisiones</p>
              <ul class="mt-3 border-t border-[#e6e4df]">
                {p.leads.map((n, k) => (
                  <li data-reveal style={`--i:${k % 2}`} class="border-b border-[#e6e4df]">
                    <a href={`/servicios#div-${n}`} class="group flex items-center justify-between gap-4 py-4 transition-[padding] duration-300 hover:pl-2">
                      <span class="flex items-baseline gap-5"><span class="w-6 font-goog text-[14px] text-[#6b6e75]">{n}</span><span class="font-goog text-[1.1rem] tracking-[-0.02em]">{short(n).title}</span></span>
                      <span class="text-[#6b6e75] transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      ))}

      <!-- Reparto -->
      <section data-tone="light" class="px-6 py-[10svh] md:px-10">
        <div class="mx-auto max-w-[1280px] border-t border-[#e6e4df] pt-10 md:pt-14">
          <div class="grid gap-6 md:grid-cols-12">
            <p data-reveal class="text-[13px] font-medium uppercase tracking-[0.14em] text-[#6b6e75] md:col-span-4">Cómo nos repartimos</p>
            <h2 data-words class="font-goog text-[clamp(2rem,4.4vw,4.2rem)] font-light leading-[1.03] tracking-[-0.045em] md:col-span-8">Ocho divisiones, dos direcciones</h2>
          </div>
          <ul class="mt-[7svh] border-t border-[#e6e4df]">
            {divisions.map((d, k) => (
              <li data-reveal style={`--i:${k % 2}`} class="border-b border-[#e6e4df]">
                <a href={`/servicios#div-${d.n}`} class="group grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-3 py-5 transition-[padding] duration-300 hover:pl-2 md:grid-cols-[4rem_1fr_16rem] md:gap-6">
                  <span class="font-goog text-[14px] text-[#6b6e75]">{d.n}</span>
                  <span class="font-goog text-[clamp(1.05rem,1.8vw,1.5rem)] tracking-[-0.025em]">{d.short}</span>
                  <span class="text-right text-[13.5px] text-[#6b6e75] md:text-left">{owner[d.n].length > 1 ? 'En conjunto' : label[owner[d.n][0]]}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Principios -->
      <section data-tone="light" class="px-6 pb-[12svh] pt-[4svh] md:px-10">
        <div class="mx-auto max-w-[1280px]">
          <p data-reveal class="text-[13px] font-medium uppercase tracking-[0.14em] text-[#6b6e75]">Cómo trabajamos juntos</p>
          <div class="mt-8 grid gap-10 md:grid-cols-3 md:gap-0 md:divide-x md:divide-[#e6e4df]">
            {principles.map(([t, p], k) => (
              <article data-reveal style={`--i:${k}`} class="md:px-8 md:first:pl-0 md:last:pr-0">
                <span class="font-goog text-[14px] text-[#6b6e75]">{String(k + 1).padStart(2, '0')}</span>
                <h3 class="mt-6 font-goog text-[1.45rem] font-normal tracking-[-0.03em]">{t}</h3>
                <p class="mt-3 text-[15px] leading-relaxed text-[#50535a]">{p}</p>
              </article>
            ))}
          </div>
          <div data-reveal class="mt-[9svh] flex flex-wrap items-center gap-3">
            <a href="mailto:info@humancorp.co?subject=Agendar%20llamada" class="rounded-full bg-[#0b0b0c] px-8 py-4 text-[15px] font-medium text-white transition-transform hover:scale-[1.03] active:scale-[0.98]">Agendar una llamada</a>
            <a href="/servicios" class="rounded-full border border-[#0b0b0c]/20 px-8 py-4 text-[15px] transition-colors hover:bg-[#0b0b0c]/5">Ver servicios</a>
          </div>
        </div>
      </section>

      <Contact />
    </main>
    <ScrollFx />
  </body>
</html>
