---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Panel from '../components/Panels.astro';
import AreaScene from '../components/AreaScene.astro';
import ScrollFx from '../components/ScrollFx.astro';
import { divisions, chain, osModules, ways } from '../data/servicios';

// Áreas que reutilizan un panel de «Cómo lo construimos»; el resto tiene su propia escena (AreaScene).
const reuse: Record<string, number> = { d1a: 0, d2a: 1, d3b: 5, d3c: 6, d5a: 4, d6d: 2, d7a: 3, d8a: 7 };
const sceneKey = (di: number, ai: number) => `d${di + 1}${String.fromCharCode(97 + ai)}`;
const split = (s: string) => s.split('|');
const palette = [['#0033ff', '#977dff'], ['#977dff', '#0600ab'], ['#0600ab', '#0033ff'], ['#977dff', '#0033ff']];
const more = [['integracion', 'Integración'], ['os', 'Business OS'], ['formas', 'Formas de trabajar'], ['alcance', 'Alcance']];
import PackCard from '../components/PackCard.astro';
import { area } from '../data/paquetes';
const areaPacks = [area(0, 'creativa', 'HC-A01', 0), area(1, 'creativa', 'HC-A02', 4), area(3, 'creativa', 'HC-A03', 2), area(2, 'tecnica', 'HC-A04', 5), area(4, 'tecnica', 'HC-A05', 8), area(5, 'tecnica', 'HC-A06', 6), area(7, 'tecnica', 'HC-A07', 9), area(6, 'contable', 'HC-A08', 7)];
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Ocho divisiones de servicios de HumanCorp: diseño, desarrollo digital, marketing, ventas y CRM, inteligencia artificial, finanzas, operaciones y datos." />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>Servicios — HumanCorp</title>
  </head>
  <body class="bg-white font-sans text-[#0a0d1f]">
    <Header />
    <main class="relative z-10 overflow-x-clip">
      <!-- Apertura -->
      <section data-tone="light" class="sv2-hero">
        <i class="sv2-band" aria-hidden="true"></i>
        <div class="sv2-in">
          <p data-reveal class="sv2-pill">Servicios</p>
          <h1 data-reveal style="--i:1" class="sv2-h1">Todo lo que hace funcionar a una empresa, <span class="sv2-gr">conectado bajo un solo estándar.</span></h1>
          <p data-reveal style="--i:2" class="sv2-sub">Diseñamos, desarrollamos, conectamos y optimizamos soluciones para empresas, en ocho divisiones que trabajan juntas.</p>
          <div data-reveal style="--i:3" class="sv2-cta">
            <a href="mailto:info@humancorp.co?subject=Agendar%20llamada" data-agendar class="sv2-b1">Agendar una llamada</a>
            <a href="/paquetes" class="sv2-b2">Ver paquetes <span aria-hidden="true">→</span></a>
          </div>
          <ol class="sv2-cards">
            {divisions.map((d, i) => (
              <li data-reveal style={`--i:${i % 4}`}>
                <a href={`#div-${d.n}`}><span class="n">{d.n}</span><span class="t">{d.short}</span></a>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <div class="sv2-wrap">
        <!-- Índice fijo -->
        <nav class="sv2-nav" aria-label="Secciones de servicios" data-nav2>
          <p class="sv2-nl">Divisiones</p>
          <ul>
            {divisions.map((d) => (<li><a href={`#div-${d.n}`} data-to={`div-${d.n}`}><span>{d.n}</span>{d.short}</a></li>))}
          </ul>
          <p class="sv2-nl sv2-nl2">Más</p>
          <ul>
            {more.map(([id, t]) => (<li><a href={`#${id}`} data-to={id}><span>·</span>{t}</a></li>))}
          </ul>
        </nav>

        <div class="sv2-main">
          <!-- Divisiones -->
          {divisions.map((d, di) => (
            <section id={`div-${d.n}`} data-tone="light" data-nsec class="sv2-div" style={`--a:${palette[di % 4][0]};--b:${palette[di % 4][1]}`}>
              <header class="sv2-dh">
                <p data-reveal class="sv2-dn"><span>{d.n}</span> División {d.n} de 08</p>
                <h2 data-reveal style="--i:1">{d.title}</h2>
                <p data-reveal style="--i:2" class="sv2-lead">{d.intro}</p>
              </header>
              <div class="sv2-grid" data-div>
                <div class="sv2-areas">
                  <p class="sv2-al">Áreas · elige una para ver su vista previa</p>
                  {d.areas.map(([t, items], ai) => (
                    <div class={`sv2-a${ai === 0 ? ' on' : ''}`} data-i={ai}>
                      <button type="button" class="sv2-ah" aria-expanded={ai === 0}>
                        <span class="l">{String.fromCharCode(65 + ai)}</span><span class="t">{t}</span><span class="c" aria-hidden="true"></span>
                      </button>
                      <ul class="sv2-li">{split(items).map((w) => <li>{w}</li>)}</ul>
                    </div>
                  ))}
                </div>
                <aside class="sv2-pv">
                  <div class="sv2-box" data-pbox style={`--sa:${palette[di % 4][0]};--sb:${palette[di % 4][1]}`}>
                    <i class="stage-bg absolute inset-0" aria-hidden="true"></i>
                    <i class="grain pointer-events-none absolute inset-0 opacity-[.12]" aria-hidden="true"></i>
                    {d.areas.map(([t], ai) => {
                      const key = sceneKey(di, ai);
                      return (
                        <div class={`sv2-p${ai === 0 ? ' on' : ''}`} data-p={ai}>
                          <div class="stage-panel absolute left-1/2 top-1/2 h-[400px] w-[640px]">
                            {key in reuse ? <Panel i={reuse[key]} label={t} /> : <AreaScene k={key} title={t} />}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                  <p class="sv2-goal"><b>Objetivo</b>{d.goal}</p>
                </aside>
              </div>
              {d.note && <p class="sv2-note">{d.note}</p>}
            </section>
          ))}

          <!-- Todo conectado -->
          <section id="integracion" data-tone="light" data-nsec class="sv2-sec sv2-alt">
            <p data-reveal class="sv2-eye">Integración</p>
            <h2 data-reveal style="--i:1" class="sv2-h2">Soluciones que se conectan entre sí</h2>
            <p data-reveal style="--i:2" class="sv2-lead">No vendemos servicios aislados. Entendemos cómo se relacionan las áreas de tu empresa y desarrollamos soluciones que generan continuidad entre ellas.</p>
            <ol class="sv2-chain">
              {chain.map((c, i) => (<li data-reveal style={`--i:${i % 4}`}><span class="n">{String(i + 1).padStart(2, '0')}</span><span class="t">{c}</span></li>))}
            </ol>
            <p data-reveal class="sv2-sm">Una campaña alimenta una landing page; la landing page alimenta un CRM; el CRM activa un agente de seguimiento; una venta inicia un proceso administrativo que actualiza la información financiera; y los datos comerciales y financieros alimentan un dashboard ejecutivo.</p>
          </section>

          <!-- Business OS -->
          <section id="os" data-tone="light" data-nsec class="sv2-sec">
            <div class="sv2-row"><p data-reveal class="sv2-eye">Visión</p><span data-reveal style="--i:1" class="sv2-bd">En desarrollo</span></div>
            <h2 data-reveal style="--i:1" class="sv2-h2">HumanCorp Business OS</h2>
            <p data-reveal style="--i:2" class="sv2-lead">Una capa propia para consultar, conectar y coordinar las herramientas y procesos de tu empresa, sin reemplazar necesariamente los sistemas que ya usas. Es una línea que estamos construyendo de forma progresiva y todavía no forma parte de nuestra oferta operativa.</p>
            <div class="sv2-os">
              {osModules.map(([t, p], i) => (
                <article data-reveal style={`--i:${i % 3}`}><span class="n">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{p}</p></article>
              ))}
            </div>
          </section>

          <!-- Formas de trabajar -->
          <section id="formas" data-tone="light" data-nsec class="sv2-sec sv2-alt">
            <p data-reveal class="sv2-eye">Formas de trabajar</p>
            <h2 data-reveal style="--i:1" class="sv2-h2">Empieza por lo que necesitas</h2>
            <div class="sv2-ways">
              {ways.map(([t, p], i) => (<article data-reveal style={`--i:${i % 2}`}><span class="n">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{p}</p></article>))}
            </div>
            <h3 data-reveal class="sv2-h3">Soluciones integrales</h3>
            <div class="sv2-packs">
              {areaPacks.map((c, i) => <div data-reveal style={`--i:${i % 2}`}><PackCard p={c} /></div>)}
            </div>
            <a data-reveal href="/paquetes" class="sv2-b2 sv2-all">Ver todos los paquetes <span aria-hidden="true">→</span></a>
          </section>

          <!-- Alcance -->
          <section id="alcance" data-tone="light" data-nsec class="sv2-sec">
            <h2 data-reveal class="sv2-h2 sv2-h2s">Claridad sobre lo que hacemos y lo que no</h2>
            <div data-reveal style="--i:1" class="sv2-txt">
              <p>Distinguimos entre los servicios que desarrolla directamente nuestro equipo, los que se ejecutan con herramientas de terceros, los que requieren colaboradores especializados y los que aún están en desarrollo.</p>
              <p>No prometemos resultados comerciales garantizados, cumplimiento fiscal automático ni seguridad absoluta. La asesoría contable y fiscal está a cargo de nuestro Director de Administración y Finanzas, que es contador, y de su área. En temas jurídicos y de seguridad especializada trabajamos con profesionales y proveedores competentes.</p>
            </div>
            <div data-reveal class="sv2-cta">
              <a href="mailto:info@humancorp.co?subject=Agendar%20llamada" data-agendar class="sv2-b1">Agendar una llamada</a>
              <a href="/" class="sv2-b2">Volver al inicio</a>
            </div>
          </section>
        </div>
      </div>

      <Contact />
    </main>
    <ScrollFx />

    <style is:global>
      .sv2-hero { position: relative; overflow: hidden; background: #fff; padding: 17svh 24px 8svh; }
      .sv2-band { position: absolute; right: -12%; top: -26%; width: 74%; height: 92%; transform: skewY(-12deg); background: linear-gradient(115deg, #0033ff 0%, #6a5dff 38%, #977dff 62%, #f0b56e 100%); opacity: 0.2; -webkit-mask-image: radial-gradient(ellipse 70% 75% at 68% 30%, #000 25%, transparent 72%); mask-image: radial-gradient(ellipse 70% 75% at 68% 30%, #000 25%, transparent 72%); pointer-events: none; }
      .sv2-in { position: relative; max-width: 1280px; margin: 0 auto; }
      .sv2-pill { display: inline-block; padding: 6px 14px; border-radius: 99px; font-size: 13px; font-weight: 500; color: #0033ff; background: rgba(0, 51, 255, 0.07); }
      .sv2-h1 { margin-top: 22px; max-width: 17ch; font-family: var(--font-goog, inherit); font-size: clamp(2.4rem, 6.2vw, 5.6rem); font-weight: 300; line-height: 1; letter-spacing: -0.05em; }
      .sv2-gr { background: linear-gradient(100deg, #0033ff, #977dff 70%); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .sv2-sub { margin-top: 26px; max-width: 34rem; font-size: clamp(1rem, 1.4vw, 1.2rem); line-height: 1.6; color: #5b6275; }
      .sv2-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 30px; }
      .sv2-b1 { display: inline-flex; align-items: center; height: 48px; padding: 0 24px; border-radius: 99px; background: #0a0d1f; color: #fff; font-size: 15px; font-weight: 500; transition: transform 0.25s; } .sv2-b1:hover { transform: translateY(-2px); }
      .sv2-b2 { display: inline-flex; align-items: center; gap: 8px; height: 48px; padding: 0 22px; border-radius: 99px; border: 1px solid #d9dcea; color: #0a0d1f; font-size: 15px; font-weight: 500; transition: background 0.25s; } .sv2-b2:hover { background: #f4f5fb; }
      .sv2-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 9svh; list-style: none; padding: 0; }
      .sv2-cards a { display: flex; flex-direction: column; justify-content: space-between; gap: 22px; height: 100%; padding: 16px; border-radius: 16px; background: #fff; border: 1px solid #e6e8f0; transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s; } .sv2-cards a:hover { transform: translateY(-3px); border-color: #b9c4ff; box-shadow: 0 18px 34px -22px rgba(0, 51, 255, 0.45); }
      .sv2-cards .n { font-size: 13px; font-weight: 600; color: #0033ff; } .sv2-cards .t { font-size: 15px; line-height: 1.3; letter-spacing: -0.01em; }
      @media (min-width: 768px) { .sv2-hero { padding: 18svh 40px 9svh; } .sv2-cards { grid-template-columns: repeat(4, 1fr); } }

      .sv2-wrap { max-width: 1360px; margin: 0 auto; padding: 0 24px; display: block; }
      .sv2-nav { position: sticky; top: 66px; z-index: 30; margin: 0 -24px; padding: 10px 24px; background: rgba(255, 255, 255, 0.92); border-bottom: 1px solid #e9ebf3; overflow-x: auto; scrollbar-width: none; display: flex; align-items: center; gap: 4px; }
      .sv2-nav::-webkit-scrollbar { display: none; } .sv2-nav ul { display: flex; gap: 4px; list-style: none; padding: 0; margin: 0; } .sv2-nl { display: none; }
      .sv2-nav a { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; padding: 8px 14px; border-radius: 99px; font-size: 13.5px; color: #5b6275; transition: background 0.2s, color 0.2s; } .sv2-nav a span { font-size: 11.5px; font-weight: 600; color: #9aa1b5; }
      .sv2-nav a.on { background: #0a0d1f; color: #fff; } .sv2-nav a.on span { color: #b9c4ff; }
      .sv2-main { min-width: 0; }
      @media (min-width: 1024px) {
        .sv2-wrap { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 56px; padding: 0 40px; }
        .sv2-nav { position: sticky; top: 110px; align-self: start; display: block; margin: 40px 0 0; padding: 0; background: none; border: 0; overflow: visible; z-index: 1; }
        .sv2-nav ul { display: block; } .sv2-nl { display: block; margin: 0 0 8px 14px; font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #9aa1b5; } .sv2-nl2 { margin-top: 26px; }
        .sv2-nav a { display: flex; padding: 7px 14px; border-radius: 10px; } .sv2-nav a:hover { background: #f4f5fb; color: #0a0d1f; } .sv2-nav a.on { background: #eef1ff; color: #0033ff; } .sv2-nav a.on span { color: #0033ff; }
      }

      .sv2-div { padding: 11svh 0 4svh; border-top: 1px solid #eceef5; scroll-margin-top: 110px; } .sv2-div:first-child { border-top: 0; }
      .sv2-dn { font-size: 13px; color: #7a8194; } .sv2-dn span { display: inline-block; margin-right: 8px; padding: 3px 10px; border-radius: 99px; font-weight: 600; color: #fff; background: linear-gradient(120deg, var(--a), var(--b)); }
      .sv2-dh h2 { margin-top: 16px; max-width: 20ch; font-family: var(--font-goog, inherit); font-size: clamp(1.9rem, 3.6vw, 3.1rem); font-weight: 400; line-height: 1.05; letter-spacing: -0.045em; }
      .sv2-lead { margin-top: 18px; max-width: 40rem; font-size: 16.5px; line-height: 1.6; color: #5b6275; }
      .sv2-grid { display: grid; gap: 28px; margin-top: 36px; }
      .sv2-pv { order: -1; }
      @media (min-width: 1100px) { .sv2-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 40px; align-items: start; } .sv2-pv { order: 0; position: sticky; top: 100px; } }
      .sv2-al { margin-bottom: 10px; font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #9aa1b5; }
      .sv2-a { border-bottom: 1px solid #eceef5; }
      .sv2-ah { display: flex; align-items: center; gap: 14px; width: 100%; padding: 16px 4px; text-align: left; cursor: pointer; }
      .sv2-ah .l { display: grid; place-items: center; flex: none; width: 26px; height: 26px; border-radius: 8px; font-size: 12px; font-weight: 600; background: #f1f3f9; color: #5b6275; transition: background 0.25s, color 0.25s; }
      .sv2-ah .t { flex: 1; font-size: 17px; line-height: 1.3; letter-spacing: -0.02em; color: #0a0d1f; }
      .sv2-ah .c { position: relative; width: 14px; height: 14px; flex: none; } .sv2-ah .c::before, .sv2-ah .c::after { content: ""; position: absolute; left: 0; right: 0; top: 6px; height: 1.6px; border-radius: 2px; background: #9aa1b5; transition: transform 0.3s; } .sv2-ah .c::after { transform: rotate(90deg); }
      .sv2-a.on .l { background: linear-gradient(120deg, var(--a), var(--b)); color: #fff; } .sv2-a.on .c::after { transform: rotate(0); }
      .sv2-li { display: none; columns: 1; gap: 28px; margin: 0 0 18px 44px; padding: 0; list-style: none; font-size: 14px; line-height: 1.45; color: #5b6275; }
      .sv2-a.on .sv2-li { display: block; } .sv2-li li { position: relative; padding: 4px 0 4px 14px; break-inside: avoid; } .sv2-li li::before { content: ""; position: absolute; left: 0; top: 11px; width: 5px; height: 5px; border-radius: 50%; background: linear-gradient(120deg, var(--a), var(--b)); }
      @media (min-width: 640px) { .sv2-li { columns: 2; } }
      .sv2-box { position: relative; overflow: hidden; border-radius: 24px; aspect-ratio: 16 / 10.4; box-shadow: 0 30px 60px -34px rgba(10, 13, 60, 0.55); }
      .sv2-p { position: absolute; inset: 0; display: none; } .sv2-p.on { display: block; animation: sv2In 0.5s cubic-bezier(0.2, 0.8, 0.2, 1); } @keyframes sv2In { from { opacity: 0; transform: translate3d(0, 10px, 0); } }
      .sv2-box [data-pn] { --q: 1; }
      .sv2-goal { margin-top: 16px; padding: 16px 18px; border-radius: 16px; background: #f6f7fb; font-size: 14.5px; line-height: 1.55; color: #3a4055; } .sv2-goal b { display: block; margin-bottom: 4px; font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #0033ff; }
      .sv2-note { margin-top: 18px; font-size: 12.5px; line-height: 1.55; color: #8a91a5; }

      .sv2-sec { padding: 11svh 0; border-top: 1px solid #eceef5; scroll-margin-top: 110px; } .sv2-alt { position: relative; } .sv2-alt::before { content: ""; position: absolute; inset: 0 -100vw; background: #f6f7fb; z-index: -1; }
      .sv2-eye { font-size: 14px; font-weight: 500; color: #0033ff; }
      .sv2-h2 { margin-top: 14px; max-width: 18ch; font-family: var(--font-goog, inherit); font-size: clamp(2rem, 4vw, 3.4rem); font-weight: 300; line-height: 1.04; letter-spacing: -0.05em; } .sv2-h2s { font-size: clamp(1.7rem, 3vw, 2.6rem); max-width: 22ch; }
      .sv2-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; } .sv2-bd { padding: 4px 12px; border-radius: 99px; font-size: 12px; font-weight: 500; color: #5b3fd1; background: rgba(151, 125, 255, 0.16); border: 1px solid rgba(151, 125, 255, 0.45); }
      .sv2-sm { margin-top: 30px; max-width: 42rem; font-size: 14.5px; line-height: 1.6; color: #7a8194; }
      .sv2-chain { display: grid; gap: 10px; margin: 40px 0 0; padding: 0; list-style: none; }
      .sv2-chain li { position: relative; display: flex; align-items: center; gap: 14px; padding: 16px 18px; border-radius: 16px; background: #fff; border: 1px solid #e6e8f0; }
      .sv2-chain .n { font-size: 13px; font-weight: 600; color: #0033ff; } .sv2-chain .t { font-size: 16px; letter-spacing: -0.01em; }
      @media (min-width: 900px) { .sv2-chain { grid-template-columns: repeat(7, 1fr); gap: 0; } .sv2-chain li { flex-direction: column; align-items: flex-start; justify-content: space-between; gap: 26px; border-radius: 0; border-right-width: 0; min-height: 124px; } .sv2-chain li:first-child { border-radius: 16px 0 0 16px; } .sv2-chain li:last-child { border-radius: 0 16px 16px 0; border-right-width: 1px; } .sv2-chain .t { font-size: 14.5px; line-height: 1.3; } }
      .sv2-os, .sv2-ways { display: grid; gap: 14px; margin-top: 40px; } @media (min-width: 700px) { .sv2-os { grid-template-columns: repeat(2, 1fr); } .sv2-ways { grid-template-columns: repeat(2, 1fr); } } @media (min-width: 1280px) { .sv2-os { grid-template-columns: repeat(3, 1fr); } }
      .sv2-os article, .sv2-ways article { padding: 26px; border-radius: 20px; background: #fff; border: 1px solid #e6e8f0; transition: transform 0.25s, box-shadow 0.25s; } .sv2-os article:hover, .sv2-ways article:hover { transform: translateY(-3px); box-shadow: 0 22px 40px -28px rgba(10, 13, 60, 0.4); }
      .sv2-os .n, .sv2-ways .n { font-size: 13px; font-weight: 600; color: #0033ff; } .sv2-os h3, .sv2-ways h3 { margin-top: 22px; font-family: var(--font-goog, inherit); font-size: 1.3rem; font-weight: 400; letter-spacing: -0.03em; } .sv2-os p, .sv2-ways p { margin-top: 10px; font-size: 14.5px; line-height: 1.6; color: #5b6275; }
      .sv2-h3 { margin-top: 9svh; font-family: var(--font-goog, inherit); font-size: clamp(1.5rem, 2.6vw, 2.2rem); font-weight: 300; letter-spacing: -0.04em; }
      .sv2-packs { display: grid; gap: 20px; margin-top: 26px; } @media (min-width: 900px) { .sv2-packs { grid-template-columns: repeat(2, 1fr); } } .sv2-all { margin-top: 30px; }
      .sv2-txt { display: grid; gap: 16px; margin-top: 26px; max-width: 44rem; font-size: 15.5px; line-height: 1.65; color: #5b6275; }
      @media (prefers-reduced-motion: reduce) { .sv2-p.on { animation: none; } }
    </style>

    <script>
      import { countsOf, paintCounts } from '../scripts/frame';

      // Vista previa de cada división: la escena se escala al ancho del cuadro y se muestra ya armada.
      const boxes = [...document.querySelectorAll<HTMLElement>('[data-pbox]')];
      boxes.forEach((b) => b.querySelectorAll<HTMLElement>('[data-pn]').forEach((pn) => paintCounts(countsOf(pn), 1)));
      const fit = () => boxes.forEach((b) => {
        const w = b.clientWidth, h = b.clientHeight;
        if (!w) return;
        const k = Math.min(w / 640, h / 400) * 0.92;
        b.querySelectorAll<HTMLElement>('.stage-panel').forEach((p) => { p.style.transform = `translate(-50%,-50%) scale(${k.toFixed(4)})`; });
      });
      new ResizeObserver(fit).observe(document.body);
      fit();

      // Áreas: se abre una a la vez y la vista previa cambia con ella.
      document.querySelectorAll<HTMLElement>('[data-div]').forEach((d) => {
        const areas = [...d.querySelectorAll<HTMLElement>('.sv2-a')];
        const panels = [...d.querySelectorAll<HTMLElement>('.sv2-p')];
        areas.forEach((a, i) => a.querySelector('.sv2-ah')!.addEventListener('click', () => {
          areas.forEach((x, k) => { x.classList.toggle('on', k === i); x.querySelector('.sv2-ah')!.setAttribute('aria-expanded', String(k === i)); });
          panels.forEach((p, k) => p.classList.toggle('on', k === i));
          fit();
        }));
      });

      // Índice: resalta la sección que está en el centro de la pantalla.
      const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-to]')];
      const bar = document.querySelector<HTMLElement>('[data-nav2]')!;
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((a) => { const on = a.dataset.to === e.target.id; a.classList.toggle('on', on); if (on && bar.scrollWidth > bar.clientWidth && getComputedStyle(bar).display === 'flex') bar.scrollTo({ left: a.offsetLeft - 24, behavior: 'smooth' }); });
      }), { rootMargin: '-35% 0px -60% 0px' });
      document.querySelectorAll('[data-nsec]').forEach((s) => io.observe(s));
    </script>
  </body>
</html>
