---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Panel from '../components/Panels.astro';
import ScrollFx from '../components/ScrollFx.astro';
import { divisions, chain, osModules, ways, packages } from '../data/servicios';

const panelOf = [0, 1, 6, 5, 4, 2, 3, 7];
const panelLabel = ['Branding', 'Sitio web', 'Marketing', 'Ventas', 'Asistentes', 'Finanzas', 'Operaciones', 'Datos'];
const split = (s: string) => s.split('|');
const palette = [['#0033ff', '#977dff'], ['#977dff', '#0600ab'], ['#0600ab', '#0033ff'], ['#977dff', '#0033ff']];
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Ocho divisiones de servicios de HumanCorp: diseño, desarrollo digital, marketing, ventas y CRM, inteligencia artificial, finanzas, operaciones y datos." />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>Servicios — HumanCorp</title>
  </head>
  <body class="bg-[#00033D] font-sans text-white">
    <div class="sv-bg" data-sv-bg aria-hidden="true"></div>
    <Header />
    <main class="relative z-10 overflow-x-clip">
      <!-- Apertura -->
      <section data-tone="dark" class="relative flex min-h-svh flex-col justify-end px-6 pb-[9svh] pt-[22svh] md:px-10">
        <div class="mx-auto w-full max-w-[1280px]">
          <p data-reveal class="text-[14px] text-white/60">Servicios</p>
          <h1 data-words class="mt-5 max-w-[16ch] font-goog text-[clamp(2.6rem,7.6vw,7.4rem)] font-light leading-[1] tracking-[-0.05em]">Todo lo que hace funcionar a una empresa, conectado bajo un solo estándar.</h1>
          <p data-reveal style="--i:1" class="mt-7 max-w-[34rem] text-[clamp(1rem,1.4vw,1.2rem)] leading-relaxed text-white/65">Diseñamos, desarrollamos, conectamos y optimizamos soluciones para empresas, en ocho divisiones que trabajan juntas.</p>
          <ol class="mt-[9svh] grid grid-cols-2 gap-3 md:grid-cols-4">
            {divisions.map((d, i) => (
              <li data-reveal style={`--i:${i % 4}`}>
                <a href={`#div-${d.n}`} class="gl group flex h-full flex-col justify-between gap-6 p-4 transition-[transform,border-color] duration-300 hover:-translate-y-1 hover:border-white/35 md:p-5">
                  <span class="sv-num text-[15px] font-medium">{d.n}</span>
                  <span class="text-[clamp(.95rem,1.25vw,1.1rem)] leading-snug tracking-[-0.01em] text-white/90">{d.short}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- Divisiones: hojas apiladas -->
      <section id="divisiones" data-tone="dark" class="relative px-3 pb-[10svh] pt-[6svh] md:px-10">
        <div class="mx-auto max-w-[1180px]" data-sheets>
          {divisions.map((d, di) => (
            <>
              <i data-m class="block h-0" id={`div-${d.n}`} style="scroll-margin-top:0" aria-hidden="true"></i>
              <article data-sheet data-a={palette[di % 4][0]} data-b={palette[di % 4][1]} class="sheet mb-5 overflow-hidden rounded-[24px] text-[#0b0c0f] md:sticky md:top-[100px] md:mb-[16svh] md:h-[calc(100svh-116px)] md:min-h-[600px] md:rounded-[28px]">
                <header class="flex items-center justify-between border-b border-black/[.07] px-5 py-3.5 text-[11px] text-black/70 md:px-8">
                  <span>HumanCorp · Servicios</span>
                  <i class="grid size-7 place-items-center rounded-full bg-[#0b0c0f] text-[11px] font-semibold text-white">H</i>
                  <span class="hidden sm:inline">humancorp.co</span><span class="sm:hidden">{d.n} / 08</span>
                </header>
                <div class="grid md:h-[calc(100%-57px)] md:grid-cols-[0.8fr_1.2fr] md:grid-rows-[auto_minmax(0,1fr)_auto]">
                  <div class="px-6 pb-2 pt-7 md:col-start-1 md:row-start-1 md:px-9 md:pt-9">
                    <p class="text-[10.5px] font-medium uppercase tracking-[0.14em] text-black/45">División {d.n} de 08</p>
                    <h2 class="mt-3 font-goog text-[clamp(1.9rem,2.9vw,2.8rem)] font-normal leading-[1.03] tracking-[-0.045em]">{d.title}</h2>
                    <p class="mt-4 text-[14px] leading-relaxed text-black/60">{d.intro}</p>
                  </div>

                  <div class="relative m-3 h-[560px] overflow-hidden rounded-[22px] text-white md:col-start-2 md:row-span-3 md:row-start-1 md:m-3 md:h-auto" style={`--sa:${palette[di % 4][0]};--sb:${palette[di % 4][1]}`}>
                    <i class="stage-bg absolute inset-0" aria-hidden="true"></i>
                    <i class="stage-orb absolute -left-10 top-[10%] size-[60%] rounded-full" aria-hidden="true"></i>
                    <i class="stage-orb stage-orb2 absolute -right-10 bottom-[18%] size-[55%] rounded-full" aria-hidden="true"></i>
                    <i class="grain pointer-events-none absolute inset-0 opacity-[.12]" aria-hidden="true"></i>
                    <div data-pbox class="absolute inset-x-3 top-3 bottom-[250px] md:bottom-[178px]">
                      <div class="stage-panel absolute left-1/2 top-1/2 h-[400px] w-[640px]"><Panel i={panelOf[di]} label={panelLabel[di]} /></div>
                    </div>
                    <div class="absolute inset-x-0 bottom-0 h-[250px] px-5 pb-5 pt-10 md:h-[178px] md:px-7" style="background:linear-gradient(to top,rgba(6,8,34,.92) 55%,rgba(6,8,34,0))">
                      <p data-words-title class="flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.12em] text-white/60"><i class="block size-1.5 rounded-full bg-[#977DFF]"></i><span>{d.areas[0][0]}</span></p>
                      <p data-words class="words mt-2.5 font-goog text-[clamp(.9rem,1.15vw,1.05rem)] font-normal leading-[1.5] tracking-[-0.01em] text-white">{split(d.areas[0][1]).map((w) => <span>{w}</span>)}</p>
                    </div>
                  </div>

                  <div class="min-h-0 px-3 pb-2 md:col-start-1 md:row-start-2 md:overflow-y-auto md:px-6" data-areas>
                    <p class="px-3 pb-2 pt-3 text-[10.5px] font-medium uppercase tracking-[0.14em] text-black/45">Áreas · toca para ver los servicios</p>
                    {d.areas.map(([t, items], ai) => (
                      <button type="button" data-area={ai} data-items={items} aria-pressed={ai === 0} class={`area group relative flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left transition-colors hover:bg-black/[.04] ${ai === 0 ? 'is-on' : ''}`}>
                        <span class="area-l grid size-[22px] shrink-0 place-items-center rounded-md text-[10.5px] font-medium">{String.fromCharCode(65 + ai)}</span>
                        <span class="area-t font-goog text-[14.5px] leading-snug tracking-[-0.015em]">{t}</span>
                        <i class="area-bar absolute inset-x-3 bottom-0 block h-px origin-left" aria-hidden="true"></i>
                      </button>
                    ))}
                  </div>

                  <div class="px-6 pb-6 pt-2 md:col-start-1 md:row-start-3 md:px-9 md:pb-8">
                    <p class="border-t border-black/[.07] pt-4 text-[12.5px] leading-relaxed text-black/70"><span class="mb-1 block text-[10px] font-medium uppercase tracking-[0.14em] text-[#4b32c9]">Objetivo</span>{d.goal}</p>
                    {d.note && <p class="mt-3 text-[11px] leading-relaxed text-black/45">{d.note}</p>}
                  </div>
                </div>
              </article>
            </>
          ))}
        </div>
      </section>

      <!-- Todo conectado -->
      <section data-tone="dark" data-div data-a="#977dff" data-b="#0033ff" class="relative px-6 py-[14svh] md:px-10">
        <div class="mx-auto max-w-[1280px]">
          <p data-reveal class="text-[14px] text-white/55">Integración</p>
          <h2 data-words class="mt-4 max-w-[18ch] font-goog text-[clamp(2.2rem,5vw,4.8rem)] font-light leading-[1.03] tracking-[-0.05em]">Soluciones que se conectan entre sí</h2>
          <p data-reveal class="mt-6 max-w-[38rem] text-[16px] leading-relaxed text-white/65">No vendemos servicios aislados. Entendemos cómo se relacionan las áreas de tu empresa y desarrollamos soluciones que generan continuidad entre ellas.</p>
          <ol class="mt-[8svh] flex flex-col lg:flex-row lg:items-stretch">
            {chain.map((c, i) => (
              <>
                <li data-reveal style={`--i:${i % 3}`} class="gl flex items-center gap-3 px-5 py-4 lg:flex-col lg:items-start lg:justify-between lg:gap-8 lg:py-5">
                  <span class="sv-num text-[14px] font-medium">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-[16px] leading-snug tracking-[-0.01em] lg:max-w-[9ch]">{c}</span>
                </li>
                {i < chain.length - 1 && <i class="chain-ln" style={`--i:${i}`} aria-hidden="true"></i>}
              </>
            ))}
          </ol>
          <p data-reveal class="mt-8 max-w-[40rem] text-[14px] leading-relaxed text-white/50">Una campaña alimenta una landing page; la landing page alimenta un CRM; el CRM activa un agente de seguimiento; una venta inicia un proceso administrativo que actualiza la información financiera; y los datos comerciales y financieros alimentan un dashboard ejecutivo.</p>
        </div>
      </section>

      <!-- Business OS -->
      <section data-tone="dark" data-div data-a="#0600ab" data-b="#977dff" class="relative px-6 py-[12svh] md:px-10">
        <div class="mx-auto max-w-[1280px]">
          <div class="flex flex-wrap items-center gap-3">
            <p data-reveal class="text-[14px] text-white/55">Visión</p>
            <span data-reveal style="--i:1" class="rounded-full border border-[#977DFF]/60 bg-[#977DFF]/15 px-3 py-1 text-[12px] font-medium text-[#d8cfff]">En desarrollo</span>
          </div>
          <h2 data-words class="mt-4 max-w-[16ch] font-goog text-[clamp(2.2rem,5vw,4.8rem)] font-light leading-[1.03] tracking-[-0.05em]">HumanCorp Business OS</h2>
          <p data-reveal class="mt-6 max-w-[40rem] text-[16px] leading-relaxed text-white/65">Una capa propia para consultar, conectar y coordinar las herramientas y procesos de tu empresa, sin reemplazar necesariamente los sistemas que ya usas. Es una línea que estamos construyendo de forma progresiva y todavía no forma parte de nuestra oferta operativa.</p>
          <div class="mt-[7svh] grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {osModules.map(([t, p], i) => (
              <article data-reveal style={`--i:${i % 3}`} class="gl p-6">
                <span class="sv-num text-[14px] font-medium">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="mt-6 font-goog text-[1.25rem] font-normal tracking-[-0.02em]">{t}</h3>
                <p class="mt-3 text-[14.5px] leading-relaxed text-white/60">{p}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Cómo contratar -->
      <section data-tone="dark" data-div data-a="#0033ff" data-b="#977dff" class="relative px-6 py-[12svh] md:px-10">
        <div class="mx-auto max-w-[1280px]">
          <p data-reveal class="text-[14px] text-white/55">Formas de trabajar</p>
          <h2 data-words class="mt-4 max-w-[16ch] font-goog text-[clamp(2.2rem,5vw,4.8rem)] font-light leading-[1.03] tracking-[-0.05em]">Empieza por lo que necesitas</h2>
          <div class="mt-[7svh] grid gap-4 md:grid-cols-2">
            {ways.map(([t, p], i) => (
              <article data-reveal style={`--i:${i % 2}`} class="gl p-6 md:p-8">
                <h3 class="font-goog text-[1.4rem] font-normal tracking-[-0.025em]">{t}</h3>
                <p class="mt-3 max-w-[30rem] text-[15px] leading-relaxed text-white/65">{p}</p>
              </article>
            ))}
          </div>
          <h3 data-reveal class="mt-[9svh] font-goog text-[clamp(1.5rem,2.6vw,2.2rem)] font-light tracking-[-0.035em]">Soluciones integrales</h3>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {packages.map(([t, items], i) => (
              <article data-reveal style={`--i:${i % 4}`} class="gl p-5">
                <h4 class="font-goog text-[1.1rem] font-normal tracking-[-0.02em]">{t}</h4>
                <ul class="mt-4 space-y-1.5 text-[13.5px] text-white/60">
                  {split(items).map((s) => <li class="flex gap-2"><i class="mt-[0.55em] block size-1 shrink-0 rounded-full bg-[#977DFF]"></i>{s}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Alcance -->
      <section data-tone="dark" class="relative px-6 py-[10svh] md:px-10">
        <div class="mx-auto grid max-w-[1280px] gap-8 md:grid-cols-12">
          <h2 data-words class="font-goog text-[clamp(1.8rem,3.2vw,3rem)] font-light leading-[1.06] tracking-[-0.04em] md:col-span-5">Claridad sobre lo que hacemos y lo que no</h2>
          <div data-reveal class="space-y-4 text-[15px] leading-relaxed text-white/65 md:col-span-7">
            <p>Distinguimos entre los servicios que desarrolla directamente nuestro equipo, los que se ejecutan con herramientas de terceros, los que requieren colaboradores especializados y los que aún están en desarrollo.</p>
            <p>No prometemos resultados comerciales garantizados, cumplimiento fiscal automático ni seguridad absoluta. En materia fiscal, contable, jurídica y de seguridad especializada trabajamos con profesionales y proveedores competentes.</p>
          </div>
        </div>
        <div data-reveal class="mx-auto mt-[9svh] flex max-w-[1280px] flex-wrap items-center gap-4">
          <a href="mailto:info@humancorp.co?subject=Agendar%20llamada" class="rounded-full bg-white px-8 py-4 text-[16px] font-medium text-[#0b0c0f] transition-transform hover:scale-[1.04] active:scale-[0.98]">Agendar una llamada</a>
          <a href="/" class="rounded-full border border-white/25 px-8 py-4 text-[16px] transition-colors hover:bg-white/10">Volver al inicio</a>
        </div>
      </section>

      <Contact />
    </main>
    <ScrollFx />

    <script>
      import { onFrame, measure, put, clamp, countsOf, paintCounts } from '../scripts/frame';
      const bg = document.querySelector<HTMLElement>('[data-sv-bg]')!;
      const tint = (el: HTMLElement) => {
        bg.style.setProperty('--sv-a', el.dataset.a!);
        bg.style.setProperty('--sv-b', el.dataset.b!);
      };
      // Secciones sueltas: el fondo toma su matiz al pasar por el centro.
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => e.isIntersecting && tint(e.target as HTMLElement)),
        { rootMargin: '-45% 0px -45% 0px' },
      );
      document.querySelectorAll<HTMLElement>('[data-div]').forEach((s) => io.observe(s));

      // Hojas apiladas: la que sube cubre a las anteriores, que quedan asomando detrás.
      const sheets = [...document.querySelectorAll<HTMLElement>('[data-sheet]')];
      const marks = [...document.querySelectorAll<HTMLElement>('[data-m]')].map((m) => measure(m));
      const wide = matchMedia('(min-width: 768px)');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      const STICK = 100;
      let active = -1;

      // Cada panel se escala para llenar su escenario.
      const pans = sheets.map((s) => ({
        box: s.querySelector<HTMLElement>('[data-pbox]')!,
        pn: s.querySelector<HTMLElement>('[data-pn]')!,
        wrap: s.querySelector<HTMLElement>('.stage-panel')!,
      }));
      const fit = () => pans.forEach(({ box, wrap }) => {
        const k = Math.min(box.clientWidth / 640, box.clientHeight / 400) * 0.97;
        wrap.style.transform = `translate(-50%,-50%) scale(${k.toFixed(4)})`;
      });
      new ResizeObserver(fit).observe(document.body);
      fit();

      // La construcción de cada panel corre en el tiempo y se reinicia cada vez que la hoja entra.
      const dur = sheets.map((s) => (s.querySelector('[data-pn="1"]') ? 12000 : 6500));
      const counts = pans.map(({ pn }) => countsOf(pn));
      const t0: (number | null)[] = sheets.map(() => null);
      const lastQ: number[] = sheets.map(() => -1);

      onFrame((t, y, vh) => {
        const n = sheets.length;
        let depth = 0;
        let cur = 0;
        for (let k = n - 1; k >= 0; k--) {
          const top = marks[k].top - y;
          const r = clamp(1 - (top - STICK) / Math.max(1, vh - STICK));
          if (r > 0.5 && k > cur) cur = k;
          if (wide.matches && !reduced.matches) {
            const s = sheets[k];
            put(s, 'transform', `translate3d(0,${(-22 * depth).toFixed(1)}px,0) scale(${(1 - 0.04 * depth).toFixed(4)})`);
            put(s, '--dim', clamp(depth).toFixed(3));
            put(s, 'opacity', (1 - clamp((depth - 2) / 0.8)).toFixed(3));
          }
          // panel: empieza al asomar la hoja, se reinicia si vuelves arriba
          const inView = top < vh * 0.8;
          if (inView && t0[k] === null) t0[k] = t;
          if (top > vh * 0.95) t0[k] = null;
          const q = reduced.matches ? 1 : t0[k] === null ? 0 : clamp((t - t0[k]!) / dur[k]);
          if (q !== lastQ[k]) { lastQ[k] = q; pans[k].pn.style.setProperty('--q', q.toFixed(4)); paintCounts(counts[k], q); }
          depth += r;
        }
        if (cur !== active && y > marks[0].top - vh * 0.6) { active = cur; tint(sheets[cur]); }
      });

      // Áreas: al elegir una, sus servicios aparecen como palabras grandes en el escenario. Cambian solas.
      sheets.forEach((sheet) => {
        const btns = [...sheet.querySelectorAll<HTMLButtonElement>('[data-area]')];
        const title = sheet.querySelector<HTMLElement>('[data-words-title] span')!;
        const words = sheet.querySelector<HTMLElement>('[data-words]')!;
        let idx = 0;
        let timer: number | undefined;
        const show = (i: number, user = false) => {
          idx = i;
          btns.forEach((b, k) => { b.classList.toggle('is-on', k === i); b.setAttribute('aria-pressed', String(k === i)); });
          title.textContent = btns[i].querySelector('.area-t')!.textContent;
          words.classList.remove('swap'); void words.offsetWidth;
          words.replaceChildren(...btns[i].dataset.items!.split('|').map((w) => Object.assign(document.createElement('span'), { textContent: w })));
          words.classList.add('swap');
          if (!user) schedule();
        };
        const schedule = () => {
          clearTimeout(timer);
          if (reduced.matches) return;
          btns.forEach((b) => b.style.removeProperty('--run'));
          btns[idx].style.setProperty('--run', 'running');
          timer = window.setTimeout(() => show((idx + 1) % btns.length), 4800);
        };
        btns.forEach((b, k) => b.addEventListener('click', () => { show(k, true); clearTimeout(timer); btns.forEach((x) => x.style.removeProperty('--run')); }));
        sheet.addEventListener('mouseenter', () => { clearTimeout(timer); });
        sheet.addEventListener('mouseleave', schedule);
        schedule();
      });
    </script>
  </body>
</html>
