---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import ProcessStory from '../components/ProcessStory.astro';
import ComoTrabajamos from '../components/ComoTrabajamos.astro';
import Faq from '../components/Faq.astro';
import Audience from '../components/Audience.astro';
import Contact from '../components/Contact.astro';
import ScrollFx from '../components/ScrollFx.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Diseño, tecnología y operaciones empresariales." />
    <script is:inline>document.documentElement.classList.add('js');try{if(!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('intro')}catch(e){}</script>
    <link rel="preload" as="image" href="/horizon.webp" type="image/webp" />
    <title>HumanCorp — Diseño, tecnología y operaciones empresariales</title>
  </head>
  <body class="bg-[#08090c] font-sans text-white">
    <div class="hc-intro" aria-hidden="true"><div class="hci-in"><b class="hci-w"><span class="hci-l">HUMAN</span><span class="hci-s">CORP</span></b></div></div>
    <Header />
    <main class="overflow-x-clip">
      <Hero />
      <ProcessStory />
      <ComoTrabajamos />
      <div id="cierre" class="relative z-10 -mt-[45svh]" style="background:linear-gradient(to bottom,rgba(0,3,61,0),#00033D 45svh)">
        <div class="pointer-events-none absolute inset-x-0 top-[45svh] bottom-0 overflow-hidden [mask-image:linear-gradient(to_bottom,transparent,#000_32svh)]" aria-hidden="true"><i class="nb nb1 absolute" style="top:-20vmax"></i><i class="nb nb2 absolute" style="bottom:-24vmax"></i></div>
        <div class="pt-[45svh]"><Audience /><Faq /></div>
      </div>
      <Contact />
    </main>
    <ScrollFx />
    <script is:inline>(function(){var d=document.documentElement;if(!d.classList.contains('intro'))return;var el=document.querySelector('.hc-intro');setTimeout(function(){el.classList.add('out')},1400);setTimeout(function(){d.classList.remove('intro');el.remove()},2150)})()</script>
  </body>
</html>
