---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import ProcessStory from '../components/ProcessStory.astro';
import ServicesDirectory from '../components/ServicesDirectory.astro';
import ScrollFx from '../components/ScrollFx.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Diseño, tecnología y operaciones empresariales." />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>HumanCorp — Diseño, tecnología y operaciones empresariales</title>
  </head>
  <body class="bg-paper font-sans text-ink">
    <Header />
    <main>
      <Hero />
      <Intro />
      <ProcessStory />
      <ServicesDirectory />
    </main>
    <ScrollFx />
  </body>
</html>
