---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import ProcessStory from '../components/ProcessStory.astro';
import Horizon from '../components/Horizon.astro';
import AreaSections from '../components/AreaSections.astro';
import Closing from '../components/Closing.astro';
import ScrollFx from '../components/ScrollFx.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Diseño, tecnología y operaciones empresariales." />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>HumanCorp — Diseño, tecnología y operaciones empresariales</title>
  </head>
  <body class="bg-[#08090c] font-sans text-white">
    <Header />
    <main>
      <Hero />
      <Horizon />
      <AreaSections />
      <ProcessStory />
      <Closing />
    </main>
    <ScrollFx />
  </body>
</html>
