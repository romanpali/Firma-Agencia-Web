      };
      // ---------- Aurora (WebGL): fondo animado con los colores del usuario ----------
      const hex3 = (h) => { const n = parseInt(h.slice(1), 16); return [(n >> 16) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255]; };
      const AU = { gl: null, u: {}, cols: [[0.6, 0.4, 0.9], [0.1, 0.2, 1]], on: false, mx: 0.5, my: 0.5 };
      const auroraInit = () => {
        const cv = $('[data-aurora]');
