---
import '../styles/global.css';

const types: [string, string, string][] = [
  ['pequena', 'Pequeña empresa', 'Presencia profesional para atraer clientes.'],
  ['crecimiento', 'Empresa en crecimiento', 'Orden y sistemas para escalar.'],
  ['consolidada', 'Empresa consolidada', 'Áreas, datos y procesos bajo un estándar.'],
  ['comercio', 'Comercio o establecimiento', 'Catálogo, pedidos y sucursales.'],
  ['profesional', 'Servicios profesionales', 'Confianza, cotizaciones y clientes.'],
  ['ecommerce', 'Comercio electrónico', 'Tienda, pagos y envíos.'],
];
const palettes: [string, string, string, string][] = [
  ['atardecer', 'Atardecer', '#F6B370', '#2F3A9E'], ['oceano', 'Océano', '#0033FF', '#977DFF'],
  ['bosque', 'Bosque', '#10b981', '#064e5a'], ['grafito', 'Grafito', '#14173f', '#8f8aa6'],
];
const styles: [string, string, string][] = [
  ['minimal', 'Minimalista', 'Aire, líneas finas y tipografía ligera.'], ['calido', 'Cálido', 'Formas suaves y cercanas.'], ['audaz', 'Audaz', 'Contraste fuerte y títulos contundentes.'],
];
const covers: [string, string, string][] = [
  ['foto', 'Fotografía', 'Un paisaje de portada, teñido con tus colores.'], ['gradiente', 'Degradado', 'Un fondo limpio con tus colores.'],
];
const row = 'cfg-row block w-full rounded-[18px] bg-[#f5f5f7] px-5 py-4 text-left transition-[background-color,box-shadow] duration-200 hover:bg-[#ededf0] aria-pressed:bg-white aria-pressed:shadow-[0_0_0_2px_#0033FF,0_12px_30px_-18px_rgba(0,51,255,.55)]';
const h = 'mt-9 font-goog text-[1.3rem] font-semibold tracking-[-0.02em]';
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Personaliza un sitio web para tu negocio con HumanCorp: elige tu nombre, tus colores y tu estilo, y míralo generarse." />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>Personaliza tu sitio — HumanCorp</title>
  </head>
  <body class="overflow-hidden bg-[#f5f5f7] font-sans text-[#14161a]">
    <div class="grid h-svh grid-rows-[44svh_minmax(0,1fr)] lg:grid-cols-[minmax(0,1fr)_460px] lg:grid-rows-1">
      <!-- Escenario: vacío hasta generar -->
      <section data-stage class="relative overflow-hidden bg-[radial-gradient(90%_75%_at_50%_35%,#fbfbfb,#ececee)]" aria-label="Vista previa de tu sitio">
        <a href="/" aria-label="Volver al inicio" class="absolute left-4 top-4 z-30 grid size-11 place-items-center rounded-full bg-white/75 text-[#14161a] shadow-[0_8px_24px_-12px_rgba(0,0,0,.4)] backdrop-blur-md transition-transform hover:scale-105 lg:left-7 lg:top-7"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></a>

        <!-- Generando -->
        <div data-gen class="pointer-events-none absolute inset-0 z-10 grid place-items-center opacity-0 transition-opacity duration-500" style="--a:#F6B370;--b:#2F3A9E">
          <div class="gen-card relative aspect-[16/11] w-[min(72%,680px)] overflow-hidden rounded-[36px] bg-white shadow-[0_40px_90px_-40px_rgba(0,0,0,.45)]">
            <i class="gen-blob gen-b1 absolute"></i><i class="gen-blob gen-b2 absolute"></i><i class="gen-blob gen-b3 absolute"></i>
            <i class="gen-shine absolute inset-0"></i><i class="grain absolute inset-0 opacity-[.18]"></i>
            <div class="absolute inset-x-0 bottom-0 p-6 text-center">
              <p data-gen-text class="font-goog text-[1.05rem] tracking-[-0.01em] text-[#14161a]/80">Entendiendo tu negocio…</p>
              <i class="relative mx-auto mt-4 block h-[3px] w-[60%] overflow-hidden rounded-full bg-black/10"><b data-gen-bar class="absolute inset-y-0 left-0 block w-full origin-left rounded-full bg-[#14161a]" style="transform:scaleX(0)"></b></i>
            </div>
          </div>
        </div>

        <!-- Sitio generado (Alba, personalizado) -->
        <div data-site class="cfg gen-hidden @container absolute inset-0 overflow-y-auto overflow-x-hidden bg-white [scrollbar-width:thin]" style="--a:#F6B370;--b:#2F3A9E;--ink:#14173f;--bg:#fdf6ee;--on:#14173f;--rad:6px;--hw:300">
          <!-- Portada -->
          <section class="relative h-full min-h-[440px] overflow-hidden text-white">
            <div data-cover-photo class="absolute inset-0 bg-cover bg-center" style="background-image:url(/horizon.webp)"></div>
            <div data-cover-grad class="absolute inset-0" hidden style="background:radial-gradient(60% 70% at 80% 20%,color-mix(in srgb,var(--b) 80%,#fff),transparent 70%),linear-gradient(135deg,var(--a),var(--b) 80%)"></div>
            <i class="absolute inset-0 opacity-[.5] mix-blend-soft-light" style="background:linear-gradient(120deg,var(--a),var(--b))"></i>
            <i data-tint class="absolute inset-0 opacity-[.55] mix-blend-color" style="background:linear-gradient(160deg,var(--b),var(--a))"></i>
            <i class="absolute inset-0" style="background:linear-gradient(to top,rgba(0,0,0,.6),rgba(0,0,0,.04) 55%,rgba(0,0,0,.28))"></i>
            <i class="grain pointer-events-none absolute inset-0 opacity-[.1]"></i>

            <nav class="rise absolute inset-x-0 top-0 flex items-center justify-between pl-[72px] pr-[clamp(16px,3cqw,40px)] pt-[22px] @4xl:pl-[clamp(80px,9cqw,120px)]" style="--d:.1s">
              <span data-name class="text-[clamp(14px,1.5cqw,18px)] uppercase tracking-[0.34em]" style="font-weight:var(--hw)">Tu empresa</span>
              <div class="hidden items-center gap-1 rounded-full border border-white/30 bg-white/15 px-2 py-1.5 backdrop-blur-md @3xl:flex" data-nav></div>
              <div class="flex items-center gap-2"><span class="hidden rounded-full border border-white/35 bg-white/10 px-4 py-2 text-[12px] backdrop-blur-md @xl:inline">Cuenta</span><span class="rounded-full bg-white px-4 py-2 text-[12px] font-medium text-[#14161a]">Contacto</span></div>
            </nav>

            <div class="rise absolute right-[12cqw] top-[24%] hidden h-[clamp(160px,26cqw,360px)] w-[clamp(90px,12cqw,170px)] overflow-hidden border border-white/45 bg-white/15 backdrop-blur-md @3xl:block" style="--d:.5s;border-radius:calc(var(--rad) + 12px);transform:rotate(-3deg)"><span data-name2 class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 -rotate-90 whitespace-nowrap text-[clamp(11px,1.3cqw,16px)] uppercase tracking-[0.4em] text-white/85">Tu empresa</span></div>

            <div class="absolute inset-x-0 bottom-0 px-[clamp(20px,5cqw,72px)] pb-[clamp(28px,5cqw,64px)]">
              <p class="rise flex items-center gap-2 text-[12px] text-white/85" style="--d:.25s"><i class="block size-2 bg-white" style="border-radius:2px"></i><span data-eyebrow>Presencia profesional</span></p>
              <h1 data-h class="rise mt-3 max-w-[14ch] text-[clamp(2rem,7.4cqw,6rem)] leading-[1.02] tracking-[-0.045em]" style="--d:.35s;font-weight:var(--hw)">Lo que haces bien, a la vista de todos.</h1>
              <div class="rise mt-6 flex flex-wrap items-center gap-3" style="--d:.55s"><span data-cta class="px-6 py-3.5 text-[14px] font-medium" style="border-radius:calc(var(--rad) + 20px);background:var(--a);color:var(--on)">Contáctanos</span><span data-cta3 class="border border-white/45 bg-white/10 px-6 py-3.5 text-[14px] backdrop-blur-md" style="border-radius:calc(var(--rad) + 20px)">Ver servicios</span></div>
              <p data-sub class="rise absolute bottom-[clamp(28px,5cqw,64px)] right-[clamp(20px,5cqw,72px)] hidden max-w-[16rem] text-[13px] leading-snug text-white/80 @3xl:block" style="--d:.7s">Presencia profesional para atraer clientes.</p>
            </div>
          </section>

          <!-- Servicios -->
          <section class="bg-[var(--bg)] px-[clamp(20px,5cqw,72px)] py-[clamp(48px,8cqw,110px)] text-[var(--ink)]">
            <p class="text-[12px] uppercase tracking-[0.2em] opacity-55">Lo que hacemos</p>
            <h2 data-h2 class="mt-3 max-w-[18ch] text-[clamp(1.6rem,4.2cqw,3.4rem)] leading-[1.05] tracking-[-0.04em]" style="font-weight:var(--hw)">Hecho con cuidado, pensado para ti.</h2>
            <div class="mt-10 grid gap-4 @2xl:grid-cols-3" data-services></div>
          </section>

          <!-- Proceso -->
          <section class="bg-white px-[clamp(20px,5cqw,72px)] py-[clamp(48px,8cqw,110px)] text-[var(--ink)]">
            <div class="grid gap-8 @2xl:grid-cols-3">
              {[['01', 'Escuchamos', 'Conocemos lo que necesitas y cómo trabajas.'], ['02', 'Diseñamos', 'Armamos una propuesta clara, a tu medida.'], ['03', 'Entregamos', 'Lo ponemos en marcha y te acompañamos.']].map(([n, t, d]) => <div class="border-t pt-5" style="border-color:color-mix(in srgb,var(--ink) 18%,transparent)"><span class="text-[13px] opacity-50">{n}</span><h3 class="mt-4 text-[1.35rem] tracking-[-0.03em]" style="font-weight:var(--hw)">{t}</h3><p class="mt-2 text-[14.5px] leading-relaxed opacity-65">{d}</p></div>)}
            </div>
          </section>

          <!-- Llamado -->
          <section class="bg-[var(--ink)] px-[clamp(20px,5cqw,72px)] py-[clamp(48px,8cqw,100px)] text-white">
            <h2 data-h3 class="max-w-[16ch] text-[clamp(1.8rem,5cqw,4rem)] leading-[1.04] tracking-[-0.045em]" style="font-weight:var(--hw)">Hablemos de tu proyecto.</h2>
            <span data-cta4 class="mt-7 inline-block px-7 py-4 text-[14px] font-medium" style="border-radius:calc(var(--rad) + 20px);background:var(--a);color:var(--on)">Contáctanos</span>
          </section>

          <footer class="flex flex-wrap items-center justify-between gap-3 bg-[var(--bg)] px-[clamp(20px,5cqw,72px)] py-7 text-[12.5px] text-[var(--ink)]"><span data-name3 class="uppercase tracking-[0.3em]" style="font-weight:var(--hw)">Tu empresa</span><span class="opacity-55">Propuesta visual ilustrativa · HumanCorp</span></footer>
        </div>
      </section>

      <!-- Panel de personalización -->
      <aside class="flex min-h-0 flex-col overflow-hidden border-t border-black/10 bg-white lg:border-l lg:border-t-0">
        <div data-scroller class="min-h-0 flex-1 overflow-y-auto px-6 pb-8 pt-6 lg:px-10 lg:pt-7">
          <div class="flex items-center justify-between text-[12px] text-black/45"><a href="/" class="tracking-wide"><span class="font-light">HUMAN</span> <span class="font-semibold">CORP</span></a><a href="/contacto" class="hover:text-black">Contacto</a></div>
          <h1 class="mt-8 font-goog text-[1.9rem] font-light uppercase tracking-[0.16em]">Tu sitio</h1>
          <p class="mt-2 max-w-[24rem] text-[13px] leading-relaxed text-black/55">Todo está listo: solo elige tu nombre, tus colores y tu estilo, y generamos tu sitio. Es una propuesta visual inicial que afinamos juntos.</p>

          <label class="mt-8 block text-[12.5px] text-black/60">Nombre de tu empresa<input data-in-name maxlength="28" placeholder="Tu empresa" class="mt-2 w-full rounded-2xl bg-[#f5f5f7] px-5 py-4 text-[15px] outline-none transition-shadow placeholder:text-black/35 focus:bg-white focus:shadow-[0_0_0_2px_#0033FF]" /></label>

          <h2 class={h}>Negocio</h2>
          <div class="mt-4 space-y-3">{types.map(([id, l, d], i) => <button type="button" data-type={id} aria-pressed={i === 0} class={row}><span class="cfg-t block text-[14.5px] text-black/65">{l}</span><span class="mt-1 block text-[11.5px] leading-snug text-black/40">{d}</span></button>)}</div>

          <h2 class={h}>Colores</h2>
          <div class="mt-4 flex flex-wrap gap-5">{palettes.map(([id, l, a, b], i) => <button type="button" data-pal={id} aria-pressed={i === 0} class="group text-left"><span class="relative block size-11 rounded-full ring-1 ring-black/10 transition-shadow group-aria-pressed:ring-2 group-aria-pressed:ring-[#0033FF] group-aria-pressed:ring-offset-2" style={`background:linear-gradient(135deg,${a} 50%,${b} 50%)`}></span><span class="mt-2 block text-[11.5px] text-black/55 group-aria-pressed:text-black">{l}</span></button>)}</div>

          <h2 class={h}>Estilo</h2>
          <div class="mt-4 space-y-3">{styles.map(([id, l, d], i) => <button type="button" data-sty={id} aria-pressed={i === 0} class={row}><span class="cfg-t block text-[14.5px] text-black/65">{l}</span><span class="mt-1 block text-[11.5px] leading-snug text-black/40">{d}</span></button>)}</div>

          <h2 class={h}>Portada</h2>
          <div class="mt-4 space-y-3">{covers.map(([id, l, d], i) => <button type="button" data-cover={id} aria-pressed={i === 0} class={row}><span class="cfg-t block text-[14.5px] text-black/65">{l}</span><span class="mt-1 block text-[11.5px] leading-snug text-black/40">{d}</span></button>)}</div>
          <p class="mt-8 text-[11.5px] leading-relaxed text-black/40">No incluye precios. Con tu elección preparamos una propuesta por escrito, con alcance, entregables, tiempos e inversión.</p>
        </div>

        <div class="bg-white px-6 py-4 shadow-[0_-12px_30px_-26px_rgba(0,0,0,.35)] lg:px-10 lg:py-5">
          <button type="button" data-generate class="w-full rounded-full bg-[#0033FF] px-7 py-4 text-[15px] font-medium text-white shadow-[0_12px_30px_-14px_rgba(0,51,255,.7)] transition-transform hover:scale-[1.01] active:scale-[0.98] disabled:opacity-60">Generar mi sitio</button>
          <a data-send hidden href="/contacto" class="block w-full rounded-full bg-[#14161a] px-7 py-4 text-center text-[15px] font-medium text-white transition-transform hover:scale-[1.01]">Enviar mi configuración</a>
        </div>
      </aside>
    </div>

    <script define:vars={{ types, palettes, styles, covers }}>
      const $ = (s) => document.querySelector(s);
      const $$ = (s) => [...document.querySelectorAll(s)];
      const site = $('[data-site]');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const label = (list, id) => (list.find((x) => x[0] === id) || [])[1];
      const set = (sel, t) => $$(sel).forEach((el) => (el.textContent = t));

      const COPY = {
        pequena: { eyebrow: 'Presencia profesional', h: 'Lo que haces bien, a la vista de todos.', sub: 'Un negocio local con la imagen que merece.', c1: 'Contáctanos', c2: 'Ver servicios', nav: ['Inicio', 'Servicios', 'Nosotros', 'Ubicación'], h2: 'Hecho con cuidado, pensado para ti.', sv: [['Atención cercana', 'Te escuchamos y resolvemos con calma.'], ['Calidad constante', 'Cuidamos cada detalle de lo que hacemos.'], ['Siempre disponibles', 'Te respondemos rápido y con claridad.']] },
        crecimiento: { eyebrow: 'Crecimiento ordenado', h: 'Crece con orden, cada día.', sub: 'Sistemas conectados para escalar sin caos.', c1: 'Agenda una demo', c2: 'Ver soluciones', nav: ['Inicio', 'Soluciones', 'Casos', 'Equipo'], h2: 'Menos fricción, más resultados.', sv: [['Procesos claros', 'Cada área sabe qué sigue y quién lo hace.'], ['Herramientas conectadas', 'Tu información fluye entre sistemas.'], ['Seguimiento continuo', 'Medimos y mejoramos contigo.']] },
        consolidada: { eyebrow: 'Operación integrada', h: 'Una operación, un solo estándar.', sub: 'Departamentos, datos y procesos en armonía.', c1: 'Conoce más', c2: 'Ver áreas', nav: ['Inicio', 'Áreas', 'Plataforma', 'Seguridad'], h2: 'Capacidad para sostener tu escala.', sv: [['Integración de áreas', 'Un mismo lenguaje entre departamentos.'], ['Información confiable', 'Datos centralizados para decidir mejor.'], ['Infraestructura sólida', 'Respaldos, accesos y continuidad.']] },
        comercio: { eyebrow: 'Tienda y sucursales', h: 'Tu tienda, abierta cuando la necesitan.', sub: 'Catálogo, pedidos y facturación al día.', c1: 'Ver catálogo', c2: 'Sucursales', nav: ['Inicio', 'Productos', 'Promos', 'Sucursales'], h2: 'Todo lo que buscas, en un solo lugar.', sv: [['Catálogo claro', 'Encuentra lo que buscas en segundos.'], ['Pedidos sin fricción', 'Pide en línea o pasa por tu compra.'], ['Promociones', 'Ofertas de temporada para ti.']] },
        profesional: { eyebrow: 'Servicios profesionales', h: 'Confianza que se nota desde el primer contacto.', sub: 'Servicios claros y cotizaciones rápidas.', c1: 'Solicitar cotización', c2: 'Ver servicios', nav: ['Inicio', 'Servicios', 'Equipo', 'Clientes'], h2: 'Experiencia al servicio de tu empresa.', sv: [['Asesoría a tu medida', 'Entendemos tu caso antes de proponer.'], ['Cotización clara', 'Alcance, tiempos e inversión por escrito.'], ['Acompañamiento', 'Seguimos contigo después de la entrega.']] },
        ecommerce: { eyebrow: 'Tienda en línea', h: 'Compra fácil, recibe a tiempo.', sub: 'Compras, pagos y envíos sin fricción.', c1: 'Comprar ahora', c2: 'Ver novedades', nav: ['Inicio', 'Novedades', 'Ofertas', 'Mi cuenta'], h2: 'Una experiencia de compra sin vueltas.', sv: [['Pago sencillo', 'Elige cómo pagar, de forma clara.'], ['Envíos con seguimiento', 'Sabes dónde está tu pedido.'], ['Atención posventa', 'Te ayudamos con cambios y dudas.']] },
      };
      const PAL = { atardecer: ['#F6B370', '#2F3A9E', '#14173f', '#fdf6ee', '#14173f'], oceano: ['#0033FF', '#977DFF', '#0b0c2b', '#f3f5ff', '#ffffff'], bosque: ['#10b981', '#064e5a', '#06251f', '#f1faf6', '#06251f'], grafito: ['#14173f', '#8f8aa6', '#0b0b0c', '#f6f5f2', '#ffffff'] };
      const STY = { minimal: ['6px', '300'], calido: ['16px', '500'], audaz: ['0px', '700'] };
      const S = { name: '', type: 'pequena', pal: 'atardecer', sty: 'minimal', cover: 'foto' };
      let G = null, phase = 'idle', dirty = false, token = 0;

      const renderPanel = () => {
        $$('[data-type]').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.type === S.type)));
        $$('[data-pal]').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.pal === S.pal)));
        $$('[data-sty]').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.sty === S.sty)));
        $$('[data-cover]').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.cover === S.cover)));
        const nm = S.name.trim() || 'Tu empresa';
        const text = `Hola, personalicé mi sitio en el configurador de HumanCorp:\n- Empresa: ${nm}\n- Tipo de negocio: ${label(types, S.type)}\n- Colores: ${label(palettes, S.pal)}\n- Estilo: ${label(styles, S.sty)}\n- Portada: ${label(covers, S.cover)}\nMe gustaría recibir una propuesta.`;
        $('[data-send]').href = `/contacto?interes=${encodeURIComponent('Sitio web')}&mensaje=${encodeURIComponent(text)}`;
        const gen = $('[data-generate]'), send = $('[data-send]');
        const done = phase === 'done';
        gen.hidden = done && !dirty; send.hidden = !(done && !dirty);
        gen.textContent = done ? 'Volver a generar' : 'Generar mi sitio';
        gen.disabled = phase === 'loading';
      };

      const drawSite = () => {
        const nm = G.name.trim() || 'Tu empresa';
        const [a, b, ink, bg, on] = PAL[G.pal];
        const [rad, hw] = STY[G.sty];
        site.style.cssText += `;--a:${a};--b:${b};--ink:${ink};--bg:${bg};--on:${on};--rad:${rad};--hw:${hw}`;
        const c = COPY[G.type];
        set('[data-name],[data-name2],[data-name3]', nm);
        set('[data-eyebrow]', c.eyebrow); set('[data-h]', c.h); set('[data-sub]', c.sub);
        set('[data-cta],[data-cta4]', c.c1); set('[data-cta3]', c.c2); set('[data-h2]', c.h2); set('[data-h3]', `Hablemos de ${nm}.`);
        $('[data-nav]').innerHTML = c.nav.map((n, i) => `<span class="rounded-full px-4 py-1.5 text-[12px] ${i === 0 ? 'bg-white/90 text-[#14161a]' : 'text-white/90'}">${n}</span>`).join('');
        $('[data-services]').innerHTML = c.sv.map(([t, d]) => `<div class="bg-white p-6 shadow-[0_20px_40px_-30px_rgba(0,0,0,.35)]" style="border-radius:calc(var(--rad) + 14px)"><i class="block size-10" style="border-radius:calc(var(--rad) + 4px);background:linear-gradient(140deg,var(--a),var(--b))"></i><h3 class="mt-6 text-[1.2rem] tracking-[-0.02em]" style="font-weight:var(--hw)">${t}</h3><p class="mt-2 text-[14.5px] leading-relaxed opacity-65">${d}</p><p class="mt-5 text-[13px] font-medium" style="color:var(--b)">Conocer más →</p></div>`).join('');
        $('[data-tint]').hidden = G.cover !== 'foto'; $('[data-cover-photo]').hidden = G.cover !== 'foto'; $('[data-cover-grad]').hidden = G.cover === 'foto';
        site.scrollTop = 0;
      };

      const STEPS = ['Entendiendo tu negocio…', 'Diseñando tu identidad…', 'Armando tu sitio…', 'Aplicando tus colores…', 'Últimos detalles…'];
      const generate = () => {
        if (phase === 'loading') return;
        const my = ++token;
        G = { ...S }; dirty = false;
        const [a, b] = PAL[G.pal];
        const gen = $('[data-gen]'); gen.style.setProperty('--a', a); gen.style.setProperty('--b', b);
        phase = 'loading'; renderPanel();
        $('[data-scroller]').scrollTo({ top: 0, behavior: 'smooth' });
        site.classList.add('gen-hidden'); site.classList.remove('gen-in');
        gen.style.opacity = '1';
        const total = reduced ? 400 : 4600;
        const bar = $('[data-gen-bar]'), txt = $('[data-gen-text]');
        const start = performance.now();
        const tick = (now) => {
          if (my !== token) return;
          const p = Math.min(1, (now - start) / total);
          bar.style.transform = `scaleX(${(1 - Math.pow(1 - p, 2)).toFixed(3)})`;
          txt.textContent = STEPS[Math.min(STEPS.length - 1, Math.floor(p * STEPS.length))];
          if (p < 1) requestAnimationFrame(tick); else reveal(my);
        };
        requestAnimationFrame(tick);
      };
      const reveal = (my) => {
        if (my !== token) return;
        drawSite();
        $('[data-gen]').style.opacity = '0';
        site.classList.remove('gen-hidden'); void site.offsetWidth; site.classList.add('gen-in');
        phase = 'done'; renderPanel();
      };

      document.addEventListener('click', (e) => {
        const t = e.target.closest('button'); if (!t) return;
        if (t.hasAttribute('data-generate')) { generate(); return; }
        if (t.dataset.type) S.type = t.dataset.type;
        else if (t.dataset.pal) S.pal = t.dataset.pal;
        else if (t.dataset.sty) S.sty = t.dataset.sty;
        else if (t.dataset.cover) S.cover = t.dataset.cover;
        else return;
        if (phase === 'done') dirty = true;
        renderPanel();
      });
      $('[data-in-name]').addEventListener('input', (e) => { S.name = e.target.value; if (phase === 'done') dirty = true; renderPanel(); });
      renderPanel();
    </script>
  </body>
</html>
