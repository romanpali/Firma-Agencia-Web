      const IC = { store: 'M4 9l1.5-5h13L20 9M4 9v11h16V9M4 9h16M9 20v-6h6v6', heart: 'M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.6-7 10-7 10z', star: 'M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z', pin: 'M12 21s7-6 7-11a7 7 0 0 0-14 0c0 5 7 11 7 11zM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z', chart: 'M4 20V9M10 20V4M16 20v-8M22 20H2', arrow: 'M5 19L19 5M9 5h10v10', layers: 'M12 3l9 5-9 5-9-5 9-5zM3 13l9 5 9-5M3 17l9 5 9-5', building: 'M4 21V5l8-2v18M12 8l8 2v11M8 9h1M8 13h1M8 17h1M16 14h1M16 18h1', shield: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3zM9 12l2 2 4-4', globe: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18', db: 'M12 8c4.4 0 8-1.3 8-3s-3.6-3-8-3-8 1.3-8 3 3.6 3 8 3zM4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3', bag: 'M6 8h12l1 12H5L6 8zM9 8V6a3 3 0 0 1 6 0v2', tag: 'M3 12V4h8l10 10-8 8L3 12zM7.5 8.5h.01', truck: 'M2 6h11v10H2zM13 9h5l3 3v4h-8M6 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z', briefcase: 'M3 8h18v12H3zM9 8V5h6v3M3 13h18', doc: 'M6 3h9l4 4v14H6zM14 3v5h5M9 13h6M9 17h6', chat: 'M4 5h16v11H9l-5 4V5z', check: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM8 12l3 3 5-6', cart: 'M3 4h2l2.5 11h10l2-8H7M10 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2zM17 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2z', card: 'M3 6h18v12H3zM3 10h18M7 15h4', box: 'M3 7l9-4 9 4v10l-9 4-9-4V7zM3 7l9 4 9-4M12 11v10' };
      const SETS = { pequena: ['store', 'heart', 'star', 'pin'], crecimiento: ['chart', 'layers', 'arrow', 'check'], consolidada: ['building', 'shield', 'globe', 'db'], comercio: ['bag', 'tag', 'truck', 'store'], profesional: ['briefcase', 'doc', 'chat', 'check'], ecommerce: ['cart', 'card', 'box', 'truck'] };
      const icon = (n, cls = '') => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="${cls}" aria-hidden="true"><path d="${IC[n]}"/></svg>`;
      // x, y (% del lienzo), tamaño (cqw), profundidad, tipo (s = sólida con ícono, g = cristal, r = anillo)
      const BUB = [[1, 46, 9, 0.9, 's', 0], [8, 64, 11, 0.8, 'g', 1], [3, 80, 12, 1, 's', 1], [17, 78, 13, 1.1, 'g', 2], [26, 60, 4.5, 0.4, 's', 3], [30, 88, 8, 0.6, 'r', 0], [38, 80, 17, 1.3, 's', 2], [48, 74, 5, 0.5, 'g', 0], [53, 90, 6, 0.5, 'r', 0], [57, 62, 11, 0.8, 's', 3], [62, 76, 14, 1.2, 'g', 1], [76, 80, 8, 0.7, 's', 0], [80, 62, 10, 0.9, 'r', 0], [84, 86, 12, 1.2, 's', 1], [92, 66, 12, 1.1, 'g', 3], [96, 40, 6, 0.5, 's', 2], [10, 90, 7, 0.7, 'g', 0]];
      const drawBubbles = (nm, type) => {
