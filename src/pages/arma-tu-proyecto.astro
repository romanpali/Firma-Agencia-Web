---
import '../styles/global.css';
import Cursor from '../components/Cursor.astro';

const types: [string, string, string][] = [
  ['pequena', 'Pequeña empresa', 'Presencia profesional para atraer clientes.'],
  ['crecimiento', 'Empresa en crecimiento', 'Orden y sistemas para escalar.'],
  ['consolidada', 'Empresa consolidada', 'Áreas, datos y procesos bajo un estándar.'],
  ['comercio', 'Comercio o establecimiento', 'Catálogo, pedidos y sucursales.'],
  ['profesional', 'Servicios profesionales', 'Confianza, cotizaciones y clientes.'],
  ['ecommerce', 'Comercio electrónico', 'Tienda, pagos y envíos.'],
];
const sites: [string, string, string][] = [
  ['landing', 'Landing', 'Una página enfocada en que te contacten.'],
  ['corporativo', 'Sitio corporativo', 'Servicios, proceso, preguntas y contacto.'],
  ['galeria', 'Galería', 'Tus proyectos y trabajos presentados como una exposición.'],
  ['ecommerce', 'Ecommerce', 'Una tienda en línea con catálogo y cesta.'],
];
const giros: [string, string][] = [['moda', 'Moda'], ['hogar', 'Hogar'], ['belleza', 'Belleza'], ['alimentos', 'Alimentos'], ['tecnologia', 'Tecnología']];

const row = 'cfg-row block w-full rounded-[18px] bg-[#f5f5f7] px-5 py-4 text-left transition-[background-color,box-shadow] duration-200 hover:bg-[#ededf0] aria-pressed:bg-white aria-pressed:shadow-[0_0_0_2px_#0033FF,0_12px_30px_-18px_rgba(0,51,255,.55)]';
const chip = 'rounded-full bg-[#f5f5f7] px-4 py-2.5 text-[13px] text-black/65 transition-colors hover:bg-[#ededf0] aria-pressed:bg-[#14161a] aria-pressed:text-white';
const h = 'mt-9 font-goog text-[1.3rem] font-semibold tracking-[-0.02em]';
const inp = 'mt-2 w-full rounded-2xl bg-[#f5f5f7] px-5 py-4 text-[15px] outline-none transition-shadow placeholder:text-black/35 focus:bg-white focus:shadow-[0_0_0_2px_#0033FF]';
const idleImgs = ['/process/reel-1.webp', '/horizon/2.webp', '/process/reel-2.webp', '/horizon/4.webp', '/process/reel-3.webp'];
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Genera una propuesta de sitio web para tu negocio con HumanCorp: solo cuéntanos lo básico y mírala generarse." />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>Personaliza tu sitio (beta) — HumanCorp</title>
  </head>
  <body class="overflow-hidden bg-white font-sans text-[#14161a]">
    <div class="grid h-svh grid-rows-[44svh_minmax(0,1fr)] lg:grid-cols-[minmax(0,1fr)_470px] lg:grid-rows-1">
      <!-- Escenario -->
      <section data-stage class="relative overflow-hidden bg-white" aria-label="Vista previa de tu sitio">
        <a href="/" aria-label="Volver al inicio" class="absolute left-4 top-4 z-30 grid size-11 place-items-center rounded-full bg-white/80 text-[#14161a] shadow-[0_8px_24px_-12px_rgba(0,0,0,.5)] backdrop-blur-md transition-transform hover:scale-105 lg:left-7 lg:top-7"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></a>

        <span data-pill hidden class="absolute right-4 top-[78px] z-30 rounded-full bg-white/85 px-4 py-2 text-[12px] text-[#14161a] shadow-[0_8px_24px_-12px_rgba(0,0,0,.4)] backdrop-blur-md lg:right-7 lg:top-[84px]"></span>

        <!-- En espera: abanico de tarjetas -->
        <div data-idle class="@container absolute inset-0 overflow-hidden text-[#14161a] transition-[opacity,filter] duration-700" style="background:radial-gradient(75% 65% at 50% 40%,#ffffff,#eef0f6 80%)">
          <i class="pointer-events-none absolute left-1/2 top-[18%] h-[60%] w-[70%] -translate-x-1/2 rounded-full opacity-[.22] blur-[90px]" style="background:radial-gradient(circle,#977dff,transparent 70%)" aria-hidden="true"></i>
          <div class="absolute inset-0 flex flex-col items-center justify-center px-6">
            <span class="grid size-12 place-items-center rounded-full border border-black/20 text-[15px] font-semibold tracking-wider">H</span>
            <div class="idle-fan relative mt-[clamp(18px,3cqw,40px)] h-[clamp(150px,30cqw,290px)] w-full" data-fan>
              {idleImgs.map((src, i) => <div data-card={i} class="idle-card absolute left-1/2 top-0 aspect-[4/5] w-[clamp(110px,17cqw,210px)] overflow-hidden rounded-[22px] border border-black/10 shadow-[0_30px_60px_-30px_rgba(10,12,40,.45)]"><img src={src} alt="" width="360" height="640" loading="eager" decoding="async" class="size-full object-cover" /></div>)}
            </div>
            <h2 class="mt-[clamp(20px,4cqw,44px)] flex items-center justify-center gap-3 text-center font-goog text-[clamp(1.6rem,4cqw,3rem)] font-light tracking-[-0.03em]">Tu sitio, a tu medida<span class="rounded-full bg-[#14161a] px-3 py-1 text-[11px] font-medium uppercase tracking-[0.14em] text-white">Beta</span></h2>
            <p class="mt-2 max-w-[28rem] text-center text-[clamp(12px,1.3cqw,14.5px)] text-black/50">Elige a la derecha cómo lo quieres y míralo generarse aquí.</p>
            <button type="button" data-focus-name class="mt-6 flex items-center gap-3 rounded-full bg-[#14161a] py-2 pl-6 pr-2 text-[14px] font-medium text-white transition-transform hover:scale-[1.03]">Configura el tuyo<span class="grid size-9 place-items-center rounded-full bg-white text-[#14161a]"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></button>
          </div>
        </div>

        <!-- Generando -->
        <div data-gen class="pointer-events-none absolute inset-0 z-10 grid place-items-center opacity-0 transition-opacity duration-500" style="--a:#F6B370;--b:#2F3A9E">
          <div class="gen-card relative aspect-[16/11] w-[min(72%,680px)] overflow-hidden rounded-[36px] bg-white shadow-[0_40px_90px_-40px_rgba(0,0,0,.6)]">
            <i class="gen-blob gen-b1 absolute"></i><i class="gen-blob gen-b2 absolute"></i><i class="gen-blob gen-b3 absolute"></i>
            <i class="gen-shine absolute inset-0"></i><i class="grain absolute inset-0 opacity-[.18]"></i>
            <div class="absolute inset-x-0 bottom-0 p-6 text-center">
              <p data-gen-text class="font-goog text-[1.05rem] tracking-[-0.01em] text-[#14161a]/80">Entendiendo tu negocio…</p>
              <i class="relative mx-auto mt-4 block h-[3px] w-[60%] overflow-hidden rounded-full bg-black/10"><b data-gen-bar class="absolute inset-y-0 left-0 block w-full origin-left rounded-full bg-[#14161a]" style="transform:scaleX(0)"></b></i>
            </div>
          </div>
        </div>

        <!-- Sitio generado -->
        <div data-site data-theme="claro" data-anim="suave" class="site cfg gen-hidden @container absolute inset-0 overflow-y-auto overflow-x-hidden [scrollbar-width:thin]" style="--a:#F6B370;--b:#2F3A9E;--ink:#14173f;--bg:#fdf6ee;--on:#14173f;--rad:6px;--hw:300;--sfont:'Inter Tight Variable',system-ui,sans-serif;--mx:0;--my:0;--spd:1;--par:1">
          <!-- Plantilla A: Paisaje -->
          <section data-d="a" class="relative h-full min-h-[560px] overflow-hidden bg-[#0b1018] text-white">
            <div class="absolute -inset-[5%]" style="translate:calc(var(--mx)*-14px*var(--par)) calc(var(--my)*-9px*var(--par))"><img src="/configurador/valle.webp" alt="" width="1200" height="675" decoding="async" class="kb size-full object-cover" /></div>
            <i class="absolute inset-0 mix-blend-soft-light" style="opacity:.5;background:linear-gradient(160deg,var(--a),var(--b))"></i>
            <i class="absolute inset-0 mix-blend-color" style="opacity:.18;background:linear-gradient(160deg,var(--b),var(--a))"></i>
            <i class="fog fog1"></i><i class="fog fog2"></i>
            <i class="beam pointer-events-none absolute inset-0"></i>
            <i class="pointer-events-none absolute inset-0" style="background:linear-gradient(to bottom,rgba(4,8,18,.62),rgba(4,8,18,.06) 40%,rgba(4,8,18,.14) 60%,rgba(4,8,18,.78))"></i>
            <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true"><i class="ff" style="left:3%;top:52%;--dl:-0.0s;--t:6s;--s:3px"></i><i class="ff" style="left:40%;top:75%;--dl:-0.9s;--t:7s;--s:4px"></i><i class="ff" style="left:77%;top:58%;--dl:-1.8s;--t:8s;--s:5px"></i><i class="ff" style="left:22%;top:81%;--dl:-2.7s;--t:9s;--s:3px"></i><i class="ff" style="left:59%;top:64%;--dl:-3.6s;--t:10s;--s:4px"></i><i class="ff" style="left:4%;top:87%;--dl:-4.5s;--t:6s;--s:5px"></i><i class="ff" style="left:41%;top:70%;--dl:-5.4s;--t:7s;--s:3px"></i><i class="ff" style="left:78%;top:53%;--dl:-6.3s;--t:8s;--s:4px"></i><i class="ff" style="left:23%;top:76%;--dl:-0.2s;--t:9s;--s:5px"></i><i class="ff" style="left:60%;top:59%;--dl:-1.1s;--t:10s;--s:3px"></i><i class="ff" style="left:5%;top:82%;--dl:-2.0s;--t:6s;--s:4px"></i><i class="ff" style="left:42%;top:65%;--dl:-2.9s;--t:7s;--s:5px"></i><i class="ff" style="left:79%;top:88%;--dl:-3.8s;--t:8s;--s:3px"></i><i class="ff" style="left:24%;top:71%;--dl:-4.7s;--t:9s;--s:4px"></i><i class="ff" style="left:61%;top:54%;--dl:-5.6s;--t:10s;--s:5px"></i><i class="ff" style="left:6%;top:77%;--dl:-6.5s;--t:6s;--s:3px"></i></div>
            <i class="grain pointer-events-none absolute inset-0 opacity-[.12]"></i>

            <nav class="rise absolute inset-x-0 top-0 flex items-center justify-between pl-[72px] pr-[clamp(16px,2.6cqw,40px)] pt-[22px] @4xl:pl-[clamp(80px,9cqw,120px)]" style="--d:.1s">
              <span class="flex items-center gap-3"><i data-markbox class="mark grid size-8 place-items-center bg-white/90 text-[14px] font-semibold not-italic text-[#14161a]">T</i><span data-name class="text-[clamp(14px,1.5cqw,19px)] font-extrabold uppercase tracking-[0.02em]">Tu empresa</span></span>
              <div class="hidden items-center gap-1 rounded-full border border-white/25 bg-white/10 px-2 py-1.5 backdrop-blur-xl @3xl:flex" data-nav></div>
              <span data-navcta class="rounded-full bg-white px-5 py-2.5 text-[12.5px] font-medium text-[#14161a]">Contacto</span>
            </nav>

            <div class="absolute inset-x-0 top-[15%] flex flex-col items-center px-6 text-center">
              <p class="rise mb-5 flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-4 py-1.5 text-[clamp(11px,1.15cqw,13.5px)] backdrop-blur-md" style="--d:.2s"><i class="size-1.5 rounded-full" style="background:var(--a)"></i><span data-eyebrow>Presencia profesional</span></p>
              <h1 data-ha class="max-w-[14ch] text-[clamp(2.1rem,7cqw,6.6rem)] font-extrabold uppercase leading-[.98] tracking-[-0.025em]" style="font-weight:min(calc(var(--hw) + 420),800)">Tu negocio, cercano</h1>
              <div class="rise mt-7 flex flex-wrap items-center justify-center gap-3" style="--d:.9s"><span data-cta class="btn !bg-white px-7 py-3.5 text-[14.5px] font-medium !text-[#14161a]">Contáctanos</span><span class="btn-o flex items-center gap-2 border border-white/50 px-6 py-3.5 text-[14.5px]"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M7 5v14l12-7z"/></svg><span data-cta3>Ver servicios</span></span></div>
            </div>

            <div class="rise absolute inset-x-0 bottom-[clamp(18px,2.6cqw,36px)] px-[clamp(16px,2.6cqw,40px)]" style="--d:1.2s">
              <p data-sub class="mx-auto mb-4 max-w-[34rem] text-center text-[clamp(12px,1.2cqw,15px)] leading-snug text-white/85">Presencia profesional para atraer clientes.</p>
              <div data-strip class="mx-auto grid max-w-[60rem] gap-px overflow-hidden rounded-[22px] border border-white/25 bg-white/20 backdrop-blur-xl @2xl:grid-cols-3"></div>
            </div>
          </section>

          <!-- Plantilla B: Retrato -->
          <section data-d="b" hidden class="b-hero relative h-full min-h-[540px] overflow-hidden bg-[#2f66ad] text-white">
            <div class="absolute -inset-[4%]" style="translate:calc(var(--mx)*-12px*var(--par)) calc(var(--my)*-8px*var(--par))"><img src="/configurador/retrato.webp" alt="" width="1694" height="928" decoding="async" class="kb size-full object-cover" style="object-position:55% 30%" /></div>
            <i class="absolute inset-0 mix-blend-soft-light" style="opacity:.5;background:linear-gradient(160deg,var(--a),var(--b))"></i>
            <i class="absolute inset-0 mix-blend-color" style="opacity:.2;background:linear-gradient(160deg,var(--b),var(--a))"></i>
            <i class="pointer-events-none absolute inset-0" style="background:linear-gradient(to bottom,rgba(0,10,40,.28),transparent 28%,transparent 55%,rgba(0,10,40,.5))"></i>
            <i class="grain pointer-events-none absolute inset-0 opacity-[.12]"></i>
            <div data-bubbles class="absolute inset-0"></div>
            <nav class="rise absolute inset-x-0 top-0 flex items-center justify-between pl-[72px] pr-[clamp(16px,2.6cqw,40px)] pt-[22px] @4xl:pl-[clamp(80px,9cqw,120px)] text-[clamp(11px,1.15cqw,14px)]" style="--d:.1s">
              <span class="flex items-center gap-2.5"><i data-markbox class="mark grid size-9 place-items-center bg-white text-[15px] font-semibold not-italic text-[#14161a]">T</i><span data-name class="text-[clamp(16px,1.7cqw,21px)] font-extrabold uppercase tracking-[0.01em]">Tu empresa</span></span>
              <div class="flex items-center gap-[clamp(14px,2.6cqw,34px)]"><span class="hidden items-center gap-[clamp(14px,2.6cqw,34px)] @3xl:flex" data-nav2></span><span data-navcta class="rounded-full bg-white px-5 py-2.5 text-[12.5px] font-medium text-[#14161a]"><span data-navcta-t>Contacto</span></span></div>
            </nav>
            <div class="absolute inset-x-0 bottom-0 px-[clamp(20px,2.6cqw,40px)] pb-[clamp(26px,3.2cqw,44px)]">
              <p class="rise mb-4 flex items-center gap-3 text-[clamp(12px,1.25cqw,15px)] text-white/90" style="--d:.2s"><span class="flex -space-x-2"><i class="grid size-7 place-items-center rounded-full border-2 border-white/80 text-[11px] not-italic" style="background:var(--a);color:var(--on)" data-av>T</i><i class="size-7 rounded-full border-2 border-white/80" style="background:linear-gradient(135deg,var(--a),var(--b))"></i><i class="size-7 rounded-full border-2 border-white/80 bg-white/80"></i></span><span data-eyebrow2>Presencia profesional</span></p>
              <h1 data-hb class="max-w-[12ch] text-[clamp(2.2rem,7cqw,6.8rem)] font-extrabold uppercase leading-[.98] tracking-[-0.025em]" style="font-weight:min(calc(var(--hw) + 420),800)"></h1>
              <div class="rise mt-6 flex flex-wrap items-center gap-3" style="--d:.9s"><span data-cta2 class="btn !bg-white px-7 py-3.5 text-[14.5px] font-medium !text-[#14161a]">Contáctanos</span></div>
              <p data-sub2 class="rise absolute bottom-[clamp(26px,3.2cqw,44px)] right-[clamp(20px,2.6cqw,40px)] hidden max-w-[21rem] text-[clamp(12px,1.25cqw,15.5px)] leading-snug text-white/90 @3xl:block" style="--d:1.1s">Presencia profesional para atraer clientes.</p>
            </div>
          </section>

          <!-- Plantilla D: Galería (portafolio) -->
          <div data-d="d" hidden class="gal">
            <section class="gal-hero">
              <i class="gal-glow g1"></i><i class="gal-glow g2"></i>
              <i class="grain pointer-events-none absolute inset-0 opacity-[.14]"></i>
              <nav class="gal-nav rise" style="--d:.1s">
                <span data-name class="gal-logo">Tu empresa</span>
                <span class="gal-links" data-gal-nav></span>
                <span class="gal-pill">Contacto</span>
              </nav>
              <div class="gal-copy">
                <p class="gal-eyebrow rise" style="--d:.2s"><i></i><span data-gal-eyebrow>Estudio creativo</span></p>
                <h1 class="gal-title" data-gal-title></h1>
                <p class="gal-desc rise" style="--d:1.1s" data-gal-desc></p>
                <div class="gal-actions rise" style="--d:1.2s"><span class="btn gal-btn" data-gal-cta>Ver proyectos</span><span class="gal-scroll"><i></i>Desliza</span></div>
              </div>
              <div class="gal-rows rise" style="--d:.6s" aria-hidden="true">
                <div class="gal-row"><div class="gal-track" data-gal-r1></div></div>
                <div class="gal-row rev"><div class="gal-track" data-gal-r2></div></div>
              </div>
            </section>

            <section class="gal-book" data-book>
              <div class="bk-stick">
                <i class="bk-wood"></i><i class="bk-lamp"></i>
                <svg class="bk-cup" viewBox="0 0 140 140" aria-hidden="true"><circle cx="66" cy="72" r="58" fill="#cfc4b0"/><circle cx="66" cy="72" r="50" fill="#e9e1d2"/><rect x="108" y="58" width="30" height="26" rx="13" fill="#f4efe4"/><rect x="116" y="64" width="14" height="14" rx="7" fill="#cfc4b0"/><circle cx="66" cy="72" r="38" fill="#f7f3ea"/><circle cx="66" cy="72" r="31" fill="#3a2418"/><ellipse cx="56" cy="62" rx="14" ry="8" fill="rgba(255,235,210,.28)" transform="rotate(-24 56 62)"/></svg>
                <svg class="bk-plant" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="52" r="40" fill="#2b2a28"/><circle cx="50" cy="52" r="33" fill="#1b1a19"/><g fill="#5f8a55">{[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <ellipse cx="50" cy="34" rx="7.5" ry="17" transform={`rotate(${i * 45} 50 52)`} />)}</g><g fill="#7ba46c">{[0, 1, 2, 3, 4, 5].map((i) => <ellipse cx="50" cy="40" rx="5" ry="11" transform={`rotate(${i * 60 + 20} 50 52)`} />)}</g></svg>
                <i class="bk-pencil"></i>
                <div class="bk-intro"><p>Obra selecta</p><h2>Proyectos que puedes explorar</h2><span>Desliza para pasar las páginas o haz clic en una.</span></div>
                <div class="bk-scene"><div class="bk-book" data-bk>
                  <i class="bk-base"></i><i class="bk-base l"></i>
                  <div class="bk-end" data-bk-end></div>
                  <div data-bk-leaves style="display:contents"></div>
                </div></div>
                <div class="bk-ui"><span data-bk-count>Cubierta</span><i><b data-bk-bar></b></i></div>
              </div>
            </section>

            <section class="gal-sec gal-svc">
              <div class="gal-head sr"><p>Lo que hacemos</p><h2>Servicios</h2></div>
              <div data-gal-svc></div>
            </section>

            <section class="gal-end sr">
              <p>¿Tienes un proyecto en mente?</p>
              <h2 data-gal-end>Hablemos.</h2>
              <span class="gal-mail" data-mail>hola@tuempresa.mx</span>
            </section>
            <footer class="gal-foot"><span data-name3>Tu empresa</span><span>Proyectos ilustrativos · HumanCorp</span></footer>
          </div>

          <!-- Plantilla C: Boutique (ecommerce) -->
          <div data-d="c" hidden class="shop">
            <div class="shop-bar"><div data-shop-marq class="shop-marq"></div></div>
            <header class="shop-head">
              <div class="shop-head-in">
                <span class="shop-nav"><button type="button" data-shop-menu>Menú</button></span>
                <span data-name class="shop-logo">Tu empresa</span>
                <span class="shop-nav shop-r"><span>Buscar</span><span class="hidden @xl:inline">Cuenta</span><span>Cesta (<b data-cart>0</b>)</span></span>
              </div>
            </header>

            <section data-hero="0" class="shop-hero0">
              <div class="shop-pane" data-pane>
                <p class="shop-eyebrow rise" style="--d:.2s" data-sh-eyebrow>Nueva colección</p>
                <h1 class="shop-title" data-sh-title></h1>
                <p class="shop-desc rise" style="--d:1s" data-sh-desc></p>
                <a class="shop-cta rise" style="--d:1.1s" data-sh-cta>Ver colección <i aria-hidden="true">→</i></a>
                <div class="shop-float" data-sh-float></div>
              </div>
              <div class="shop-photo"><img data-sh-img alt="" width="1200" height="800" decoding="async" /><i class="shop-tint"></i></div>
            </section>

            <section data-hero="1" hidden class="shop-hero1">
              <div class="shop-photo full"><img data-sh-img alt="" width="1200" height="800" decoding="async" /><i class="shop-tint"></i></div>
              <div class="shop-over">
                <p class="shop-eyebrow rise" style="--d:.2s" data-sh-eyebrow>Nueva colección</p>
                <h1 class="shop-title big" data-sh-title></h1>
                <a class="shop-cta rise" style="--d:1.1s" data-sh-cta>Ver colección <i aria-hidden="true">→</i></a>
              </div>
            </section>

            <section class="shop-sec">
              <div class="shop-filters" data-filters></div>
              <div class="shop-grid" data-grid></div>
            </section>

            <section class="shop-banner sr"><p data-sh-banner>Nuevo</p><div data-sh-banner-marq class="shop-marq big"></div></section>

            <section class="shop-feat">
              {[['Envíos a todo el país', 'Seguimiento de tu pedido en cada paso.'], ['Cambios y devoluciones', 'Tienes tiempo para decidir con calma.'], ['Pago seguro', 'Tarjeta, transferencia o a tu manera.']].map(([t, d], i) => <div class="sr" style={`--sd:${i * 0.12}s`}><span>0{i + 1}</span><h3>{t}</h3><p>{d}</p></div>)}
            </section>

            <section class="shop-news sr">
              <h2 data-sh-news>Suscríbete</h2>
              <p>Novedades y lanzamientos, sin spam.</p>
