        $('[data-girobox]').hidden = S.site !== 'ecommerce';
        const nm = S.name.trim() || 'Tu empresa';
        const text = `Hola, generé una propuesta en el configurador de HumanCorp (beta):\n- Negocio: ${nm} (${S.city})\n${S.desc.trim() ? '- Qué hace: ' + S.desc.trim() + '\n' : ''}- Tipo de negocio: ${label(types, S.type)}\n- Tipo de sitio: ${SITE_NAME[S.site]}${S.site === 'ecommerce' ? ' · ' + label(giros, S.giro) : ''}\n${G ? '- Propuesta: plantilla ' + TPL_NAME[G.tpl] + ', paleta ' + PAL_NAME[G.pal] + '\n' : ''}Me gustaría recibir una cotización.`;
        $('[data-send]').href = `/contacto?interes=${encodeURIComponent('Sitio web')}&mensaje=${encodeURIComponent(text)}`;
        const gen = $('[data-generate]'), after = $('[data-after]');
        const done = phase === 'done';
        gen.hidden = done && !dirty; after.hidden = !(done && !dirty);
        gen.textContent = done ? 'Volver a generar' : 'Generar mi sitio';
        gen.disabled = phase === 'loading';
        const rr = $('[data-reroll]'); if (rr) rr.disabled = phase === 'loading';
      };

      /* ---------- Dibujar el sitio generado ---------- */
      const drawSite = () => {
        const nm = G.name.trim() || 'Tu empresa';
        const slug = nm.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '') || 'tuempresa';
        const P = PALS[G.pal];
        const on = lum(P.a) > 0.45 ? '#14161a' : '#ffffff';
        const [rad, hw] = STY[G.sty];
        site.style.cssText += `;--a:${P.a};--b:${P.b};--ink:${P.ink};--bg:${P.bg};--on:${on};--rad:${rad};--hw:${hw};--sfont:${FONT[G.font]};--spd:1;--par:1`;
        site.dataset.theme = G.theme; site.dataset.anim = 'suave';
        $$('[data-d]').forEach((el) => (el.hidden = el.dataset.d !== G.tpl));
        const shop = G.tpl === 'c', gal = G.tpl === 'd', own = shop || gal;
        $$('[data-sec]').forEach((x) => (x.hidden = own || !G.secs.includes(x.dataset.sec)));
        $$('[data-common]').forEach((x) => (x.hidden = own));
        const c = COPY[G.type];
        const city = G.city.trim() || 'Mérida, Yucatán';
        const desc = G.desc.trim();
        set('[data-name],[data-name3]', nm); $$('[data-name2]').forEach((el, i) => (el.textContent = (i ? '| ' : '') + nm));
        set('[data-city],[data-city2]', city); set('[data-mail]', `hola@${slug}.mx`);
        $$('[data-markbox]').forEach((m) => { m.hidden = G.mark === 'ninguno'; m.textContent = nm[0].toUpperCase(); m.style.borderRadius = G.mark === 'circulo' ? '999px' : 'calc(var(--rad) + 2px)'; });
        set('[data-av]', nm[0].toUpperCase());
        $$('.sr').forEach((el) => el.classList.remove('in'));
        if (gal) { drawGallery(nm, slug); }
        else if (shop) { drawShop(nm); stopRot(); }
        else {
          set('[data-eyebrow]', desc || c.eyebrow); set('[data-eyebrow2]', desc || c.eyebrow);
          set('[data-sub],[data-sub2]', desc ? `${nm}: ${desc}.` : `${c.sub} ${nm} te acompaña: simple, claro y listo para crecer contigo.`);
          set('[data-cta],[data-cta2],[data-cta4]', c.c1); set('[data-cta3]', c.c2); set('[data-navcta-t]', c.nav[3]);
          set('[data-h2]', c.h2); set('[data-h3]', `Hablemos de ${nm}.`);
          $('[data-nav]').innerHTML = c.nav.map((n, i) => `<span class="rounded-full px-[clamp(10px,1.4cqw,20px)] py-2 text-[clamp(11px,1.15cqw,14px)] ${i === 0 ? 'bg-white/20 text-white' : 'text-white/90'}">${n}</span>`).join('');
          $('[data-nav2]').innerHTML = c.nav.map((n, i) => `<span class="${i === 0 ? 'text-white' : 'text-white/85'}">${n}<sup class="ml-1 text-[.62em] opacity-60">0${i + 1}</sup></span>`).join('');
          $('[data-strip]').innerHTML = c.sv.map(([t, d], i) => `<div class="flex items-center gap-3 bg-black/20 px-5 py-4 text-left"><i class="grid size-10 shrink-0 place-items-center rounded-full text-white" style="background:linear-gradient(140deg,var(--a),var(--b))">${icon(SETS[G.type][i], 'size-5')}</i><span><b class="block text-[13.5px] font-medium">${t}</b><span class="block text-[11.5px] leading-snug text-white/70">${d}</span></span></div>`).join('');
          $('[data-services]').innerHTML = c.sv.map(([t, d], i) => `<div class="sr card svc relative overflow-hidden p-7" style="--sd:${i * 0.12}s;border-radius:calc(var(--rad) + 18px)"><span class="svc-n absolute right-6 top-5 text-[13px] opacity-35">0${i + 1}</span><i class="svc-ic grid size-12 place-items-center text-white" style="border-radius:calc(var(--rad) + 6px);background:linear-gradient(140deg,var(--a),var(--b))">${icon(SETS[G.type][i], 'size-6')}</i><h3 class="mt-8 text-[1.3rem] tracking-[-0.025em]" style="font-weight:var(--hw)">${t}</h3><p class="mt-2 text-[14.5px] leading-relaxed opacity-65">${d}</p><p class="svc-link mt-6 flex items-center gap-2 text-[13px] font-medium" style="color:var(--a)">Conocer más <span aria-hidden="true">→</span></p></div>`).join('');
          $('[data-faq]').innerHTML = c.faq.map(([q, an], i) => `<details class="sr faq border-t py-4" ${i === 0 ? 'open' : ''} style="--sd:${i * 0.1}s"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[1.05rem] tracking-[-0.015em]">${q}<i class="faq-i grid size-7 shrink-0 place-items-center rounded-full border border-current/30 text-[15px] leading-none not-italic">+</i></summary><p class="mt-3 max-w-[40rem] text-[14.5px] leading-relaxed opacity-65">${an.replace('{city}', esc(city))}</p></details>`).join('');
          const mq = [...c.sv.map((x) => x[0]), ...c.nav.slice(1)];
          $('[data-marquee]').innerHTML = mq.concat(mq).map((t) => `<span class="text-[clamp(1.1rem,2.6cqw,2.2rem)] tracking-[-0.03em]" style="font-weight:var(--hw)">${t}</span><i class="size-2 rounded-full" style="background:var(--a)"></i>`).join('');
          if (G.tpl === 'a') drawHeading('[data-ha]', c.pre, c.words, '', false); else { drawBubbles(nm, G.type); drawHeading('[data-hb]', c.pre, c.words, '', false); }
        }
        site.scrollTop = 0; site.classList.remove('scrolled');
        io.disconnect(); $$('.sr').forEach((el) => io.observe(el));
      };

      /* Revelado al hacer scroll dentro del sitio y paralaje con el cursor */
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { root: site, threshold: 0.12 });
      site.addEventListener('pointermove', (e) => { const r = site.getBoundingClientRect(); site.style.setProperty('--mx', ((e.clientX - r.left) / r.width - 0.5).toFixed(3)); site.style.setProperty('--my', ((e.clientY - r.top) / r.height - 0.5).toFixed(3)); }, { passive: true });

      /* ---------- Generación ---------- */
      const STEPS = ['Entendiendo tu negocio…', 'Eligiendo un diseño…', 'Armando tu sitio…', 'Aplicando colores…', 'Últimos detalles…'];
      const generate = (again) => {
        if (phase === 'loading') return;
        const my = ++token;
        roll = again ? roll + 1 : 0;
        const next = { ...S, ...compose() };
        G = next; last = next; dirty = false;
        clearInterval(fanTimer); stopRot();
        const P = PALS[G.pal];
        const gen = $('[data-gen]'); gen.style.setProperty('--a', P.a); gen.style.setProperty('--b', P.b);
        phase = 'loading'; renderPanel();
        $('[data-pill]').hidden = true;
        $('[data-scroller]').scrollTo({ top: 0, behavior: 'smooth' });
        const idle = $('[data-idle]'); idle.style.opacity = '0'; idle.style.filter = 'blur(14px)'; idle.style.pointerEvents = 'none';
        site.classList.add('gen-hidden'); site.classList.remove('gen-in');
        gen.style.opacity = '1';
        const total = reduced ? 400 : 4200;
        const bar = $('[data-gen-bar]'), txt = $('[data-gen-text]');
        const start = performance.now();
        const tick = (now) => {
          if (my !== token) return;
          const p = Math.min(1, (now - start) / total);
          bar.style.transform = `scaleX(${(1 - Math.pow(1 - p, 2)).toFixed(3)})`;
          txt.textContent = STEPS[Math.min(STEPS.length - 1, Math.floor(p * STEPS.length))];
          if (p < 1) requestAnimationFrame(tick); else reveal(my);
        };
        requestAnimationFrame(tick);
      };
      const reveal = (my) => {
        if (my !== token) return;
        drawSite();
        $('[data-gen]').style.opacity = '0';
        site.classList.remove('gen-hidden'); void site.offsetWidth; site.classList.add('gen-in');
        phase = 'done'; renderPanel();
        const pill = $('[data-pill]'); pill.textContent = `Propuesta ${roll + 1} · ${TPL_NAME[G.tpl]}`; pill.hidden = false;
      };

      document.addEventListener('click', (e) => {
        const t = e.target.closest('button'); if (!t || t.closest('[data-site]')) return;
        if (t.hasAttribute('data-generate')) { generate(false); return; }
        if (t.hasAttribute('data-reroll')) { generate(true); return; }
        const d = t.dataset;
        if (d.type) S.type = d.type;
        else if (d.siteT) S.site = d.siteT;
        else if (d.giro) S.giro = d.giro;
        else return;
        if (phase === 'done') dirty = true;
        renderPanel();
      });
      const bind = (sel, key) => $(sel).addEventListener('input', (e) => { S[key] = e.target.value; if (phase === 'done') dirty = true; renderPanel(); });
      bind('[data-in-name]', 'name'); bind('[data-in-city]', 'city'); bind('[data-in-desc]', 'desc');
      renderPanel();
    </script>
  </body>
</html>
