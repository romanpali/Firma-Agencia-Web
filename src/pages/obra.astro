---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import ScrollFx from '../components/ScrollFx.astro';
import BookProps from '../components/BookProps.astro';
import XmasProps from '../components/XmasProps.astro';
import '../styles/marea.css';
import '../styles/mdash.css';
import '../styles/marea-web.css';
import '../styles/trama.css';
import '../styles/aurora.css';
import '../styles/abaco.css';
import '../styles/obra-mobile.css';
import { pagesFor, leavesMarkup, type Proj } from '../scripts/book';
import { mareaLeaves, mareaPieces } from '../scripts/marea';
import { tramaLeaves, tramaPieces } from '../scripts/trama';
import { auroraLeaves, auroraPieces } from '../scripts/aurora';
import { abacoLeaves, abacoPieces } from '../scripts/abaco';

const hcWm = `<b class="hc-wm"><i class="hc-l">HUMAN</i> <i class="hc-s">CORP</i></b>`;
const hcBack = `<div class="pg hc-pg" data-rp="dark"><div class="hc-blk hc-on">${hcWm}</div></div>`;
const hcFront = `<div class="pg hc-pg" data-rp="light"><div class="hc-intro"><img class="hc-ph" src="/team/mauricio-bn.webp" alt="Mauricio Pali, Director de Administración y Finanzas" width="640" height="641" decoding="sync" /><div class="hc-tx"><p class="hc-k">Contabilidad</p><h4>Tus cuentas, en manos de quien dirige nuestras finanzas.</h4><p class="hc-p">Mauricio Pali, contador y Director de Administración y Finanzas, y su área llevan tu contabilidad y tu asesoría fiscal, con el respaldo de nuestra tecnología. Lo jurídico lo resolvemos con profesionales aliados.</p><small>Mauricio Pali · Administración y Finanzas</small></div></div><div class="hc-blk">${hcWm}</div></div>`;
// Proyectos ilustrativos (nombres ficticios): ejemplos de lo que HumanCorp construye en cada división.
const projs: Proj[] = [
  { n: 'Marea', leaves: mareaLeaves(), pieces: mareaPieces, cat: 'Identidad, web y panel con IA', y: 2026, hl: 'Un lugar para bajar el ritmo', d: 'Identidad, sitio web, reservas en línea y un panel con asistente de IA para unas estancias boutique junto a un lago.', tags: ['Identidad', 'Sitio web', 'Reservas en línea', 'Panel con IA'], art: 0, dark: true, layout: 1, img: '/obra/marea-lago-uhd.webp' },
  { n: 'Casa Lumbre', leaves: [{ f: hcFront, b: hcBack }], cat: 'Sitio web y SEO', y: 2026, hl: 'Presencia que se encuentra', d: 'Un sitio rápido y claro, pensado para aparecer en su ciudad y recibir contactos.', tags: ['Diseño web', 'SEO local', 'Formularios'], art: 2, dark: false, layout: 1, img: '/obra/p2.webp' },
  { n: 'Trama', leaves: [...tramaLeaves(), { f: hcBack, b: hcBack }], pieces: tramaPieces, cat: 'Ecommerce de moda y panel', y: 2025, hl: 'Moda de estudio, a un toque de la cesta', d: 'Identidad, tienda en línea con fichas de producto, tallas y cesta, y un panel de pedidos e inventario con asistente.', tags: ['Ecommerce', 'Catálogo y cesta', 'Panel con IA'], art: 4, dark: false, layout: 1, img: '/obra/p3.webp' },
  { n: 'Hikari Estudio', leaves: auroraLeaves(hcBack, hcBack), pieces: auroraPieces, cat: 'Diseño y fotografía', y: 2025, hl: 'Imágenes con calma', d: 'Identidad, sitio web y portafolio de un estudio de diseño y fotografía, con pocos elementos y mucho espacio.', tags: ['Identidad', 'Sitio web', 'Fotografía'], art: 7, dark: false, layout: 1, img: '/obra/p4.webp' },
  { n: 'Ábaco', leaves: abacoLeaves(), pieces: abacoPieces, cat: 'Finanzas y operaciones', y: 2025, hl: 'Las cuentas, en orden', d: 'Identidad, sitio web y panel de facturas, cobranza y aprobaciones para ordenar las finanzas y operaciones de una empresa.', tags: ['Identidad', 'Sitio web', 'Panel de operación'], art: 6, dark: true, layout: 1, img: '/obra/p5.webp' },
];
// Celular: la baraja usa estas cuatro portadas verticales (sin Casa Lumbre)
const mimg: Record<string, string> = { Marea: '/obra/m/marea.webp', Trama: '/obra/m/trama.webp', 'Hikari Estudio': '/obra/m/hikari.webp', 'Ábaco': '/obra/m/abaco.webp' };
const mprojs = projs.filter((p) => mimg[p.n]);
const { leaves, end } = pagesFor(projs, { brand: 'HumanCorp', mail: 'info@humancorp.co', mailHref: '/contacto', year: 2026, endTitle: 'Diseño, tecnología y operaciones empresariales', contentsTitle: 'Contenido' });
const leavesHtml = leavesMarkup(leaves);
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Obra selecta de HumanCorp: proyectos de identidad, sitios web, ventas, automatización y finanzas, para recorrer página por página." />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>Obra — HumanCorp</title>
  </head>
  <body class="bg-[#0a0706] font-sans text-white">
    <Header />
    <style is:global>[data-nav]::before { display: none; } .ob-cue, .ob-note, [data-bk-count] { display: none; }</style>
    <main class="@container relative z-10 overflow-x-clip" style="--a:#977DFF;--b:#0033FF;--ink:#14173f;--hw:420;--rad:10px;--sh:100svh;--sfont:'Inter Tight Variable',system-ui,sans-serif">
      <section data-tone="dark" class="gal-book ob-book" data-book data-frame="cine" data-closed>
        <div class="bw-stick">
          <script is:inline>(()=>{const d=new Date(),m=d.getMonth(),q=new URLSearchParams(location.search).get('navidad');if(q==='1'||(q!=='0'&&((m===10&&d.getDate()>=15)||m===11||(m===0&&d.getDate()<=6)))){document.currentScript.closest('[data-book]').dataset.xmas='';document.documentElement.dataset.xmas=''}})()</script>
          <i class="ob-win" aria-hidden="true"></i><canvas class="ob-snow" data-snow aria-hidden="true"></canvas>
          <div class="bwv">
            <div class="bw-world" data-bw>
              <BookProps />
              <XmasProps />
              <div class="bw-book" data-bk>
                <i class="bw-sh r"></i><i class="bw-sh l"></i><i class="bw-fs"></i><i class="bw-base"></i><i class="bw-base l"></i>
                <i class="bw-edge r"></i><i class="bw-edge l"></i>
                <div class="bw-end" set:html={end}></div>
                <div style="display:contents" set:html={leavesHtml}></div>
              </div>
            </div>
          </div>
          <div class="bw-intro ob-hero">
            <p class="ob-pill"><i></i>Obra selecta · 2026</p>
            <h1 class="ob-title"><span class="ob-l"><span>Proyectos que</span></span><span class="ob-l"><span>puedes <em>explorar</em></span></span></h1>
            <p class="ob-sub ob-hint">Haz clic en las páginas para ver cada proyecto; desliza para hojear el libro.</p>
            <div class="ob-cta"><button type="button" class="ob-b1" data-ob-start>Empezar a hojear <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button><a class="ob-b2" href="/contacto">Hablemos</a></div>
            <ol class="ob-idx">{projs.map((p, i) => <li><em>{`0${i + 1}`}</em>{p.cat.split(' ')[0] === 'Sitio' ? 'Sitios web' : p.cat.split(' y ')[0]}</li>)}</ol>
          </div>
          <div class="bw-intro ob-cue"><i></i><span>Desliza</span></div>
          <p class="bw-intro ob-note">Ejemplos ilustrativos, no son clientes reales.</p>
          <div class="bw-ui"><span data-bk-count>Cubierta</span><i><b data-bk-bar></b></i></div>
        </div>
      </section>

      <!-- Celular: una baraja de cartas que se desliza a la izquierda (sin libro 3D). Al tocar una carta se abre el proyecto a pantalla completa (scripts/obra-mobile.ts). -->
      <section class="ob-m" data-obs data-tone="dark">
        <div class="obs-bgs" aria-hidden="true">{mprojs.map((_, i) => <i class={`obs-bg${i === 0 ? ' on' : ''}`} data-th={projs.indexOf(_)}><img src={mimg[_.n]} alt="" decoding="async" /><b></b><b></b></i>)}<s class="obs-grain"></s></div>
        <header class="obs-head">
          <div class="obs-row"><p class="obs-eye"><i></i>Obra selecta · 2026</p><p class="obs-cnt"><span data-obs-n>01</span><em> / 0{mprojs.length}</em></p></div>
          <h2 class="obs-title" data-obs-title aria-live="polite">{mprojs[0].n}</h2>
          <p class="obs-sub" data-obs-sub>{mprojs[0].cat} · {mprojs[0].y}</p>
        </header>
        <div class="obs-deck" data-obs-deck>
          {mprojs.map((p, i) => (
            <article class="obs-card" data-i={i} data-th={projs.indexOf(p)} data-n={p.n} data-cat={p.cat} data-y={p.y} data-hl={p.hl} data-d={p.d} data-tags={p.tags.join('|')} data-img={mimg[p.n]}>
              <img src={mimg[p.n]} alt="" width="900" height="1200" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
              <i class="obs-shade"></i>
              <b class="obs-num">{`0${i + 1}`}</b>
              <div class="obs-meta"><p>{p.hl}</p><span class="obs-go"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></span></div>
            </article>
          ))}
        </div>
        <p class="obs-hint"><i></i><span>Desliza para ver más · toca para abrir</span></p>
        <nav class="obs-tab" aria-label="Proyectos">
          {mprojs.map((p, i) => <button type="button" data-go={i} class={i === 0 ? 'on' : ''}><i></i><span>{p.n.split(' ')[0]}</span></button>)}
        </nav>
        {mprojs.map((p, i) => (
          <template data-p={i}>
            {(p.pieces || []).map((pc) => <figure class="obm-pc"><div class="obm-pg" set:html={pc.h}></div><figcaption>{pc.t}</figcaption></figure>)}
          </template>
        ))}
      </section>

      <section data-tone="dark" class="relative px-6 py-[14svh] text-center md:px-10" style="background:linear-gradient(#0a0706,#00033D)">
        <p class="text-[13px] font-medium uppercase tracking-[0.14em] text-white/55">Tu proyecto</p>
        <h2 class="mx-auto mt-5 max-w-[16ch] font-goog text-[clamp(2.2rem,5.6vw,5rem)] font-light leading-[1.03] tracking-[-0.045em]">¿Quieres verlo aquí?</h2>
        <p class="mx-auto mt-5 max-w-[30rem] text-[16px] leading-relaxed text-white/65">Cuéntanos qué necesitas y armamos una propuesta a tu medida. También puedes personalizar una vista de tu sitio.</p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a href="/contacto" class="rounded-full bg-white px-8 py-4 text-[15px] font-medium text-[#0b0c0f] transition-transform hover:scale-[1.03]">Hablemos</a>
          <a href="/arma-tu-proyecto" class="rounded-full border border-white/30 px-8 py-4 text-[15px] transition-colors hover:bg-white/10">Armar mi proyecto (beta)</a>
        </div>
      </section>
      <Contact />
    </main>
    <ScrollFx />

    <script>
      import { mountBook } from '../scripts/book';
      import '../scripts/marea-ui';
      import '../scripts/marea-site';
      import '../scripts/trama-site';
      import '../scripts/trama-dash';
      import '../scripts/au-site';
      import '../scripts/abaco-site';
      import '../scripts/obra-deck';
      const main = document.querySelector<HTMLElement>('main')!;
      const sec = document.querySelector<HTMLElement>('[data-book]')!;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const xmas = 'xmas' in sec.dataset;
      let top = 0, raf = 0;
      const measure = () => { top = sec.getBoundingClientRect().top + scrollY; };
      measure();
      // Posición suavizada: al scrollear rápido las páginas se voltean una a una en lugar de saltar al final.
      let cur = scrollY, lastT = 0;
      const b = mountBook({ sec, scrollY: () => cur, secTop: () => top, viewH: () => innerHeight, scrollTo: (y) => scrollTo({ top: y, behavior: reduced ? 'auto' : 'smooth' }), reduced });
      const update = (t: number) => {
        raf = 0;
        if (!sec.offsetHeight) return; // celular: el libro está oculto
        const dt = Math.min(64, t - lastT || 16); lastT = t;
        const target = scrollY;
        if (reduced) cur = target;
        else {
          // control de velocidad: suavizado + tope (en alturas de pantalla por segundo), así las páginas se voltean una a una por rápido que bajes
          const gap = target - cur, vmax = innerHeight * 1.8 * (1 + Math.max(0, Math.abs(gap) / innerHeight - 2) * 0.5) * (dt / 1000);
          cur += Math.max(-vmax, Math.min(vmax, gap * (1 - Math.exp(-dt / 120))));
          if (Math.abs(target - cur) < 0.5) cur = target;
        }
        const open = cur - top > 10;
        sec.classList.toggle('is-open', open);
        if (open) sec.removeAttribute('data-closed'); else sec.setAttribute('data-closed', '');
        b.update();
        if (cur !== target) raf = requestAnimationFrame(update);
      };
      addEventListener('scroll', () => { if (!raf) { lastT = 0; raf = requestAnimationFrame(update); } }, { passive: true });
      // Al dejar de desplazarse, si una hoja quedó casi abierta o casi cerrada, el libro la asienta del todo:
      // así las páginas interactivas (como el sitio de Marea) quedan planas y se pueden usar.
      let snapT = 0;
      addEventListener('scroll', () => {
        clearTimeout(snapT);
        if (reduced || !sec.offsetHeight) return;
        snapT = window.setTimeout(() => {
          const n = sec.querySelectorAll('.bw-leaf').length, range = Math.max(1, sec.offsetHeight - innerHeight);
          const t = Math.max(0, Math.min(1, ((scrollY - top) / range - 0.05) / 0.88)) * n, k = Math.round(t);
          if (k < 1 || k > n - 1 || Math.abs(t - k) < 0.004 || Math.abs(t - k) > 0.2) return;
          scrollTo({ top: top + (0.05 + (k / n) * 0.88) * range, behavior: 'smooth' });
        }, 260);
      }, { passive: true });
      addEventListener('resize', () => { measure(); cur = scrollY; b.update(); });
      addEventListener('load', () => { measure(); cur = scrollY; b.update(); });
      const lamp = sec.querySelector<HTMLElement>('.bw-lamp')!;
      let lr = 0;
      addEventListener('pointermove', (e) => { if (lr) return; lr = requestAnimationFrame(() => { lr = 0; lamp.style.translate = `${((e.clientX / innerWidth - 0.5) * 50).toFixed(0)}px ${((e.clientY / innerHeight - 0.5) * 36).toFixed(0)}px`; }); }, { passive: true });
      document.querySelector('[data-ob-start]')?.addEventListener('click', () => b.go(1));
      b.update();

      // Temporada navideña: se cargan solo las imágenes de la versión visible y cae nieve detrás de la ventana (solo mientras está a la vista).
      const mobile = matchMedia('(max-width: 700px)').matches;
      // La escena se muestra cuando el libro ya está acomodado y las imágenes de la temporada cargaron (antes se veía armándose: hojas amontonadas y objetos sin imagen).
      const loads: Promise<void>[] = [];
      setTimeout(() => Promise.race([Promise.all(loads), new Promise((r) => setTimeout(r, 1600))]).then(() => requestAnimationFrame(() => requestAnimationFrame(() => sec.classList.add('ob-ready')))), 0);
      if (xmas) {
        document.querySelectorAll<HTMLImageElement>('img[data-xm-src]').forEach((im) => {
          if (!!im.closest('.ob-m') !== mobile) return;
          loads.push(new Promise<void>((r) => { im.addEventListener('load', () => r(), { once: true }); im.addEventListener('error', () => r(), { once: true }); }));
          im.src = im.dataset.xmSrc!;
        });
        document.querySelectorAll<HTMLCanvasElement>('[data-snow]').forEach((snow) => {
          const ctx = snow.getContext('2d'); if (!ctx || reduced) return;
          let fl: { x: number; y: number; r: number; v: number; s: number; a: number }[] = [], w = 0, h = 0, on = false, id = 0, last = 0;
          const size = () => {
            const dpr = Math.min(devicePixelRatio || 1, 1.5);
            w = snow.clientWidth; h = snow.clientHeight; snow.width = w * dpr; snow.height = h * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            fl = Array.from({ length: Math.round(Math.min(160, (w * h) / 6500)) }, () => { const z = Math.random(); return { x: Math.random() * w, y: Math.random() * h, r: 0.5 + z * z * 2.2, v: 12 + z * 40, s: Math.random() * 6.28, a: 0.25 + z * 0.5 }; });
          };
          const tick = (now: number) => {
            const dt = Math.min(0.05, (now - (last || now)) / 1000); last = now;
            ctx.clearRect(0, 0, w, h); ctx.fillStyle = '#fff';
            // un solo trazo por nivel de opacidad (en vez de uno por copo)
            for (let q = 0; q < 4; q++) {
              ctx.globalAlpha = 0.25 + q * 0.2; ctx.beginPath();
              for (const f of fl) {
                if (q === 0) { f.y += f.v * dt; f.s += dt * 0.8; f.x += Math.sin(f.s) * f.r * 6 * dt; if (f.y > h + 4) { f.y = -4; f.x = Math.random() * w; } }
                if (Math.min(3, Math.floor(f.a * 4)) !== q) continue;
                ctx.moveTo(f.x + f.r, f.y); ctx.arc(f.x, f.y, f.r, 0, 6.283);
              }
              ctx.fill();
            }
            id = on ? requestAnimationFrame(tick) : 0;
          };
          size(); addEventListener('resize', size);
          new IntersectionObserver(([e]) => { on = e.isIntersecting; if (on && !id) { last = 0; id = requestAnimationFrame(tick); } }).observe(snow.parentElement!);
        });
      }

      // Celular: las tarjetas se apilan; la anterior se hunde un poco y se oscurece cuando la siguiente la cubre.
      const obm = document.querySelector<HTMLElement>('[data-obm]');
      if (obm) {
        const cards = [...obm.querySelectorAll<HTMLElement>('[data-obm-card]')];
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.3 });
        cards.forEach((c) => io.observe(c));
        const prev: string[] = []; let tk = false;
        const run = () => {
          tk = false;
          if (!obm.offsetHeight) return;
          cards.forEach((c, i) => {
            const nx = cards[i + 1]; if (!nx) return;
            const h = c.offsetHeight, k = Math.max(0, Math.min(1, (h - (nx.getBoundingClientRect().top - (78 + i * 12))) / h)).toFixed(3);
            if (prev[i] !== k) { prev[i] = k; c.style.setProperty('--c', k); }
          });
        };
        const req = () => { if (!tk) { tk = true; requestAnimationFrame(run); } };
        addEventListener('scroll', req, { passive: true }); addEventListener('resize', req); run();
      }
    </script>
  </body>
</html>
