---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import ScrollFx from '../components/ScrollFx.astro';
import BookProps from '../components/BookProps.astro';
import { pagesFor, leavesMarkup, type Proj } from '../scripts/book';

// Proyectos ilustrativos (nombres ficticios): ejemplos de lo que HumanCorp construye en cada división.
const projs: Proj[] = [
  { n: 'Alba', cat: 'Branding e identidad', y: 2026, hl: 'Una marca con voz propia', d: 'Identidad, sistema visual y manual de marca para un estudio creativo.', tags: ['Branding', 'Dirección de arte', 'Manual de marca'], img: '/horizon.webp', art: 0, dark: true, layout: 1 },
  { n: 'Casa Lumbre', cat: 'Sitio web y SEO', y: 2026, hl: 'Presencia que se encuentra', d: 'Un sitio rápido y claro, pensado para aparecer en su ciudad y recibir contactos.', tags: ['Diseño web', 'SEO local', 'Formularios'], img: '/configurador/valle.webp', art: 2, dark: false, layout: 0 },
  { n: 'Grupo Ceiba', cat: 'Ventas y CRM', y: 2025, hl: 'Todo el seguimiento, en un solo lugar', d: 'Prospectos, cotizaciones y reportes conectados en un mismo tablero.', tags: ['CRM', 'Automatización', 'Reportes'], img: '/configurador/retrato.webp', art: 4, dark: true, layout: 0 },
  { n: 'Estudio Aurora', cat: 'Asistentes y automatización', y: 2025, hl: 'Un asistente que sí ayuda', d: 'Responde, da seguimiento y avisa al equipo, con supervisión humana.', tags: ['Agentes de IA', 'Flujos', 'Integraciones'], art: 7, dark: false, layout: 2 },
  { n: 'Taller 33', cat: 'Finanzas y operaciones', y: 2025, hl: 'Números claros, decisiones tranquilas', d: 'Facturación, flujo de caja y procesos internos ordenados.', tags: ['Facturación CFDI', 'Dashboards', 'Procesos'], art: 6, dark: true, layout: 2 },
];
const { leaves, end } = pagesFor(projs, { brand: 'HumanCorp', mail: 'info@humancorp.co', mailHref: '/contacto', year: 2026, endTitle: 'Diseño, tecnología y operaciones empresariales', contentsTitle: 'Contenido' });
const leavesHtml = leavesMarkup(leaves);
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Obra selecta de HumanCorp: proyectos de identidad, sitios web, ventas, automatización y finanzas, para recorrer página por página." />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>Obra — HumanCorp</title>
  </head>
  <body class="bg-[#0a0706] font-sans text-white">
    <Header />
    <main class="@container relative z-10 overflow-x-clip" style="--a:#977DFF;--b:#0033FF;--ink:#14173f;--hw:420;--rad:10px;--sh:100svh;--sfont:'Inter Tight Variable',system-ui,sans-serif">
      <section data-tone="dark" class="gal-book" data-book>
        <div class="bw-stick">
          <div class="bwv">
            <div class="bw-world" data-bw>
              <BookProps />
              <div class="bw-book" data-bk>
                <i class="bw-sh r"></i><i class="bw-sh l"></i><i class="bw-fs"></i><i class="bw-base"></i><i class="bw-base l"></i>
                <i class="bw-edge r"></i><i class="bw-edge l"></i>
                <div class="bw-end" set:html={end}></div>
                <div style="display:contents" set:html={leavesHtml}></div>
              </div>
            </div>
          </div>
          <div class="bw-intro"><h1>Proyectos que puedes explorar</h1><span>Haz clic en las páginas o desliza para recorrer la obra. Son ejemplos ilustrativos de lo que construimos.</span></div>
          <div class="bw-ui"><span data-bk-count>Cubierta</span><i><b data-bk-bar></b></i></div>
        </div>
      </section>

      <section data-tone="dark" class="relative px-6 py-[14svh] text-center md:px-10" style="background:linear-gradient(#0a0706,#00033D)">
        <p class="text-[13px] font-medium uppercase tracking-[0.14em] text-white/55">Tu proyecto</p>
        <h2 class="mx-auto mt-5 max-w-[16ch] font-goog text-[clamp(2.2rem,5.6vw,5rem)] font-light leading-[1.03] tracking-[-0.045em]">¿Quieres verlo aquí?</h2>
        <p class="mx-auto mt-5 max-w-[30rem] text-[16px] leading-relaxed text-white/65">Cuéntanos qué necesitas y armamos una propuesta a tu medida. También puedes personalizar una vista de tu sitio.</p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a href="/contacto" class="rounded-full bg-white px-8 py-4 text-[15px] font-medium text-[#0b0c0f] transition-transform hover:scale-[1.03]">Hablemos</a>
          <a href="/arma-tu-proyecto" class="rounded-full border border-white/30 px-8 py-4 text-[15px] transition-colors hover:bg-white/10">Armar mi proyecto (beta)</a>
        </div>
      </section>
      <Contact />
    </main>
    <ScrollFx />

    <script>
      import { mountBook } from '../scripts/book';
      const main = document.querySelector<HTMLElement>('main')!;
      const sec = document.querySelector<HTMLElement>('[data-book]')!;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let top = 0, raf = 0;
      const measure = () => { top = sec.getBoundingClientRect().top + scrollY; };
      measure();
      const b = mountBook({ sec, scrollY: () => scrollY, secTop: () => top, viewH: () => innerHeight, scrollTo: (y) => scrollTo({ top: y, behavior: reduced ? 'auto' : 'smooth' }), reduced });
      const update = () => { raf = 0; b.update(); };
      addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
      addEventListener('resize', () => { measure(); b.update(); });
      addEventListener('load', () => { measure(); b.update(); });
      const lamp = sec.querySelector<HTMLElement>('.bw-lamp')!;
      let lr = 0;
      addEventListener('pointermove', (e) => { if (lr) return; lr = requestAnimationFrame(() => { lr = 0; lamp.style.translate = `${((e.clientX / innerWidth - 0.5) * 50).toFixed(0)}px ${((e.clientY / innerHeight - 0.5) * 36).toFixed(0)}px`; }); }, { passive: true });
      b.update();
    </script>
  </body>
</html>
