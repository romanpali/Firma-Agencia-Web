---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import ScrollFx from '../components/ScrollFx.astro';

// Proyectos ilustrativos (nombres ficticios): ejemplos de lo que HumanCorp construye en cada división.
const projects = [
  { n: 'Alba', cat: 'Branding e identidad', y: 2026, d: 'Identidad, sistema visual y manual de marca para un estudio creativo.', tags: ['Branding', 'Dirección de arte', 'Manual de marca'], href: '/servicios#div-01' },
  { n: 'Casa Lumbre', cat: 'Sitio web y SEO', y: 2026, d: 'Un sitio rápido y claro, pensado para aparecer en su ciudad y recibir contactos.', tags: ['Diseño web', 'SEO local', 'Formularios'], href: '/servicios#div-02' },
  { n: 'Grupo Ceiba', cat: 'Ventas y CRM', y: 2025, d: 'Seguimiento de prospectos, cotizaciones y reportes en un solo lugar.', tags: ['CRM', 'Automatización', 'Reportes'], href: '/servicios#div-04' },
  { n: 'Estudio Aurora', cat: 'Asistentes y automatización', y: 2025, d: 'Un asistente que responde y da seguimiento, con supervisión humana.', tags: ['Agentes de IA', 'Flujos', 'Integraciones'], href: '/servicios#div-05' },
  { n: 'Taller 33', cat: 'Finanzas y operaciones', y: 2025, d: 'Facturación, flujo de caja y procesos internos ordenados.', tags: ['Facturación CFDI', 'Dashboards', 'Procesos'], href: '/servicios#div-06' },
];
const N = 6;
const pn = (n: number) => `<span class="bk-pn">${String(n).padStart(2, '0')}</span>`;
const cover = `<div class="bk-cover"><p>Obra selecta</p><b>HumanCorp</b><i></i><span>2026</span></div>`;
const contents = `<div class="bk-paper"><p class="bk-k">Contenido</p><h3>Obra selecta</h3><ul>${projects.map((p, i) => `<li><button type="button" data-bk-go="${i + 1}"><span>0${i + 1}</span><b>${p.n}</b><i></i><em>${p.cat}</em></button></li>`).join('')}</ul>${pn(2)}</div>`;
const vis = (i: number) => { const p = projects[i]; return `<div class="gcard bk-vis art${i}"><i class="s1"></i><i class="s2"></i><i class="s3"></i><div class="bk-vt"><span>0${i + 1}</span><b>${p.n}</b><em>${p.cat} · ${p.y}</em></div>${pn(3 + i * 2)}</div>`; };
const txt = (i: number) => { const p = projects[i]; return `<div class="bk-paper"><p class="bk-k">Proyecto 0${i + 1}</p><h3>${p.n}</h3><p class="bk-cat">${p.cat} · ${p.y}</p><p class="bk-d">${p.d}</p><ul class="bk-tags">${p.tags.map((t) => `<li>${t}</li>`).join('')}</ul><a class="bk-more" href="${p.href}">Ver servicio →</a>${pn(4 + i * 2)}</div>`; };
const closing = `<div class="bk-paper"><p class="bk-k">Gracias por recorrer la obra</p><h3>¿Hablamos de tu proyecto?</h3><p class="bk-d">Cuéntanos qué necesitas y lo armamos juntos, paso a paso.</p><a class="bk-more" href="/contacto">Escríbenos →</a>${pn(12)}</div>`;
const leaves = [{ f: cover, b: contents }, ...projects.map((_, i) => ({ f: vis(i), b: i < 4 ? txt(i + 1) : closing }))];
const end = `<div class="bk-faceend"><p>HumanCorp</p><b>Diseño, tecnología y operaciones</b><a href="/contacto">info@humancorp.co</a>${pn(14)}</div>`;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Obra selecta de HumanCorp: proyectos de identidad, sitios web, ventas, automatización y finanzas, para recorrer página por página." />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>Obra — HumanCorp</title>
  </head>
  <body class="bg-[#0a0706] font-sans text-white">
    <Header />
    <main class="@container relative z-10 overflow-x-clip" style="--a:#977DFF;--b:#0033FF;--ink:#14173f;--hw:420;--rad:10px;--sh:100svh;--mx:0;--my:0">
      <section data-tone="dark" class="gal-book obra" data-book>
        <div class="bk-stick">
          <i class="bk-wood"></i><i class="bk-lamp"></i>
          <svg class="bk-cup" viewBox="0 0 140 140" aria-hidden="true"><circle cx="66" cy="72" r="58" fill="#cfc4b0"/><circle cx="66" cy="72" r="50" fill="#e9e1d2"/><rect x="108" y="58" width="30" height="26" rx="13" fill="#f4efe4"/><rect x="116" y="64" width="14" height="14" rx="7" fill="#cfc4b0"/><circle cx="66" cy="72" r="38" fill="#f7f3ea"/><circle cx="66" cy="72" r="31" fill="#3a2418"/><ellipse cx="56" cy="62" rx="14" ry="8" fill="rgba(255,235,210,.28)" transform="rotate(-24 56 62)"/></svg>
          <svg class="bk-plant" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="52" r="40" fill="#2b2a28"/><circle cx="50" cy="52" r="33" fill="#1b1a19"/><g fill="#5f8a55">{[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <ellipse cx="50" cy="34" rx="7.5" ry="17" transform={`rotate(${i * 45} 50 52)`} />)}</g><g fill="#7ba46c">{[0, 1, 2, 3, 4, 5].map((i) => <ellipse cx="50" cy="40" rx="5" ry="11" transform={`rotate(${i * 60 + 20} 50 52)`} />)}</g></svg>
          <i class="bk-pencil"></i>
          <div class="bk-intro"><p>Obra selecta</p><h1>Proyectos que puedes explorar</h1><span>Desliza para pasar las páginas o haz clic en una. Son ejemplos ilustrativos de lo que construimos.</span></div>
          <div class="bk-scene"><div class="bk-book" data-bk>
            <i class="bk-base"></i><i class="bk-base l"></i>
            <div class="bk-end"><div class="bk-faceend" set:html={end.replace(/^<div class="bk-faceend">|<\/div>$/g, '')}></div></div>
            <div style="display:contents">
              {leaves.map((l, k) => (
                <div class="bk-leaf" data-k={k}><div class="bk-face f" set:html={l.f}></div><div class="bk-face b" set:html={l.b}></div></div>
              ))}
            </div>
          </div></div>
          <div class="bk-ui"><span data-bk-count>Cubierta</span><i><b data-bk-bar></b></i></div>
        </div>
      </section>

      <section data-tone="dark" class="relative px-6 py-[14svh] text-center md:px-10" style="background:linear-gradient(#0a0706,#00033D)">
        <p class="text-[13px] font-medium uppercase tracking-[0.14em] text-white/55">Tu proyecto</p>
        <h2 class="mx-auto mt-5 max-w-[16ch] font-goog text-[clamp(2.2rem,5.6vw,5rem)] font-light leading-[1.03] tracking-[-0.045em]">¿Quieres verlo aquí?</h2>
        <p class="mx-auto mt-5 max-w-[30rem] text-[16px] leading-relaxed text-white/65">Cuéntanos qué necesitas y armamos una propuesta a tu medida. También puedes personalizar una vista de tu sitio.</p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a href="/contacto" class="rounded-full bg-white px-8 py-4 text-[15px] font-medium text-[#0b0c0f] transition-transform hover:scale-[1.03]">Hablemos</a>
          <a href="/arma-tu-proyecto" class="rounded-full border border-white/30 px-8 py-4 text-[15px] transition-colors hover:bg-white/10">Armar mi proyecto (beta)</a>
        </div>
      </section>
      <Contact />
    </main>
    <ScrollFx />

    <script>
      const main = document.querySelector<HTMLElement>('main')!;
      const sec = document.querySelector<HTMLElement>('[data-book]')!;
      const book = sec.querySelector<HTMLElement>('[data-bk]')!;
      const leaves = [...sec.querySelectorAll<HTMLElement>('.bk-leaf')];
      const N = leaves.length;
      const count = sec.querySelector<HTMLElement>('[data-bk-count]')!;
      const bar = sec.querySelector<HTMLElement>('[data-bk-bar]')!;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const cl = (x: number) => Math.max(0, Math.min(1, x));
      const sm = (x: number) => x * x * (3 - 2 * x);
      let top = 0, range = 1, raf = 0;
      const measure = () => { top = sec.getBoundingClientRect().top + scrollY; range = Math.max(1, sec.offsetHeight - innerHeight); };
      const update = () => {
        raf = 0;
        const p = cl((scrollY - top) / range);
        const t = cl((p - 0.05) / 0.88) * N;
        const cur = Math.floor(Math.min(t, N - 0.001));
        leaves.forEach((el, k) => {
          const a = sm(cl(t - k)) * 180;
          el.style.setProperty('--ang', a.toFixed(2));
          el.style.setProperty('--z', `${(a > 90 ? k : N - k) * 6}px`);
          el.style.setProperty('--shade', (Math.sin((a * Math.PI) / 180) * 0.5).toFixed(3));
          el.style.visibility = k >= cur - 1 && k <= cur + 1 ? 'visible' : 'hidden';
        });
        const e = sm(cl(p / 0.28));
        book.style.setProperty('--o', sm(cl(t)).toFixed(3));
        book.style.setProperty('--lb', cl(t * 1.5).toFixed(3));
        book.style.setProperty('--rx', (62 - 42 * e).toFixed(2));
        book.style.setProperty('--rz', (-9 * (1 - e)).toFixed(2));
        book.style.setProperty('--bs', (0.8 + 0.22 * e).toFixed(3));
        sec.style.setProperty('--bp', p.toFixed(3));
        const pg = Math.round(t);
        count.textContent = pg < 1 ? 'Cubierta' : pg > N - 1 ? `Proyecto ${N - 1} de ${N - 1}` : `Proyecto ${pg} de ${N - 1}`;
        bar.style.transform = `scaleX(${(t / N).toFixed(3)})`;
      };
      const go = (t: number) => {
        measure();
        scrollTo({ top: top + (0.05 + (t / N) * 0.88) * range + (t > 0 && t < N ? 2 : 0), behavior: reduced ? 'auto' : 'smooth' });
      };
      addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
      addEventListener('resize', () => { measure(); update(); });
      addEventListener('load', () => { measure(); update(); });
      main.addEventListener('pointermove', (e) => { main.style.setProperty('--mx', (e.clientX / innerWidth - 0.5).toFixed(3)); main.style.setProperty('--my', (e.clientY / innerHeight - 0.5).toFixed(3)); }, { passive: true });
      book.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t.closest('a')) return;
        const g = t.closest<HTMLElement>('[data-bk-go]');
        if (g) { go(+g.dataset.bkGo!); return; }
        const leaf = t.closest<HTMLElement>('.bk-leaf');
        if (!leaf) return;
        const k = +leaf.dataset.k!, a = parseFloat(leaf.style.getPropertyValue('--ang')) || 0;
        go(a > 90 ? k : k + 1);
      });
      measure(); update();
    </script>
  </body>
</html>
