---
import Light from '../layouts/Light.astro';
import Panel from '../components/Panels.astro';

const covers = [
  ['Asesoría contable', 'Te orientamos sobre cómo llevar y entender la contabilidad de tu empresa.'],
  ['Asesoría fiscal en general', 'Resolvemos tus dudas y te acompañamos con tu información fiscal.'],
  ['Facturación electrónica', 'Organización y automatización de CFDI 4.0 y de tus comprobantes.'],
  ['Control financiero', 'Ingresos, egresos, cuentas por cobrar y por pagar, y flujo de caja.'],
  ['Documentación en orden', 'Tus facturas, contratos y comprobantes clasificados y fáciles de encontrar.'],
  ['Recordatorios de obligaciones', 'Seguimiento de fechas y pendientes para que nada se te pase.'],
];
const checks = [
  'No tengo claro cuánto gano realmente cada mes.',
  'Emito mis facturas de forma manual y a veces tarde.',
  'Mi información está en varios lugares y cuesta encontrarla.',
  'Tengo dudas sobre mis obligaciones fiscales.',
  'No sé qué cuentas por cobrar tengo pendientes.',
  'Mis gastos no están clasificados.',
  'Quiero preparar mi información para que la revise un contador.',
  'Quiero conectar mi facturación con mis ventas.',
];
const how = [
  ['Diagnóstico', 'Revisamos tu situación contable y fiscal actual, y cómo llevas hoy tu información.'],
  ['Orden y automatización', 'Organizamos tu información y automatizamos lo repetitivo con la tecnología de HumanCorp.'],
  ['Acompañamiento', 'Damos seguimiento, resolvemos dudas y revisamos contigo de forma continua.'],
];
import { quote } from '../data/paquetes';
// Acceso rápido a los paquetes contables y fiscales: el más básico, la asesoría y los extras.
const acceso: { n: string; t: string; d: string; g: [string, string]; href: string }[] = [
  { n: 'Básico', t: 'Apoyo contable puntual', d: 'Ordena tu información o resuelve una situación específica.', g: ['#10b981', '#0f766e'], href: quote('Apoyo contable puntual') },
  { n: 'Asesoría', t: 'Asesoría contable y fiscal', d: 'Acompañamiento continuo del Director de Administración y Finanzas (contador) y su área.', g: ['#4f46e5', '#1e3a8a'], href: quote('Asesoría contable y fiscal') },
  { n: 'Extra', t: 'Operaciones financieras', d: 'Facturación, flujo de caja, reportes y organización documental.', g: ['#0ea5e9', '#3730a3'], href: quote('Operaciones financieras') },
  { n: 'Extra', t: 'Orden financiero', d: 'Contabilidad, operación y tableros en un solo lugar.', g: ['#7c3aed', '#3730a3'], href: quote('Orden financiero') },
  { n: 'Extra', t: 'Venta en línea', d: 'Tienda, promoción y facturación electrónica conectadas.', g: ['#f59e0b', '#be185d'], href: quote('Venta en línea') },
];
---

<Light title="Asesoría contable y fiscal" description="Asesoría contable y fiscal de HumanCorp, a cargo de nuestro contador, con la tecnología y la automatización que ordenan tu información.">
  <section data-tone="light" class="px-6 pb-[8svh] pt-[24svh] md:px-10">
    <div class="mx-auto max-w-[1280px]">
      <p data-reveal class="text-[13px] font-medium uppercase tracking-[0.14em] text-[#6b6e75]">Contable y fiscal</p>
      <h1 data-words class="mt-6 max-w-[17ch] font-goog text-[clamp(2.5rem,6.6vw,6.4rem)] font-light leading-[1.02] tracking-[-0.05em]">Tu información en orden, con quien la entiende.</h1>
      <p data-reveal style="--i:1" class="mt-7 max-w-[38rem] text-[clamp(1.05rem,1.5vw,1.3rem)] leading-relaxed text-[#3a3d42]">Nuestro Director de Administración y Finanzas es contador. Junto con su área te brinda asesoría contable y fiscal, apoyada en la tecnología y la automatización que construimos para tu empresa.</p>
      <div data-reveal style="--i:2" class="mt-9 flex flex-wrap gap-3">
        <a href="/contacto?interes=Asesor%C3%ADa%20contable%20y%20fiscal" class="rounded-full bg-[#0b0b0c] px-7 py-3.5 text-[15px] font-medium text-white transition-transform hover:scale-[1.03]">Platicar con nuestro contador</a>
        <a href="#necesitas" class="rounded-full border border-[#0b0b0c]/20 px-7 py-3.5 text-[15px] transition-colors hover:bg-[#0b0b0c]/5">¿Qué necesita mi negocio?</a>
      </div>
    </div>
  </section>

  <section data-tone="light" class="px-6 pb-[4svh] md:px-10">
    <div class="mx-auto max-w-[1280px]">
      <div class="flex flex-wrap items-baseline justify-between gap-3 border-t border-[#e6e4df] pt-8">
        <p data-reveal class="text-[13px] font-medium uppercase tracking-[0.14em] text-[#6b6e75]">Acceso rápido a paquetes</p>
        <a data-reveal href="/paquetes#contable" class="text-[14px] underline decoration-[#0b0b0c]/25 underline-offset-[6px] hover:decoration-[#0b0b0c]">Ver todos los paquetes contables y fiscales →</a>
      </div>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {acceso.map((a, i) => (
          <li data-reveal style={`--i:${i % 3}`}>
            <a href={a.href} class="group flex h-full flex-col rounded-[20px] p-5 text-white shadow-[0_24px_50px_-30px_rgba(14,12,60,.7)] ring-1 ring-white/20 transition-transform duration-300 hover:-translate-y-1" style={`background:linear-gradient(rgba(7,8,38,.3),rgba(7,8,38,.45)),linear-gradient(150deg,${a.g[0]},${a.g[1]})`}>
              <span class={`w-fit rounded-full px-2.5 py-[3px] text-[10.5px] font-semibold uppercase tracking-[0.16em] ${a.n === 'Extra' ? 'bg-black/25 ring-1 ring-white/30' : 'bg-white text-[#14163a]'}`}>{a.n}</span>
              <h3 class="mt-5 font-goog text-[1.2rem] leading-[1.1] tracking-[-0.03em]">{a.t}</h3>
              <p class="mt-2 text-[13px] leading-relaxed text-white/90">{a.d}</p>
              <span class="mt-auto pt-5 text-[13.5px] font-medium">Cotizar <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section data-tone="light" class="px-6 py-[6svh] md:px-10">
    <div class="mx-auto max-w-[1280px] border-t border-[#e6e4df] pt-10">
      <p data-reveal class="text-[13px] font-medium uppercase tracking-[0.14em] text-[#6b6e75]">Qué cubre</p>
      <ul class="mt-8 grid gap-x-10 md:grid-cols-2 lg:grid-cols-3">
        {covers.map(([t, d], i) => (
          <li data-reveal style={`--i:${i % 3}`} class="border-t border-[#e6e4df] py-7">
            <span class="font-goog text-[14px] text-[#6b6e75]">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="mt-4 font-goog text-[1.35rem] font-normal tracking-[-0.03em]">{t}</h2>
            <p class="mt-2 text-[14.5px] leading-relaxed text-[#50535a]">{d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section data-tone="dark" class="relative overflow-hidden bg-[#00033D] px-6 py-[9svh] text-white md:px-10">
    <i class="pointer-events-none absolute inset-0" style="background:radial-gradient(70vmax 55vmax at 85% 0%,rgba(0,51,255,.45),transparent 70%),radial-gradient(60vmax 50vmax at 0% 100%,rgba(151,125,255,.3),transparent 70%)" aria-hidden="true"></i>
    <div class="relative mx-auto grid max-w-[1280px] items-center gap-10 md:grid-cols-12 md:gap-14">
      <div class="md:col-span-5">
        <p data-reveal class="text-[13px] font-medium uppercase tracking-[0.14em] text-white/60">Con tecnología</p>
        <h2 data-words class="mt-5 font-goog text-[clamp(2rem,3.6vw,3.4rem)] font-light leading-[1.04] tracking-[-0.045em]">Menos papeleo, más claridad</h2>
        <p data-reveal class="mt-5 max-w-[26rem] text-[15.5px] leading-relaxed text-white/70">Tu información financiera, tus facturas y tus próximos vencimientos en un solo panel, para decidir con datos y llegar a la revisión contable con todo en orden.</p>
      </div>
      <div data-reveal class="md:col-span-7">
        <div data-fit class="relative mx-auto aspect-[8/5] w-full max-w-[720px] overflow-hidden rounded-[22px] border border-white/15 bg-white/5 shadow-[0_40px_90px_-40px_rgba(0,0,40,.9)]">
          <div class="absolute left-1/2 top-1/2 h-[400px] w-[640px]" data-fit-inner style="--q:1"><Panel i={2} label="Finanzas" /></div>
        </div>
      </div>
    </div>
  </section>

  <section id="necesitas" data-tone="light" class="px-6 py-[10svh] md:px-10">
    <div class="mx-auto grid max-w-[1280px] gap-10 md:grid-cols-12 md:gap-14">
      <div class="md:col-span-5">
        <p data-reveal class="text-[13px] font-medium uppercase tracking-[0.14em] text-[#6b6e75]">¿Qué necesita tu negocio?</p>
        <h2 data-words class="mt-5 font-goog text-[clamp(2rem,3.6vw,3.4rem)] font-light leading-[1.04] tracking-[-0.045em]">Marca lo que te suena familiar</h2>
        <p data-reveal class="mt-5 max-w-[26rem] text-[15.5px] leading-relaxed text-[#50535a]">Es una forma rápida de ordenar tus ideas. Después puedes enviarnos tu selección para platicarla con nuestro contador.</p>
      </div>
      <div class="md:col-span-7">
        <ul data-checks class="border-t border-[#e6e4df]">
          {checks.map((c) => (
            <li class="border-b border-[#e6e4df]"><label class="chk flex cursor-pointer items-center gap-4 py-4 text-[15.5px]"><input type="checkbox" value={c} class="sr-only" /><i class="grid size-6 shrink-0 place-items-center rounded-md border border-[#0b0b0c]/25 transition-colors"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 transition-opacity" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg></i><span class="text-[#3a3d42] transition-colors">{c}</span></label></li>
          ))}
        </ul>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a data-send href="/contacto?interes=Asesor%C3%ADa%20contable%20y%20fiscal" class="rounded-full bg-[#0b0b0c] px-7 py-3.5 text-[15px] font-medium text-white transition-transform hover:scale-[1.03]">Enviar mi selección</a>
          <span data-count class="text-[13.5px] text-[#6b6e75]">Aún no marcas ninguna.</span>
        </div>
      </div>
    </div>
  </section>

  <section data-tone="light" class="px-6 pb-[10svh] md:px-10">
    <div class="mx-auto max-w-[1280px] border-t border-[#e6e4df] pt-10">
      <p data-reveal class="text-[13px] font-medium uppercase tracking-[0.14em] text-[#6b6e75]">Cómo trabajamos</p>
      <ol class="mt-8 grid gap-10 md:grid-cols-3 md:gap-0 md:divide-x md:divide-[#e6e4df]">
        {how.map(([t, d], i) => <li data-reveal style={`--i:${i}`} class="md:px-8 md:first:pl-0 md:last:pr-0"><span class="font-goog text-[14px] text-[#6b6e75]">{String(i + 1).padStart(2, '0')}</span><h3 class="mt-6 font-goog text-[1.45rem] font-normal tracking-[-0.03em]">{t}</h3><p class="mt-3 text-[15px] leading-relaxed text-[#50535a]">{d}</p></li>)}
      </ol>
    </div>
  </section>

  <section data-tone="light" class="px-6 pb-[12svh] md:px-10">
    <div data-reveal class="mx-auto grid max-w-[1280px] items-center gap-8 rounded-[24px] bg-[#f6f5f2] p-6 md:grid-cols-[180px_1fr_auto] md:p-8">
      <img src="/team/mauricio.jpg" alt="Mauricio Alberto Pali Maldonado" width="640" height="641" loading="lazy" class="portrait aspect-square w-[140px] rounded-[10px] object-cover object-top md:w-full" style="filter:grayscale(1)" />
      <div>
        <p class="text-[12px] font-medium uppercase tracking-[0.14em] text-[#6b6e75]">Asesor Fiscal y Contable</p>
        <h2 class="mt-2 font-goog text-[clamp(1.5rem,2.4vw,2.2rem)] tracking-[-0.035em]">Mauricio Alberto Pali Maldonado</h2>
        <p class="mt-3 max-w-[34rem] text-[15px] leading-relaxed text-[#50535a]">Contador y Director de Administración y Finanzas de HumanCorp. Lleva la asesoría contable y fiscal de las empresas que acompañamos.</p>
      </div>
      <a href="/contacto?interes=Asesor%C3%ADa%20contable%20y%20fiscal" class="rounded-full bg-[#0b0b0c] px-7 py-3.5 text-center text-[15px] font-medium text-white transition-transform hover:scale-[1.03]">Agendar una llamada</a>
    </div>
    <p class="mx-auto mt-6 max-w-[1280px] text-[12.5px] leading-relaxed text-[#6b6e75]">La información de esta página es general y no sustituye una asesoría para tu caso específico. El alcance de cada servicio se define por escrito antes de contratar.</p>
  </section>

  <script>
    import { countsOf, paintCounts } from '../scripts/frame';
    // Escala el panel para que llene su marco.
    const box = document.querySelector<HTMLElement>('[data-fit]')!;
    const inner = box.querySelector<HTMLElement>('[data-fit-inner]')!;
    const fit = () => { const k = Math.min(box.clientWidth / 640, box.clientHeight / 400) * 0.96; inner.style.transform = `translate(-50%,-50%) scale(${k})`; };
    new ResizeObserver(fit).observe(box); fit();
    inner.querySelector('.pn')!.setAttribute('style', '--q:1;left:0;top:0');
    paintCounts(countsOf(inner), 1);

    // Lista «¿Qué necesita tu negocio?» → mensaje precargado en contacto.
    const list = document.querySelector<HTMLElement>('[data-checks]')!;
    const send = document.querySelector<HTMLAnchorElement>('[data-send]')!;
    const count = document.querySelector<HTMLElement>('[data-count]')!;
    list.addEventListener('change', () => {
      const on = [...list.querySelectorAll<HTMLInputElement>('input:checked')].map((i) => i.value);
      count.textContent = on.length ? `${on.length} marcada${on.length > 1 ? 's' : ''}.` : 'Aún no marcas ninguna.';
      const msg = on.length ? `Hola, me gustaría platicar sobre asesoría contable y fiscal. Me identifico con lo siguiente:\n- ${on.join('\n- ')}` : '';
      send.href = `/contacto?interes=${encodeURIComponent('Asesoría contable y fiscal')}${msg ? '&mensaje=' + encodeURIComponent(msg) : ''}`;
    });
  </script>
</Light>
